// Tiny images as bytes, for the image tests (`import fixtures;`). Made with
// Python's imaging library: a 3 x 2 red rectangle as PNG and as JPEG, a
// genuine 4097 x 1 PNG, and hostile variants built from them. Kept as hex,
// one line each (as arrays, the formatter gives every byte its own line).

/** A 3 x 2 PNG. */
fun png(): u8[] = from_hex(
    "89504e470d0a1a0a0000000d49484452000000030000000208020000001216f14d0000001549444154789c633ca1a1c1c0c0c0c0c0c0c4000300148c011ca02b9ba10000000049454e44ae426082",
);

/** A 3 x 2 JPEG. */
fun jpeg(): u8[] = from_hex(
    "",
);

/** A genuine 4097 x 1 PNG: GTK would decode it; kivuli's check refuses it. */
fun wide_png(): u8[] = from_hex(
    "89504e470d0a1a0a0000000d494844520000100100000001080000000094885f9e0000001c4944415478daedc1010d00000c02a0dbfcd1ede180fc01000000f30a20fc00829c07cf870000000049454e44ae426082",
);

/** The PNG with its IHDR saying 5000 x 5000: a small file claiming a huge image. */
fun huge_png(): u8[] {
    let mut out = png();
    // Width at bytes 16-19, height at 20-23, big-endian: 5000 = 0x1388.
    out[18] = 19;
    out[19] = 136;
    out[22] = 19;
    out[23] = 136;
    out
}

/** The PNG with a sound header and its pixel data broken. */
fun corrupt_png(): u8[] {
    let mut out = png();
    out[40] = 0;
    out[41] = 0;
    out[42] = 0;
    out
}

/** The first `n` bytes of `bytes`. */
fun cut(bytes: u8[], n: i64): u8[] {
    let mut out: u8[] = [];
    let mut i = 0;
    while i < n {
        out.push(bytes[i]);
        i = i + 1;
    }
    out
}

/** The bytes a string of hex digits (two per byte, lowercase) spells. */
fun from_hex(digits: string): u8[] {
    let all = "0123456789abcdef";
    let mut values: i64[] = [];
    for b of digits {
        let mut v = 0;
        while all.slice(v, v + 1).to_bytes()[0] != b {
            v = v + 1;
        }
        values.push(v);
    }
    let mut out: u8[] = [];
    let mut i = 0;
    while i + 1 < values.len {
        out.push((values[i] * 16 + values[i + 1]) as u8);
        i = i + 2;
    }
    out
}
