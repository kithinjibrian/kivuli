// Menu entries, without GTK: items, separators, disabled items.
import kivuli.view.menus { MenuEntry, items, layout };
import kivuli { item, menu_label, menu_separator, submenu, check_item, radio_group };

fun assert_same<T>(actual: T, expected: T) {
    assert_eq("{actual}", "{expected}");
}

@test
fun entries_are_items_separators_and_disabled_items() {
    let open: MenuEntry<i64> = MenuEntry.Item("Open", Some(1));
    assert_same(item("Open", 1), open);
    let line: MenuEntry<i64> = MenuEntry.Separator;
    assert_same(menu_separator(), line);
    let off: MenuEntry<i64> = MenuEntry.Item("Open", None);
    assert_same(item("Open", 1).disabled(true), off);
    assert_same(item("Open", 1).disabled(false), open);
}

@test
fun labels_submenus_and_hints_are_entries() {
    let title: MenuEntry<i64> = MenuEntry.Label("My Account");
    assert_same(menu_label("My Account"), title);
    let hinted: MenuEntry<i64> = MenuEntry.Hinted("Profile", Some(1), "Ctrl+P");
    assert_same(item("Profile", 1).hint("Ctrl+P"), hinted);
    // Disabling keeps the hint; an empty hint is a plain item again.
    let off: MenuEntry<i64> = MenuEntry.Hinted("Profile", None, "Ctrl+P");
    assert_same(item("Profile", 1).hint("Ctrl+P").disabled(true), off);
    let plain: MenuEntry<i64> = MenuEntry.Item("Profile", Some(1));
    assert_same(item("Profile", 1).hint("Ctrl+P").hint(""), plain);
    let sub: MenuEntry<i64> = MenuEntry.Submenu("Invite", [MenuEntry.Item("Email", Some(2))]);
    assert_same(submenu("Invite", [item("Email", 2)]), sub);
}

@test
fun items_are_counted_depth_first_through_submenus() {
    let entries: MenuEntry<i64>[] = [
        menu_label("A"),
        item("One", 1),
        submenu("More", [item("Two", 2), menu_separator(), item("Three", 3)]),
        item("Four", 4).hint("Ctrl+4"),
    ];
    assert_eq(items(entries).map(fun(i) = i.0), ["One", "Two", "Three", "Four"]);
    assert_eq(layout(entries), [
        "label A",
        "item One",
        "sub More [ item Two | item Three ]",
        "item Four Ctrl+4",
    ]);
}

@test
fun a_mapped_submenu_maps_inside() {
    let entries: MenuEntry<i64>[] = [submenu("More", [item("Two", 2).hint("Ctrl+2")])];
    let mapped = entries.map(fun(e) = e.map(fun(n: i64): string = "{n}"));
    assert_eq(items(mapped).map(fun(i) = i.1), [Some("2")]);
}

@test
fun check_items_and_radio_groups_are_entries() {
    let check: MenuEntry<i64> = check_item(
        "Status bar",
        true,
        fun(b: bool): i64 = if b { 1 } else { 0 },
    );
    // Picking sends the toggle of the opposite.
    assert_eq(items([check]), [("Status bar", Some(0))]);
    assert_eq(items([check.disabled(true)]), [("Status bar", None)]);
    let radio: MenuEntry<i64> = radio_group("Bottom", [("Top", 1), ("Bottom", 2)]);
    assert_eq(items([radio]), [("Top", Some(1)), ("Bottom", Some(2))]);
    assert_eq(items([radio.disabled(true)]), [("Top", None), ("Bottom", None)]);
    // Ticks follow the model through the actions' states, not the model's layout.
    assert_eq(layout([check, radio]), ["check Status bar", "radio [ Top Bottom ]"]);
    assert_eq(layout([check_item("Status bar", false, fun(b: bool): i64 = 0)]), [
        "check Status bar",
    ]);
    assert_eq(layout([check.hint("Ctrl+B")]), ["check Status bar Ctrl+B"]);
}

@test
fun check_items_and_radio_groups_map() {
    let entries: MenuEntry<i64>[] = [
        check_item("A", false, fun(b: bool): i64 = if b { 1 } else { 0 }),
        radio_group("X", [("X", 5)]),
    ];
    let mapped = entries.map(fun(e) = e.map(fun(n: i64): string = "{n}"));
    assert_eq(items(mapped).map(fun(i) = i.1), [Some("1"), Some("5")]);
}
