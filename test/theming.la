// Colours, and the paint pass: each node's style becomes its CSS classes
// before the diff, the rules the view needs are collected for the app's
// stylesheet, and what the app got wrong stops it before GTK. No GTK.
import kivuli.styles.theming { Color, read_hex };
import kivuli.styles.paint { painted, stylesheet };
import kivuli.view.walk { check_content };
import kivuli {
    View,
    Font,
    Text,
    Size,
    Weight,
    FontStyle,
    Transform,
    Paint,
    Background,
    Gradient,
    Image,
    Border,
    Spacing,
    Edges,
    Side,
    Width,
    Radius,
    button,
    button_with,
    checkbox,
    column,
    icon,
    input,
    lazy,
    rgb,
    row,
    spacer,
    text,
    header_bar,
    When,
    State,
    Sizing,
    Bar,
};

@test
fun hex_reads_three_six_and_eight_digits() {
    assert_eq(read_hex("#242424"), Ok(Color { red: 36, green: 36, blue: 36, alpha: 255 }));
    assert_eq(read_hex("#fff"), Ok(Color { red: 255, green: 255, blue: 255, alpha: 255 }));
    assert_eq(read_hex("#FF000080"), Ok(Color { red: 255, green: 0, blue: 0, alpha: 128 }));
    assert_eq(rgb(1, 2, 3), Color { red: 1, green: 2, blue: 3, alpha: 255 });
}

@test
fun bad_hex_strings_say_why() {
    assert_eq(read_hex("242424"), Err("a colour starts with #: \"242424\""));
    assert_eq(read_hex("#24242"), Err("a colour has 3, 6 or 8 hex digits: \"#24242\""));
    assert_eq(read_hex("#zz0000"), Err("not a hex digit in \"#zz0000\""));
}

fun classes_of(v: View<i64>): string[] = match painted(v) {
    Ok(Styled(_, s)) => s.classes,
    Ok(_) => [],
    Err(problem) => panic(problem),
};

@test
fun painting_gives_each_node_the_classes_of_its_values() {
    assert_eq(
        classes_of(
            text("a").style([
                Font { weight: Weight.Bold, ..Font.theme() },
                Text { transform: Transform.Uppercase, ..Text.theme() },
            ]),
        ),
        ["kv-fw-700", "kv-tt-upper"],
    );
    assert_eq(classes_of(text("a").tooltip("t")), []);
    // A value changed by a later `.style` call gives the new class only.
    assert_eq(
        classes_of(
            text("a").style([Font { weight: Weight.Bold, ..Font.theme() }]).style([
                Font { weight: Weight.Thin, ..Font.theme() },
            ]),
        ),
        ["kv-fw-100"],
    );
}

@test
fun the_stylesheet_has_every_rule_the_view_uses_once() {
    let v: View<i64> = column([
        text("a").style([Font { weight: Weight.Bold, ..Font.theme() }]),
        row([
            text("b").style([
                Font { weight: Weight.Bold, ..Font.theme() },
                Font { style: FontStyle.Italic, ..Font.theme() },
            ]),
        ]),
        lazy("k", fun(): View<i64> = text("c").style([Text { letter_spacing: 1, ..Text.theme() }])),
    ]);
    let painted_view = match painted(v) {
        Ok(p) => p,
        Err(problem) => panic(problem),
    };
    assert_eq(stylesheet(painted_view), [
        ("kv-fw-700", ".kv-fw-700 {{ font-weight: 700; }}"),
        ("kv-fst-italic", ".kv-fst-italic {{ font-style: italic; }}"),
        ("kv-ls-1", ".kv-ls-1 {{ letter-spacing: 1px; }}"),
    ]);
}

@test
fun painting_refuses_what_the_app_got_wrong() {
    let deep: View<i64> = column([text("a").header(header_bar([], text("T"), []))]);
    assert_eq(
        painted(deep).map(fun(v) = 0),
        Err(".header(…) belongs on the root of the view only"),
    );
    let bad: View<i64> = column([text("a").style([Font { size: Size.Pt(0), ..Font.theme() }])]);
    assert_eq(painted(bad).map(fun(v) = 0), Err("Size.Pt(0): a font size must be positive"));
    // `.size` is a box size for icons and pictures; text takes Font.size.
    let sized: View<i64> = column([text("a").size(20)]);
    assert_eq(
        painted(sized).map(fun(v) = 0),
        Err(".size(n) on text is gone: use .style([Font {{ size: Size.Pt(n), ..Font.theme() }}])"),
    );
    let icon_size: View<i64> = column([icon("folder-symbolic").size(24)]);
    assert_eq(painted(icon_size).map(fun(v) = 0), Ok(0));
}

@test
fun a_button_withs_content_holds_nothing_interactive() {
    let fine: View<i64> = row([text("Account").expand(), spacer(), icon("go-next-symbolic")]);
    assert_eq(check_content(fine), Ok(()));
    let inner: View<i64> = row([text("Account"), button("Delete", 1)]);
    assert_eq(
        check_content(inner),
        Err("a button_with's content can't hold a button (\"Delete\")"),
    );
    let field: View<i64> = column([input("x", fun(s: string) = 1)]);
    assert_eq(check_content(field), Err("a button_with's content can't hold a text field"));
    let tick: View<i64> = checkbox("On", true, fun(b: bool) = 1);
    assert_eq(check_content(tick), Err("a button_with's content can't hold a check box (\"On\")"));
    let nested: View<i64> = lazy("k", fun(): View<i64> = button_with(text("x"), 1));
    assert_eq(check_content(nested), Err("a button_with's content can't hold a button_with"));
    // The paint pass refuses it, wherever the button is.
    let bad: View<i64> = column([button_with(inner, 2)]);
    assert_eq(
        painted(bad).map(fun(v) = 0),
        Err("a button_with's content can't hold a button (\"Delete\")"),
    );
}

@test
fun painting_gives_a_backgrounds_classes_and_refuses_its_bad_values() {
    let dark = Background { color: Paint.Color(rgb(16, 16, 16)), ..Background.theme() };
    assert_eq(classes_of(text("a").style([dark])), ["kv-bg-101010ff", "kv-bgi-none"]);
    let pictured: View<i64> = column([]).style([
        Background { image: Some(Image.Icon("starred-symbolic")), ..Background.theme() },
    ]);
    let cs = classes_of(pictured);
    assert_eq(cs.len, 1);
    assert(cs[0].starts_with("kv-bgp-"));
    let bad: View<i64> = column([
        text("a").style([Background { gradient: Gradient.Radial([]), ..Background.theme() }]),
    ]);
    assert_eq(painted(bad).map(fun(v) = 0), Err("Gradient: a gradient needs at least two stops"));
}

@test
fun painting_gives_a_borders_classes_and_refuses_its_bad_values() {
    let framed: View<i64> = text("a").style([
        Border {
            bottom: Side { width: Width.Px(1), ..Side.theme() },
            radius: Radius.All(6),
            ..Border.theme(),
        },
    ]);
    assert_eq(classes_of(framed), [
        "kv-bw-bottom-1",
        "kv-bs-bottom-solid",
        "kv-br-tl-6",
        "kv-br-tr-6",
        "kv-br-br-6",
        "kv-br-bl-6",
    ]);
    let bad: View<i64> = column([
        text("a").style([Border { radius: Radius.All(-1), ..Border.theme() }]),
    ]);
    assert_eq(painted(bad).map(fun(v) = 0), Err("Radius.All(-1): a radius can't be negative"));
}

@test
fun painting_gives_a_spacings_classes_and_refuses_its_bad_values() {
    let room: View<i64> = text("a").style([
        Spacing { padding: Edges { top: Width.Px(2), ..Edges.theme() }, ..Spacing.theme() },
    ]);
    assert_eq(classes_of(room), ["kv-p-top-2"]);
    let bad: View<i64> = column([
        column([]).style([Spacing { gap: Width.Px(-1), ..Spacing.theme() }]),
    ]);
    assert_eq(
        painted(bad).map(fun(v) = 0),
        Err("Spacing.gap: Width.Px(-1): a gap can't be negative"),
    );
}

/** An empty bar with the tests' message type. */
fun blank(): Bar<i64> = header_bar([], text("T"), []);

fun root_classes(v: View<i64>): string[] = match painted(v) {
    Ok(Styled(_, s)) => s.bar_classes,
    _ => [],
};

@test
fun painting_gives_the_bar_its_classes_and_refuses_what_it_cant_take() {
    let bar: Bar<i64> = header_bar([], text("T"), []).style([
        Background { color: Paint.Color(rgb(36, 36, 36)), ..Background.theme() },
        When(State.Hover, [Font { weight: Weight.Bold, ..Font.theme() }]),
    ]);
    assert_eq(root_classes(text("body").header(bar)), [
        "kv-bg-242424ff",
        "kv-bgi-none",
        "kv-hover-fw-700",
    ]);
    let wide: View<i64> = text("body").header(
        blank().style([Sizing { max_width: Width.Px(10), ..Sizing.theme() }]),
    );
    assert_eq(
        painted(wide).map(fun(v) = 0),
        Err("header_bar(…): a header bar's size and gap are the window's"),
    );
    let pictured: View<i64> = text("body").header(
        blank().style([Background { image: Some(Image.Icon("a")), ..Background.theme() }]),
    );
    assert_eq(
        painted(pictured).map(fun(v) = 0),
        Err("header_bar(…): a header bar can't have a background image"),
    );
}
