// Context menus on real GTK widgets: the node keeps its widget and gains a
// popover menu and an action per item; picking an item (activating its
// action) sends its message, a disabled one nothing; an update re-points the
// messages and rebuilds the model only for new labels; a right-click and the
// Menu key pop it up, and a node whose menu was taken away opens nothing; a
// removed node frees its popover. Needs a display, so it is skipped without
// one. (How it looks and where it opens: examples/frame.la.)
import std.env;
import gtk {
    GtkApplication,
    GtkWidget,
    connect_app,
    emit_widget,
    g_action_activate,
    g_application_quit,
    g_application_run,
    g_object_unref,
    gtk_application_new,
    gtk_application_window_new,
    gtk_popover_popdown,
    gtk_shortcut_action_activate,
    gtk_widget_get_visible,
    gtk_widget_grab_focus,
    lgtk_emit_pressed,
    on_finalized,
};
import kivuli.live { mount, live_of };
import kivuli.effects { sandbox_app };
import kivuli.live_tree { Live, Popup, widget };
import kivuli { View, button, column, item, menu_separator, text };

fun has_display(): bool = env.get("DISPLAY").is_some() || env.get("WAYLAND_DISPLAY").is_some();

/** Runs `steps` with a function giving the app's top column's children now. */
fun with_app<Model, Msg>(
    id: string,
    model: Model,
    update: fun(Model, Msg): Model,
    view: fun(Model): View<Msg>,
    steps: fun(fun(): Live<Msg>[]),
) {
    let application = gtk_application_new(id, 0);
    connect_app(
        application,
        "activate",
        fun(a: GtkApplication) {
            let window = gtk_application_window_new(a);
            let app = mount(a, window, sandbox_app("org.kivuli.test", model, update, view));
            steps(fun(): Live<Msg>[] = match live_of(app) {
                Box(_, _, kids) => kids,
                _ => panic("expected a column"),
            });
            g_application_quit(a);
        },
        0,
    );
    g_application_run(application, 0, None);
    g_object_unref(application);
}

fun note(seen: Ref<string[]>, s: string) {
    seen.update(fun(xs) {
        let mut ys = xs;
        ys.push(s);
        ys
    });
}

enum Act {
    /** What an item sends: the number it carries. */
    Sent(i64),
    Retarget,
    Rename,
    Drop,
    Gone,
}

struct Tab {
    target: i64,
    label: string,
    menu: bool,
    shown: bool,
}

fun view_tab(t: Tab): View<Act> {
    let tab: View<Act> = button("news", Act.Sent(0)).menu(
        if t.menu {
            [
                item(t.label, Act.Sent(t.target)),
                menu_separator(),
                item("Close", Act.Sent(9)).disabled(true),
            ]
        } else {
            []
        },
    );
    column([
        if t.shown { tab } else { text("none") },
        button("Retarget", Act.Retarget),
        button("Rename", Act.Rename),
        button("Drop", Act.Drop),
        button("Gone", Act.Gone),
    ])
}

/** The tab's widget and its menu, as kivuli holds them. */
fun parts(kids: Live<Act>[]): (GtkWidget, Popup<Act>) = match kids[0] {
    Menu(node, popup) => (widget(node), popup),
    _ => panic("expected a node with a menu"),
};

@test
fun menus_send_follow_the_view_open_and_go() {
    if !has_display() {
        skip("no display");
    }
    let seen: Ref<string[]> = Ref.new([]);
    let freed: Ref<string[]> = Ref.new([]);
    let update = fun(t: Tab, msg: Act): Tab = match msg {
        Sent(n) => {
            note(seen, "sent {n}");
            t
        }
        Retarget => Tab { target: t.target + 1, ..t },
        Rename => Tab { label: "Reopen", ..t },
        Drop => Tab { menu: false, ..t },
        Gone => Tab { shown: false, ..t },
    };
    with_app("org.kivuli.test.menu", Tab {
        target: 1,
        label: "Open",
        menu: true,
        shown: true,
    }, update, view_tab, fun(kids: fun(): Live<Act>[]) {
        let (tab, popup) = parts(kids());
        note(seen, "shows {popup.shown.get()}, {popup.actions.get().len} actions");
        // Picking: the first item sends its message; the disabled one nothing.
        g_action_activate(popup.actions.get()[0], None);
        g_action_activate(popup.actions.get()[1], None);
        // An update re-points the message; the same labels keep the model.
        let model = popup.model.get();
        emit_widget(widget(kids()[1]), "clicked");
        let (same_tab, same) = parts(kids());
        note(seen, "same widget: {same_tab == tab}, same model: {same.model.get() == model}");
        g_action_activate(same.actions.get()[0], None);
        // New labels rebuild the model.
        emit_widget(widget(kids()[2]), "clicked");
        let (_, renamed) = parts(kids());
        note(seen, "renamed: {renamed.shown.get()}, new model: {renamed.model.get() != model}");
        // A right-click and the Menu key pop it up.
        lgtk_emit_pressed(renamed.click, 1, 3.0, 4.0);
        note(seen, "right-click: {gtk_widget_get_visible(renamed.popover)}");
        gtk_popover_popdown(renamed.popover);
        gtk_shortcut_action_activate(renamed.keys, 0, tab, None);
        note(seen, "menu key: {gtk_widget_get_visible(renamed.popover)}");
        // Taken away: the widget stays, and the menu closes and opens no more.
        emit_widget(widget(kids()[3]), "clicked");
        let (dropped_tab, dropped) = parts(kids());
        note(
            seen,
            "dropped: {dropped_tab == tab}, open: {gtk_widget_get_visible(dropped.popover)}",
        );
        lgtk_emit_pressed(dropped.click, 1, 3.0, 4.0);
        note(seen, "after a right-click: {gtk_widget_get_visible(dropped.popover)}");
        // Removed: the node and its popover are freed.
        on_finalized(dropped.popover, fun(gone: GtkWidget) {
            note(freed, "popover");
        });
        on_finalized(tab, fun(gone: GtkWidget) {
            note(freed, "tab");
        });
        // Closing the menu gave the tab focus back, and a hidden window keeps
        // its focus widget alive even once removed (a shown one doesn't:
        // checked in C, GTK 4.22). Focus moves away first, as a click would.
        gtk_widget_grab_focus(widget(kids()[4]));
        emit_widget(widget(kids()[4]), "clicked");
    });
    assert_eq(seen.get(), [
        "shows [\"item Open\", \"|\", \"item Close\"], 2 actions",
        "sent 1",
        "same widget: true, same model: true",
        "sent 2",
        "renamed: [\"item Reopen\", \"|\", \"item Close\"], new model: true",
        "right-click: 1",
        "menu key: 1",
        "dropped: true, open: 0",
        "after a right-click: 0",
    ]);
    assert_eq(freed.get(), ["popover", "tab"]);
}
