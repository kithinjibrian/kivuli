// The header bar on real GTK widgets: the window's titlebar, its parts
// patched in place and its buttons sending messages, and a replaced view
// keeping the ones packed after it; the window controls styled through the
// bar (PRP-054). Needs a display, so it is skipped
// without one. Maximizing and an expanding title widget need a window on
// screen: those are checked by hand.
import std.env;
import gtk {
    GtkApplication,
    GtkWidget,
    connect_app,
    emit_widget,
    g_application_quit,
    g_application_run,
    g_object_unref,
    gtk_application_new,
    gtk_application_window_new,
    gtk_header_bar_get_show_title_buttons,
    gtk_header_bar_get_title_widget,
    gtk_widget_get_parent,
    gtk_window_get_titlebar,
    gtk_widget_has_css_class,
    gtk_widget_get_first_child,
    gtk_widget_get_next_sibling,
    lgtk_widget_rgba,
};
import kivuli.render.live { mount, live_of };
import kivuli.core.effects { sandbox_app };
import kivuli.core.live_tree { Live, widget };
import kivuli {
    View,
    Inside,
    Part,
    Text,
    button,
    column,
    input,
    text,
    header_bar,
    Background,
    Paint,
    hex,
};

fun has_display(): bool = env.get("DISPLAY").is_some() || env.get("WAYLAND_DISPLAY").is_some();

/** Runs `steps` on the mounted app's window and root, noting every message `update` receives. */
fun with_app<Model, Msg>(
    id: string,
    model: Model,
    update: fun(Model, Msg): Model,
    view: fun(Model): View<Msg>,
    received: Ref<string[]>,
    steps: fun(GtkWidget, fun(): Live<Msg>),
) {
    let application = gtk_application_new(id, 0);
    connect_app(
        application,
        "activate",
        fun(a: GtkApplication) {
            let window = gtk_application_window_new(a);
            let app = mount(a, window, sandbox_app(
                "org.kivuli.test",
                model,
                fun(m: Model, msg: Msg): Model {
                    received.update(fun(xs) {
                        let mut ys = xs;
                        ys.push("{msg}");
                        ys
                    });
                    update(m, msg)
                },
                view,
            ));
            steps(window, fun(): Live<Msg> = live_of(app));
            g_application_quit(a);
        },
        0,
    );
    g_application_run(application, 0, None);
    g_object_unref(application);
}

fun note(seen: Ref<string[]>, s: string) {
    seen.update(fun(xs) {
        let mut ys = xs;
        ys.push(s);
        ys
    });
}

enum Nav {
    Back,
    Typed(string),
    More,
}

struct Browser {
    address: string,
    extra: bool,
}

fun update_browser(b: Browser, msg: Nav): Browser = match msg {
    Back => b,
    Typed(s) => Browser { address: s, ..b },
    More => Browser { extra: !b.extra, ..b },
};

fun view_browser(b: Browser): View<Nav> {
    let mut end = [button("More", Nav.More)];
    if b.extra {
        end.push(button("Extra", Nav.More));
    }
    column([text("page {b.address}")]).header(
        header_bar([button("Back", Nav.Back)], input(b.address, Nav.Typed).expand(), end),
    )
}

/** The header as the live tree holds it: its start and end widgets' counts, and the title widget. */
fun header_of(window: GtkWidget, root: Live<Nav>): string {
    let Framed(bar, _, title, Pack(_, _, start), Pack(_, _, end)) = root else {
        panic("expected a header");
    };
    let is_titlebar = gtk_window_get_titlebar(window) == Some(bar);
    let is_title = gtk_header_bar_get_title_widget(bar) == Some(widget(title));
    "titlebar {is_titlebar} buttons {gtk_header_bar_get_show_title_buttons(bar)} title {is_title} start {start.len} end {end.len}"
}

@test
fun a_header_bar_is_the_titlebar_and_its_parts_follow_the_model() {
    if !has_display() {
        skip("no display");
    }
    let seen: Ref<string[]> = Ref.new([]);
    let received: Ref<string[]> = Ref.new([]);
    with_app("org.kivuli.test.header", Browser {
        address: "home",
        extra: false,
    }, update_browser, view_browser, received, fun(window: GtkWidget, root: fun(): Live<Nav>) {
        note(seen, header_of(window, root()));
        let Framed(_, _, title, Pack(_, _, start), Pack(_, _, end)) = root() else {
            panic("expected a header");
        };
        let address = widget(title);
        // A click in the bar sends its message.
        emit_widget(widget(start[0]), "clicked");
        // More adds an end button (Append), then removes it (Remove).
        emit_widget(widget(end[0]), "clicked");
        note(seen, header_of(window, root()));
        emit_widget(widget(end[0]), "clicked");
        note(seen, header_of(window, root()));
        let Framed(_, _, after, _, _) = root() else {
            panic("expected a header");
        };
        note(seen, "same title widget: {widget(after) == address}");
    });
    assert_eq(seen.get(), [
        "titlebar true buttons 1 title true start 1 end 1",
        "titlebar true buttons 1 title true start 1 end 2",
        "titlebar true buttons 1 title true start 1 end 1",
        "same title widget: true",
    ]);
    assert_eq(received.get(), ["Back", "More", "More"]);
}

enum Repack {
    Swap,
}

// The header's first start view changes kind (text to button): it's replaced,
// and the view after it is taken off and packed again.
fun view_repack(swapped: bool): View<Repack> = column([button("Swap", Repack.Swap)]).header(
    header_bar(
        [if swapped { button("first", Repack.Swap) } else { text("first") }, text("second")],
        text("Title"),
        [],
    ),
);

@test
fun replacing_a_header_view_keeps_the_ones_after_it() {
    if !has_display() {
        skip("no display");
    }
    let seen: Ref<string[]> = Ref.new([]);
    let received: Ref<string[]> = Ref.new([]);
    with_app("org.kivuli.test.repack", false, fun(
        s: bool,
        msg: Repack,
    ): bool = true, view_repack, received, fun(window: GtkWidget, root: fun(): Live<Repack>) {
        let Framed(_, body, _, Pack(_, _, before), _) = root() else {
            panic("expected a header");
        };
        let second = widget(before[1]);
        let Box(_, _, kids) = body else {
            panic("expected a column");
        };
        emit_widget(widget(kids[0]), "clicked");
        let Framed(_, _, _, Pack(_, _, after), _) = root() else {
            panic("expected a header");
        };
        note(
            seen,
            "views {after.len}, second kept: {widget(after[1]) == second}, still in the bar: {gtk_widget_get_parent(second).is_some()}",
        );
    });
    assert_eq(seen.get(), ["views 2, second kept: true, still in the bar: true"]);
}

enum Shade {
    Toggle,
}

fun view_shaded(dark: bool): View<Shade> = column([text("page")]).header(
    header_bar([button("Toggle", Shade.Toggle)], text("Title"), []).style(
        if dark {
            [Background { color: Paint.Color(hex("#242424")), ..Background.theme() }]
        } else {
            []
        },
    ),
);

@test
fun a_bars_style_goes_on_the_bar_and_follows_the_model() {
    if !has_display() {
        skip("no display");
    }
    let seen: Ref<string[]> = Ref.new([]);
    let received: Ref<string[]> = Ref.new([]);
    with_app("org.kivuli.test.bar", true, fun(
        dark: bool,
        msg: Shade,
    ): bool = !dark, view_shaded, received, fun(window: GtkWidget, root: fun(): Live<Shade>) {
        let Framed(bar, body, _, Pack(_, _, start), _) = root() else {
            panic("expected a header");
        };
        note(
            seen,
            "bar {gtk_widget_has_css_class(bar, "kv-bg-242424ff")} page {gtk_widget_has_css_class(widget(body), "kv-bg-242424ff")} controls {gtk_header_bar_get_show_title_buttons(bar)}",
        );
        emit_widget(widget(start[0]), "clicked");
        let Framed(same, _, _, _, _) = root() else {
            panic("expected a header");
        };
        note(
            seen,
            "after: same bar {same == bar}, dark {gtk_widget_has_css_class(bar, "kv-bg-242424ff")}",
        );
    });
    assert_eq(seen.get(), ["bar 1 page 0 controls 1", "after: same bar true, dark 0"]);
}

enum Plain {
    Never,
}

fun view_controls(n: i64): View<Plain> = column([text("page")]).header(
    header_bar([], text("Title"), []).style([
        Inside(Part.WindowButton, [Text.color(hex("#112233"))]),
        Inside(Part.WindowClose, [Text.color(hex("#ff0000"))]),
        Inside(Part.WindowIcon, [Text.color(hex("#00ff00"))]),
        Inside(Part.WindowCloseIcon, [Text.color(hex("#0000ff"))]),
    ]),
);

/** The first widget under `w` (itself included) with the CSS class `css`. */
fun find(w: GtkWidget, css: string): Option<GtkWidget> {
    if gtk_widget_has_css_class(w, css) != 0 {
        return Some(w);
    }
    let mut child = gtk_widget_get_first_child(w);
    while child.is_some() {
        let c = child.expect("checked above");
        match find(c, css) {
            Some(found) => {
                return Some(found);
            }
            None => {}
        }
        child = gtk_widget_get_next_sibling(c);
    }
    None
}

/** A widget's text colour as hex, `#rrggbbaa`. */
fun rgba(w: GtkWidget): string {
    let n = lgtk_widget_rgba(w) as i64;
    let digits = "0123456789abcdef";
    let mut out = "#";
    let mut shift = 28;
    while shift >= 0 {
        let d = n >> shift & 15;
        out = out + digits.slice(d, d + 1);
        shift = shift - 4;
    }
    out
}

@test
fun a_bars_style_reaches_its_window_controls() {
    if !has_display() {
        skip("no display");
    }
    let seen: Ref<string[]> = Ref.new([]);
    let received: Ref<string[]> = Ref.new([]);
    with_app("org.kivuli.test.controls", 0, fun(
        n: i64,
        msg: Plain,
    ): i64 = n, view_controls, received, fun(window: GtkWidget, root: fun(): Live<Plain>) {
        let Framed(bar, _, _, _, _) = root() else {
            panic("expected a header");
        };
        match (find(bar, "minimize"), find(bar, "close")) {
            (Some(minimize), Some(close)) => {
                let icon = gtk_widget_get_first_child(close).expect(
                    "a window control holds its icon",
                );
                let other = gtk_widget_get_first_child(minimize).expect(
                    "a window control holds its icon",
                );
                note(
                    seen,
                    "minimize {rgba(minimize)} close {rgba(close)} icon {rgba(other)} close icon {rgba(icon)}",
                );
            }
            _ => note(seen, "no window controls"),
        }
    });
    assert_eq(seen.get(), [
        "minimize #112233ff close #ff0000ff icon #00ff00ff close icon #0000ffff",
    ]);
}
