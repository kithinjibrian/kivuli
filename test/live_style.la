// Modifiers on real GTK widgets: a style is applied when a widget is made,
// changed by a SetStyle patch, and undone when the modifier goes. Needs a
// display, so it is skipped without one.
import std.env;
import gtk {
    GtkApplication,
    GtkWidget,
    connect_app,
    emit_widget,
    g_application_quit,
    g_application_run,
    g_object_unref,
    gtk_application_new,
    gtk_application_window_new,
    gtk_box_get_spacing,
    gtk_label_get_attributes,
    gtk_widget_get_halign,
    gtk_widget_get_margin_start,
    gtk_widget_get_margin_top,
    gtk_widget_get_sensitive,
    gtk_widget_get_vexpand,
    gtk_widget_has_css_class,
    pango_attr_list_to_string,
};
import kivuli.live { dispatch, mount, live_of };
import kivuli.effects { sandbox_app };
import kivuli.live_tree { Live, widget };
import kivuli { View, Align, column, row, spacer, text, ButtonStyle, button };

fun has_display(): bool = env.get("DISPLAY").is_some() || env.get("WAYLAND_DISPLAY").is_some();

enum Look {
    Roomy,
    Plain,
}

struct Page {
    roomy: bool,
}

fun update(p: Page, msg: Look): Page = match msg {
    Roomy => Page { roomy: true },
    Plain => Page { roomy: false },
};

// The title's padding and alignment, and the row's spacing, follow the model;
// the spacer always carries padding, and must still grow.
fun view(p: Page): View<Look> = if p.roomy {
    column([
        text("Title").padding(12).align(Align.Center).bold().size(18).dim(),
        row([text("a"), text("b")]).spacing(8),
        spacer().padding(2),
    ])
} else {
    column([text("Title"), row([text("a"), text("b")]), spacer().padding(2)])
};

// A label's Pango attributes as text; empty when it has none.
fun attrs(label: GtkWidget): string = match gtk_label_get_attributes(label) {
    Some(list) => pango_attr_list_to_string(list),
    None => "",
};

// margin, alignment across the column (GtkAlign: 0 fill, 3 center), the
// row's spacing, whether the spacer grows down, and the title's bold, size
// (18pt = 18432 Pango units) and dim class.
fun read(root: Live<Look>): i32[] {
    let Box(_, _, kids) = root else {
        panic("expected a column");
    };
    let title = widget(kids[0]);
    [
        gtk_widget_get_margin_top(title),
        gtk_widget_get_margin_start(title),
        gtk_widget_get_halign(title),
        gtk_box_get_spacing(widget(kids[1])),
        gtk_widget_get_vexpand(widget(kids[2])),
        if attrs(title).contains("weight bold") { 1 } else { 0 },
        if attrs(title).contains("size 18432") { 1 } else { 0 },
        gtk_widget_has_css_class(title, "dim-label"),
    ]
}

@test
fun styles_apply_change_and_undo_on_the_same_widgets() {
    if !has_display() {
        skip("no display");
    }
    let seen: Ref<i32[][]> = Ref.new([]);
    let application = gtk_application_new("org.kivuli.test.style", 0);
    connect_app(
        application,
        "activate",
        fun(a: GtkApplication) {
            let window = gtk_application_window_new(a);
            let app = mount(
                a,
                window,
                sandbox_app("org.kivuli.test", Page { roomy: false }, update, view),
            );
            let first = live_of(app);
            seen.update(fun(xs) {
                let mut ys = xs;
                ys.push(read(first));
                ys
            });
            for msg of [Look.Roomy, Look.Plain] {
                dispatch(app, msg);
                let Some(s) = app.state.get() else {
                    panic("no state after a message");
                };
                seen.update(fun(xs) {
                    let mut ys = xs;
                    ys.push(read(s.live));
                    ys
                });
            }
            g_application_quit(a);
        },
        0,
    );
    g_application_run(application, 0, None);
    g_object_unref(application);

    // Plain, then roomy (padding 12, centered, spacing 8, bold 18pt dim), then plain again:
    // every field is undone. The padded spacer grows throughout.
    assert_eq(seen.get(), [
        [0, 0, 0, 0, 1, 0, 0, 0],
        [12, 12, 3, 8, 1, 1, 1, 1],
        [0, 0, 0, 0, 1, 0, 0, 0],
    ]);
}

enum Tap {
    Add,
    Reset,
}

struct Tally {
    count: i64,
}

fun update_tally(t: Tally, msg: Tap): Tally = match msg {
    Add => Tally { count: t.count + 1 },
    Reset => Tally { count: 0 },
};

// Reset is disabled at zero (decision 6); Add is the primary action, Reset
// the dangerous one.
fun view_tally(t: Tally): View<Tap> = row([
    button("Add", Tap.Add).style(ButtonStyle.Primary),
    button("Reset", Tap.Reset).style(ButtonStyle.Danger).disabled(t.count == 0),
]);

@test
fun a_disabled_button_is_greyed_out_and_sends_nothing() {
    if !has_display() {
        skip("no display");
    }
    let seen: Ref<string[]> = Ref.new([]);
    let received: Ref<string[]> = Ref.new([]);
    let application = gtk_application_new("org.kivuli.test.buttons", 0);
    connect_app(
        application,
        "activate",
        fun(a: GtkApplication) {
            let window = gtk_application_window_new(a);
            let app = mount(a, window, sandbox_app(
                "org.kivuli.test",
                Tally { count: 0 },
                fun(t: Tally, msg: Tap): Tally {
                    received.update(fun(xs) {
                        let mut ys = xs;
                        ys.push("{msg}");
                        ys
                    });
                    update_tally(t, msg)
                },
                view_tally,
            ));
            let first = live_of(app);
            let Box(_, _, kids) = first else {
                panic("expected a row");
            };
            let add = widget(kids[0]);
            let reset = widget(kids[1]);
            let look = fun(): string {
                let sensitive = gtk_widget_get_sensitive(reset);
                let primary = gtk_widget_has_css_class(add, "suggested-action");
                let danger = gtk_widget_has_css_class(reset, "destructive-action");
                "reset {sensitive}, primary {primary}, danger {danger}"
            };
            // At zero: a click on the greyed-out Reset sends nothing.
            emit_widget(reset, "clicked");
            seen.update(fun(xs) {
                let mut ys = xs;
                ys.push(look());
                ys
            });
            // After Add, Reset works again, and then is disabled again.
            emit_widget(add, "clicked");
            seen.update(fun(xs) {
                let mut ys = xs;
                ys.push(look());
                ys
            });
            emit_widget(reset, "clicked");
            seen.update(fun(xs) {
                let mut ys = xs;
                ys.push(look());
                ys
            });
            g_application_quit(a);
        },
        0,
    );
    g_application_run(application, 0, None);
    g_object_unref(application);

    assert_eq(seen.get(), [
        "reset 0, primary 1, danger 1",
        "reset 1, primary 1, danger 1",
        "reset 0, primary 1, danger 1",
    ]);
    assert_eq(received.get(), ["Add", "Reset"]);
}
