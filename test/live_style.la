// Modifiers on real GTK widgets: a style is applied when a widget is made,
// changed by a SetStyle patch, and undone when the modifier goes. Needs a
// display, so it is skipped without one.
import std.env;
import gtk {
    GtkApplication,
    GtkWidget,
    connect_app,
    g_application_quit,
    g_application_run,
    g_object_unref,
    gtk_application_new,
    gtk_application_window_new,
    gtk_box_get_spacing,
    gtk_widget_get_halign,
    gtk_widget_get_margin_start,
    gtk_widget_get_margin_top,
    gtk_widget_get_vexpand,
    gtk_window_set_child,
};
import kivuli.live { Live, Running, State, dispatch, sender, widget };
import kivuli.build { create };
import kivuli { View, Align, column, row, spacer, text };

fun has_display(): bool = env.get("DISPLAY").is_some() || env.get("WAYLAND_DISPLAY").is_some();

enum Look {
    Roomy,
    Plain,
}

struct Page {
    roomy: bool,
}

fun update(p: Page, msg: Look): Page = match msg {
    Roomy => Page { roomy: true },
    Plain => Page { roomy: false },
};

// The title's padding and alignment, and the row's spacing, follow the model;
// the spacer always carries padding, and must still grow.
fun view(p: Page): View<Look> = if p.roomy {
    column([
        text("Title").padding(12).align(Align.Center),
        row([text("a"), text("b")]).spacing(8),
        spacer().padding(2),
    ])
} else {
    column([text("Title"), row([text("a"), text("b")]), spacer().padding(2)])
};

// margin, alignment across the column (GtkAlign: 0 fill, 3 center), the
// row's spacing, and whether the spacer grows down.
fun read(root: Live<Look>): i32[] {
    let Box(_, _, kids) = root else {
        panic("expected a column");
    };
    let title = widget(kids[0]);
    [
        gtk_widget_get_margin_top(title),
        gtk_widget_get_margin_start(title),
        gtk_widget_get_halign(title),
        gtk_box_get_spacing(widget(kids[1])),
        gtk_widget_get_vexpand(widget(kids[2])),
    ]
}

@test
fun styles_apply_change_and_undo_on_the_same_widgets() {
    if !has_display() {
        skip("no display");
    }
    let seen: Ref<i32[][]> = Ref.new([]);
    let application = gtk_application_new("org.kivuli.test.style", 0);
    connect_app(
        application,
        "activate",
        fun(a: GtkApplication) {
            let window = gtk_application_window_new(a);
            let state: Ref<Option<State<Page, Look>>> = Ref.new(None);
            let app = Running {
                window: window,
                update_fn: update,
                view_fn: view,
                state: state,
                patching: Ref.new(false),
            };
            let init = Page { roomy: false };
            let tree = view(init);
            let first = create(tree, sender(app));
            gtk_window_set_child(window, widget(first));
            state.set(Some(State { model: init, tree: tree, live: first }));
            seen.update(fun(xs) {
                let mut ys = xs;
                ys.push(read(first));
                ys
            });
            for msg of [Look.Roomy, Look.Plain] {
                dispatch(app, msg);
                let Some(s) = state.get() else {
                    panic("no state after a message");
                };
                seen.update(fun(xs) {
                    let mut ys = xs;
                    ys.push(read(s.live));
                    ys
                });
            }
            g_application_quit(a);
        },
        0,
    );
    g_application_run(application, 0, None);
    g_object_unref(application);

    // Plain, then roomy (padding 12, centered, spacing 8), then plain again:
    // every field is undone. The padded spacer grows throughout.
    assert_eq(seen.get(), [[0, 0, 0, 0, 1], [12, 12, 3, 8, 1], [0, 0, 0, 0, 1]]);
}
