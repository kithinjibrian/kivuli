// Styling a widget's parts (PRP-036): `Inside(part, …)` merges like a
// node's values and is written as a descendant rule, alone or under a
// state; its classes go on the node; `Mark.icon` is GTK's icon source; what
// a part can't take is refused. No GTK.
import kivuli.styles { Sheet };
import kivuli.styles.sheets { rules };
import kivuli.styles.checks { check };
import kivuli.styles.paint { painted };
import kivuli.view.looks { Style };
import kivuli {
    View,
    Part,
    Inside,
    Mark,
    When,
    State,
    Token,
    Background,
    Border,
    Sizing,
    Spacing,
    Image,
    Text,
    checkbox,
};

fun box(): View<i64> = checkbox("x", false, fun(b: bool): i64 = 1);

fun sheet_of<M>(v: View<M>): Sheet = match v {
    Styled(_, s) => s.sheet,
    _ => panic("expected a styled node"),
};

fun keys(s: Sheet): string[] = rules(s).map(fun(r) = r.0);

@test
fun a_part_is_a_descendant_rule() {
    let s = Inside(Part.Check, [Background.color(Token.Primary)]).apply(Sheet.theme());
    assert_eq(rules(s), [
        ("kv-check-bgt-primary check", "background-color: var(--kv-primary);"),
        ("kv-check-bgi-none check", "background-image: none;"),
    ]);
}

@test
fun a_second_inside_of_a_part_merges_into_the_first() {
    let s = Inside(Part.Check, [Background.color(Token.Accent)]).apply(
        Inside(Part.Check, [Background.color(Token.Primary), Sizing.min_width(16)]).apply(
            Sheet.theme(),
        ),
    );
    assert_eq(s.parts.len, 1);
    let found = keys(s);
    assert(found.iter().any(fun(k) = k == "kv-check-bgt-accent check"));
    assert(!found.iter().any(fun(k) = k == "kv-check-bgt-primary check"));
    assert(found.iter().any(fun(k) = k.starts_with("kv-check-") && k.ends_with(" check")));
}

@test
fun under_a_state_the_pseudo_class_sits_on_the_widget() {
    let s = When(State.Checked, [Inside(Part.Check, [Background.color(Token.Primary)])]).apply(
        Sheet.theme(),
    );
    let k = keys(s).filter(fun(k) = !k.contains("bgi-none"));
    assert_eq(k.len, 1);
    assert(k[0].starts_with("kv-checked-check-bgt-primary."));
    assert(k[0].ends_with(":checked check"));
}

@test
fun a_parts_classes_go_on_the_node() {
    let v = box().style([Inside(Part.Check, [Background.color(Token.Primary)])]);
    match painted(v) {
        Ok(Styled(_, s)) => assert(s.classes.iter().any(fun(c) = c == "kv-check-bgt-primary")),
        _ => panic("expected a painted, styled node"),
    }
}

@test
fun a_mark_is_gtks_icon_source() {
    let s = Mark.icon("object-select-symbolic", 14).apply(Sheet.theme());
    let r = rules(s);
    assert_eq(r.len, 1);
    assert_eq(
        r[0].1,
        "-gtk-icon-source: -gtk-icontheme(\"object-select-symbolic\"); -gtk-icon-size: 14px;",
    );
    assert_eq(check(s), Ok(()));
    assert_eq(
        check(Mark.icon("a\"b", 14).apply(Sheet.theme())),
        Err(
            "Mark.icon(\"a\"b\", 14): an icon name can't hold quotes, backslashes, ; {{ }} or line breaks",
        ),
    );
    assert_eq(
        check(Mark.icon("ok", 0).apply(Sheet.theme())),
        Err("Mark.icon(\"ok\", 0): an icon's size is at least 1 pixel"),
    );
}

@test
fun what_a_part_cant_take_is_refused() {
    // A When inside a part is allowed now (PRP-039): its state sits on the part.
    let hovered = sheet_of(
        box().style([Inside(Part.Check, [When(State.Hover, [Background.color(Token.Accent)])])]),
    );
    assert_eq(check(hovered), Ok(()));
    let gap = sheet_of(box().style([Inside(Part.Check, [Spacing.gap(4)])]));
    assert_eq(
        check(gap),
        Err(
            "Inside(Part.Check, …): a part can't change a background image, an exact or maximum size, or the gap",
        ),
    );
    let fine = sheet_of(box().style([Inside(Part.Check, [Border.rounded(4)])]));
    assert_eq(check(fine), Ok(()));
}

@test
fun under_focus_a_part_keeps_its_node() {
    let s = When(State.Focus, [Inside(Part.Check, [Border.all(1, Token.Ring)])]).apply(
        Sheet.theme(),
    );
    for k of keys(s) {
        assert(k.ends_with(":focus-visible check"));
    }
}

@test
fun a_sliders_parts_are_its_trough_highlight_and_knob() {
    let s = Inside(Part.Knob, [Border.rounded(999)]).apply(
        Inside(Part.Highlight, [Background.color(Token.Primary)]).apply(
            Inside(Part.Trough, [Background.color(Token.Muted)]).apply(Sheet.theme()),
        ),
    );
    let k = keys(s);
    assert(k.iter().any(fun(x) = x == "kv-trough-bgt-muted trough"));
    assert(k.iter().any(fun(x) = x == "kv-highlight-bgt-primary highlight"));
    assert(k.iter().any(fun(x) = x.starts_with("kv-slider-") && x.ends_with(" slider")));
    let hovered = When(State.Hover, [Inside(Part.Knob, [Background.color(Token.Accent)])]).apply(
        Sheet.theme(),
    );
    assert(keys(hovered).iter().any(fun(x) = x.ends_with(":hover slider")));
}

@test
fun a_dropdowns_parts_are_paths_and_an_item_takes_its_own_hover() {
    let s = Inside(Part.Item, [
        Background.color(Token.Popover),
        When(State.Hover, [Background.color(Token.Accent)]),
    ]).apply(
        Inside(Part.List, [Background.color(Token.Popover)]).apply(
            Inside(Part.Arrow, [Background.color(Token.Muted)]).apply(
                Inside(Part.Trigger, [Background.color(Token.Card)]).apply(Sheet.theme()),
            ),
        ),
    );
    let k = keys(s);
    assert(k.iter().any(fun(x) = x == "kv-trigger-bgt-card > button"));
    assert(k.iter().any(fun(x) = x == "kv-arrow-bgt-muted arrow"));
    assert(k.iter().any(fun(x) = x == "kv-list-bgt-popover popover > contents"));
    assert(k.iter().any(fun(x) = x == "kv-item-bgt-popover popover row"));
    // A state inside a part sits on the part.
    assert(k.iter().any(fun(x) = x == "kv-item-hover-bgt-accent popover row:hover"));
    // Under the widget's state, the part comes after.
    let focused = When(State.Focus, [Inside(Part.Trigger, [Border.all(1, Token.Ring)])]).apply(
        Sheet.theme(),
    );
    for x of keys(focused) {
        assert(x.ends_with(":focus-visible > button"));
    }
    assert_eq(check(s), Ok(()));
}

@test
fun an_inside_inside_an_inside_is_still_refused() {
    let v = box().style([Inside(Part.Item, [Inside(Part.Arrow, [Background.color(Token.Muted)])])]);
    assert_eq(check(sheet_of(v)), Err("Inside(Part.Item, …): a part can't hold another Inside"));
}

@test
fun a_menus_parts_are_paths_into_its_popover() {
    let s = Inside(Part.MenuHint, [Background.color(Token.Muted)]).apply(
        Inside(Part.MenuSeparator, [Background.color(Token.Border)]).apply(
            Inside(Part.MenuLabel, [Background.color(Token.Card)]).apply(
                Inside(Part.MenuItem, [Background.color(Token.Accent)]).apply(
                    Inside(Part.MenuBox, [Background.color(Token.Popover)]).apply(Sheet.theme()),
                ),
            ),
        ),
    );
    let k = keys(s);
    assert(k.iter().any(fun(x) = x == "kv-menu-bgt-popover popover.menu > contents"));
    assert(k.iter().any(fun(x) = x == "kv-menuitem-bgt-accent popover.menu modelbutton"));
    assert(k.iter().any(fun(x) = x == "kv-menulabel-bgt-card popover.menu label.title"));
    assert(k.iter().any(fun(x) = x == "kv-menuseparator-bgt-border popover.menu separator"));
    assert(k.iter().any(fun(x) = x == "kv-menuhint-bgt-muted popover.menu accelerator"));
}

@test
fun a_menus_check_and_radio_are_parts_with_their_own_checked_state() {
    let s = Inside(Part.MenuRadio, [
        When(State.Checked, [Mark.icon("media-record-symbolic", 8)]),
    ]).apply(
        Inside(Part.MenuCheck, [
            When(State.Checked, [Mark.icon("object-select-symbolic", 16)]),
        ]).apply(Sheet.theme()),
    );
    let k = keys(s);
    assert(
        k.iter().any(
            fun(x) = x.starts_with("kv-menucheck-") && x.ends_with(" popover.menu check:checked"),
        ),
    );
    assert(
        k.iter().any(
            fun(x) = x.starts_with("kv-menuradio-") && x.ends_with(" popover.menu radio:checked"),
        ),
    );
}

@test
fun a_tooltip_is_the_roots_sibling() {
    let s = Inside(Part.Tooltip, [Background.color(Token.Foreground)]).apply(Sheet.theme());
    assert(keys(s).iter().any(fun(x) = x == "kv-tooltip-bgt-foreground ~ tooltip"));
}

@test
fun a_dropdowns_group_heading_and_line_are_its_header_parts() {
    let s = Inside(Part.GroupLine, [Background.color(Token.Border)]).apply(
        Inside(Part.GroupHeading, [Text.color(Token.MutedForeground)]).apply(Sheet.theme()),
    );
    let k = keys(s);
    assert(
        k.iter().any(
            fun(x) = x == "kv-groupheading-fgt-muted-foreground popover listview > header",
        ),
    );
    assert(
        k.iter().any(fun(x) = x == "kv-groupline-bgt-border popover listview > header separator"),
    );
    assert_eq(check(s), Ok(()));
}

@test
fun a_bars_window_controls_are_parts_with_their_own_hover() {
    let s = Inside(Part.WindowIcon, [Background.color(Token.Muted)]).apply(
        Inside(Part.WindowClose, [When(State.Hover, [Background.color(Token.Destructive)])]).apply(
            Inside(Part.WindowButton, [Text.color(Token.MutedForeground)]).apply(Sheet.theme()),
        ),
    );
    let k = keys(s);
    assert(
        k.iter().any(fun(x) = x == "kv-windowbutton-fgt-muted-foreground windowcontrols > button"),
    );
    assert(
        k.iter().any(
            fun(
                x,
            ) = x == "kv-windowclose-hover-bgt-destructive windowcontrols > button.close:hover",
        ),
    );
    assert(k.iter().any(fun(x) = x == "kv-windowicon-bgt-muted windowcontrols > button > image"));
    assert_eq(check(s), Ok(()));
}

@test
fun a_progress_bars_fill_is_its_progress_node() {
    let s = Inside(Part.Fill, [Background.color(Token.Primary)]).apply(Sheet.theme());
    assert(keys(s).iter().any(fun(x) = x == "kv-fill-bgt-primary progress"));
}
