// The testing helpers, used as an app's own tests would use them, on a small
// to-do app, with no GTK. (test/entry.la reaches them through `import kivuli;`.)
import kivuli {
    View,
    button,
    checkbox,
    column,
    input,
    lazy,
    row,
    text,
    text_area,
    dropdown,
    slider,
    icon,
    image,
    Image,
    wrap,
    keyed_wrap,
    overlay,
    button_with,
    item,
    menu_separator,
    header_bar,
};
import kivuli.testing {
    Lookup,
    choose,
    click,
    is_disabled,
    is_field_disabled,
    pick,
    press,
    slide,
    submit,
    texts,
    toggle,
    tooltip,
    type_into,
};

enum Msg {
    Level(i64),
    Notes(string),
    Draft(string),
    Add,
    Clear,
    Done(bool),
}

struct Model {
    draft: string,
    items: string[],
    done: bool,
}

fun view(m: Model): View<Msg> = column([
    row([
        input(m.draft, Msg.Draft).placeholder("New task").on_submit(Msg.Add),
        button("Add", Msg.Add).disabled(m.draft == ""),
    ]),
    input("", Msg.Draft).placeholder("Notes"),
    lazy("{m.items.len}", fun(): View<Msg> = text("{m.items.len} tasks")),
    checkbox("Done", m.done, Msg.Done),
    button("Clear", Msg.Clear),
    button("Clear", Msg.Clear),
]);

fun empty(): Model = Model { draft: "", items: [], done: false };

@test
fun clicking_finds_the_button_by_label() {
    let m = Model { draft: "milk", ..empty() };
    assert_eq(click(view(m), "Add"), Ok(Msg.Add));
    assert_eq(click(view(m), "Remove"), Err(Lookup.NotFound("button \"Remove\"")));
    assert_eq(click(view(m), "Clear"), Err(Lookup.Ambiguous("button \"Clear\"", 2)));
}

@test
fun a_disabled_button_sends_nothing() {
    assert_eq(click(view(empty()), "Add"), Err(Lookup.Silent("button \"Add\"")));
    assert_eq(is_disabled(view(empty()), "Add"), Ok(true));
    assert_eq(is_disabled(view(Model { draft: "milk", ..empty() }), "Add"), Ok(false));
}

@test
fun typing_and_enter_find_the_field_by_placeholder() {
    assert_eq(type_into(view(empty()), "New task", "milk"), Ok(Msg.Draft("milk")));
    assert_eq(submit(view(empty()), "New task"), Ok(Msg.Add));
    assert_eq(submit(view(empty()), "Notes"), Err(Lookup.Silent("text field \"Notes\"")));
    assert_eq(
        type_into(view(empty()), "Search", "x"),
        Err(Lookup.NotFound("text field \"Search\"")),
    );
}

@test
fun toggling_sends_the_opposite_state() {
    assert_eq(toggle(view(empty()), "Done"), Ok(Msg.Done(true)));
    assert_eq(toggle(view(Model { done: true, ..empty() }), "Done"), Ok(Msg.Done(false)));
}

@test
fun texts_include_what_lazy_nodes_build() {
    let m = Model { items: ["a", "b"], ..empty() };
    assert_eq(texts(view(m)), ["2 tasks"]);
}

fun with_notes(): View<Msg> = column([
    input("", Msg.Draft).placeholder("New task").name("task"),
    text_area("old notes", Msg.Notes).name("notes"),
    text_area("", Msg.Notes).name("twice"),
    input("", Msg.Draft).name("twice"),
]);

@test
fun type_into_finds_text_areas_and_inputs_by_name() {
    assert_eq(type_into(with_notes(), "notes", "a\nb"), Ok(Msg.Notes("a\nb")));
    assert_eq(type_into(with_notes(), "task", "milk"), Ok(Msg.Draft("milk")));
    assert_eq(type_into(with_notes(), "New task", "milk"), Ok(Msg.Draft("milk")));
}

@test
fun a_name_on_two_fields_is_ambiguous_and_an_unknown_one_not_found() {
    assert_eq(
        type_into(with_notes(), "twice", "x"),
        Err(Lookup.Ambiguous("text field \"twice\"", 2)),
    );
    assert_eq(type_into(with_notes(), "nope", "x"), Err(Lookup.NotFound("text field \"nope\"")));
}

@test
fun texts_leave_out_what_is_typed_in_text_areas() {
    assert_eq(texts(column([text("Notes"), text_area("secret draft", Msg.Notes)])), ["Notes"]);
}

fun deletes(): View<Msg> = column([
    row([checkbox("milk", false, Msg.Done), button("✕", Msg.Clear).tooltip("Delete milk")]),
    row([
        checkbox("eggs", false, Msg.Done),
        button("✕", Msg.Add).tooltip("Delete eggs").disabled(true),
    ]),
    button("Same", Msg.Add).tooltip("Same"),
    button("Twin", Msg.Add).tooltip("Shared"),
    button("Twin2", Msg.Clear).tooltip("Shared"),
]);

@test
fun click_finds_a_button_by_its_tooltip() {
    assert_eq(click(deletes(), "Delete milk"), Ok(Msg.Clear));
    assert_eq(click(deletes(), "✕"), Err(Lookup.Ambiguous("button \"✕\"", 2)));
    // Label and tooltip both "Same": one button, so one match.
    assert_eq(click(deletes(), "Same"), Ok(Msg.Add));
    assert_eq(click(deletes(), "Shared"), Err(Lookup.Ambiguous("button \"Shared\"", 2)));
}

@test
fun is_disabled_by_tooltip_and_reading_a_tooltip() {
    assert_eq(is_disabled(deletes(), "Delete eggs"), Ok(true));
    assert_eq(click(deletes(), "Delete eggs"), Err(Lookup.Silent("button \"Delete eggs\"")));
    assert_eq(tooltip(deletes(), "Twin"), Ok("Shared"));
    assert_eq(tooltip(column([button("Plain", Msg.Add)]), "Plain"), Ok(""));
    assert_eq(tooltip(deletes(), "Nope"), Err(Lookup.NotFound("button \"Nope\"")));
}

fun keyed(): View<Msg> = column([
    button("Add", Msg.Add).shortcut("Ctrl+N"),
    button("Clear", Msg.Clear).shortcut("Ctrl+L").disabled(true),
    button("One", Msg.Add).shortcut("Ctrl+D"),
    button("Two", Msg.Clear).shortcut("ctrl+d"),
]);

@test
fun press_gives_the_message_of_the_button_with_that_shortcut() {
    assert_eq(press(keyed(), "Ctrl+N"), Ok(Msg.Add));
    assert_eq(press(keyed(), "ctrl+n"), Ok(Msg.Add));
    assert_eq(press(keyed(), "Ctrl+L"), Err(Lookup.Silent("shortcut \"Ctrl+L\"")));
    assert_eq(press(keyed(), "Ctrl+Q"), Err(Lookup.NotFound("shortcut \"Ctrl+Q\"")));
    assert_eq(press(keyed(), "Ctrl+D"), Err(Lookup.Ambiguous("shortcut \"Ctrl+D\"", 2)));
}

fun settings(): View<Msg> = column([
    dropdown([("Add it", Msg.Add), ("Clear it", Msg.Clear)], "Add it").name("action"),
    slider(0, 100, 50, Msg.Level).name("volume"),
    slider(8, 72, 12, Msg.Level).step(2).name("font"),
    slider(0, 1, 0, Msg.Level).name("twin"),
    slider(0, 1, 0, Msg.Level).name("twin"),
]);

@test
fun choose_gives_the_message_of_a_choice() {
    assert_eq(choose(settings(), "action", "Clear it"), Ok(Msg.Clear));
    assert_eq(
        choose(settings(), "action", "Nope"),
        Err(Lookup.NotFound("choice \"Nope\" in \"action\"")),
    );
    assert_eq(
        choose(settings(), "nowhere", "Add it"),
        Err(Lookup.NotFound("drop-down \"nowhere\"")),
    );
}

@test
fun slide_clamps_and_rounds_like_the_widget() {
    assert_eq(slide(settings(), "volume", 42), Ok(Msg.Level(42)));
    assert_eq(slide(settings(), "volume", 150), Ok(Msg.Level(100)));
    assert_eq(slide(settings(), "volume", -3), Ok(Msg.Level(0)));
    // Steps of 2 from 8: 13 rounds to 14, 11 to 12 (half-way rounds up).
    assert_eq(slide(settings(), "font", 13), Ok(Msg.Level(14)));
    assert_eq(slide(settings(), "font", 10), Ok(Msg.Level(10)));
    assert_eq(slide(settings(), "twin", 1), Err(Lookup.Ambiguous("slider \"twin\"", 2)));
}

@test
fun an_icon_only_button_is_clicked_by_its_tooltip_and_pictures_are_not_texts() {
    let v: View<Msg> = column([
        icon("emblem-ok-symbolic"),
        image(Image.File("a.png")),
        text("Tasks"),
        button("", Msg.Clear).icon("user-trash-symbolic").tooltip("Clear all"),
    ]);
    assert_eq(click(v, "Clear all"), Ok(Msg.Clear));
    assert_eq(texts(v), ["Tasks"]);
}

fun locked(): View<Msg> = column([
    input("milk", Msg.Draft).placeholder("New task").on_submit(Msg.Add).disabled(true),
    text_area("old notes", Msg.Notes).name("notes").disabled(true),
    input("", Msg.Draft).placeholder("Open"),
    input("", Msg.Draft).placeholder("Twin"),
    input("", Msg.Draft).placeholder("Twin"),
]);

@test
fun a_disabled_field_is_silent() {
    assert_eq(
        type_into(locked(), "New task", "eggs"),
        Err(Lookup.Silent("text field \"New task\"")),
    );
    assert_eq(submit(locked(), "New task"), Err(Lookup.Silent("text field \"New task\"")));
    assert_eq(type_into(locked(), "notes", "new"), Err(Lookup.Silent("text field \"notes\"")));
    // An enabled one still sends.
    assert_eq(type_into(locked(), "Open", "x"), Ok(Msg.Draft("x")));
}

@test
fun is_field_disabled_finds_fields_as_type_into_does() {
    assert_eq(is_field_disabled(locked(), "New task"), Ok(true));
    assert_eq(is_field_disabled(locked(), "notes"), Ok(true));
    assert_eq(is_field_disabled(locked(), "Open"), Ok(false));
    assert_eq(
        is_field_disabled(locked(), "Nowhere"),
        Err(Lookup.NotFound("text field \"Nowhere\"")),
    );
    assert_eq(is_field_disabled(locked(), "Twin"), Err(Lookup.Ambiguous("text field \"Twin\"", 2)));
}

fun framed_app(): View<Msg> = column([text("body")]).header(
    header_bar([button("Clear", Msg.Clear)], input("", Msg.Draft).placeholder("Address"), []),
);

@test
fun header_buttons_and_fields_are_found_like_any_others() {
    assert_eq(click(framed_app(), "Clear"), Ok(Msg.Clear));
    assert_eq(type_into(framed_app(), "Address", "x"), Ok(Msg.Draft("x")));
}

@test
fun a_button_with_an_image_is_found_by_its_tooltip() {
    let v: View<Msg> = column([
        button("", Msg.Add).image(Image.Bytes("app:icon", [1, 2, 3])).tooltip("Open the app"),
    ]);
    assert_eq(click(v, "Open the app"), Ok(Msg.Add));
}

@test
fun buttons_in_a_grid_are_found_like_any_others() {
    let v: View<Msg> = keyed_wrap([
        ("x", button("Clear", Msg.Clear)),
        ("y", wrap([button("Add", Msg.Add)])),
    ]);
    assert_eq(click(v, "Clear"), Ok(Msg.Clear));
    assert_eq(click(v, "Add"), Ok(Msg.Add));
}

@test
fun buttons_in_a_layer_and_in_the_base_are_found() {
    let v: View<Msg> = overlay(button("Add", Msg.Add), [button("Clear", Msg.Clear)]);
    assert_eq(click(v, "Add"), Ok(Msg.Add));
    assert_eq(click(v, "Clear"), Ok(Msg.Clear));
}

fun tabs(): View<Msg> = column([
    button("news", Msg.Add).menu([
        item("Close tab", Msg.Clear),
        menu_separator(),
        item("Close others", Msg.Add).disabled(true),
    ]),
    button("", Msg.Add).tooltip("Settings").menu([item("Reset", Msg.Clear)]),
    text("notes").name("notes").menu([item("Clear", Msg.Clear)]),
    button("twin", Msg.Add).menu([item("Close tab", Msg.Clear)]),
    button("twin", Msg.Add).menu([item("Close tab", Msg.Clear)]),
]);

@test
fun pick_finds_a_menu_item_by_its_owner() {
    assert_eq(pick(tabs(), "news", "Close tab"), Ok(Msg.Clear));
    assert_eq(pick(tabs(), "Settings", "Reset"), Ok(Msg.Clear));
    assert_eq(pick(tabs(), "notes", "Clear"), Ok(Msg.Clear));
    assert_eq(
        pick(tabs(), "news", "Close others"),
        Err(Lookup.Silent("menu item \"Close others\"")),
    );
    assert_eq(pick(tabs(), "news", "Nope"), Err(Lookup.NotFound("menu item \"Nope\"")));
    assert_eq(pick(tabs(), "nowhere", "Close tab"), Err(Lookup.NotFound("menu on \"nowhere\"")));
    assert_eq(pick(tabs(), "twin", "Close tab"), Err(Lookup.Ambiguous("menu on \"twin\"", 2)));
    // The button itself still clicks, and by tooltip.
    assert_eq(click(tabs(), "news"), Ok(Msg.Add));
    assert_eq(click(tabs(), "Settings"), Ok(Msg.Add));
}

fun panel(): View<Msg> = column([
    button_with(row([text("Account"), text("Signed in"), icon("go-next-symbolic")]), Msg.Add),
    button_with(row([text("Notifications"), text("On")]), Msg.Clear).tooltip("Alerts"),
    button_with(row([text("Access"), text("On")]), Msg.Done(true)).name("access"),
    button_with(text("Data"), Msg.Clear).disabled(true).tooltip("Nothing saved"),
]);

@test
fun a_button_with_is_found_by_its_text_tooltip_or_name() {
    assert_eq(click(panel(), "Account"), Ok(Msg.Add));
    assert_eq(click(panel(), "Signed in"), Ok(Msg.Add));
    assert_eq(click(panel(), "Alerts"), Ok(Msg.Clear));
    assert_eq(click(panel(), "access"), Ok(Msg.Done(true)));
    assert_eq(click(panel(), "On"), Err(Lookup.Ambiguous("button \"On\"", 2)));
    assert_eq(click(panel(), "Data"), Err(Lookup.Silent("button \"Data\"")));
    assert_eq(click(panel(), "Nowhere"), Err(Lookup.NotFound("button \"Nowhere\"")));
    assert_eq(is_disabled(panel(), "Data"), Ok(true));
    assert_eq(is_disabled(panel(), "Account"), Ok(false));
    assert_eq(tooltip(panel(), "Data"), Ok("Nothing saved"));
}

@test
fun toggling_a_disabled_check_box_is_silent() {
    let v: View<Msg> = column([checkbox("Done", false, Msg.Done).disabled(true)]);
    assert_eq(toggle(v, "Done"), Err(Lookup.Silent("check box \"Done\"")));
}

@test
fun sliding_a_disabled_slider_is_silent() {
    let v: View<Msg> = column([
        slider(0, 10, 5, fun(n: i64) = Msg.Done(n > 5)).name("level").disabled(true),
    ]);
    assert_eq(slide(v, "level", 7), Err(Lookup.Silent("slider \"level\"")));
}
