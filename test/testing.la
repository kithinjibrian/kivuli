// The testing helpers, used as an app's own tests would use them, on a small
// to-do app, with no GTK. (test/entry.la reaches them through `import kivuli;`.)
import kivuli { View, button, checkbox, column, input, lazy, row, text, text_area };
import kivuli.testing { Lookup, click, is_disabled, submit, texts, toggle, tooltip, type_into };

enum Msg {
    Notes(string),
    Draft(string),
    Add,
    Clear,
    Done(bool),
}

struct Model {
    draft: string,
    items: string[],
    done: bool,
}

fun view(m: Model): View<Msg> = column([
    row([
        input(m.draft, Msg.Draft).placeholder("New task").on_submit(Msg.Add),
        button("Add", Msg.Add).disabled(m.draft == ""),
    ]),
    input("", Msg.Draft).placeholder("Notes"),
    lazy("{m.items.len}", fun(): View<Msg> = text("{m.items.len} tasks")),
    checkbox("Done", m.done, Msg.Done),
    button("Clear", Msg.Clear),
    button("Clear", Msg.Clear),
]);

fun empty(): Model = Model { draft: "", items: [], done: false };

@test
fun clicking_finds_the_button_by_label() {
    let m = Model { draft: "milk", ..empty() };
    assert_eq(click(view(m), "Add"), Ok(Msg.Add));
    assert_eq(click(view(m), "Remove"), Err(Lookup.NotFound("button \"Remove\"")));
    assert_eq(click(view(m), "Clear"), Err(Lookup.Ambiguous("button \"Clear\"", 2)));
}

@test
fun a_disabled_button_sends_nothing() {
    assert_eq(click(view(empty()), "Add"), Err(Lookup.Silent("button \"Add\"")));
    assert_eq(is_disabled(view(empty()), "Add"), Ok(true));
    assert_eq(is_disabled(view(Model { draft: "milk", ..empty() }), "Add"), Ok(false));
}

@test
fun typing_and_enter_find_the_field_by_placeholder() {
    assert_eq(type_into(view(empty()), "New task", "milk"), Ok(Msg.Draft("milk")));
    assert_eq(submit(view(empty()), "New task"), Ok(Msg.Add));
    assert_eq(submit(view(empty()), "Notes"), Err(Lookup.Silent("text field \"Notes\"")));
    assert_eq(
        type_into(view(empty()), "Search", "x"),
        Err(Lookup.NotFound("text field \"Search\"")),
    );
}

@test
fun toggling_sends_the_opposite_state() {
    assert_eq(toggle(view(empty()), "Done"), Ok(Msg.Done(true)));
    assert_eq(toggle(view(Model { done: true, ..empty() }), "Done"), Ok(Msg.Done(false)));
}

@test
fun texts_include_what_lazy_nodes_build() {
    let m = Model { items: ["a", "b"], ..empty() };
    assert_eq(texts(view(m)), ["2 tasks"]);
}

fun with_notes(): View<Msg> = column([
    input("", Msg.Draft).placeholder("New task").name("task"),
    text_area("old notes", Msg.Notes).name("notes"),
    text_area("", Msg.Notes).name("twice"),
    input("", Msg.Draft).name("twice"),
]);

@test
fun type_into_finds_text_areas_and_inputs_by_name() {
    assert_eq(type_into(with_notes(), "notes", "a\nb"), Ok(Msg.Notes("a\nb")));
    assert_eq(type_into(with_notes(), "task", "milk"), Ok(Msg.Draft("milk")));
    assert_eq(type_into(with_notes(), "New task", "milk"), Ok(Msg.Draft("milk")));
}

@test
fun a_name_on_two_fields_is_ambiguous_and_an_unknown_one_not_found() {
    assert_eq(
        type_into(with_notes(), "twice", "x"),
        Err(Lookup.Ambiguous("text field \"twice\"", 2)),
    );
    assert_eq(type_into(with_notes(), "nope", "x"), Err(Lookup.NotFound("text field \"nope\"")));
}

@test
fun texts_leave_out_what_is_typed_in_text_areas() {
    assert_eq(texts(column([text("Notes"), text_area("secret draft", Msg.Notes)])), ["Notes"]);
}

fun deletes(): View<Msg> = column([
    row([checkbox("milk", false, Msg.Done), button("✕", Msg.Clear).tooltip("Delete milk")]),
    row([
        checkbox("eggs", false, Msg.Done),
        button("✕", Msg.Add).tooltip("Delete eggs").disabled(true),
    ]),
    button("Same", Msg.Add).tooltip("Same"),
    button("Twin", Msg.Add).tooltip("Shared"),
    button("Twin2", Msg.Clear).tooltip("Shared"),
]);

@test
fun click_finds_a_button_by_its_tooltip() {
    assert_eq(click(deletes(), "Delete milk"), Ok(Msg.Clear));
    assert_eq(click(deletes(), "✕"), Err(Lookup.Ambiguous("button \"✕\"", 2)));
    // Label and tooltip both "Same": one button, so one match.
    assert_eq(click(deletes(), "Same"), Ok(Msg.Add));
    assert_eq(click(deletes(), "Shared"), Err(Lookup.Ambiguous("button \"Shared\"", 2)));
}

@test
fun is_disabled_by_tooltip_and_reading_a_tooltip() {
    assert_eq(is_disabled(deletes(), "Delete eggs"), Ok(true));
    assert_eq(click(deletes(), "Delete eggs"), Err(Lookup.Silent("button \"Delete eggs\"")));
    assert_eq(tooltip(deletes(), "Twin"), Ok("Shared"));
    assert_eq(tooltip(column([button("Plain", Msg.Add)]), "Plain"), Ok(""));
    assert_eq(tooltip(deletes(), "Nope"), Err(Lookup.NotFound("button \"Nope\"")));
}
