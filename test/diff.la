// Diffing views: the changes listed are the fewest that make the widgets
// showing the old view show the new one. `diff` is package-level: files in
// test/ see package-level items (lughac milestone 97).
import kivuli.diff { Patch, diff as patches };
import kivuli.looks { Style, plain };
import kivuli.styles { Sheet };
import kivuli {
    Image,
    View,
    text,
    button,
    column,
    row,
    input,
    checkbox,
    spacer,
    separator,
    scroll,
    keyed_column,
    Align,
    Font,
    Text,
    Weight,
    Paint,
    text_area,
    dropdown,
    slider,
    icon,
    image,
    Fit,
};

// Views and patches can hold functions, which have no `==`: compare what they
// print instead (functions print as `<fun>`; DECISION-008).
fun assert_same<T>(actual: T, expected: T) {
    assert_eq("{actual}", "{expected}");
}

enum Msg {
    Add,
    Reset,
    Named(string),
    Done(bool),
    Level(i64),
}

fun counter(count: i64): View<Msg> = column([
    text("Clicked {count} times"),
    button("Add", Msg.Add),
    button("Reset", Msg.Reset),
]);

@test
fun equal_text_needs_nothing() {
    let none: Patch<Msg>[] = [];
    assert_same(patches(text("hi"), text("hi")), none);
}

@test
fun changed_text_is_set_in_place() {
    let expected: Patch<Msg>[] = [Patch.SetText([], "bye")];
    assert_same(patches(text("hi"), text("bye")), expected);
}

@test
fun a_counter_click_changes_one_label() {
    // The counter from examples/counter.la, going from 2 clicks to 3: the label
    // changes, and both buttons are re-pointed at their (unchanged) messages.
    let expected: Patch<Msg>[] = [
        Patch.SetText([0], "Clicked 3 times"),
        Patch.SetMsg([1], Some(Msg.Add)),
        Patch.SetMsg([2], Some(Msg.Reset)),
    ];
    assert_same(patches(counter(2), counter(3)), expected);
}

@test
fun a_renamed_button_keeps_its_widget() {
    let expected: Patch<Msg>[] = [Patch.SetLabel([], "Again"), Patch.SetMsg([], Some(Msg.Add))];
    assert_same(patches(button("Add", Msg.Add), button("Again", Msg.Add)), expected);
}

@test
fun a_different_kind_is_replaced() {
    let expected: Patch<Msg>[] = [Patch.Replace([1], text("gone"))];
    assert_same(
        patches(column([text("a"), button("b", Msg.Add)]), column([text("a"), text("gone")])),
        expected,
    );
}

@test
fun a_longer_column_appends() {
    let expected: Patch<Msg>[] = [Patch.Append([], text("b")), Patch.Append([], text("c"))];
    assert_same(patches(column([text("a")]), column([text("a"), text("b"), text("c")])), expected);
}

@test
fun a_shorter_column_removes_from_the_end() {
    let expected: Patch<Msg>[] = [Patch.Remove([2]), Patch.Remove([1])];
    assert_same(patches(column([text("a"), text("b"), text("c")]), column([text("a")])), expected);
}

@test
fun nested_paths_lead_through_columns() {
    let expected: Patch<Msg>[] = [Patch.SetText([1, 0], "new")];
    assert_same(
        patches(
            column([text("top"), column([text("old")])]),
            column([text("top"), column([text("new")])]),
        ),
        expected,
    );
}

@test
fun a_row_diffs_its_children_like_a_column() {
    let expected: Patch<Msg>[] = [Patch.SetText([1], "b2"), Patch.Append([], text("c"))];
    assert_same(
        patches(row([text("a"), text("b")]), row([text("a"), text("b2"), text("c")])),
        expected,
    );
}

@test
fun a_row_that_becomes_a_column_is_replaced() {
    let expected: Patch<Msg>[] = [Patch.Replace([], column([text("a")]))];
    assert_same(patches(row([text("a")]), column([text("a")])), expected);
}

@test
fun a_changed_input_value_is_set_and_its_handler_re_pointed() {
    let expected: Patch<Msg>[] = [
        Patch.SetValue([], "Ada"),
        Patch.SetOnChange([], Some(Msg.Named)),
        Patch.SetOnSubmit([], None),
    ];
    assert_same(patches(input("", Msg.Named), input("Ada", Msg.Named)), expected);
}

@test
fun an_unchanged_input_value_is_left_alone() {
    let expected: Patch<Msg>[] = [
        Patch.SetOnChange([], Some(Msg.Named)),
        Patch.SetOnSubmit([], None),
    ];
    assert_same(patches(input("Ada", Msg.Named), input("Ada", Msg.Named)), expected);
}

@test
fun the_re_pointed_handler_is_the_new_one() {
    let changes = patches(input("", Msg.Named), input("", fun(s: string) = Msg.Named(s + "!")));
    match changes[0] {
        SetOnChange(_, Some(f)) => assert_eq(f("hi"), Msg.Named("hi!")),
        _ => panic("expected SetOnChange"),
    }
}

@test
fun a_ticked_checkbox_is_set_and_its_handler_re_pointed() {
    let expected: Patch<Msg>[] = [Patch.SetChecked([], true), Patch.SetOnToggle([], Msg.Done)];
    assert_same(
        patches(checkbox("Done", false, Msg.Done), checkbox("Done", true, Msg.Done)),
        expected,
    );
}

@test
fun a_relabelled_checkbox_keeps_its_widget() {
    let expected: Patch<Msg>[] = [Patch.SetLabel([], "Finished"), Patch.SetOnToggle([], Msg.Done)];
    assert_same(
        patches(checkbox("Done", true, Msg.Done), checkbox("Finished", true, Msg.Done)),
        expected,
    );
}

@test
fun a_checkbox_is_not_a_button() {
    let expected: Patch<Msg>[] = [Patch.Replace([], button("Done", Msg.Add))];
    assert_same(patches(checkbox("Done", false, Msg.Done), button("Done", Msg.Add)), expected);
}

@test
fun spacers_and_separators_never_change() {
    let none: Patch<Msg>[] = [];
    assert_same(patches(column([spacer(), separator()]), column([spacer(), separator()])), none);
}

@test
fun a_spacer_that_becomes_a_separator_is_replaced() {
    let expected: Patch<Msg>[] = [Patch.Replace([0], separator())];
    assert_same(patches(column([spacer()]), column([separator()])), expected);
}

@test
fun a_scroll_leads_to_its_one_child_at_index_0() {
    let expected: Patch<Msg>[] = [Patch.SetText([1, 0, 2], "c2"), Patch.Append([1, 0], text("d"))];
    assert_same(
        patches(
            column([text("top"), scroll(column([text("a"), text("b"), text("c")]))]),
            column([text("top"), scroll(column([text("a"), text("b"), text("c2"), text("d")]))]),
        ),
        expected,
    );
}

@test
fun a_scroll_whose_child_changes_kind_replaces_the_child() {
    let expected: Patch<Msg>[] = [Patch.Replace([0], button("b", Msg.Add))];
    assert_same(patches(scroll(text("a")), scroll(button("b", Msg.Add))), expected);
}

// Keyed lists: rows are matched by key, so each test also says what matching
// by position would have done instead.

fun list(keys: string[]): View<Msg> {
    let mut rows: (string, View<Msg>)[] = [];
    for k of keys {
        rows.push((k, text(k)));
    }
    keyed_column(rows)
}

@test
fun an_unchanged_keyed_list_needs_nothing() {
    let none: Patch<Msg>[] = [];
    assert_same(patches(list(["a", "b", "c"]), list(["a", "b", "c"])), none);
}

@test
fun deleting_from_the_middle_removes_only_that_row() {
    // By position: SetText([1], "c") and Remove([2]).
    let expected: Patch<Msg>[] = [Patch.Remove([1])];
    assert_same(patches(list(["a", "b", "c"]), list(["a", "c"])), expected);
}

@test
fun adding_at_the_front_inserts_only_that_row() {
    // By position: every row rewritten, then one appended.
    let expected: Patch<Msg>[] = [Patch.Insert([], 0, text("a"))];
    assert_same(patches(list(["b", "c"]), list(["a", "b", "c"])), expected);
}

@test
fun rotating_moves_one_row() {
    let expected: Patch<Msg>[] = [Patch.Move([], 2, 0)];
    assert_same(patches(list(["a", "b", "c"]), list(["c", "a", "b"])), expected);
}

@test
fun reversing_moves_rows_one_place_at_a_time() {
    // Each move counts positions in the list as the previous moves left it.
    let expected: Patch<Msg>[] = [Patch.Move([], 2, 0), Patch.Move([], 2, 1)];
    assert_same(patches(list(["a", "b", "c"]), list(["c", "b", "a"])), expected);
}

@test
fun a_moved_row_is_also_diffed_at_its_new_place() {
    let expected: Patch<Msg>[] = [Patch.Move([], 1, 0), Patch.SetText([0], "B!")];
    assert_same(
        patches(
            keyed_column([("a", text("a")), ("b", text("b"))]),
            keyed_column([("b", text("B!")), ("a", text("a"))]),
        ),
        expected,
    );
}

@test
fun removals_inserts_and_moves_together() {
    // [a, b, c, d] → [d, x, b]: drop c and a (from the end), then d to the
    // front, then x inserted after it; b is already in place.
    let expected: Patch<Msg>[] = [
        Patch.Remove([2]),
        Patch.Remove([0]),
        Patch.Move([], 1, 0),
        Patch.Insert([], 1, text("x")),
    ];
    assert_same(patches(list(["a", "b", "c", "d"]), list(["d", "x", "b"])), expected);
}

@test
fun a_keyed_column_is_not_a_column() {
    let expected: Patch<Msg>[] = [Patch.Replace([], column([text("a")]))];
    assert_same(patches(list(["a"]), column([text("a")])), expected);
}

@test
fun adding_a_modifier_restyles_the_same_widget() {
    let expected: Patch<Msg>[] = [Patch.SetStyle([0], Style { tooltip: "t8", ..plain() })];
    assert_same(patches(column([text("a")]), column([text("a").tooltip("t8")])), expected);
}

@test
fun dropping_a_modifier_restyles_back_to_plain() {
    let expected: Patch<Msg>[] = [Patch.SetStyle([], plain())];
    assert_same(patches(text("a").tooltip("t8"), text("a")), expected);
}

@test
fun style_and_content_are_diffed_separately() {
    let expected: Patch<Msg>[] = [
        Patch.SetStyle([], Style { tooltip: "t2", ..plain() }),
        Patch.SetText([], "b"),
    ];
    assert_same(patches(text("a").tooltip("t1"), text("b").tooltip("t2")), expected);
}

@test
fun an_unchanged_style_needs_nothing() {
    let none: Patch<Msg>[] = [];
    assert_same(patches(text("a").align(Align.Center), text("a").align(Align.Center)), none);
}

@test
fun a_new_kind_is_replaced_with_its_style() {
    let expected: Patch<Msg>[] = [Patch.Replace([], button("b", Msg.Add).tooltip("t3"))];
    assert_same(patches(text("a").tooltip("t3"), button("b", Msg.Add).tooltip("t3")), expected);
}

@test
fun making_text_bold_restyles_it() {
    let bold = Font { weight: Weight.Bold, ..Font.theme() };
    let sheet = Sheet { font: bold, ..Sheet.theme() };
    let expected: Patch<Msg>[] = [Patch.SetStyle([], Style { sheet: sheet, ..plain() })];
    assert_same(patches(text("a"), text("a").style([bold])), expected);
}

@test
fun disabling_a_button_takes_its_message_away() {
    let expected: Patch<Msg>[] = [Patch.SetMsg([], None)];
    assert_same(
        patches(button("Reset", Msg.Reset), button("Reset", Msg.Reset).disabled(true)),
        expected,
    );
}

@test
fun a_changed_text_area_is_set_and_its_handler_re_pointed() {
    let expected: Patch<Msg>[] = [Patch.SetValue([], "b"), Patch.SetOnChange([], Some(Msg.Named))];
    assert_same(patches(text_area("a", Msg.Named), text_area("b", Msg.Named)), expected);
}

@test
fun an_unchanged_text_area_only_re_points_its_handler() {
    let expected: Patch<Msg>[] = [Patch.SetOnChange([], Some(Msg.Named))];
    assert_same(patches(text_area("a", Msg.Named), text_area("a", Msg.Named)), expected);
}

@test
fun a_text_area_that_becomes_an_input_is_replaced() {
    let expected: Patch<Msg>[] = [Patch.Replace([], input("a", Msg.Named))];
    assert_same(patches(text_area("a", Msg.Named), input("a", Msg.Named)), expected);
}

@test
fun a_tooltip_or_wrapping_is_a_restyle() {
    let tip: Patch<Msg>[] = [
        Patch.SetStyle([], Style { tooltip: "hi", ..plain() }),
        Patch.SetMsg([], Some(Msg.Add)),
    ];
    assert_same(patches(button("x", Msg.Add), button("x", Msg.Add).tooltip("hi")), tip);
    let wrapped: Patch<Msg>[] = [Patch.SetStyle([], Style { wrap: true, ..plain() })];
    assert_same(patches(text("long"), text("long").wrap()), wrapped);
}

@test
fun a_dropdown_always_sets_its_choices() {
    let choices = [("Add", Msg.Add), ("Reset", Msg.Reset)];
    let expected: Patch<Msg>[] = [Patch.SetChoices([], choices, "Add")];
    assert_same(patches(dropdown(choices, "Reset"), dropdown(choices, "Add")), expected);
    let same: Patch<Msg>[] = [Patch.SetChoices([], choices, "Reset")];
    assert_same(patches(dropdown(choices, "Reset"), dropdown(choices, "Reset")), same);
}

@test
fun a_slider_sets_only_what_changed_and_re_points_its_handler() {
    let moved: Patch<Msg>[] = [Patch.SetNumber([], 50), Patch.SetOnSlide([], Msg.Level)];
    assert_same(patches(slider(0, 100, 42, Msg.Level), slider(0, 100, 50, Msg.Level)), moved);
    let ranged: Patch<Msg>[] = [Patch.SetRange([], 0, 10), Patch.SetOnSlide([], Msg.Level)];
    assert_same(patches(slider(0, 100, 5, Msg.Level), slider(0, 10, 5, Msg.Level)), ranged);
    let still: Patch<Msg>[] = [Patch.SetOnSlide([], Msg.Level)];
    assert_same(patches(slider(0, 100, 5, Msg.Level), slider(0, 100, 5, Msg.Level)), still);
}

@test
fun a_dropdown_that_becomes_a_slider_is_replaced() {
    let expected: Patch<Msg>[] = [Patch.Replace([], slider(0, 1, 0, Msg.Level))];
    assert_same(patches(dropdown([("Add", Msg.Add)], "Add"), slider(0, 1, 0, Msg.Level)), expected);
}

@test
fun a_renamed_icon_or_a_new_file_is_set_in_place() {
    let renamed: Patch<Msg>[] = [Patch.SetImage([], Image.Icon("user-trash-symbolic"))];
    assert_same(patches(icon("list-add-symbolic"), icon("user-trash-symbolic")), renamed);
    let none: Patch<Msg>[] = [];
    assert_same(patches(icon("list-add-symbolic"), icon("list-add-symbolic")), none);
    let moved: Patch<Msg>[] = [Patch.SetImage([], Image.File("b.png"))];
    assert_same(patches(image(Image.File("a.png")), image(Image.File("b.png"))), moved);
    assert_same(patches(image(Image.File("a.png")), image(Image.File("a.png"))), none);
}

@test
fun a_button_icon_is_set_in_place_and_an_image_fit_is_a_restyle() {
    let iconned: Patch<Msg>[] = [
        Patch.SetButtonImage([], Some(Image.Icon("list-add-symbolic"))),
        Patch.SetMsg([], Some(Msg.Add)),
    ];
    assert_same(
        patches(button("Add", Msg.Add), button("Add", Msg.Add).icon("list-add-symbolic")),
        iconned,
    );
    let refit: Patch<Msg>[] = [Patch.SetStyle([], Style { fit: Fit.Cover, ..plain() })];
    assert_same(
        patches(image(Image.File("a.png")), image(Image.File("a.png")).fit(Fit.Cover)),
        refit,
    );
}

@test
fun disabling_a_field_takes_its_handlers_away_in_place() {
    let off: Patch<Msg>[] = [Patch.SetOnChange([], None), Patch.SetOnSubmit([], None)];
    assert_same(
        patches(input("a", Msg.Named).on_submit(Msg.Add), input("a", Msg.Named).disabled(true)),
        off,
    );
    let on: Patch<Msg>[] = [
        Patch.SetOnChange([], Some(Msg.Named)),
        Patch.SetOnSubmit([], Some(Msg.Add)),
    ];
    assert_same(
        patches(input("a", Msg.Named).disabled(true), input("a", Msg.Named).on_submit(Msg.Add)),
        on,
    );
    let area: Patch<Msg>[] = [Patch.SetOnChange([], None)];
    assert_same(patches(text_area("a", Msg.Named), text_area("a", Msg.Named).disabled(true)), area);
}

@test
fun a_disabled_fields_value_still_updates() {
    let expected: Patch<Msg>[] = [
        Patch.SetValue([], "b"),
        Patch.SetOnChange([], None),
        Patch.SetOnSubmit([], None),
    ];
    assert_same(
        patches(input("a", Msg.Named).disabled(true), input("b", Msg.Named).disabled(true)),
        expected,
    );
    let area: Patch<Msg>[] = [Patch.SetValue([], "b"), Patch.SetOnChange([], None)];
    assert_same(
        patches(text_area("a", Msg.Named).disabled(true), text_area("b", Msg.Named).disabled(true)),
        area,
    );
}

fun framed(title: string, start: View<Msg>[], end: View<Msg>[]): View<Msg> = text("body").header(
    start,
    text(title),
    end,
);

@test
fun a_headers_parts_diff_in_place() {
    let retitled: Patch<Msg>[] = [Patch.SetText([1], "New")];
    assert_same(patches(framed("Old", [], []), framed("New", [], [])), retitled);
    let added: Patch<Msg>[] = [Patch.Append([3], button("Menu", Msg.Add))];
    assert_same(patches(framed("T", [], []), framed("T", [], [button("Menu", Msg.Add)])), added);
    let removed: Patch<Msg>[] = [Patch.SetMsg([2, 0], Some(Msg.Reset)), Patch.Remove([2, 1])];
    assert_same(
        patches(
            framed("T", [button("Back", Msg.Reset), button("Next", Msg.Add)], []),
            framed("T", [button("Back", Msg.Reset)], []),
        ),
        removed,
    );
    let body: Patch<Msg>[] = [Patch.SetText([0], "other")];
    assert_same(patches(framed("T", [], []), text("other").header([], text("T"), [])), body);
}

@test
fun the_same_style_twice_is_no_change() {
    let dim = Text { color: Paint.Faded(0.55), ..Text.theme() };
    let expected: Patch<Msg>[] = [];
    assert_same(patches(text("a").style([dim]), text("a").style([dim])), expected);
}
