// Diffing views: the changes listed are the fewest that make the widgets
// showing the old view show the new one. `diff` is package-level: files in
// test/ see package-level items (lughac milestone 97).
import kivuli.diff { Patch, diff as patches };
import kivuli {
    View,
    text,
    button,
    column,
    row,
    input,
    checkbox,
    spacer,
    separator,
    scroll,
    keyed_column,
};

// Views and patches can hold functions, which have no `==`: compare what they
// print instead (functions print as `<fun>`; DECISION-008).
fun assert_same<T>(actual: T, expected: T) {
    assert_eq("{actual}", "{expected}");
}

enum Msg {
    Add,
    Reset,
    Named(string),
    Done(bool),
}

fun counter(count: i64): View<Msg> = column([
    text("Clicked {count} times"),
    button("Add", Msg.Add),
    button("Reset", Msg.Reset),
]);

@test
fun equal_text_needs_nothing() {
    let none: Patch<Msg>[] = [];
    assert_same(patches(text("hi"), text("hi")), none);
}

@test
fun changed_text_is_set_in_place() {
    let expected: Patch<Msg>[] = [Patch.SetText([], "bye")];
    assert_same(patches(text("hi"), text("bye")), expected);
}

@test
fun a_counter_click_changes_one_label() {
    // The counter from examples/counter.la, going from 2 clicks to 3: the label
    // changes, and both buttons are re-pointed at their (unchanged) messages.
    let expected: Patch<Msg>[] = [
        Patch.SetText([0], "Clicked 3 times"),
        Patch.SetMsg([1], Msg.Add),
        Patch.SetMsg([2], Msg.Reset),
    ];
    assert_same(patches(counter(2), counter(3)), expected);
}

@test
fun a_renamed_button_keeps_its_widget() {
    let expected: Patch<Msg>[] = [Patch.SetLabel([], "Again"), Patch.SetMsg([], Msg.Add)];
    assert_same(patches(button("Add", Msg.Add), button("Again", Msg.Add)), expected);
}

@test
fun a_different_kind_is_replaced() {
    let expected: Patch<Msg>[] = [Patch.Replace([1], text("gone"))];
    assert_same(
        patches(column([text("a"), button("b", Msg.Add)]), column([text("a"), text("gone")])),
        expected,
    );
}

@test
fun a_longer_column_appends() {
    let expected: Patch<Msg>[] = [Patch.Append([], text("b")), Patch.Append([], text("c"))];
    assert_same(patches(column([text("a")]), column([text("a"), text("b"), text("c")])), expected);
}

@test
fun a_shorter_column_removes_from_the_end() {
    let expected: Patch<Msg>[] = [Patch.Remove([2]), Patch.Remove([1])];
    assert_same(patches(column([text("a"), text("b"), text("c")]), column([text("a")])), expected);
}

@test
fun nested_paths_lead_through_columns() {
    let expected: Patch<Msg>[] = [Patch.SetText([1, 0], "new")];
    assert_same(
        patches(
            column([text("top"), column([text("old")])]),
            column([text("top"), column([text("new")])]),
        ),
        expected,
    );
}

@test
fun a_row_diffs_its_children_like_a_column() {
    let expected: Patch<Msg>[] = [Patch.SetText([1], "b2"), Patch.Append([], text("c"))];
    assert_same(
        patches(row([text("a"), text("b")]), row([text("a"), text("b2"), text("c")])),
        expected,
    );
}

@test
fun a_row_that_becomes_a_column_is_replaced() {
    let expected: Patch<Msg>[] = [Patch.Replace([], column([text("a")]))];
    assert_same(patches(row([text("a")]), column([text("a")])), expected);
}

@test
fun a_changed_input_value_is_set_and_its_handler_re_pointed() {
    let expected: Patch<Msg>[] = [Patch.SetValue([], "Ada"), Patch.SetOnChange([], Msg.Named)];
    assert_same(patches(input("", Msg.Named), input("Ada", Msg.Named)), expected);
}

@test
fun an_unchanged_input_value_is_left_alone() {
    let expected: Patch<Msg>[] = [Patch.SetOnChange([], Msg.Named)];
    assert_same(patches(input("Ada", Msg.Named), input("Ada", Msg.Named)), expected);
}

@test
fun the_re_pointed_handler_is_the_new_one() {
    let changes = patches(input("", Msg.Named), input("", fun(s: string) = Msg.Named(s + "!")));
    match changes[0] {
        SetOnChange(_, f) => assert_eq(f("hi"), Msg.Named("hi!")),
        _ => panic("expected SetOnChange"),
    }
}

@test
fun a_ticked_checkbox_is_set_and_its_handler_re_pointed() {
    let expected: Patch<Msg>[] = [Patch.SetChecked([], true), Patch.SetOnToggle([], Msg.Done)];
    assert_same(
        patches(checkbox("Done", false, Msg.Done), checkbox("Done", true, Msg.Done)),
        expected,
    );
}

@test
fun a_relabelled_checkbox_keeps_its_widget() {
    let expected: Patch<Msg>[] = [Patch.SetLabel([], "Finished"), Patch.SetOnToggle([], Msg.Done)];
    assert_same(
        patches(checkbox("Done", true, Msg.Done), checkbox("Finished", true, Msg.Done)),
        expected,
    );
}

@test
fun a_checkbox_is_not_a_button() {
    let expected: Patch<Msg>[] = [Patch.Replace([], button("Done", Msg.Add))];
    assert_same(patches(checkbox("Done", false, Msg.Done), button("Done", Msg.Add)), expected);
}

@test
fun spacers_and_separators_never_change() {
    let none: Patch<Msg>[] = [];
    assert_same(patches(column([spacer(), separator()]), column([spacer(), separator()])), none);
}

@test
fun a_spacer_that_becomes_a_separator_is_replaced() {
    let expected: Patch<Msg>[] = [Patch.Replace([0], separator())];
    assert_same(patches(column([spacer()]), column([separator()])), expected);
}

@test
fun a_scroll_leads_to_its_one_child_at_index_0() {
    let expected: Patch<Msg>[] = [Patch.SetText([1, 0, 2], "c2"), Patch.Append([1, 0], text("d"))];
    assert_same(
        patches(
            column([text("top"), scroll(column([text("a"), text("b"), text("c")]))]),
            column([text("top"), scroll(column([text("a"), text("b"), text("c2"), text("d")]))]),
        ),
        expected,
    );
}

@test
fun a_scroll_whose_child_changes_kind_replaces_the_child() {
    let expected: Patch<Msg>[] = [Patch.Replace([0], button("b", Msg.Add))];
    assert_same(patches(scroll(text("a")), scroll(button("b", Msg.Add))), expected);
}

// Keyed lists: rows are matched by key, so each test also says what matching
// by position would have done instead.

fun list(keys: string[]): View<Msg> {
    let mut rows: (string, View<Msg>)[] = [];
    for k of keys {
        rows.push((k, text(k)));
    }
    keyed_column(rows)
}

@test
fun an_unchanged_keyed_list_needs_nothing() {
    let none: Patch<Msg>[] = [];
    assert_same(patches(list(["a", "b", "c"]), list(["a", "b", "c"])), none);
}

@test
fun deleting_from_the_middle_removes_only_that_row() {
    // By position: SetText([1], "c") and Remove([2]).
    let expected: Patch<Msg>[] = [Patch.Remove([1])];
    assert_same(patches(list(["a", "b", "c"]), list(["a", "c"])), expected);
}

@test
fun adding_at_the_front_inserts_only_that_row() {
    // By position: every row rewritten, then one appended.
    let expected: Patch<Msg>[] = [Patch.Insert([], 0, text("a"))];
    assert_same(patches(list(["b", "c"]), list(["a", "b", "c"])), expected);
}

@test
fun rotating_moves_one_row() {
    let expected: Patch<Msg>[] = [Patch.Move([], 2, 0)];
    assert_same(patches(list(["a", "b", "c"]), list(["c", "a", "b"])), expected);
}

@test
fun reversing_moves_rows_one_place_at_a_time() {
    // Each move counts positions in the list as the previous moves left it.
    let expected: Patch<Msg>[] = [Patch.Move([], 2, 0), Patch.Move([], 2, 1)];
    assert_same(patches(list(["a", "b", "c"]), list(["c", "b", "a"])), expected);
}

@test
fun a_moved_row_is_also_diffed_at_its_new_place() {
    let expected: Patch<Msg>[] = [Patch.Move([], 1, 0), Patch.SetText([0], "B!")];
    assert_same(
        patches(
            keyed_column([("a", text("a")), ("b", text("b"))]),
            keyed_column([("b", text("B!")), ("a", text("a"))]),
        ),
        expected,
    );
}

@test
fun removals_inserts_and_moves_together() {
    // [a, b, c, d] → [d, x, b]: drop c and a (from the end), then d to the
    // front, then x inserted after it; b is already in place.
    let expected: Patch<Msg>[] = [
        Patch.Remove([2]),
        Patch.Remove([0]),
        Patch.Move([], 1, 0),
        Patch.Insert([], 1, text("x")),
    ];
    assert_same(patches(list(["a", "b", "c", "d"]), list(["d", "x", "b"])), expected);
}

@test
fun a_keyed_column_is_not_a_column() {
    let expected: Patch<Msg>[] = [Patch.Replace([], column([text("a")]))];
    assert_same(patches(list(["a"]), column([text("a")])), expected);
}
