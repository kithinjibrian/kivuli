// Diffing a header bar's looks: they're a style field of the root, so a
// change restyles it in place. (test/diff.la is at the file size limit.)
import kivuli.diff { Patch, diff as patches };
import kivuli.looks { Style, plain };
import kivuli { View, text };

fun assert_same<T>(actual: T, expected: T) {
    assert_eq("{actual}", "{expected}");
}

@test
fun a_change_of_header_looks_is_a_restyle_of_the_root() {
    let before: View<i64> = text("b").header([], text("T"), []);
    let expected: Patch<i64>[] = [Patch.SetStyle([], Style { header_looks: ["Bar"], ..plain() })];
    assert_same(patches(before, before.header_style(["Bar"])), expected);
}
