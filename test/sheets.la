// A style's values, checked and turned into CSS: one class per property and
// value, so nodes sharing a value share a class. No GTK.
import kivuli.styles { Sheet };
import kivuli.styles.sheets { check, picture, picture_css, rules, url_of };
import kivuli {
    Font,
    Text,
    Size,
    Weight,
    Family,
    FontStyle,
    LineHeight,
    Decoration,
    Transform,
    Paint,
    Background,
    Gradient,
    Stop,
    Fill,
    Image,
    hex,
};
import fixtures;
import kivuli.view.pictures { data_url };

fun named(name: string, fallback: Family): Font = Font {
    family: Family.Named(name, fallback),
    ..Font.theme(),
};

fun sheet(f: Font, t: Text): Sheet = Sheet { font: f, text: t, ..Sheet.theme() };

fun css(s: Sheet): string[] = rules(s).map(fun(rule) = ".{rule.0} {{ {rule.1} }}");

@test
fun the_theme_sheet_needs_no_css() {
    assert_eq(css(sheet(Font.theme(), Text.theme())), []);
}

@test
fun font_values_become_rules() {
    assert_eq(css(sheet(Font { weight: Weight.Thin, ..Font.theme() }, Text.theme())), [
        ".kv-fw-100 {{ font-weight: 100; }}",
    ]);
    assert_eq(css(sheet(Font { weight: Weight.Black, ..Font.theme() }, Text.theme())), [
        ".kv-fw-900 {{ font-weight: 900; }}",
    ]);
    assert_eq(css(sheet(Font { size: Size.Pt(22), ..Font.theme() }, Text.theme())), [
        ".kv-fs-22pt {{ font-size: 22pt; }}",
    ]);
    assert_eq(
        css(
            sheet(
                Font { weight: Weight.Bold, size: Size.Scale(1.1), ..Font.theme() },
                Text.theme(),
            ),
        ),
        [".kv-fs-s1100 {{ font-size: 110.0%; }}", ".kv-fw-700 {{ font-weight: 700; }}"],
    );
    assert_eq(css(sheet(Font { size: Size.Scale(0.875), ..Font.theme() }, Text.theme())), [
        ".kv-fs-s875 {{ font-size: 87.5%; }}",
    ]);
    assert_eq(css(sheet(Font { family: Family.Monospace, ..Font.theme() }, Text.theme())), [
        ".kv-ff-mono {{ font-family: monospace; }}",
    ]);
    assert_eq(css(sheet(named("Inter", Family.Sans), Text.theme())), [
        ".kv-ff-496e746572-sans {{ font-family: \"Inter\", sans-serif; }}",
    ]);
    assert_eq(css(sheet(Font { style: FontStyle.Italic, ..Font.theme() }, Text.theme())), [
        ".kv-fst-italic {{ font-style: italic; }}",
    ]);
    assert_eq(css(sheet(Font { tabular: true, ..Font.theme() }, Text.theme())), [
        ".kv-tnum {{ font-variant-numeric: tabular-nums; }}",
    ]);
}

@test
fun text_values_become_rules() {
    assert_eq(
        css(sheet(Font.theme(), Text { line_height: LineHeight.Times(1.6), ..Text.theme() })),
        [".kv-lh-1600 {{ line-height: 1.6; }}"],
    );
    assert_eq(css(sheet(Font.theme(), Text { letter_spacing: 1, ..Text.theme() })), [
        ".kv-ls-1 {{ letter-spacing: 1px; }}",
    ]);
    assert_eq(css(sheet(Font.theme(), Text { letter_spacing: -1, ..Text.theme() })), [
        ".kv-ls-m1 {{ letter-spacing: -1px; }}",
    ]);
    assert_eq(
        css(sheet(Font.theme(), Text { decoration: Decoration.Strikethrough, ..Text.theme() })),
        [".kv-td-strike {{ text-decoration-line: line-through; }}"],
    );
    assert_eq(css(sheet(Font.theme(), Text { transform: Transform.Uppercase, ..Text.theme() })), [
        ".kv-tt-upper {{ text-transform: uppercase; }}",
    ]);
    assert_eq(css(sheet(Font.theme(), Text { color: Paint.Faded(0.55), ..Text.theme() })), [
        ".kv-fade-550 {{ color: alpha(currentColor, 0.55); }}",
    ]);
    assert_eq(
        css(sheet(Font.theme(), Text { color: Paint.Color(hex("#e0e0e0")), ..Text.theme() })),
        [".kv-fg-e0e0e0ff {{ color: #e0e0e0ff; }}"],
    );
}

@test
fun every_field_gives_its_own_class() {
    let s = sheet(
        Font { size: Size.Pt(12), weight: Weight.Bold, style: FontStyle.Italic, ..Font.theme() },
        Text { line_height: LineHeight.Times(1.2), transform: Transform.Uppercase, ..Text.theme() },
    );
    assert_eq(rules(s).map(fun(rule) = rule.0), [
        "kv-fs-12pt",
        "kv-fw-700",
        "kv-fst-italic",
        "kv-lh-1200",
        "kv-tt-upper",
    ]);
}

@test
fun good_values_pass_the_check() {
    assert_eq(
        check(
            sheet(Font { weight: Weight.Black, size: Size.Scale(2.0), ..Font.theme() }, Text {
                color: Paint.Faded(0.55),
                ..Text.theme(),
            }),
        ),
        Ok(()),
    );
    assert_eq(check(sheet(named("Fira Code", Family.Monospace), Text.theme())), Ok(()));
}

@test
fun bad_values_say_what_is_wrong() {
    assert_eq(
        check(sheet(Font { size: Size.Pt(0), ..Font.theme() }, Text.theme())),
        Err("Size.Pt(0): a font size must be positive"),
    );
    assert_eq(
        check(sheet(Font { size: Size.Scale(0.0), ..Font.theme() }, Text.theme())),
        Err("Size.Scale(0.0): a font scale must be positive"),
    );
    assert_eq(
        check(sheet(Font.theme(), Text { line_height: LineHeight.Times(-1.0), ..Text.theme() })),
        Err("LineHeight.Times(-1.0): a line height must be positive"),
    );
    assert_eq(
        check(sheet(named("", Family.Sans), Text.theme())),
        Err("Family.Named(\"\"): a font needs a name"),
    );
    assert_eq(
        check(sheet(named("Inter", Family.Named("Roboto", Family.Sans)), Text.theme())),
        Err("Family.Named(\"Inter\"): a font's fallback must be Sans, Serif or Monospace"),
    );
    assert_eq(
        check(sheet(named("Inter", Family.Theme), Text.theme())),
        Err("Family.Named(\"Inter\"): a font's fallback must be Sans, Serif or Monospace"),
    );
    assert_eq(
        check(sheet(Font.theme(), Text { color: Paint.Faded(1.5), ..Text.theme() })),
        Err("Paint.Faded(1.5): an opacity is between 0 and 1"),
    );
}

@test
fun a_font_name_cant_break_out_of_its_css_string() {
    for name of ["a\"b", "a\\b", "a;b", "a{{b", "a}}b", "a\nb"] {
        assert_eq(
            check(sheet(named(name, Family.Sans), Text.theme())),
            Err(
                "Family.Named(\"{name}\"): a font name can't hold quotes, backslashes, ; {{ }} or line breaks",
            ),
        );
    }
}

fun bg(b: Background): Sheet = Sheet { background: b, ..Sheet.theme() };

fun stops(a: string, b: string): Stop[] = [
    Stop { color: Paint.Color(hex(a)), at: 0.0 },
    Stop { color: Paint.Color(hex(b)), at: 1.0 },
];

@test
fun a_background_colour_clears_the_themes_image_so_it_shows() {
    assert_eq(rules(bg(Background { color: Paint.Color(hex("#242424")), ..Background.theme() })), [
        ("kv-bg-242424ff", "background-color: #242424ff;"),
        ("kv-bgi-none", "background-image: none;"),
    ]);
    assert_eq(rules(bg(Background { color: Paint.Faded(0.08), ..Background.theme() })), [
        ("kv-bgfade-80", "background-color: alpha(currentColor, 0.08);"),
        ("kv-bgi-none", "background-image: none;"),
    ]);
}

@test
fun gradients_are_one_background_image_rule() {
    let linear = rules(
        bg(Background {
            gradient: Gradient.Linear(180, stops("#1e3c72", "#2a5298")),
            ..Background.theme(),
        }),
    );
    assert_eq(linear.len, 1);
    assert(linear[0].0.starts_with("kv-bgi-g"));
    assert_eq(
        linear[0].1,
        "background-image: linear-gradient(180deg, #1e3c72ff 0.0%, #2a5298ff 100.0%);",
    );
    let radial = rules(
        bg(Background {
            gradient: Gradient.Radial([
                Stop { color: Paint.Faded(0.15), at: 0.0 },
                Stop { color: Paint.Faded(0.0), at: 1.0 },
            ]),
            ..Background.theme(),
        }),
    );
    assert_eq(
        radial[0].1,
        "background-image: radial-gradient(circle, alpha(currentColor, 0.15) 0.0%, alpha(currentColor, 0.0) 100.0%);",
    );
    // The same gradient shares a class; another doesn't.
    let again = rules(
        bg(Background {
            gradient: Gradient.Linear(180, stops("#1e3c72", "#2a5298")),
            ..Background.theme(),
        }),
    );
    let other = rules(
        bg(Background {
            gradient: Gradient.Linear(90, stops("#1e3c72", "#2a5298")),
            ..Background.theme(),
        }),
    );
    assert_eq(again[0].0, linear[0].0);
    assert(other[0].0 != linear[0].0);
    // Over a colour: the colour stays beneath, and isn't cleared.
    let both = rules(
        bg(Background {
            color: Paint.Color(hex("#101010")),
            gradient: Gradient.Linear(180, stops("#00000000", "#000000aa")),
            ..Background.theme(),
        }),
    );
    assert_eq(both.map(fun(r) = r.0.slice(0, 8)), ["kv-bg-10", "kv-bgi-g"]);
}

@test
fun a_picture_is_its_own_rule_over_the_gradient() {
    let sample = Image.File("examples/assets/sample.png");
    let s = bg(Background {
        color: Paint.Color(hex("#101010")),
        gradient: Gradient.Linear(180, stops("#00000000", "#000000aa")),
        image: Some(sample),
        fill: Fill.Cover,
    });
    // Only the colour is an ordinary rule; the image and gradient are the picture's.
    assert_eq(rules(s).map(fun(r) = r.0), ["kv-bg-101010ff"]);
    let Some((class, img, gradient, fill)) = picture(s) else {
        panic("expected a picture");
    };
    assert(class.starts_with("kv-bgp-"));
    assert_eq(img, sample);
    assert_eq(gradient, "linear-gradient(180deg, #00000000 0.0%, #000000aa 100.0%)");
    assert_eq(
        fill,
        "background-size: cover; background-position: center; background-repeat: no-repeat;",
    );
    assert_eq(picture(bg(Background.theme())), None);
}

@test
fun each_fill_is_its_css() {
    let fill_of = fun(f: Fill): string = match picture(
        bg(Background { image: Some(Image.Icon("x")), fill: f, ..Background.theme() }),
    ) {
        Some((_, _, _, css)) => css,
        None => "none",
    };
    // With an image, the theme's fill is Cover.
    assert_eq(fill_of(Fill.Theme), fill_of(Fill.Cover));
    assert_eq(
        fill_of(Fill.Contain),
        "background-size: contain; background-position: center; background-repeat: no-repeat;",
    );
    assert_eq(
        fill_of(Fill.Tile),
        "background-size: auto; background-position: center; background-repeat: repeat;",
    );
    assert_eq(
        fill_of(Fill.Stretch),
        "background-size: 100% 100%; background-position: center; background-repeat: no-repeat;",
    );
}

@test
fun a_pictures_rule_is_built_from_its_url() {
    let fill = "background-size: cover; background-position: center; background-repeat: no-repeat;";
    assert_eq(
        picture_css(
            Some("-gtk-icontheme(\"x\")"),
            "linear-gradient(180deg, #000000ff 0.0%, #ffffffff 100.0%)",
            fill,
        ),
        "background-image: -gtk-icontheme(\"x\"), linear-gradient(180deg, #000000ff 0.0%, #ffffffff 100.0%); {fill}",
    );
    // A picture that can't be shown: the gradient alone, or no image at all.
    assert_eq(
        picture_css(None, "linear-gradient(0deg, #000000ff 0.0%, #ffffffff 100.0%)", fill),
        "background-image: linear-gradient(0deg, #000000ff 0.0%, #ffffffff 100.0%); {fill}",
    );
    assert_eq(picture_css(None, "", fill), "background-image: none;");
}

@test
fun a_pictures_url_comes_from_its_checked_bytes() {
    let none_on_disk = fun(path: string): Option<u8[]> = None;
    let png_on_disk = fun(path: string): Option<u8[]> = Some(fixtures.png());
    assert_eq(
        url_of(Image.Icon("starred-symbolic"), none_on_disk),
        Some("-gtk-icontheme(\"starred-symbolic\")"),
    );
    assert_eq(
        url_of(Image.Bytes("k", fixtures.jpeg()), none_on_disk),
        data_url(fixtures.jpeg()).map(fun(u) = "url(\"{u}\")"),
    );
    assert_eq(
        url_of(Image.File("a.png"), png_on_disk),
        data_url(fixtures.png()).map(fun(u) = "url(\"{u}\")"),
    );
    // Missing, or failing the checks: no image.
    assert_eq(url_of(Image.File("missing.png"), none_on_disk), None);
    assert_eq(url_of(Image.Bytes("bad", fixtures.huge_png()), none_on_disk), None);
}

@test
fun bad_background_values_say_what_is_wrong() {
    assert_eq(
        check(
            bg(Background {
                gradient: Gradient.Linear(0, [Stop { color: Paint.Theme, at: 0.0 }]),
                ..Background.theme(),
            }),
        ),
        Err("Gradient: a gradient needs at least two stops"),
    );
    assert_eq(
        check(
            bg(Background {
                gradient: Gradient.Radial([
                    Stop { color: Paint.Theme, at: 0.0 },
                    Stop { color: Paint.Theme, at: 1.5 },
                ]),
                ..Background.theme(),
            }),
        ),
        Err("Stop at 1.5: a stop is between 0 and 1"),
    );
    assert_eq(
        check(
            bg(Background {
                gradient: Gradient.Linear(0, [
                    Stop { color: Paint.Theme, at: 0.6 },
                    Stop { color: Paint.Theme, at: 0.2 },
                ]),
                ..Background.theme(),
            }),
        ),
        Err("Gradient: its stops must be in order"),
    );
    assert_eq(
        check(bg(Background { color: Paint.Faded(2.0), ..Background.theme() })),
        Err("Paint.Faded(2.0): an opacity is between 0 and 1"),
    );
    assert_eq(
        check(
            bg(Background {
                gradient: Gradient.Linear(0, [
                    Stop { color: Paint.Faded(-0.5), at: 0.0 },
                    Stop { color: Paint.Theme, at: 1.0 },
                ]),
                ..Background.theme(),
            }),
        ),
        Err("Paint.Faded(-0.5): an opacity is between 0 and 1"),
    );
}

@test
fun an_icon_name_cant_break_out_of_its_css_string() {
    for name of ["a\"b", "a\\b", "a;b", "a{{b", "a}}b", "a\nb"] {
        assert_eq(
            check(bg(Background { image: Some(Image.Icon(name)), ..Background.theme() })),
            Err(
                "Image.Icon(\"{name}\"): an icon name can't hold quotes, backslashes, ; {{ }} or line breaks",
            ),
        );
    }
}
