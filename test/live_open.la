// Opening from outside (PRP-065): an app with `on_open`, run with a command
// line, mounts and gets what it was asked to open as one message (a local
// file's absolute path, an address as GIO normalises it), after `init`; an
// app without it mounts through `activate` and gets nothing. Needs a
// display, so it is skipped without one.
import std.env;
import kivuli.render.launch { run_with };
import kivuli { App, Cmd, Sub, View, text };

fun has_display(): bool = env.get("DISPLAY").is_some() || env.get("WAYLAND_DISPLAY").is_some();

enum Msg {
    Open(string[]),
}

fun app(id: string, heard: Ref<string[]>, on_open: Option<fun(string[]): Msg>): App<i64, Msg> = App {
    id: id,
    // Quits once the first update has run, or straight away when nothing is opened.
    init: (0, if on_open.is_some() { Cmd.none() } else { Cmd.quit() }),
    update: fun(m: i64, msg: Msg): (i64, Cmd<Msg>) = match msg {
        Open(items) => {
            heard.set(items);
            (m + 1, Cmd.quit())
        }
    },
    view: fun(m: i64): View<Msg> = {
        heard.update(fun(xs) = if xs.len == 0 { ["mounted"] } else { xs });
        text("{m}")
    },
    subscriptions: fun(m: i64): Sub<Msg> = Sub.none(),
    on_open: on_open,
};

@test
fun an_app_opening_from_outside_gets_what_it_was_asked() {
    if !has_display() {
        skip("no display");
    }
    let heard: Ref<string[]> = Ref.new([]);
    let status = run_with(app("org.kivuli.test.open", heard, Some(Msg.Open)), [
        "prog",
        "/tmp/kivuli-open-test.rkb",
        "rapidkoi://notes.dafifi.net",
    ]);
    assert_eq(status, 0);
    assert_eq(heard.get(), ["/tmp/kivuli-open-test.rkb", "rapidkoi://notes.dafifi.net/"]);
}

@test
fun an_app_without_on_open_ignores_its_command_line() {
    if !has_display() {
        skip("no display");
    }
    let heard: Ref<string[]> = Ref.new([]);
    let status = run_with(app("org.kivuli.test.no_open", heard, None), [
        "prog",
        "/tmp/kivuli-open-test.rkb",
    ]);
    assert_eq(status, 0);
    assert_eq(heard.get(), ["mounted"]);
}
