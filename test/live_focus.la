// Clicking away clears keyboard focus (PRP-024): the window watches primary
// clicks no widget under the pointer took (the bubble phase), and a press
// there leaves nothing focused; `Cmd.focus` still focuses afterwards. Needs
// a display, so it is skipped without one. (How a real click feels:
// examples/search_bar.la.)
import std.env;
import gtk {
    GtkApplication,
    GtkWidget,
    connect_app,
    g_application_quit,
    g_application_run,
    g_object_unref,
    gtk_application_new,
    gtk_application_window_new,
    gtk_box_append,
    gtk_box_new,
    gtk_label_new,
    gtk_root_get_focus,
    gtk_widget_grab_focus,
    gtk_widget_is_ancestor,
    lgtk_emit_pressed,
};
import kivuli.render.live { dispatch, mount, live_of };
import kivuli.core.live_tree { widget };
import kivuli.render.windows { keeps_focus };
import kivuli { App, Cmd, Sub, View, column, input, text };

fun has_display(): bool = env.get("DISPLAY").is_some() || env.get("WAYLAND_DISPLAY").is_some();

fun note(seen: Ref<string[]>, s: string) {
    seen.update(fun(xs) {
        let mut ys = xs;
        ys.push(s);
        ys
    });
}

/** Whether the window's focus is in `w` (an entry's sits on a widget inside it). */
fun focused_in(window: GtkWidget, w: GtkWidget): bool = match gtk_root_get_focus(window) {
    Some(f) => f == w || gtk_widget_is_ancestor(f, w) == 1,
    None => false,
};

enum Go {
    Typed(string),
    Focus,
}

@test
fun a_click_no_widget_takes_clears_focus() {
    if !has_display() {
        skip("no display");
    }
    let seen: Ref<string[]> = Ref.new([]);
    let application = gtk_application_new("org.kivuli.test.blur", 0);
    connect_app(
        application,
        "activate",
        fun(a: GtkApplication) {
            let window = gtk_application_window_new(a);
            let app = mount(a, window, App {
                id: "org.kivuli.test",
                init: (0, Cmd.none()),
                update: fun(m: i64, msg: Go): (i64, Cmd<Go>) = match msg {
                    Focus => (m, Cmd.focus("address")),
                    _ => (m, Cmd.none()),
                },
                view: fun(m: i64): View<Go> = column([
                    input("", Go.Typed).name("address"),
                    text("beside it"),
                ]),
                subscriptions: fun(m: i64): Sub<Go> = Sub.none(),
                on_open: None,
            });
            let field = match live_of(app) {
                Box(_, _, kids) => widget(kids[0]),
                _ => panic("expected a column"),
            };
            gtk_widget_grab_focus(field);
            note(seen, "focused {focused_in(window, field)}");
            // A primary click that reached the window: nothing under it took it.
            lgtk_emit_pressed(app.blur, 1, 5.0, 5.0);
            note(seen, "after a click away: none {gtk_root_get_focus(window).is_none()}");
            dispatch(app, Go.Focus);
            note(seen, "Cmd.focus still works {focused_in(window, field)}");
            g_application_quit(a);
        },
        0,
    );
    g_application_run(application, 0, None);
    g_object_unref(application);
    assert_eq(seen.get(), [
        "focused true",
        "after a click away: none true",
        "Cmd.focus still works true",
    ]);
}

// DECISION-042: a text view takes the focus on a single press without
// claiming it, so the click reaches the window too. A click on the focused
// widget, or inside it, keeps the focus; one elsewhere, or on nothing, clears it.
@test
fun a_click_inside_the_focused_widget_keeps_the_focus() {
    if !has_display() {
        skip("no display");
    }
    let seen: Ref<string[]> = Ref.new([]);
    let application = gtk_application_new("org.kivuli.test.keep", 0);
    connect_app(
        application,
        "activate",
        fun(a: GtkApplication) {
            let field = gtk_box_new(1, 0);
            let inside = gtk_label_new("inside");
            gtk_box_append(field, inside);
            let beside = gtk_label_new("beside");
            note(seen, "on it {keeps_focus(Some(field), Some(field))}");
            note(seen, "inside it {keeps_focus(Some(inside), Some(field))}");
            note(seen, "beside it {keeps_focus(Some(beside), Some(field))}");
            note(seen, "on nothing {keeps_focus(None, Some(field))}");
            note(seen, "nothing focused {keeps_focus(Some(field), None)}");
            g_application_quit(a);
        },
        0,
    );
    g_application_run(application, 0, None);
    g_object_unref(application);
    assert_eq(seen.get(), [
        "on it true",
        "inside it true",
        "beside it false",
        "on nothing false",
        "nothing focused false",
    ]);
}
