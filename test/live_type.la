// Styles as values on real GTK widgets: a node's values land as classes and
// the app's stylesheet holds their rules; a value never seen before adds its
// rule while the app runs, on the same widget; colours read back from GTK as
// set, and a faded colour is the theme's text colour at that opacity. Needs
// a display, so it is skipped without one. (How text looks: examples/type.la.)
import std.env;
import gtk {
    GtkApplication,
    GtkWidget,
    connect_app,
    emit_widget,
    g_application_quit,
    g_application_run,
    g_object_unref,
    gtk_application_new,
    gtk_application_window_new,
    gtk_widget_get_overflow,
    gtk_widget_has_css_class,
    lgtk_widget_rgba,
};
import kivuli.render.live { mount, live_of };
import kivuli.core.effects { sandbox_app };
import kivuli.core.live_tree { Live, widget };
import fixtures;
import kivuli {
    View,
    Sizing,
    Background,
    Gradient,
    Stop,
    Fill,
    Image,
    Border,
    When,
    Shadow,
    Drop,
    Effects,
    Move,
    State,
    Side,
    Outline,
    Width,
    Line,
    Radius,
    Font,
    Text,
    Size,
    Weight,
    Paint,
    Transform,
    Decoration,
    button,
    checkbox,
    column,
    hex,
    text,
};

fun has_display(): bool = env.get("DISPLAY").is_some() || env.get("WAYLAND_DISPLAY").is_some();

fun note(seen: Ref<string[]>, s: string) {
    seen.update(fun(xs) {
        let mut ys = xs;
        ys.push(s);
        ys
    });
}

enum Grow {
    Bigger,
}

fun view_type(big: bool): View<Grow> = column([
    text("Bold").style([
        Font { weight: Weight.Bold, ..Font.theme() },
        Text { transform: Transform.Uppercase, ..Text.theme() },
    ]),
    text("Sized").style([Font { size: Size.Pt(if big { 30 } else { 12 }), ..Font.theme() }]),
    text("Red").style([Text { color: Paint.Color(hex("#ff0000")), ..Text.theme() }]),
    text("Plain"),
    text("Faded").style([Text { color: Paint.Faded(0.55), ..Text.theme() }]),
    button("Bigger", Grow.Bigger),
    checkbox("Struck", true, fun(b: bool) = Grow.Bigger).style([
        Text { decoration: Decoration.Strikethrough, ..Text.theme() },
    ]),
]);

/** A colour from `lgtk_widget_rgba`'s 0xRRGGBBAA, as its four channels. */
fun channels(rgba: u32): i64[] {
    let n = rgba as i64;
    [n / 16777216 % 256, n / 65536 % 256, n / 256 % 256, n % 256]
}

@test
fun values_land_as_classes_and_new_ones_join_the_stylesheet() {
    if !has_display() {
        skip("no display");
    }
    let seen: Ref<string[]> = Ref.new([]);
    let application = gtk_application_new("org.kivuli.test.type", 0);
    connect_app(
        application,
        "activate",
        fun(a: GtkApplication) {
            let window = gtk_application_window_new(a);
            let app = mount(
                a,
                window,
                sandbox_app(
                    "org.kivuli.test",
                    false,
                    fun(big: bool, msg: Grow): bool = true,
                    view_type,
                ),
            );
            let kids = fun(): Live<Grow>[] = match live_of(app) {
                Box(_, _, ks) => ks,
                _ => panic("expected a column"),
            };
            let bold = widget(kids()[0]);
            note(
                seen,
                "bold {gtk_widget_has_css_class(bold, "kv-fw-700")} upper {gtk_widget_has_css_class(bold, "kv-tt-upper")}",
            );
            let css = fun(): string[] = app.styles.css.get();
            note(
                seen,
                "rules {css().len}, bold rule {css().any(fun(r) = r == ".kv-fw-700 {{ font-weight: 700; }}")}",
            );
            // A size never seen before: its rule joins, and the same widget changes class.
            let sized = widget(kids()[1]);
            emit_widget(widget(kids()[5]), "clicked");
            note(
                seen,
                "same {widget(kids()[1]) == sized} 30pt {gtk_widget_has_css_class(sized, "kv-fs-30pt")} 12pt {gtk_widget_has_css_class(sized, "kv-fs-12pt")} rule {css().any(fun(r) = r == ".kv-fs-30pt {{ font-size: 30pt; }}")}",
            );
            // Colours as GTK computes them.
            note(seen, "red {channels(lgtk_widget_rgba(widget(kids()[2])))}");
            let plain = channels(lgtk_widget_rgba(widget(kids()[3])));
            let faded = channels(lgtk_widget_rgba(widget(kids()[4])));
            // The theme's colour, its alpha times 0.55 (rounded either way).
            let want = plain[3] * 55 / 100;
            note(
                seen,
                "faded keeps the colour {faded[0] == plain[0] && faded[1] == plain[1] && faded[2] == plain[2]}, alpha 55% {faded[3] >= want - 1 && faded[3] <= want + 1}",
            );
            // A check box's own label takes its classes: decoration isn't inherited.
            match kids()[6] {
                Checkbox(_, label, _) => note(
                    seen,
                    "check box label struck {gtk_widget_has_css_class(label, "kv-td-strike")}",
                ),
                _ => note(seen, "not a check box"),
            }
            g_application_quit(a);
        },
        0,
    );
    g_application_run(application, 0, None);
    g_object_unref(application);
    assert_eq(seen.get(), [
        "bold 1 upper 1",
        "rules 7, bold rule true",
        "same true 30pt 1 12pt 0 rule true",
        "red [255, 0, 0, 255]",
        "faded keeps the colour true, alpha 55% true",
        "check box label struck 1",
    ]);
}

enum Swap {
    Next,
}

fun view_backgrounds(second: bool): View<Swap> = column([
    column([]).style([
        Sizing { min_height: Width.Px(40), ..Sizing.theme() },
        Background {
            color: Paint.Color(hex("#101010")),
            gradient: Gradient.Linear(180, [
                Stop { color: Paint.Color(hex("#00000000")), at: 0.0 },
                Stop { color: Paint.Color(hex("#000000aa")), at: 1.0 },
            ]),
            image: Some(
                Image.Bytes(
                    if second { "jpeg" } else { "png" },
                    if second { fixtures.jpeg() } else { fixtures.png() },
                ),
            ),
            fill: Fill.Cover,
        },
    ]),
    column([]).style([
        Sizing { min_height: Width.Px(40), ..Sizing.theme() },
        Background { image: Some(Image.File("examples/assets/sample.png")), ..Background.theme() },
    ]),
    column([]).style([
        Sizing { min_height: Width.Px(40), ..Sizing.theme() },
        Background { image: Some(Image.File("no/such/file.png")), ..Background.theme() },
    ]),
    button("Next", Swap.Next),
]);

/** The rule for `class` in the app's stylesheet, or "". */
fun rule_for(css: string[], class: string): string {
    let mut found = "";
    for r of css {
        if r.starts_with(".{class} ") {
            found = r;
        }
    }
    found
}

/** A widget's own class that starts with `prefix` (kivuli's), or "". */
fun class_of(css: string[], w: GtkWidget, prefix: string): string {
    let mut found = "";
    for r of css {
        // A rule is ".class { … }": its class is what comes before the first space.
        let class = r.split(" ")[0].slice(1, r.split(" ")[0].len);
        if class.starts_with(prefix) && gtk_widget_has_css_class(w, class) == 1 {
            found = class;
        }
    }
    found
}

@test
fun backgrounds_land_as_classes_and_pictures_as_checked_data_urls() {
    if !has_display() {
        skip("no display");
    }
    let seen: Ref<string[]> = Ref.new([]);
    let application = gtk_application_new("org.kivuli.test.backgrounds", 0);
    connect_app(
        application,
        "activate",
        fun(a: GtkApplication) {
            let window = gtk_application_window_new(a);
            let app = mount(
                a,
                window,
                sandbox_app(
                    "org.kivuli.test",
                    false,
                    fun(second: bool, msg: Swap): bool = true,
                    view_backgrounds,
                ),
            );
            let kids = fun(): Live<Swap>[] = match live_of(app) {
                Box(_, _, ks) => ks,
                _ => panic("expected a column"),
            };
            let css = fun(): string[] = app.styles.css.get();
            let hero = widget(kids()[0]);
            note(seen, "colour {gtk_widget_has_css_class(hero, "kv-bg-101010ff")}");
            let picture = class_of(css(), hero, "kv-bgp-");
            let body = rule_for(css(), picture);
            note(
                seen,
                "bytes as png data {body.contains("url(\"data:image/png;base64,")} over the gradient {body.contains("linear-gradient(180deg")} cover {body.contains("background-size: cover")}",
            );
            let file = rule_for(css(), class_of(css(), widget(kids()[1]), "kv-bgp-"));
            note(
                seen,
                "file as data {file.contains("url(\"data:image/png;base64,")} no path {!file.contains("sample.png")}",
            );
            let missing = rule_for(css(), class_of(css(), widget(kids()[2]), "kv-bgp-"));
            note(seen, "missing file {missing.contains("background-image: none;")}");
            // A picture never seen before joins while the app runs.
            emit_widget(widget(kids()[3]), "clicked");
            let now = rule_for(css(), class_of(css(), widget(kids()[0]), "kv-bgp-"));
            note(seen, "new picture as jpeg data {now.contains("url(\"data:image/jpeg;base64,")}");
            g_application_quit(a);
        },
        0,
    );
    g_application_run(application, 0, None);
    g_object_unref(application);
    assert_eq(seen.get(), [
        "colour 1",
        "bytes as png data true over the gradient true cover true",
        "file as data true no path true",
        "missing file true",
        "new picture as jpeg data true",
    ]);
}

enum Round {
    Flatten,
}

fun view_borders(rounded: bool): View<Round> = column([
    column([text("inside")]).style([
        Border {
            all: Side { width: Width.Px(1), color: Paint.Faded(0.2), style: Line.Solid },
            radius: if rounded { Radius.All(12) } else { Radius.Theme },
            ..Border.theme(),
        },
        Outline {
            width: Width.Px(2),
            color: Paint.Color(hex("#2a5298")),
            style: Line.Dashed,
            offset: 2,
        },
    ]),
    button("Flatten", Round.Flatten),
]);

@test
fun borders_land_as_classes_and_rounded_nodes_clip_their_content() {
    if !has_display() {
        skip("no display");
    }
    let seen: Ref<string[]> = Ref.new([]);
    let application = gtk_application_new("org.kivuli.test.borders", 0);
    connect_app(
        application,
        "activate",
        fun(a: GtkApplication) {
            let window = gtk_application_window_new(a);
            let app = mount(
                a,
                window,
                sandbox_app(
                    "org.kivuli.test",
                    true,
                    fun(rounded: bool, msg: Round): bool = false,
                    view_borders,
                ),
            );
            let kids = fun(): Live<Round>[] = match live_of(app) {
                Box(_, _, ks) => ks,
                _ => panic("expected a column"),
            };
            let css = fun(): string[] = app.styles.css.get();
            let card = widget(kids()[0]);
            note(
                seen,
                "classes {gtk_widget_has_css_class(card, "kv-bw-top-1")} {gtk_widget_has_css_class(card, "kv-br-tl-12")} {gtk_widget_has_css_class(card, "kv-ow-2")}",
            );
            note(
                seen,
                "outline rule keeps focus {css().any(fun(r) = r == ".kv-ow-2:not(:focus-visible) {{ outline-width: 2px; }}")}",
            );
            // GtkOverflow: 0 visible, 1 hidden.
            note(seen, "rounded clips {gtk_widget_get_overflow(card)}");
            emit_widget(widget(kids()[1]), "clicked");
            note(
                seen,
                "flat: same {widget(kids()[0]) == card} clips {gtk_widget_get_overflow(card)} radius class {gtk_widget_has_css_class(card, "kv-br-tl-12")}",
            );
            g_application_quit(a);
        },
        0,
    );
    g_application_run(application, 0, None);
    g_object_unref(application);
    assert_eq(seen.get(), [
        "classes 1 1 1",
        "outline rule keeps focus true",
        "rounded clips 1",
        "flat: same true clips 0 radius class 0",
    ]);
}

@test
fun a_states_classes_land_and_its_rules_join_the_stylesheet() {
    if !has_display() {
        skip("no display");
    }
    let seen: Ref<string[]> = Ref.new([]);
    let application = gtk_application_new("org.kivuli.test.states", 0);
    connect_app(
        application,
        "activate",
        fun(a: GtkApplication) {
            let window = gtk_application_window_new(a);
            let app = mount(
                a,
                window,
                sandbox_app(
                    "org.kivuli.test",
                    false,
                    fun(m: bool, msg: Swap): bool = m,
                    fun(m: bool): View<Swap> = column([
                        button("Save", Swap.Next).style([
                            Shadow {
                                boxes: [
                                    Drop {
                                        y: 2,
                                        blur: 8,
                                        color: Paint.Color(hex("#00000040")),
                                        ..Drop.theme(),
                                    },
                                ],
                                ..Shadow.theme(),
                            },
                            Effects {
                                opacity: Some(0.9),
                                transform: [Move.Rotate(-2)],
                                ..Effects.theme(),
                            },
                            Background { color: Paint.Color(hex("#2a5298")), ..Background.theme() },
                            When(State.Hover, [
                                Background {
                                    color: Paint.Color(hex("#3a62a8")),
                                    ..Background.theme(),
                                },
                            ]),
                            When(State.Press, [
                                Background {
                                    color: Paint.Color(hex("#1e3c72")),
                                    ..Background.theme(),
                                },
                            ]),
                        ]),
                    ]),
                ),
            );
            let save = match live_of(app) {
                Box(_, _, ks) => widget(ks[0]),
                _ => panic("expected a column"),
            };
            let css = app.styles.css.get();
            note(
                seen,
                "classes {gtk_widget_has_css_class(save, "kv-bg-2a5298ff")} {gtk_widget_has_css_class(save, "kv-hover-bg-3a62a8ff")} {gtk_widget_has_css_class(save, "kv-press-bg-1e3c72ff")}",
            );
            note(
                seen,
                "hover rule {css.any(fun(r) = r == ".kv-hover-bg-3a62a8ff:hover {{ background-color: #3a62a8ff; }}")}",
            );
            note(
                seen,
                "press rule {css.any(fun(r) = r == ".kv-press-bg-1e3c72ff.kv-press-bg-1e3c72ff.kv-press-bg-1e3c72ff:active {{ background-color: #1e3c72ff; }}")}",
            );
            note(
                seen,
                "effects {gtk_widget_has_css_class(save, "kv-op-900")} {css.any(fun(r) = r == ".kv-op-900 {{ opacity: 0.9; }}") && css.any(fun(r) = r.contains("box-shadow: 0px 2px 8px 0px #00000040;")) && css.any(fun(r) = r.contains("transform: rotate(-2deg);"))}",
            );
            g_application_quit(a);
        },
        0,
    );
    g_application_run(application, 0, None);
    g_object_unref(application);
    assert_eq(seen.get(), [
        "classes 1 1 1",
        "hover rule true",
        "press rule true",
        "effects 1 true",
    ]);
}
