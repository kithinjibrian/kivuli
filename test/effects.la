// Effects as data: what commands and subscriptions flatten to, the app a
// sandbox runs, and the window a view's root asks for. No GTK.
import kivuli.core.effects { active_listeners, commands, receivers, sandbox_app, timers };
import kivuli.core.diff { Patch, diff as patches };
import kivuli.view.looks { Style, Window, plain };
import kivuli { App, Cmd, Sub, View, column, text };

// Views and commands can hold functions, which have no `==`: compare what
// they print instead (DECISION-008).
fun assert_same<T>(actual: T, expected: T) {
    assert_eq("{actual}", "{expected}");
}

enum Msg {
    Ping,
    Tick(i64),
    Got(i64),
    Active(bool),
}

enum Outer {
    Inner(Msg),
}

@test
fun commands_flatten_in_order_without_nones() {
    let cmd: Cmd<Msg> = Cmd.batch([
        Cmd.none(),
        Cmd.after(5, Msg.Ping),
        Cmd.batch([Cmd.quit(), Cmd.none()]),
    ]);
    let expected: Cmd<Msg>[] = [Cmd.After(5, Msg.Ping), Cmd.Quit];
    assert_same(commands(cmd), expected);
}

@test
fun timers_get_keys_that_tell_equal_intervals_apart() {
    let sub: Sub<Msg> = Sub.batch([
        Sub.every(1000, Msg.Tick),
        Sub.none(),
        Sub.every(1000, Msg.Tick),
        Sub.every(50, Msg.Tick),
    ]);
    let mut keys: string[] = [];
    for t of timers(sub) {
        keys.push(t.key);
    }
    assert_eq(keys, ["1000#0", "1000#1", "50#0"]);
    // A timer's function makes the message from the time.
    let f = timers(sub)[2].tick;
    assert_eq(f(7), Msg.Tick(7));
}

@test
fun a_sandbox_app_has_no_effects() {
    let app: App<i64, Msg> = sandbox_app(
        "org.kivuli.test",
        1,
        fun(n: i64, m: Msg): i64 = n + 1,
        fun(n: i64): View<Msg> = text("{n}"),
    );
    let (start, first) = app.init;
    assert_eq(start, 1);
    assert_same(first, Cmd.none());
    let update = app.update;
    let (next, cmd) = update(1, Msg.Ping);
    assert_eq(next, 2);
    assert_same(cmd, Cmd.none());
    let subscriptions = app.subscriptions;
    assert_same(subscriptions(2), Sub.none());
}

@test
fun the_window_lands_in_the_roots_style() {
    let expected: View<Msg> = View.Styled(View.Column([]), Style {
        window: Some(Window { title: "Ticks", width: 300, height: 200 }),
        ..plain(),
    });
    assert_same(column([]).window("Ticks", 300, 200), expected);
}

@test
fun a_new_title_restyles_the_root() {
    let expected: Patch<Msg>[] = [
        Patch.SetStyle([], Style {
            window: Some(Window { title: "Ticks 2", width: 300, height: 200 }),
            ..plain(),
        }),
    ];
    assert_same(
        patches(column([]).window("Ticks 1", 300, 200), column([]).window("Ticks 2", 300, 200)),
        expected,
    );
}

@test
fun focus_commands_flatten_and_map() {
    let cmd: Cmd<Msg> = Cmd.batch([Cmd.focus("task"), Cmd.none()]);
    let expected: Cmd<Msg>[] = [Cmd.Focus("task")];
    assert_same(commands(cmd), expected);
    assert_same(commands(cmd.map(fun(m: Msg): Msg = m)), expected);
}

@test
fun scroll_to_commands_flatten_and_map() {
    let cmd: Cmd<Msg> = Cmd.batch([Cmd.scroll_to("row-30"), Cmd.none()]);
    let expected: Cmd<Msg>[] = [Cmd.ScrollTo("row-30")];
    assert_same(commands(cmd), expected);
    assert_same(commands(cmd.map(fun(m: Msg): Msg = m)), expected);
}

@test
fun a_task_is_a_command_whose_work_gives_its_message() {
    let cmd: Cmd<Msg> = Cmd.batch([Cmd.none(), Cmd.task(fun(): i64 = 6 * 7, Msg.Got)]);
    let cs = commands(cmd);
    assert_eq(cs.len, 1);
    match cs[0] {
        Task(job) => assert_eq(job(), Msg.Got(42)),
        _ => panic("expected a task"),
    }
    // Mapped: the same work, its message mapped.
    match commands(cmd.map(Outer.Inner))[0] {
        Task(job) => assert_eq(job(), Outer.Inner(Msg.Got(42))),
        _ => panic("expected a task"),
    }
}

@test
fun a_receive_turns_each_sent_value_into_a_message_in_order() {
    let c: Chan<i64> = Chan.buffered(4);
    c.send(1);
    c.send(2);
    let sub: Sub<Msg> = Sub.batch([Sub.every(10, Msg.Tick), Sub.receive(c, Msg.Got)]);
    let polls = receivers(sub);
    assert_eq(polls.len, 1);
    let poll = polls[0];
    assert_eq(poll(), Some(Msg.Got(1)));
    assert_eq(poll(), Some(Msg.Got(2)));
    // Nothing ready: no message, and no waiting.
    assert_eq(poll(), None);
    // Mapped, on the same channel.
    c.send(3);
    let mapped = receivers(sub.map(Outer.Inner))[0];
    assert_eq(mapped(), Some(Outer.Inner(Msg.Got(3))));
    // Timers don't count as receivers, and receivers aren't timers.
    assert_eq(timers(sub).len, 1);
}

@test
fun window_active_listeners_are_found_in_order_and_mapped() {
    let sub: Sub<Msg> = Sub.batch([
        Sub.window_active(Msg.Active),
        Sub.every(10, Msg.Tick),
        Sub.batch([Sub.window_active(fun(on: bool) = if on { Msg.Ping } else { Msg.Got(0) })]),
    ]);
    let listeners = active_listeners(sub);
    assert_eq(listeners.len, 2);
    assert_same(listeners[0](true), Msg.Active(true));
    assert_same(listeners[1](false), Msg.Got(0));
    let quiet: Sub<Msg> = Sub.none();
    assert_eq(active_listeners(quiet).len, 0);
    let mapped = active_listeners(Sub.window_active(Msg.Active).map(Outer.Inner));
    assert_same(mapped[0](false), Outer.Inner(Msg.Active(false)));
}

@test
fun copy_commands_flatten_and_map() {
    let cmd: Cmd<Msg> = Cmd.batch([Cmd.copy_text("https://counter.dafifi.net"), Cmd.none()]);
    let expected: Cmd<Msg>[] = [Cmd.Copy("https://counter.dafifi.net")];
    assert_same(commands(cmd), expected);
    let mapped: Cmd<Outer> = cmd.map(Outer.Inner);
    let mapped_expected: Cmd<Outer>[] = [Cmd.Copy("https://counter.dafifi.net")];
    assert_same(commands(mapped), mapped_expected);
}
