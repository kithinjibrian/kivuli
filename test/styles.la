// Styles as values (PRP-016): `.style`'s merge rule: the last value that sets
// a field wins; `Theme` sets nothing; two `.style` calls are one longer
// list. No GTK.
import kivuli.styles { Sheet };
import kivuli {
    View,
    Styling,
    Font,
    Text,
    Size,
    Weight,
    Family,
    FontStyle,
    LineHeight,
    Decoration,
    Transform,
    Paint,
    Background,
    Gradient,
    Stop,
    Fill,
    Image,
    button,
    column,
    row,
    spacer,
    text,
    hex,
};

fun sheet_of<M>(v: View<M>): Sheet = match v {
    Styled(_, s) => s.sheet,
    _ => panic("expected a styled node"),
};

// One-field values, written in full: what an app would write.
fun weight(w: Weight): Font = Font { weight: w, ..Font.theme() };

fun big(): Font = Font { weight: Weight.Black, size: Size.Scale(2.0), ..Font.theme() };

@test
fun the_theme_values_set_nothing() {
    assert_eq(Font.theme(), Font {
        family: Family.Theme,
        size: Size.Theme,
        weight: Weight.Theme,
        style: FontStyle.Theme,
        tabular: false,
    });
    assert_eq(Text.theme(), Text {
        color: Paint.Theme,
        line_height: LineHeight.Theme,
        letter_spacing: 0,
        decoration: Decoration.Theme,
        transform: Transform.Theme,
    });
    assert_eq(Sheet.theme(), Sheet {
        font: Font.theme(),
        text: Text.theme(),
        background: Background.theme(),
    });
    assert_eq(Background.theme(), Background {
        color: Paint.Theme,
        gradient: Gradient.Theme,
        image: None,
        fill: Fill.Theme,
    });
}

@test
fun the_last_value_that_sets_a_field_wins() {
    let a: View<i64> = text("x").style([big(), weight(Weight.Thin), weight(Weight.Bold)]);
    assert_eq(sheet_of(a).font, Font {
        size: Size.Scale(2.0),
        weight: Weight.Bold,
        ..Font.theme(),
    });
    let b: View<i64> = text("x").style([weight(Weight.Bold), big()]);
    assert_eq(sheet_of(b).font, big());
}

@test
fun theme_fields_are_skipped() {
    // The later value sets only the weight: the size stays.
    let v: View<i64> = text("x").style([big(), Font { weight: Weight.Thin, ..Font.theme() }]);
    assert_eq(sheet_of(v).font, Font {
        size: Size.Scale(2.0),
        weight: Weight.Thin,
        ..Font.theme(),
    });
    // A whole theme value changes nothing.
    let same: View<i64> = text("x").style([big(), Font.theme(), Text.theme()]);
    assert_eq(sheet_of(same).font, big());
}

@test
fun fonts_and_text_merge_separately_in_one_list() {
    let v: View<i64> = text("x").style([
        Font { family: Family.Monospace, ..Font.theme() },
        Text { transform: Transform.Uppercase, ..Text.theme() },
        Font { tabular: true, ..Font.theme() },
        Text { color: Paint.Faded(0.55), letter_spacing: 2, ..Text.theme() },
    ]);
    assert_eq(sheet_of(v), Sheet {
        font: Font { family: Family.Monospace, tabular: true, ..Font.theme() },
        text: Text {
            transform: Transform.Uppercase,
            color: Paint.Faded(0.55),
            letter_spacing: 2,
            ..Text.theme(),
        },
        ..Sheet.theme(),
    });
}

@test
fun two_style_calls_are_one_longer_list() {
    let wide = Text { letter_spacing: 1, ..Text.theme() };
    let split: View<i64> = text("x").style([big(), wide]).style([weight(Weight.Thin)]).padding(4);
    let whole: View<i64> = text("x").padding(4).style([big(), wide, weight(Weight.Thin)]);
    assert_eq(sheet_of(split), sheet_of(whole));
    // Nothing set: the theme's.
    let none: View<i64> = text("x").padding(4);
    assert_eq(sheet_of(none), Sheet.theme());
}

// The PRP's OBJECTIVE, as written there.
struct Model {
    folder: string,
    total: string,
}

enum Msg {
    Clear,
}

/** Reused, so named: a plain function returning values. */
fun section(): Styling[] = [
    Font { size: Size.Scale(0.875), weight: Weight.Semibold, ..Font.theme() },
    Text {
        transform: Transform.Uppercase,
        letter_spacing: 1,
        color: Paint.Faded(0.55),
        ..Text.theme(),
    },
];

fun view(m: Model): View<Msg> = column([
    text("Storage").style([Font { size: Size.Pt(22), weight: Weight.Bold, ..Font.theme() }]),
    text("DOWNLOADS").style(section()),
    row([
        text("Folder"),
        spacer(),
        text(m.folder).style([Font { family: Family.Monospace, tabular: true, ..Font.theme() }]),
    ]),
    text("Pictures are kept until you clear them.").wrap().style([
        Text { color: Paint.Faded(0.55), line_height: LineHeight.Times(1.6), ..Text.theme() },
    ]),
    text("Price").style([
        Font { weight: Weight.Medium, ..Font.theme() },
        Text { decoration: Decoration.Strikethrough, ..Text.theme() },
    ]),
    text(m.total).style([Text { color: Paint.Color(hex("#e0e0e0")), ..Text.theme() }]),
    button("Clear cache", Msg.Clear).style([Font { weight: Weight.Bold, ..Font.theme() }]),
]).spacing(10).padding(24);

fun kids(v: View<Msg>): View<Msg>[] = match v {
    Styled(Column(xs), _) => xs,
    _ => panic("expected a styled column"),
};

@test
fun the_objective_reads_as_written() {
    let k = kids(view(Model { folder: "~/Downloads", total: "12 MB" }));
    assert_eq(sheet_of(k[0]).font, Font { size: Size.Pt(22), weight: Weight.Bold, ..Font.theme() });
    assert_eq(sheet_of(k[1]), Sheet {
        font: Font { size: Size.Scale(0.875), weight: Weight.Semibold, ..Font.theme() },
        text: Text {
            transform: Transform.Uppercase,
            letter_spacing: 1,
            color: Paint.Faded(0.55),
            ..Text.theme(),
        },
        ..Sheet.theme(),
    });
    let folder = match k[2] {
        Row(xs) => xs[2],
        _ => panic("expected a row"),
    };
    assert_eq(sheet_of(folder).font, Font {
        family: Family.Monospace,
        tabular: true,
        ..Font.theme(),
    });
    assert_eq(sheet_of(k[3]).text, Text {
        color: Paint.Faded(0.55),
        line_height: LineHeight.Times(1.6),
        ..Text.theme(),
    });
    assert_eq(sheet_of(k[4]), Sheet {
        font: Font { weight: Weight.Medium, ..Font.theme() },
        text: Text { decoration: Decoration.Strikethrough, ..Text.theme() },
        ..Sheet.theme(),
    });
    assert_eq(sheet_of(k[5]).text.color, Paint.Color(hex("#e0e0e0")));
    assert_eq(sheet_of(k[6]).font, Font { weight: Weight.Bold, ..Font.theme() });
}

fun tint(x: f64): Background = Background { color: Paint.Faded(x), ..Background.theme() };

fun down(): Gradient = Gradient.Linear(180, [
    Stop { color: Paint.Color(hex("#1e3c72")), at: 0.0 },
    Stop { color: Paint.Color(hex("#2a5298")), at: 1.0 },
]);

@test
fun backgrounds_merge_field_by_field() {
    // A later gradient keeps the colour beneath it.
    let v: View<i64> = column([]).style([
        tint(0.08),
        Background { gradient: down(), ..Background.theme() },
    ]);
    assert_eq(sheet_of(v).background, Background {
        color: Paint.Faded(0.08),
        gradient: down(),
        ..Background.theme(),
    });
    // A later image replaces an earlier one; None sets nothing.
    let a = Background { image: Some(Image.Icon("a")), ..Background.theme() };
    let b = Background { image: Some(Image.Icon("b")), fill: Fill.Tile, ..Background.theme() };
    let w: View<i64> = column([]).style([a, b, Background.theme()]);
    assert_eq(sheet_of(w).background, b);
    // Fonts and text between backgrounds touch neither.
    let x: View<i64> = text("x").style([
        tint(0.1),
        Font { weight: Weight.Bold, ..Font.theme() },
        Background { fill: Fill.Cover, ..Background.theme() },
    ]);
    assert_eq(sheet_of(x).background, Background {
        color: Paint.Faded(0.1),
        fill: Fill.Cover,
        ..Background.theme(),
    });
    assert_eq(sheet_of(x).font, Font { weight: Weight.Bold, ..Font.theme() });
}

// PRP-017's OBJECTIVE, as written there.
enum Pick {
    Go,
}

/** A card that works in light and dark: a tint of the theme's own text colour. */
fun card(): Background = Background { color: Paint.Faded(0.08), ..Background.theme() };

fun backgrounds_view(rows: View<Pick>[]): View<Pick> = column([
    column(rows).style([card()]).padding(16),
    text("NEW").style([
        Background { color: Paint.Color(hex("#c0392b")), ..Background.theme() },
        Text { color: Paint.Color(hex("#ffffff")), ..Text.theme() },
    ]),
    column([]).height(120).style([
        Background {
            gradient: Gradient.Linear(180, [
                Stop { color: Paint.Color(hex("#1e3c72")), at: 0.0 },
                Stop { color: Paint.Color(hex("#2a5298")), at: 1.0 },
            ]),
            ..Background.theme(),
        },
    ]),
    column([]).height(160).style([
        Background {
            color: Paint.Color(hex("#101010")),
            gradient: Gradient.Linear(180, [
                Stop { color: Paint.Color(hex("#00000000")), at: 0.0 },
                Stop { color: Paint.Color(hex("#000000aa")), at: 1.0 },
            ]),
            image: Some(Image.File("examples/assets/sample.png")),
            fill: Fill.Cover,
        },
    ]),
    column([]).height(80).style([
        Background {
            image: Some(Image.Icon("starred-symbolic")),
            fill: Fill.Tile,
            ..Background.theme(),
        },
    ]),
]);

fun pick_kids(v: View<Pick>): View<Pick>[] = match v {
    Column(xs) => xs,
    _ => panic("expected a column"),
};

@test
fun the_backgrounds_objective_reads_as_written() {
    let k = pick_kids(backgrounds_view([text("row")]));
    assert_eq(sheet_of(k[0]).background, card());
    assert_eq(sheet_of(k[1]).background.color, Paint.Color(hex("#c0392b")));
    assert_eq(sheet_of(k[1]).text.color, Paint.Color(hex("#ffffff")));
    assert_eq(sheet_of(k[2]).background, Background { gradient: down(), ..Background.theme() });
    let hero = sheet_of(k[3]).background;
    assert_eq(
        (hero.color, hero.image, hero.fill),
        (Paint.Color(hex("#101010")), Some(Image.File("examples/assets/sample.png")), Fill.Cover),
    );
    assert_eq(sheet_of(k[4]).background, Background {
        image: Some(Image.Icon("starred-symbolic")),
        fill: Fill.Tile,
        ..Background.theme(),
    });
}
