// Building views: what an app's `view` returns is exactly the tree it wrote.
import kivuli.looks { Style, plain };
import kivuli {
    View,
    text,
    button,
    column,
    row,
    input,
    checkbox,
    spacer,
    separator,
    scroll,
    keyed_column,
    Align,
    ButtonStyle,
    text_area,
    dropdown,
    slider,
    icon,
    image,
    Fit,
    Image,
    wrap,
    keyed_wrap,
    overlay,
    Surface,
    theme,
};

// Views and patches can hold functions, which have no `==`: compare what they
// print instead (functions print as `<fun>`; DECISION-008).
fun assert_same<T>(actual: T, expected: T) {
    assert_eq("{actual}", "{expected}");
}

enum Shade {
    Bar,
    Selected,
}

enum Msg {
    Add,
    Reset,
    Named(string),
    Done(bool),
    Level(i64),
}

struct Model {
    count: i64,
}

// A counter's view, as an app would write it.
fun view(m: Model): View<Msg> = column([
    text("Clicked {m.count} times"),
    button("Add", Msg.Add),
    button("Reset", Msg.Reset),
]);

@test
fun builds_the_tree_it_describes() {
    let expected: View<Msg> = View.Column([
        View.Text("Clicked 2 times"),
        View.Button("Add", Some(Msg.Add), None),
        View.Button("Reset", Some(Msg.Reset), None),
    ]);
    assert_same(view(Model { count: 2 }), expected);
}

@test
fun the_view_follows_the_model() {
    assert_ne("{view(Model { count: 0 })}", "{view(Model { count: 1 })}");
}

@test
fun a_button_carries_its_message() {
    match button("Reset", Msg.Reset) {
        Button(label, msg, _) => {
            assert_eq(label, "Reset");
            assert_eq(msg, Some(Msg.Reset));
        }
        _ => panic("expected a button"),
    }
}

@test
fun a_row_holds_its_children_in_order() {
    let expected: View<Msg> = View.Row([
        View.Button("Add", Some(Msg.Add), None),
        View.Button("Reset", Some(Msg.Reset), None),
    ]);
    assert_same(row([button("Add", Msg.Add), button("Reset", Msg.Reset)]), expected);
}

@test
fun an_input_shows_its_value_and_turns_text_into_a_message() {
    // `Msg.Named` is a variant used as a function (lughac milestone 94).
    match input("Ada", Msg.Named) {
        Input(value, Some((on_change, _))) => {
            assert_eq(value, "Ada");
            assert_eq(on_change("Grace"), Msg.Named("Grace"));
        }
        _ => panic("expected an input"),
    }
}

@test
fun a_checkbox_shows_its_label_and_state_and_turns_a_toggle_into_a_message() {
    match checkbox("Done", true, Msg.Done) {
        Checkbox(label, checked, on_toggle) => {
            assert_eq(label, "Done");
            assert(checked);
            assert_eq(on_toggle(false), Msg.Done(false));
        }
        _ => panic("expected a checkbox"),
    }
}

@test
fun spacers_separators_and_scrolls_are_plain_nodes() {
    let expected: View<Msg> = View.Column([
        View.Spacer,
        View.Separator,
        View.Scroll(View.Text("long")),
    ]);
    assert_same(column([spacer(), separator(), scroll(text("long"))]), expected);
}

@test
fun a_keyed_column_keeps_its_keys_with_its_children() {
    let expected: View<Msg> = View.Keyed([("a", View.Text("A")), ("b", View.Text("B"))]);
    assert_same(keyed_column([("a", text("A")), ("b", text("B"))]), expected);
}

@test
fun modifiers_merge_into_one_style() {
    let expected: View<Msg> = View.Styled(View.Text("x"), Style {
        padding: 4,
        align: Align.Center,
        ..plain(),
    });
    assert_same(text("x").padding(8).align(Align.Center).padding(4), expected);
}

@test
fun every_layout_modifier_lands_in_the_style() {
    let expected: View<Msg> = View.Styled(View.Column([]), Style {
        padding: 1,
        spacing: 2,
        expand: true,
        align: Align.End,
        width: 30,
        height: 40,
        ..plain(),
    });
    assert_same(
        column([]).padding(1).spacing(2).expand().align(Align.End).width(30).height(40),
        expected,
    );
}

@test
fun text_modifiers_land_in_the_style() {
    let expected: View<Msg> = View.Styled(View.Text("x"), Style {
        size: 18,
        bold: true,
        dim: true,
        ..plain(),
    });
    assert_same(text("x").size(18).bold().dim(), expected);
}

@test
fun a_disabled_button_carries_no_message() {
    let expected: View<Msg> = View.Button("Reset", None, None);
    assert_same(button("Reset", Msg.Reset).disabled(true), expected);
}

@test
fun disabled_false_changes_nothing() {
    assert_same(button("Reset", Msg.Reset).disabled(false), button("Reset", Msg.Reset));
}

@test
fun disabled_reaches_a_styled_button_and_ignores_other_nodes() {
    let expected: View<Msg> = View.Styled(View.Button("Go", None, None), Style {
        button: ButtonStyle.Primary,
        ..plain(),
    });
    assert_same(button("Go", Msg.Add).button_style(ButtonStyle.Primary).disabled(true), expected);
    let label: View<Msg> = text("x");
    assert_same(label.disabled(true), label);
}

@test
fun a_text_area_shows_its_text_and_turns_edits_into_messages() {
    match text_area("a", Msg.Named) {
        TextArea(value, Some(on_change)) => {
            assert_eq(value, "a");
            assert_eq(on_change("b\nc"), Msg.Named("b\nc"));
        }
        _ => panic("expected a text area"),
    }
}

@test
fun a_name_lands_in_the_style() {
    let expected: View<Msg> = View.Styled(View.TextArea("a", Some(Msg.Named)), Style {
        name: "notes",
        ..plain(),
    });
    assert_same(text_area("a", Msg.Named).name("notes"), expected);
}

@test
fun long_text_modifiers_and_tooltips_land_in_the_style() {
    let wrapped: View<Msg> = View.Styled(View.Text("x"), Style { wrap: true, ..plain() });
    assert_same(text("x").wrap(), wrapped);
    let capped: View<Msg> = View.Styled(View.Text("x"), Style {
        wrap: true,
        wrap_at: 40,
        ..plain(),
    });
    assert_same(text("x").wrap_at(40), capped);
    let cut: View<Msg> = View.Styled(View.Text("x"), Style {
        ellipsize: true,
        selectable: true,
        ..plain(),
    });
    assert_same(text("x").ellipsize().selectable(), cut);
    let tipped: View<Msg> = View.Styled(View.Button("x", Some(Msg.Add), None), Style {
        tooltip: "Add one",
        ..plain(),
    });
    assert_same(button("x", Msg.Add).tooltip("Add one"), tipped);
}

@test
fun shortcut_and_autofocus_land_in_the_style() {
    let keyed: View<Msg> = View.Styled(View.Button("Add", Some(Msg.Add), None), Style {
        shortcut: "Ctrl+N",
        ..plain(),
    });
    assert_same(button("Add", Msg.Add).shortcut("Ctrl+N"), keyed);
    let focused: View<Msg> = View.Styled(View.Text("x"), Style { autofocus: true, ..plain() });
    assert_same(text("x").autofocus(), focused);
}

@test
fun a_dropdown_and_a_slider_are_plain_nodes() {
    let picks: View<Msg> = View.Dropdown([("Add", Msg.Add), ("Reset", Msg.Reset)], "Reset");
    assert_same(dropdown([("Add", Msg.Add), ("Reset", Msg.Reset)], "Reset"), picks);
    match slider(0, 100, 42, Msg.Level) {
        Slider(min, max, value, on_change) => {
            assert_eq((min, max, value), (0, 100, 42));
            assert_eq(on_change(7), Msg.Level(7));
        }
        _ => panic("expected a slider"),
    }
    let stepped: View<Msg> = View.Styled(View.Slider(0, 10, 4, Msg.Level), Style {
        step: 2,
        ..plain(),
    });
    assert_same(slider(0, 10, 4, Msg.Level).step(2), stepped);
}

@test
fun icons_and_images_are_plain_nodes_with_their_modifiers() {
    let add: View<Msg> = View.Image(Image.Icon("list-add-symbolic"));
    assert_same(icon("list-add-symbolic"), add);
    let big: View<Msg> = View.Styled(View.Image(Image.Icon("list-add-symbolic")), Style {
        size: 48,
        ..plain(),
    });
    assert_same(icon("list-add-symbolic").size(48), big);
    let picture: View<Msg> = View.Image(Image.File("a.png"));
    assert_same(image(Image.File("a.png")), picture);
    assert_eq(plain().fit, Fit.Contain);
    let covered: View<Msg> = View.Styled(View.Image(Image.File("a.png")), Style {
        fit: Fit.Cover,
        ..plain(),
    });
    assert_same(image(Image.File("a.png")).fit(Fit.Cover), covered);
}

@test
fun disabling_a_field_takes_its_messages_away() {
    let off: View<Msg> = View.Input("Ada", None);
    assert_same(input("Ada", Msg.Named).disabled(true), off);
    assert_same(input("Ada", Msg.Named).on_submit(Msg.Add).disabled(true), off);
    // Nothing to add Enter to once it's disabled: either order is the same.
    assert_same(input("Ada", Msg.Named).disabled(true).on_submit(Msg.Add), off);
    let area: View<Msg> = View.TextArea("a", None);
    assert_same(text_area("a", Msg.Named).disabled(true), area);
    // Through a style wrapper.
    let named: View<Msg> = View.Styled(View.TextArea("a", None), Style {
        name: "notes",
        ..plain(),
    });
    assert_same(text_area("a", Msg.Named).name("notes").disabled(true), named);
}

@test
fun disabled_false_changes_nothing_on_a_field() {
    let on: View<Msg> = View.Input("Ada", Some((Msg.Named, Some(Msg.Add))));
    assert_same(input("Ada", Msg.Named).on_submit(Msg.Add).disabled(false), on);
    let area: View<Msg> = View.TextArea("a", Some(Msg.Named));
    assert_same(text_area("a", Msg.Named).disabled(false), area);
}

@test
fun styles_and_window_settings_land_in_the_style() {
    let styled: View<Msg> = View.Styled(View.Text("a"), Style {
        looks: ["Bar", "Selected"],
        ..plain(),
    });
    assert_same(text("a").style([Shade.Bar, Shade.Selected]), styled);
    let t = theme([Shade.Bar], fun(s: Shade) = Surface.theme());
    let rooted: View<Msg> = View.Styled(View.Text("a"), Style {
        theme: Some(t),
        maximized: true,
        ..plain(),
    });
    assert_same(text("a").theme(t).maximized(), rooted);
}

@test
fun a_header_frames_the_node_and_its_styles_stay_outside() {
    let framed: View<Msg> = View.Styled(
        View.Framed(View.Text("body"), [button("Back", Msg.Reset)], text("Title"), []),
        Style { padding: 8, ..plain() },
    );
    assert_same(
        text("body").padding(8).header([button("Back", Msg.Reset)], text("Title"), []),
        framed,
    );
    assert_same(
        text("body").header([button("Back", Msg.Reset)], text("Title"), []).padding(8),
        framed,
    );
}

@test
fun header_looks_land_in_the_root_style_outside_the_frame() {
    let expected: View<Msg> = View.Styled(View.Framed(View.Text("body"), [], text("T"), []), Style {
        header_looks: ["Bar"],
        ..plain(),
    });
    assert_same(text("body").header([], text("T"), []).header_style([Shade.Bar]), expected);
}

@test
fun images_on_their_own_and_on_buttons_are_plain_data() {
    let picture: View<Msg> = View.Image(Image.Bytes("k", [1, 2]));
    assert_same(image(Image.Bytes("k", [1, 2])), picture);
    let named: View<Msg> = View.Image(Image.Icon("list-add-symbolic"));
    assert_same(icon("list-add-symbolic"), named);
    let with_bytes: View<Msg> = View.Button("Add", Some(Msg.Add), Some(Image.Bytes("k", [1])));
    assert_same(button("Add", Msg.Add).image(Image.Bytes("k", [1])), with_bytes);
    let with_icon: View<Msg> = View.Button(
        "Add",
        Some(Msg.Add),
        Some(Image.Icon("list-add-symbolic")),
    );
    assert_same(button("Add", Msg.Add).icon("list-add-symbolic"), with_icon);
    // Through a style wrapper; disabling keeps the image.
    let sized: View<Msg> = View.Styled(View.Button("", None, Some(Image.Icon("x"))), Style {
        size: 48,
        ..plain(),
    });
    assert_same(button("", Msg.Add).size(48).icon("x").disabled(true), sized);
    // `.icon("")` takes the image away, as before.
    let bare: View<Msg> = View.Button("Add", Some(Msg.Add), None);
    assert_same(button("Add", Msg.Add).icon("x").icon(""), bare);
}

@test
fun wraps_are_plain_nodes_with_their_modifiers() {
    let positional: View<Msg> = View.Wrap([View.Text("a"), View.Text("b")]);
    assert_same(wrap([text("a"), text("b")]), positional);
    let keyed: View<Msg> = View.KeyedWrap([("a", View.Text("a"))]);
    assert_same(keyed_wrap([("a", text("a"))]), keyed);
    let grid: View<Msg> = View.Styled(View.Wrap([]), Style {
        equal: true,
        max_per_line: 6,
        spacing: 12,
        ..plain(),
    });
    assert_same(wrap([]).equal().max_per_line(6).spacing(12), grid);
    // No limit for n <= 0.
    let unlimited: View<Msg> = View.Styled(View.Wrap([]), Style { max_per_line: 0, ..plain() });
    assert_same(wrap([]).max_per_line(-3), unlimited);
}

@test
fun an_overlay_holds_a_base_and_layers_placed_by_style() {
    let plain_overlay: View<Msg> = View.Overlay(View.Text("page"), [View.Text("panel")]);
    assert_same(overlay(text("page"), [text("panel")]), plain_overlay);
    let placed: View<Msg> = View.Styled(View.Text("panel"), Style {
        place_across: Align.End,
        place_down: Align.Fill,
        ..plain(),
    });
    assert_same(text("panel").place(Align.End, Align.Fill), placed);
    // Without .place a layer covers the base.
    assert_eq((plain().place_across, plain().place_down), (Align.Fill, Align.Fill));
}
