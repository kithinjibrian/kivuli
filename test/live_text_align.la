// Text alignment on real labels (PRP-030): plain text starts at the start,
// `Text.center()` and `Text.end()` place it and its wrapped lines, a changed
// value lands on the same widget, and a native button's label keeps GTK's
// placement. Needs a display, so it is skipped without one.
import std.env;
import gtk {
    GtkApplication,
    GtkWidget,
    connect_app,
    emit_widget,
    g_application_quit,
    g_application_run,
    g_object_unref,
    gtk_application_new,
    gtk_application_window_new,
    gtk_label_get_justify,
    gtk_label_get_xalign,
    gtk_widget_get_halign,
    gtk_widget_get_parent,
};
import kivuli.render.live { mount, live_of };
import kivuli.core.effects { sandbox_app };
import kivuli.core.live_tree { Live, widget };
import kivuli { View, Text, button, column, text };

fun has_display(): bool = env.get("DISPLAY").is_some() || env.get("WAYLAND_DISPLAY").is_some();

fun note(seen: Ref<string[]>, s: string) {
    seen.update(fun(xs) {
        let mut ys = xs;
        ys.push(s);
        ys
    });
}

enum Flip {
    Flip,
}

/** Plain, centred, at the end; the third swaps to centred when flipped; a native button. */
fun view_align(n: i64): View<Flip> = column([
    text("plain"),
    text("centred").style([Text.center()]),
    text("end").style([if n == 0 { Text.end() } else { Text.center() }]),
    button("flip", Flip.Flip),
]);

/** A label's placement as `x justify`: x as tenths. */
fun placed(
    w: GtkWidget,
): string = "{((gtk_label_get_xalign(w) as f64) * 10.0 + 0.5) as i64} {gtk_label_get_justify(w)}";

@test
fun labels_take_their_alignment() {
    if !has_display() {
        skip("no display");
    }
    let seen: Ref<string[]> = Ref.new([]);
    let application = gtk_application_new("org.kivuli.test.text_align", 0);
    connect_app(
        application,
        "activate",
        fun(a: GtkApplication) {
            let window = gtk_application_window_new(a);
            let app = mount(
                a,
                window,
                sandbox_app("org.kivuli.test", 0, fun(n: i64, msg: Flip): i64 = n + 1, view_align),
            );
            let kids = fun(): Live<Flip>[] = match live_of(app) {
                Box(_, _, ks) => ks,
                _ => panic("expected a column"),
            };
            let end = widget(kids()[2]);
            note(
                seen,
                "plain {placed(widget(kids()[0]))} centred {placed(widget(kids()[1]))} end {placed(end)}",
            );
            emit_widget(widget(kids()[3]), "clicked");
            note(seen, "same {widget(kids()[2]) == end} now {placed(end)}");
            match kids()[3] {
                Button(_, _, _, _, label, _) => note(seen, "button label {placed(label)}"),
                _ => note(seen, "not a button"),
            }
            g_application_quit(a);
        },
        0,
    );
    g_application_run(application, 0, None);
    g_object_unref(application);
    // GtkJustification: 0 left, 1 right, 2 center.
    assert_eq(seen.get(), [
        "plain 0 0 centred 5 2 end 10 1",
        "same true now 5 2",
        "button label 5 0",
    ]);
}

/** A button's content's `GtkAlign` (1 start, 2 end, 3 center). */
fun content_align<M>(node: Live<M>): i64 = match node {
    Button(_, _, _, _, label, _) => match gtk_widget_get_parent(label) {
        Some(box) => gtk_widget_get_halign(box) as i64,
        None => -1,
    },
    _ => -2,
};

/** A plain button, one at the start, one whose end swaps to centred when flipped. */
fun view_buttons(n: i64): View<Flip> = column([
    button("plain", Flip.Flip),
    button("start", Flip.Flip).style([Text.start()]),
    button("end", Flip.Flip).style([if n == 0 { Text.end() } else { Text.center() }]),
]);

@test
fun a_buttons_text_alignment_places_its_content() {
    if !has_display() {
        skip("no display");
    }
    let seen: Ref<string[]> = Ref.new([]);
    let application = gtk_application_new("org.kivuli.test.button_align", 0);
    connect_app(
        application,
        "activate",
        fun(a: GtkApplication) {
            let window = gtk_application_window_new(a);
            let app = mount(
                a,
                window,
                sandbox_app(
                    "org.kivuli.test",
                    0,
                    fun(n: i64, msg: Flip): i64 = n + 1,
                    view_buttons,
                ),
            );
            let kids = fun(): Live<Flip>[] = match live_of(app) {
                Box(_, _, ks) => ks,
                _ => panic("expected a column"),
            };
            note(
                seen,
                "{content_align(kids()[0])} {content_align(kids()[1])} {content_align(kids()[2])}",
            );
            emit_widget(widget(kids()[0]), "clicked");
            note(seen, "now {content_align(kids()[2])}");
            g_application_quit(a);
        },
        0,
    );
    g_application_run(application, 0, None);
    g_object_unref(application);
    // GTK's centre by default; the style's start, end, then centre.
    assert_eq(seen.get(), ["3 1 2", "now 3"]);
}
