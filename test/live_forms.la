// Text fields and check boxes on real GTK widgets: what a user does reaches
// the model, and kivuli's own patches don't echo back as messages. Needs a
// display, so it is skipped without one.
import std.env;
import gtk {
    GtkApplication,
    GtkTextBuffer,
    GtkWidget,
    connect_app,
    connect_buffer,
    emit_widget,
    g_application_quit,
    g_application_run,
    g_object_unref,
    gtk_application_new,
    gtk_application_window_new,
    gtk_check_button_get_active,
    gtk_check_button_set_active,
    gtk_editable_get_text,
    gtk_editable_set_text,
    gtk_entry_get_placeholder_text,
    gtk_label_get_text,
    gtk_scrolled_window_get_child,
    gtk_text_buffer_set_text,
    gtk_text_view_get_wrap_mode,
    lgtk_text_cursor,
    lgtk_text_place_cursor,
};
import kivuli.live { dispatch, mount, live_of };
import kivuli.effects { sandbox_app };
import kivuli.build { text_of };
import kivuli.live_tree { Live, widget };
import kivuli { View, button, checkbox, column, input, text, text_area };

fun has_display(): bool = env.get("DISPLAY").is_some() || env.get("WAYLAND_DISPLAY").is_some();

// A check box as `[x] label` or `[ ] label`, read back from GTK (its label is kivuli's own child).
fun ticked(node: Live<Chore>): string {
    let Checkbox(w, label, _) = node else {
        panic("expected a check box");
    };
    let tick = if gtk_check_button_get_active(w) != 0 { "x" } else { " " };
    "[{tick}] " + gtk_label_get_text(label)
}

enum Form {
    Named(string),
    Clear,
}

struct Person {
    name: string,
}

fun update_person(p: Person, msg: Form): Person = match msg {
    Named(name) => Person { name: name },
    Clear => Person { name: "" },
};

fun view_person(p: Person): View<Form> = column([
    input(p.name, Form.Named),
    text("Hello, {p.name}"),
    button("Clear", Form.Clear),
]);

@test
fun typing_reaches_the_model_and_a_patch_does_not_echo() {
    if !has_display() {
        skip("no display");
    }
    let after_typing = Ref.new("");
    let after_clear = Ref.new("");
    // Every message `update` receives. An echo of a patch must not be one: it
    // would run a second dispatch inside the first, whose state the outer one
    // then overwrites, so the final model alone can't show it.
    let received: Ref<string[]> = Ref.new([]);
    let application = gtk_application_new("org.kivuli.test.input", 0);
    connect_app(
        application,
        "activate",
        fun(a: GtkApplication) {
            let window = gtk_application_window_new(a);
            let app = mount(a, window, sandbox_app(
                "org.kivuli.test",
                Person { name: "" },
                fun(p: Person, msg: Form): Person {
                    received.update(fun(xs) {
                        let mut ys = xs;
                        ys.push("{msg}");
                        ys
                    });
                    update_person(p, msg)
                },
                view_person,
            ));
            let first = live_of(app);
            let Box(_, _, kids) = first else {
                panic("expected a column");
            };
            // What a user typing "Ada" ends with: the entry's text changes, outside any dispatch.
            gtk_editable_set_text(widget(kids[0]), "Ada");
            after_typing.set(gtk_label_get_text(widget(kids[1])));
            // Clear empties the entry through a SetValue patch; its `changed` echo is dropped.
            emit_widget(widget(kids[2]), "clicked");
            after_clear.set(gtk_editable_get_text(widget(kids[0])));
            g_application_quit(a);
        },
        0,
    );
    g_application_run(application, 0, None);
    g_object_unref(application);

    assert_eq(after_typing.get(), "Hello, Ada");
    assert_eq(after_clear.get(), "");
    assert_eq(received.get(), ["Named(\"Ada\")", "Clear"]);
}

enum Chore {
    Done(bool),
    Reset,
}

struct Task {
    done: bool,
}

fun update_task(t: Task, msg: Chore): Task = match msg {
    Done(done) => Task { done: done },
    Reset => Task { done: false },
};

// The label follows the state, so ticking also relabels the box (SetLabel).
fun view_task(t: Task): View<Chore> = column([
    checkbox(if t.done { "Done!" } else { "Done" }, t.done, Chore.Done),
    button("Reset", Chore.Reset),
]);

@test
fun ticking_reaches_the_model_and_a_patch_does_not_echo() {
    if !has_display() {
        skip("no display");
    }
    let after_tick = Ref.new("");
    let after_reset = Ref.new("");
    // Every message `update` receives; see the input test for why.
    let received: Ref<string[]> = Ref.new([]);
    let application = gtk_application_new("org.kivuli.test.checkbox", 0);
    connect_app(
        application,
        "activate",
        fun(a: GtkApplication) {
            let window = gtk_application_window_new(a);
            let app = mount(a, window, sandbox_app(
                "org.kivuli.test",
                Task { done: false },
                fun(t: Task, msg: Chore): Task {
                    received.update(fun(xs) {
                        let mut ys = xs;
                        ys.push("{msg}");
                        ys
                    });
                    update_task(t, msg)
                },
                view_task,
            ));
            let first = live_of(app);
            let Box(_, _, kids) = first else {
                panic("expected a column");
            };
            // What a user's click ends with: the box becomes ticked, outside any dispatch.
            gtk_check_button_set_active(widget(kids[0]), 1);
            after_tick.set(ticked(kids[0]));
            // Reset unticks it through a SetChecked patch; its `toggled` echo is dropped.
            emit_widget(widget(kids[1]), "clicked");
            after_reset.set(ticked(kids[0]));
            g_application_quit(a);
        },
        0,
    );
    g_application_run(application, 0, None);
    g_object_unref(application);

    assert_eq(after_tick.get(), "[x] Done!");
    assert_eq(after_reset.get(), "[ ] Done");
    assert_eq(received.get(), ["Done(true)", "Reset"]);
}

enum Note {
    Typed(string),
    Send(i64),
}

struct Outbox {
    text: string,
    sent: i64,
}

fun update_outbox(o: Outbox, msg: Note): Outbox = match msg {
    Typed(t) => Outbox { text: t, ..o },
    Send(n) => Outbox { text: "", sent: n },
};

// Enter sends the next message number; the placeholder says how many went.
fun view_outbox(o: Outbox): View<Note> = column([
    input(o.text, Note.Typed).placeholder("{o.sent} sent").on_submit(Note.Send(o.sent + 1)),
]);

@test
fun enter_sends_the_current_message_and_the_placeholder_follows() {
    if !has_display() {
        skip("no display");
    }
    let seen: Ref<string[]> = Ref.new([]);
    let received: Ref<string[]> = Ref.new([]);
    let application = gtk_application_new("org.kivuli.test.submit", 0);
    connect_app(
        application,
        "activate",
        fun(a: GtkApplication) {
            let window = gtk_application_window_new(a);
            let app = mount(a, window, sandbox_app(
                "org.kivuli.test",
                Outbox { text: "", sent: 0 },
                fun(o: Outbox, msg: Note): Outbox {
                    received.update(fun(xs) {
                        let mut ys = xs;
                        ys.push("{msg}");
                        ys
                    });
                    update_outbox(o, msg)
                },
                view_outbox,
            ));
            let Box(_, _, kids) = live_of(app) else {
                panic("expected a column");
            };
            let entry = widget(kids[0]);
            let note = fun() {
                let hint = gtk_entry_get_placeholder_text(entry).unwrap_or("none");
                seen.update(fun(xs) {
                    let mut ys = xs;
                    ys.push(hint);
                    ys
                });
            };
            note();
            emit_widget(entry, "activate");
            note();
            emit_widget(entry, "activate");
            note();
            g_application_quit(a);
        },
        0,
    );
    g_application_run(application, 0, None);
    g_object_unref(application);

    assert_eq(seen.get(), ["0 sent", "1 sent", "2 sent"]);
    // The second Enter sends 2: the handler was re-pointed (SetOnSubmit), not left at 1.
    assert_eq(received.get(), ["Send(1)", "Send(2)"]);
}

enum Edit {
    Typed(string),
    Set(string),
}

struct Notes {
    text: string,
}

fun update_notes(n: Notes, msg: Edit): Notes = match msg {
    Typed(t) => Notes { text: t },
    Set(t) => Notes { text: t },
};

fun view_notes(n: Notes): View<Edit> = column([text_area(n.text, Edit.Typed).name("notes")]);

@test
fun a_text_area_sends_edits_keeps_its_cursor_and_does_not_echo() {
    if !has_display() {
        skip("no display");
    }
    let seen: Ref<string[]> = Ref.new([]);
    let received: Ref<string[]> = Ref.new([]);
    let note = fun(s: string) {
        seen.update(fun(xs) {
            let mut ys = xs;
            ys.push(s);
            ys
        });
    };
    let application = gtk_application_new("org.kivuli.test.textarea", 0);
    connect_app(
        application,
        "activate",
        fun(a: GtkApplication) {
            let window = gtk_application_window_new(a);
            let app = mount(a, window, sandbox_app(
                "org.kivuli.test",
                Notes { text: "" },
                fun(n: Notes, msg: Edit): Notes {
                    received.update(fun(xs) {
                        let mut ys = xs;
                        ys.push("{msg}");
                        ys
                    });
                    update_notes(n, msg)
                },
                view_notes,
            ));
            let Box(_, _, kids) = live_of(app) else {
                panic("expected a column");
            };
            let TextArea(scrolled, buffer, _) = kids[0] else {
                panic("expected a text area");
            };
            // Every `changed` the buffer fires, kivuli's own included.
            let changes = Ref.new(0);
            connect_buffer(
                buffer,
                "changed",
                fun(b: GtkTextBuffer) {
                    changes.update(fun(c) = c + 1);
                },
                0,
            );
            let wrap = match gtk_scrolled_window_get_child(scrolled) {
                Some(view) => gtk_text_view_get_wrap_mode(view),
                None => -1,
            };
            note("wrap {wrap}");
            // What a user typing ends with: the buffer changes outside any dispatch.
            gtk_text_buffer_set_text(buffer, "hello world", -1);
            note("typed: {text_of(buffer)}, changes {changes.get()}");
            // The update that followed asked for the text already shown: no rewrite,
            // so no second `changed`.
            lgtk_text_place_cursor(buffer, 8);
            dispatch(app, Edit.Set("hello world"));
            note("same text: cursor {lgtk_text_cursor(buffer)}, changes {changes.get()}");
            // The model shortens the text: the cursor is clamped to its end.
            dispatch(app, Edit.Set("hi"));
            note("shorter: {text_of(buffer)}, cursor {lgtk_text_cursor(buffer)}");
            // The model lengthens it: the cursor keeps its offset.
            lgtk_text_place_cursor(buffer, 1);
            dispatch(app, Edit.Set("hi there, friend"));
            note("longer: {text_of(buffer)}, cursor {lgtk_text_cursor(buffer)}");
            g_application_quit(a);
        },
        0,
    );
    g_application_run(application, 0, None);
    g_object_unref(application);

    assert_eq(seen.get(), [
        "wrap 3",
        "typed: hello world, changes 1",
        "same text: cursor 8, changes 1",
        "shorter: hi, cursor 2",
        "longer: hi there, friend, cursor 1",
    ]);
    // The model's changes sent no echo: only the typing and the app's own messages.
    assert_eq(received.get(), [
        "Typed(\"hello world\")",
        "Set(\"hello world\")",
        "Set(\"hi\")",
        "Set(\"hi there, friend\")",
    ]);
}
