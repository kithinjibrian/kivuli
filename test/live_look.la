// App looks and the header bar on real GTK widgets: the theme's stylesheet
// reaches the display, a node's looks come and go as classes (GTK's own
// classes kept), and a header bar is the window's titlebar, its parts
// patched in place and its buttons sending messages. Needs a display, so it
// is skipped without one. Maximizing and an expanding title widget need a
// window on screen: those are checked by hand (examples/frame.la).
import std.env;
import gtk {
    GtkApplication,
    GtkWidget,
    connect_app,
    emit_widget,
    g_application_quit,
    g_application_run,
    g_object_unref,
    gtk_application_new,
    gtk_application_window_new,
    gtk_header_bar_get_show_title_buttons,
    gtk_header_bar_get_title_widget,
    gtk_widget_get_overflow,
    gtk_widget_has_css_class,
    gtk_window_get_titlebar,
    lgtk_widget_rgba,
};
import kivuli.live { mount, live_of };
import kivuli.effects { sandbox_app };
import kivuli.live_tree { Live, widget };
import kivuli { ButtonStyle, Surface, View, button, column, hex, input, text, theme };

fun has_display(): bool = env.get("DISPLAY").is_some() || env.get("WAYLAND_DISPLAY").is_some();

/** Runs `steps` on the mounted app's window and root, noting every message `update` receives. */
fun with_app<Model, Msg>(
    id: string,
    model: Model,
    update: fun(Model, Msg): Model,
    view: fun(Model): View<Msg>,
    received: Ref<string[]>,
    steps: fun(GtkWidget, fun(): Live<Msg>),
) {
    let application = gtk_application_new(id, 0);
    connect_app(
        application,
        "activate",
        fun(a: GtkApplication) {
            let window = gtk_application_window_new(a);
            let app = mount(a, window, sandbox_app(
                "org.kivuli.test",
                model,
                fun(m: Model, msg: Msg): Model {
                    received.update(fun(xs) {
                        let mut ys = xs;
                        ys.push("{msg}");
                        ys
                    });
                    update(m, msg)
                },
                view,
            ));
            steps(window, fun(): Live<Msg> = live_of(app));
            g_application_quit(a);
        },
        0,
    );
    g_application_run(application, 0, None);
    g_object_unref(application);
}

fun note(seen: Ref<string[]>, s: string) {
    seen.update(fun(xs) {
        let mut ys = xs;
        ys.push(s);
        ys
    });
}

enum Look {
    Bar,
    Red,
}

fun surface(l: Look): Surface = match l {
    Bar => Surface { background: Some(hex("#242424")), ..Surface.theme() },
    Red => Surface { text: Some(hex("#ff0000")), ..Surface.theme() },
};

enum Paint {
    Toggle,
}

fun view_painted(on: bool): View<Paint> = column([
    text("words").style(if on { [Look.Red] } else { [] }),
    button("Toggle", Paint.Toggle).button_style(ButtonStyle.Primary).style(
        if on { [Look.Bar] } else { [] },
    ),
]).theme(theme([Look.Bar, Look.Red], surface));

/** A widget's colour and classes, as far as looks go. */
fun painted_state(label: GtkWidget, toggle: GtkWidget): string {
    let red = lgtk_widget_rgba(label) == 4278190335;
    "red text {red} | button kv-bg {gtk_widget_has_css_class(toggle, "kv-bg-242424ff")} suggested {gtk_widget_has_css_class(toggle, "suggested-action")}"
}

@test
fun looks_reach_the_widgets_and_come_and_go_as_classes() {
    if !has_display() {
        skip("no display");
    }
    let seen: Ref<string[]> = Ref.new([]);
    let received: Ref<string[]> = Ref.new([]);
    with_app("org.kivuli.test.looks", true, fun(
        on: bool,
        msg: Paint,
    ): bool = !on, view_painted, received, fun(window: GtkWidget, root: fun(): Live<Paint>) {
        let Box(_, _, kids) = root() else {
            panic("expected a column");
        };
        let label = widget(kids[0]);
        let toggle = widget(kids[1]);
        // The theme's stylesheet is on the display: the Red look colours the text.
        note(seen, painted_state(label, toggle));
        emit_widget(toggle, "clicked");
        note(seen, painted_state(label, toggle));
        emit_widget(toggle, "clicked");
        note(seen, painted_state(label, toggle));
    });
    assert_eq(seen.get(), [
        "red text true | button kv-bg 1 suggested 1",
        "red text false | button kv-bg 0 suggested 1",
        "red text true | button kv-bg 1 suggested 1",
    ]);
    assert_eq(received.get(), ["Toggle", "Toggle"]);
}

enum Nav {
    Back,
    Typed(string),
    More,
}

struct Browser {
    address: string,
    extra: bool,
}

fun update_browser(b: Browser, msg: Nav): Browser = match msg {
    Back => b,
    Typed(s) => Browser { address: s, ..b },
    More => Browser { extra: !b.extra, ..b },
};

fun view_browser(b: Browser): View<Nav> {
    let mut end = [button("More", Nav.More)];
    if b.extra {
        end.push(button("Extra", Nav.More));
    }
    column([text("page {b.address}")]).header(
        [button("Back", Nav.Back)],
        input(b.address, Nav.Typed).expand(),
        end,
    )
}

/** The header as the live tree holds it: its start and end widgets' counts, and the title widget. */
fun header_of(window: GtkWidget, root: Live<Nav>): string {
    let Framed(bar, _, title, Pack(_, _, start), Pack(_, _, end)) = root else {
        panic("expected a header");
    };
    let is_titlebar = gtk_window_get_titlebar(window) == Some(bar);
    let is_title = gtk_header_bar_get_title_widget(bar) == Some(widget(title));
    "titlebar {is_titlebar} buttons {gtk_header_bar_get_show_title_buttons(bar)} title {is_title} start {start.len} end {end.len}"
}

@test
fun a_header_bar_is_the_titlebar_and_its_parts_follow_the_model() {
    if !has_display() {
        skip("no display");
    }
    let seen: Ref<string[]> = Ref.new([]);
    let received: Ref<string[]> = Ref.new([]);
    with_app("org.kivuli.test.header", Browser {
        address: "home",
        extra: false,
    }, update_browser, view_browser, received, fun(window: GtkWidget, root: fun(): Live<Nav>) {
        note(seen, header_of(window, root()));
        let Framed(_, _, title, Pack(_, _, start), Pack(_, _, end)) = root() else {
            panic("expected a header");
        };
        let address = widget(title);
        // A click in the bar sends its message.
        emit_widget(widget(start[0]), "clicked");
        // More adds an end button (Append), then removes it (Remove).
        emit_widget(widget(end[0]), "clicked");
        note(seen, header_of(window, root()));
        emit_widget(widget(end[0]), "clicked");
        note(seen, header_of(window, root()));
        let Framed(_, _, after, _, _) = root() else {
            panic("expected a header");
        };
        note(seen, "same title widget: {widget(after) == address}");
    });
    assert_eq(seen.get(), [
        "titlebar true buttons 1 title true start 1 end 1",
        "titlebar true buttons 1 title true start 1 end 2",
        "titlebar true buttons 1 title true start 1 end 1",
        "same title widget: true",
    ]);
    assert_eq(received.get(), ["Back", "More", "More"]);
}

enum Head {
    Toggle,
}

fun view_head(on: bool): View<Head> = column([text("page")]).theme(
    theme([Look.Bar, Look.Red], surface),
).header([button("Toggle", Head.Toggle)], text("Title"), []).header_style(
    if on { [Look.Bar, Look.Red] } else { [] },
);

/** The bar's classes and text colour, as far as its looks go. */
fun bar_state(bar: GtkWidget): string {
    let red = lgtk_widget_rgba(bar) == 4278190335;
    "kv-bg {gtk_widget_has_css_class(bar, "kv-bg-242424ff")} kv-fg {gtk_widget_has_css_class(bar, "kv-fg-ff0000ff")} red {red} titlebar {gtk_widget_has_css_class(bar, "titlebar")}"
}

@test
fun the_header_bar_takes_its_looks_and_the_apps_css_wins_there() {
    if !has_display() {
        skip("no display");
    }
    let seen: Ref<string[]> = Ref.new([]);
    let received: Ref<string[]> = Ref.new([]);
    with_app("org.kivuli.test.header_look", true, fun(
        on: bool,
        msg: Head,
    ): bool = !on, view_head, received, fun(window: GtkWidget, root: fun(): Live<Head>) {
        let Framed(bar, _, _, Pack(_, _, start), _) = root() else {
            panic("expected a header");
        };
        note(seen, bar_state(bar));
        emit_widget(widget(start[0]), "clicked");
        note(seen, bar_state(bar));
        emit_widget(widget(start[0]), "clicked");
        note(seen, bar_state(bar));
    });
    assert_eq(seen.get(), [
        "kv-bg 1 kv-fg 1 red true titlebar 1",
        "kv-bg 0 kv-fg 0 red false titlebar 1",
        "kv-bg 1 kv-fg 1 red true titlebar 1",
    ]);
    assert_eq(received.get(), ["Toggle", "Toggle"]);
}

enum Shape {
    Page,
}

enum Round {
    Toggle,
}

fun view_round(on: bool): View<Round> = column([
    column([text("page")]).style(if on { [Shape.Page] } else { [] }),
    button("Toggle", Round.Toggle),
]).theme(
    theme(
        [Shape.Page],
        fun(s: Shape) = Surface {
            background: Some(hex("#161616")),
            radius_top_right: Some(12),
            ..Surface.theme(),
        },
    ),
);

/** A node's corner class and whether it clips its content. */
fun round_state(
    page: GtkWidget,
): string = "tr {gtk_widget_has_css_class(page, "kv-radius-tr-12")} all {gtk_widget_has_css_class(page, "kv-radius-12")} overflow {gtk_widget_get_overflow(page)}";

@test
fun a_rounded_corner_lands_and_clips_the_content() {
    if !has_display() {
        skip("no display");
    }
    let seen: Ref<string[]> = Ref.new([]);
    let received: Ref<string[]> = Ref.new([]);
    with_app("org.kivuli.test.corner", true, fun(
        on: bool,
        msg: Round,
    ): bool = !on, view_round, received, fun(window: GtkWidget, root: fun(): Live<Round>) {
        let Box(_, _, kids) = root() else {
            panic("expected a column");
        };
        let page = widget(kids[0]);
        note(seen, round_state(page));
        emit_widget(widget(kids[1]), "clicked");
        note(seen, round_state(page));
        emit_widget(widget(kids[1]), "clicked");
        note(seen, round_state(page));
        let Box(_, _, again) = root() else {
            panic("expected a column");
        };
        note(seen, "same: {widget(again[0]) == page}");
    });
    assert_eq(seen.get(), [
        "tr 1 all 0 overflow 1",
        "tr 0 all 0 overflow 0",
        "tr 1 all 0 overflow 1",
        "same: true",
    ]);
    assert_eq(received.get(), ["Toggle", "Toggle"]);
}
