// The native progress bar on a real GtkProgressBar (PRP-045): built at its
// fraction, an update moves it on the same widget, and a value past either
// end shows full or empty. Needs a display, so it is skipped without one.
import std.env;
import gtk {
    GtkApplication,
    connect_app,
    emit_widget,
    g_application_quit,
    g_application_run,
    g_object_unref,
    gtk_application_new,
    gtk_application_window_new,
    gtk_progress_bar_get_fraction,
};
import kivuli.render.live { mount, live_of };
import kivuli.core.effects { sandbox_app };
import kivuli.core.live_tree { Live, widget };
import kivuli { View, button, column, progress };

fun has_display(): bool = env.get("DISPLAY").is_some() || env.get("WAYLAND_DISPLAY").is_some();

fun note(seen: Ref<string[]>, s: string) {
    seen.update(fun(xs) {
        let mut ys = xs;
        ys.push(s);
        ys
    });
}

/** 30, then 80, then 150 (past the end), then -20: one click each. */
fun view_bar(step: i64): View<i64> = column([
    progress(if step == 0 { 30 } else if step == 1 { 80 } else if step == 2 { 150 } else { -20 }),
    button("Next", 1),
]);

@test
fun a_progress_bar_shows_its_value_and_moves_on_the_same_widget() {
    if !has_display() {
        skip("no display");
    }
    let seen: Ref<string[]> = Ref.new([]);
    let application = gtk_application_new("org.kivuli.test.progress", 0);
    connect_app(
        application,
        "activate",
        fun(a: GtkApplication) {
            let window = gtk_application_window_new(a);
            let app = mount(
                a,
                window,
                sandbox_app("org.kivuli.test", 0, fun(n: i64, msg: i64): i64 = n + msg, view_bar),
            );
            let kids = fun(): Live<i64>[] = match live_of(app) {
                Box(_, _, ks) => ks,
                _ => panic("expected a column"),
            };
            let bar = widget(kids()[0]);
            let shown = fun(): string = "{((gtk_progress_bar_get_fraction(widget(kids()[0])) * 100.0) + 0.5) as i64}";
            note(seen, "starts {shown()}");
            emit_widget(widget(kids()[1]), "clicked");
            note(seen, "same {widget(kids()[0]) == bar} {shown()}");
            emit_widget(widget(kids()[1]), "clicked");
            note(seen, "past the end {shown()}");
            emit_widget(widget(kids()[1]), "clicked");
            note(seen, "below zero {shown()}");
            g_application_quit(a);
        },
        0,
    );
    g_application_run(application, 0, None);
    g_object_unref(application);
    assert_eq(seen.get(), ["starts 30", "same true 80", "past the end 100", "below zero 0"]);
}
