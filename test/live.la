// Patching real GTK widgets: a hidden window goes through a run of messages,
// and after each one the widgets are read back from GTK. Needs a display, so
// it is skipped without one.
import std.env;
import gtk {
    GtkApplication,
    GtkWidget,
    connect_app,
    emit_widget,
    g_application_quit,
    g_application_run,
    g_object_unref,
    gtk_application_new,
    gtk_application_window_new,
    gtk_button_get_label,
    gtk_check_button_get_active,
    gtk_editable_get_text,
    gtk_label_get_text,
    gtk_orientable_get_orientation,
    gtk_widget_get_first_child,
    gtk_widget_get_next_sibling,
    gtk_widget_get_vexpand,
};
import kivuli.live { dispatch, mount, live_of };
import kivuli.effects { sandbox_app };
import kivuli.live_tree { Live, widget };
import kivuli { View, button, column, keyed_column, row, scroll, separator, spacer, text };

enum Msg {
    Add,
    More,
    Fewer,
}

struct Model {
    count: i64,
    rows: i64,
}

fun update(m: Model, msg: Msg): Model = match msg {
    Add => Model { count: m.count + 1, ..m },
    More => Model { rows: m.rows + 1, ..m },
    Fewer => Model { rows: m.rows - 1, ..m },
};

// Every patch kind shows up: the label's text changes (SetText), rows come
// and go (Append, Remove), and the last child turns from text into a button
// and back (Replace).
fun view(m: Model): View<Msg> {
    let mut kids: View<Msg>[] = [
        View.Text("Clicked {m.count} times"),
        View.Button("Add", Some(Msg.Add)),
    ];
    let mut i = 0;
    while i < m.rows {
        kids.push(View.Text("row {i}"));
        i = i + 1;
    }
    kids.push(if m.count == 2 { View.Button("two!", Some(Msg.Add)) } else { View.Text("not two") });
    View.Column(kids)
}

// What GTK shows, read back from the widgets themselves; buttons in brackets.
fun shown<M>(node: Live<M>): string = match node {
    Label(w) => gtk_label_get_text(w),
    Button(w, _, _, _) => "[" + gtk_button_get_label(w).unwrap_or("?") + "]",
    Input(w, _, _) => "<" + gtk_editable_get_text(w) + ">",
    TextArea(_, _, _) => "<area>",
    Checkbox(w, label, _) => {
        let tick = if gtk_check_button_get_active(w) != 0 { "x" } else { " " };
        "[{tick}] " + gtk_label_get_text(label)
    }
    Spacer(w) => {
        let grows = if gtk_widget_get_vexpand(w) != 0 { "v" } else { "h" };
        "~{grows}"
    }
    Separator(w) => if gtk_orientable_get_orientation(w) == 0 { "-" } else { "|" },
    // Shown in full by test/live_choices.la.
    Dropdown(_, _) => "<choices>",
    Slider(_, _, _, _) => "<slider>",
    Scroll(_, kid) => "scroll(" + shown(kid) + ")",
    Box(_, _, kids) => {
        let mut out = "";
        for k of kids {
            out = out + shown(k) + " | ";
        }
        out
    }
};

fun has_display(): bool = env.get("DISPLAY").is_some() || env.get("WAYLAND_DISPLAY").is_some();

@test
fun messages_patch_the_same_widgets() {
    if !has_display() {
        skip("no display");
    }
    let seen: Ref<string[]> = Ref.new([]);
    let same_root = Ref.new(false);
    let application = gtk_application_new("org.kivuli.test.live", 0);
    connect_app(
        application,
        "activate",
        fun(a: GtkApplication) {
            let window = gtk_application_window_new(a);
            let app = mount(
                a,
                window,
                sandbox_app("org.kivuli.test", Model { count: 0, rows: 0 }, update, view),
            );
            let first = live_of(app);
            for msg of [Msg.Add, Msg.More, Msg.More, Msg.Add, Msg.Fewer, Msg.Add] {
                dispatch(app, msg);
                let Some(s) = app.state.get() else {
                    panic("no state after a message");
                };
                seen.update(fun(xs) {
                    let mut ys = xs;
                    ys.push(shown(s.live));
                    ys
                });
            }
            // A real press of the real Add button: its handler, connected once
            // when the button was made, sends the message it holds in its Ref.
            let Some(before) = app.state.get() else {
                panic("no state before the press");
            };
            match before.live {
                Box(_, _, kids) => emit_widget(widget(kids[1]), "clicked"),
                _ => panic("expected a column"),
            }
            let Some(s) = app.state.get() else {
                panic("no state at the end");
            };
            seen.update(fun(xs) {
                let mut ys = xs;
                ys.push(shown(s.live));
                ys
            });
            // Patched, never rebuilt: the column on screen is the one made first.
            same_root.set(widget(s.live) == widget(first));
            g_application_quit(a);
        },
        0,
    );
    g_application_run(application, 0, None);
    g_object_unref(application);

    let expected = [
        "Clicked 1 times | [Add] | not two | ",
        "Clicked 1 times | [Add] | row 0 | not two | ",
        "Clicked 1 times | [Add] | row 0 | row 1 | not two | ",
        "Clicked 2 times | [Add] | row 0 | row 1 | [two!] | ",
        "Clicked 2 times | [Add] | row 0 | [two!] | ",
        "Clicked 3 times | [Add] | row 0 | not two | ",
        "Clicked 4 times | [Add] | row 0 | not two | ",
    ];
    assert_eq(seen.get(), expected);
    assert(same_root.get());
}

enum Pane {
    More,
    Swap,
}

struct Panel {
    rows: i64,
    swapped: bool,
}

fun update_panel(p: Panel, msg: Pane): Panel = match msg {
    More => Panel { rows: p.rows + 1, ..p },
    Swap => Panel { swapped: !p.swapped, ..p },
};

// Separators and spacers in both directions, and a scroll whose child grows
// (Append inside it) and then changes kind (Replace of its one child).
fun view_panel(p: Panel): View<Pane> {
    let mut rows: View<Pane>[] = [];
    let mut i = 0;
    while i < p.rows {
        rows.push(text("row {i}"));
        i = i + 1;
    }
    let inside = if p.swapped { button("back", Pane.Swap) } else { column(rows) };
    column([
        text("top"),
        separator(),
        row([text("L"), spacer(), separator(), text("R")]),
        scroll(inside),
        spacer(),
    ])
}

@test
fun separators_spacers_and_scrolls_follow_their_parent_and_patch() {
    if !has_display() {
        skip("no display");
    }
    let seen: Ref<string[]> = Ref.new([]);
    let application = gtk_application_new("org.kivuli.test.layout", 0);
    connect_app(
        application,
        "activate",
        fun(a: GtkApplication) {
            let window = gtk_application_window_new(a);
            let app = mount(
                a,
                window,
                sandbox_app(
                    "org.kivuli.test",
                    Panel { rows: 1, swapped: false },
                    update_panel,
                    view_panel,
                ),
            );
            let first = live_of(app);
            seen.update(fun(xs) {
                let mut ys = xs;
                ys.push(shown(first));
                ys
            });
            for msg of [Pane.More, Pane.Swap] {
                dispatch(app, msg);
                let Some(s) = app.state.get() else {
                    panic("no state after a message");
                };
                seen.update(fun(xs) {
                    let mut ys = xs;
                    ys.push(shown(s.live));
                    ys
                });
            }
            g_application_quit(a);
        },
        0,
    );
    g_application_run(application, 0, None);
    g_object_unref(application);

    // `-` a horizontal separator, `|` a vertical one; `~v` a spacer growing
    // down, `~h` one growing across.
    assert_eq(seen.get(), [
        "top | - | L | ~h | | | R |  | scroll(row 0 | ) | ~v | ",
        "top | - | L | ~h | | | R |  | scroll(row 0 | row 1 | ) | ~v | ",
        "top | - | L | ~h | | | R |  | scroll([back]) | ~v | ",
    ]);
}

enum Edit {
    Show(string[]),
}

struct Rows {
    keys: string[],
}

fun update_rows(r: Rows, msg: Edit): Rows = match msg {
    Show(keys) => Rows { keys: keys },
};

fun view_rows(r: Rows): View<Edit> {
    let mut rows: (string, View<Edit>)[] = [];
    for k of r.keys {
        rows.push((k, text(k)));
    }
    keyed_column(rows)
}

// The labels `box` shows, in the order GTK lays them out: read from GTK,
// not from kivuli's own record of the children.
fun on_screen(box: GtkWidget): string {
    let mut out: string[] = [];
    let mut here = gtk_widget_get_first_child(box);
    while here.is_some() {
        let w = here.unwrap();
        out.push(gtk_label_get_text(w));
        here = gtk_widget_get_next_sibling(w);
    }
    "{out}"
}

@test
fun keyed_rows_move_insert_and_go_as_whole_widgets() {
    if !has_display() {
        skip("no display");
    }
    let seen: Ref<string[]> = Ref.new([]);
    let same_c = Ref.new(false);
    let application = gtk_application_new("org.kivuli.test.keyed", 0);
    connect_app(
        application,
        "activate",
        fun(a: GtkApplication) {
            let window = gtk_application_window_new(a);
            let app = mount(
                a,
                window,
                sandbox_app(
                    "org.kivuli.test",
                    Rows { keys: ["a", "b", "c", "d"] },
                    update_rows,
                    view_rows,
                ),
            );
            let first = live_of(app);
            let Box(box, _, kids) = first else {
                panic("expected a box");
            };
            let c = widget(kids[2]);
            let steps: string[][] = [
                ["c", "a", "b", "d"],
                ["c", "a", "d"],
                ["x", "c", "a", "d"],
                ["d", "a", "c", "x"],
            ];
            for keys of steps {
                dispatch(app, Edit.Show(keys));
                seen.update(fun(xs) {
                    let mut ys = xs;
                    ys.push(on_screen(box));
                    ys
                });
            }
            // After a move, a delete, an insert and a reversal, row "c" is
            // still the widget it was made as.
            let Some(s) = app.state.get() else {
                panic("no state at the end");
            };
            let Box(_, _, now) = s.live else {
                panic("expected a box");
            };
            same_c.set(widget(now[2]) == c);
            g_application_quit(a);
        },
        0,
    );
    g_application_run(application, 0, None);
    g_object_unref(application);

    assert_eq(seen.get(), [
        "[\"c\", \"a\", \"b\", \"d\"]",
        "[\"c\", \"a\", \"d\"]",
        "[\"x\", \"c\", \"a\", \"d\"]",
        "[\"d\", \"a\", \"c\", \"x\"]",
    ]);
    assert(same_c.get());
}
