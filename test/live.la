// Patching real GTK widgets: a hidden window goes through a run of messages,
// and after each one the widgets are read back from GTK. Needs a display, so
// it is skipped without one.
import std.env;
import gtk;
import kivuli.live { Live, Running, State, create, dispatch, sender, widget };
import kivuli { View, button, checkbox, column, input, text };

enum Msg {
    Add,
    More,
    Fewer,
}

struct Model {
    count: i64,
    rows: i64,
}

fun update(m: Model, msg: Msg): Model = match msg {
    Add => Model { count: m.count + 1, ..m },
    More => Model { rows: m.rows + 1, ..m },
    Fewer => Model { rows: m.rows - 1, ..m },
};

// Every patch kind shows up: the label's text changes (SetText), rows come
// and go (Append, Remove), and the last child turns from text into a button
// and back (Replace).
fun view(m: Model): View<Msg> {
    let mut kids: View<Msg>[] = [View.Text("Clicked {m.count} times"), View.Button("Add", Msg.Add)];
    let mut i = 0;
    while i < m.rows {
        kids.push(View.Text("row {i}"));
        i = i + 1;
    }
    kids.push(if m.count == 2 {
        View.Button("two!", Msg.Add)
    } else {
        View.Text("not two")
    });
    View.Column(kids)
}

// What GTK shows, read back from the widgets themselves; buttons in brackets.
fun shown<M>(node: Live<M>): string = match node {
    Label(w) => gtk.raw.gtk_label_get_text(w),
    Button(w, _) => "[" + gtk.raw.gtk_button_get_label(w).unwrap_or("?") + "]",
    Input(w, _) => "<" + gtk.raw.gtk_editable_get_text(w) + ">",
    Checkbox(w, _) => {
        let tick = if gtk.raw.gtk_check_button_get_active(w) != 0 {
            "x"
        } else {
            " "
        };
        "[{tick}] " + gtk.raw.gtk_check_button_get_label(w).unwrap_or("?")
    }
    Box(_, kids) => {
        let mut out = "";
        for k of kids {
            out = out + shown(k) + " | ";
        }
        out
    }
};

fun has_display(): bool = env.get("DISPLAY").is_some() || env.get("WAYLAND_DISPLAY").is_some();

@test
fun messages_patch_the_same_widgets() {
    if !has_display() {
        skip("no display");
    }
    let seen: Ref<string[]> = Ref.new([]);
    let same_root = Ref.new(false);
    let application = gtk.raw.gtk_application_new("org.kivuli.test.live", 0);
    gtk.raw.connect_app(
        application,
        "activate",
        fun(a: gtk.raw.GtkApplication) {
            let window = gtk.raw.gtk_application_window_new(a);
            let state: Ref<Option<State<Model, Msg>>> = Ref.new(None);
            let app = Running {
                window: window,
                update_fn: update,
                view_fn: view,
                state: state,
                patching: Ref.new(false),
            };
            let init = Model { count: 0, rows: 0 };
            let tree = view(init);
            let first = create(tree, sender(app));
            gtk.raw.gtk_window_set_child(window, widget(first));
            state.set(Some(State { model: init, tree: tree, live: first }));
            for msg of [Msg.Add, Msg.More, Msg.More, Msg.Add, Msg.Fewer, Msg.Add] {
                dispatch(app, msg);
                let Some(s) = state.get() else {
                    panic("no state after a message");
                };
                seen.update(fun(xs) {
                    let mut ys = xs;
                    ys.push(shown(s.live));
                    ys
                });
            }
            // A real press of the real Add button: its handler, connected once
            // when the button was made, sends the message it holds in its Ref.
            let Some(before) = state.get() else {
                panic("no state before the press");
            };
            match before.live {
                Box(_, kids) => gtk.raw.emit_widget(widget(kids[1]), "clicked"),
                _ => panic("expected a column"),
            }
            let Some(s) = state.get() else {
                panic("no state at the end");
            };
            seen.update(fun(xs) {
                let mut ys = xs;
                ys.push(shown(s.live));
                ys
            });
            // Patched, never rebuilt: the column on screen is the one made first.
            same_root.set(widget(s.live) == widget(first));
            gtk.raw.g_application_quit(a);
        },
        0,
    );
    gtk.raw.g_application_run(application, 0, None);
    gtk.raw.g_object_unref(application);

    let expected = [
        "Clicked 1 times | [Add] | not two | ",
        "Clicked 1 times | [Add] | row 0 | not two | ",
        "Clicked 1 times | [Add] | row 0 | row 1 | not two | ",
        "Clicked 2 times | [Add] | row 0 | row 1 | [two!] | ",
        "Clicked 2 times | [Add] | row 0 | [two!] | ",
        "Clicked 3 times | [Add] | row 0 | not two | ",
        "Clicked 4 times | [Add] | row 0 | not two | ",
    ];
    assert_eq(seen.get(), expected);
    assert(same_root.get());
}

enum Form {
    Named(string),
    Clear,
}

struct Person {
    name: string,
}

fun update_person(p: Person, msg: Form): Person = match msg {
    Named(name) => Person { name: name },
    Clear => Person { name: "" },
};

fun view_person(p: Person): View<Form> = column([
    input(p.name, Form.Named),
    text("Hello, {p.name}"),
    button("Clear", Form.Clear),
]);

@test
fun typing_reaches_the_model_and_a_patch_does_not_echo() {
    if !has_display() {
        skip("no display");
    }
    let after_typing = Ref.new("");
    let after_clear = Ref.new("");
    // Every message `update` receives. An echo of a patch must not be one: it
    // would run a second dispatch inside the first, whose state the outer one
    // then overwrites, so the final model alone can't show it.
    let received: Ref<string[]> = Ref.new([]);
    let application = gtk.raw.gtk_application_new("org.kivuli.test.input", 0);
    gtk.raw.connect_app(
        application,
        "activate",
        fun(a: gtk.raw.GtkApplication) {
            let window = gtk.raw.gtk_application_window_new(a);
            let state: Ref<Option<State<Person, Form>>> = Ref.new(None);
            let app = Running {
                window: window,
                update_fn: fun(p: Person, msg: Form): Person {
                    received.update(fun(xs) {
                        let mut ys = xs;
                        ys.push("{msg}");
                        ys
                    });
                    update_person(p, msg)
                },
                view_fn: view_person,
                state: state,
                patching: Ref.new(false),
            };
            let init = Person { name: "" };
            let tree = view_person(init);
            let first = create(tree, sender(app));
            gtk.raw.gtk_window_set_child(window, widget(first));
            state.set(Some(State { model: init, tree: tree, live: first }));
            let Box(_, kids) = first else {
                panic("expected a column");
            };
            // What a user typing "Ada" ends with: the entry's text changes, outside any dispatch.
            gtk.raw.gtk_editable_set_text(widget(kids[0]), "Ada");
            after_typing.set(gtk.raw.gtk_label_get_text(widget(kids[1])));
            // Clear empties the entry through a SetValue patch; its `changed` echo is dropped.
            gtk.raw.emit_widget(widget(kids[2]), "clicked");
            after_clear.set(gtk.raw.gtk_editable_get_text(widget(kids[0])));
            gtk.raw.g_application_quit(a);
        },
        0,
    );
    gtk.raw.g_application_run(application, 0, None);
    gtk.raw.g_object_unref(application);

    assert_eq(after_typing.get(), "Hello, Ada");
    assert_eq(after_clear.get(), "");
    assert_eq(received.get(), ["Named(\"Ada\")", "Clear"]);
}

enum Chore {
    Done(bool),
    Reset,
}

struct Task {
    done: bool,
}

fun update_task(t: Task, msg: Chore): Task = match msg {
    Done(done) => Task { done: done },
    Reset => Task { done: false },
};

// The label follows the state, so ticking also relabels the box (SetLabel).
fun view_task(t: Task): View<Chore> = column([
    checkbox(
        if t.done {
            "Done!"
        } else {
            "Done"
        },
        t.done,
        Chore.Done,
    ),
    button("Reset", Chore.Reset),
]);

@test
fun ticking_reaches_the_model_and_a_patch_does_not_echo() {
    if !has_display() {
        skip("no display");
    }
    let after_tick = Ref.new("");
    let after_reset = Ref.new("");
    // Every message `update` receives; see the input test for why.
    let received: Ref<string[]> = Ref.new([]);
    let application = gtk.raw.gtk_application_new("org.kivuli.test.checkbox", 0);
    gtk.raw.connect_app(
        application,
        "activate",
        fun(a: gtk.raw.GtkApplication) {
            let window = gtk.raw.gtk_application_window_new(a);
            let state: Ref<Option<State<Task, Chore>>> = Ref.new(None);
            let app = Running {
                window: window,
                update_fn: fun(t: Task, msg: Chore): Task {
                    received.update(fun(xs) {
                        let mut ys = xs;
                        ys.push("{msg}");
                        ys
                    });
                    update_task(t, msg)
                },
                view_fn: view_task,
                state: state,
                patching: Ref.new(false),
            };
            let init = Task { done: false };
            let tree = view_task(init);
            let first = create(tree, sender(app));
            gtk.raw.gtk_window_set_child(window, widget(first));
            state.set(Some(State { model: init, tree: tree, live: first }));
            let Box(_, kids) = first else {
                panic("expected a column");
            };
            // What a user's click ends with: the box becomes ticked, outside any dispatch.
            gtk.raw.gtk_check_button_set_active(widget(kids[0]), 1);
            after_tick.set(shown(kids[0]));
            // Reset unticks it through a SetChecked patch; its `toggled` echo is dropped.
            gtk.raw.emit_widget(widget(kids[1]), "clicked");
            after_reset.set(shown(kids[0]));
            gtk.raw.g_application_quit(a);
        },
        0,
    );
    gtk.raw.g_application_run(application, 0, None);
    gtk.raw.g_object_unref(application);

    assert_eq(after_tick.get(), "[x] Done!");
    assert_eq(after_reset.get(), "[ ] Done");
    assert_eq(received.get(), ["Done(true)", "Reset"]);
}
