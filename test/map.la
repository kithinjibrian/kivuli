// Mapping a component's messages into a bigger app's: views, commands and
// subscriptions. No GTK.
import kivuli.core.effects { commands, timers };
import kivuli.testing { click, submit, texts, toggle, type_into };
import kivuli {
    Cmd,
    Sub,
    View,
    button,
    checkbox,
    column,
    input,
    lazy,
    row,
    text,
    text_area,
    dropdown,
    slider,
    icon,
    image,
    Image,
    wrap,
    keyed_wrap,
    overlay,
    button_with,
    item,
    Fit,
    header_bar,
};

// Views and commands can hold functions, which have no `==`: compare what
// they print instead (DECISION-008).
fun assert_same<T>(actual: T, expected: T) {
    assert_eq("{actual}", "{expected}");
}

// A small component with its own messages.
enum Part {
    Level(i64),
    Inc,
    Named(string),
    Shown(bool),
    Go,
}

fun part(label: string): View<Part> = column([
    text(label),
    row([button("+", Part.Inc), checkbox("Show", false, Part.Shown)]),
    input("", Part.Named).placeholder("Name").on_submit(Part.Go),
    lazy("tail", fun(): View<Part> = text("tail")),
]);

// The app it sits in.
enum App {
    Left(Part),
    Right(Part),
}

@test
fun every_handler_sends_the_mapped_message() {
    let v = part("left").map(App.Left);
    assert_eq(click(v, "+"), Ok(App.Left(Part.Inc)));
    assert_eq(toggle(v, "Show"), Ok(App.Left(Part.Shown(true))));
    assert_eq(type_into(v, "Name", "Ada"), Ok(App.Left(Part.Named("Ada"))));
    assert_eq(submit(v, "Name"), Ok(App.Left(Part.Go)));
}

@test
fun mapping_keeps_text_and_structure_and_looks_through_lazies() {
    let v = row([part("left").map(App.Left), part("right").map(App.Right)]);
    assert_eq(texts(v), ["left", "tail", "right", "tail"]);
    let Row(halves) = v else {
        panic("expected a row");
    };
    assert_eq(click(halves[1], "+"), Ok(App.Right(Part.Inc)));
}

@test
fun commands_map_their_messages_and_keep_quit() {
    let cmd: Cmd<Part> = Cmd.batch([Cmd.after(5, Part.Go), Cmd.quit()]);
    let expected: Cmd<App>[] = [Cmd.After(5, App.Left(Part.Go)), Cmd.Quit];
    assert_same(commands(cmd.map(App.Left)), expected);
}

@test
fun subscriptions_map_their_ticks() {
    let sub: Sub<Part> = Sub.every(1000, fun(now: i64): Part = Part.Named("{now}"));
    let t = timers(sub.map(App.Right))[0];
    assert_eq(t.key, "1000#0");
    let tick = t.tick;
    assert_eq(tick(7), App.Right(Part.Named("7")));
}

@test
fun a_mapped_text_area_sends_the_mapped_message() {
    let v = text_area("", Part.Named).name("n").map(App.Left);
    assert_eq(type_into(v, "n", "hi"), Ok(App.Left(Part.Named("hi"))));
}

@test
fun mapped_choices_and_sliders_send_mapped_messages() {
    let picks = dropdown([("Go", Part.Go), ("Inc", Part.Inc)], "Go").name("d").map(App.Right);
    assert_eq(kivuli.testing.choose(picks, "d", "Inc"), Ok(App.Right(Part.Inc)));
    let slid = slider(0, 9, 3, Part.Level).name("s").map(App.Left);
    assert_eq(kivuli.testing.slide(slid, "s", 5), Ok(App.Left(Part.Level(5))));
}

@test
fun icons_and_images_pass_through_map() {
    // Icons send nothing: the part's message type comes from the annotation.
    let part: View<Part> = column([
        icon("list-add-symbolic"),
        image(Image.File("a.png")).fit(Fit.Cover),
    ]);
    let mapped = part.map(App.Left);
    let expected: View<App> = column([
        icon("list-add-symbolic"),
        image(Image.File("a.png")).fit(Fit.Cover),
    ]);
    assert_same(mapped, expected);
}

@test
fun mapped_fields_send_mapped_messages_and_disabled_ones_stay_silent() {
    let on = input("", Part.Named).placeholder("p").map(App.Left);
    assert_eq(type_into(on, "p", "x"), Ok(App.Left(Part.Named("x"))));
    let off: View<App> = input("", Part.Named).disabled(true).map(App.Left);
    let expected: View<App> = View.Input("", None);
    assert_same(off, expected);
}

@test
fun a_mapped_header_sends_mapped_messages() {
    let part: View<Part> = text("body").header(header_bar([button("Go", Part.Go)], text("T"), []));
    assert_eq(click(part.map(App.Left), "Go"), Ok(App.Left(Part.Go)));
}

@test
fun images_pass_through_map_and_their_buttons_send_mapped_messages() {
    let part = button("", Part.Go).image(Image.Bytes("k", [1])).tooltip("Go");
    assert_eq(click(part.map(App.Left), "Go"), Ok(App.Left(Part.Go)));
    let mapped: View<App> = part.map(App.Left);
    let expected: View<App> = button("", App.Left(Part.Go)).image(Image.Bytes("k", [1])).tooltip(
        "Go",
    );
    assert_same(mapped, expected);
}

@test
fun grids_map_their_childrens_messages() {
    let part: View<Part> = keyed_wrap([("g", button("Go", Part.Go))]);
    assert_eq(click(part.map(App.Left), "Go"), Ok(App.Left(Part.Go)));
    let flat: View<Part> = wrap([button("Inc", Part.Inc)]);
    assert_eq(click(flat.map(App.Right), "Inc"), Ok(App.Right(Part.Inc)));
}

@test
fun an_overlay_maps_its_base_and_layers() {
    let part: View<Part> = overlay(button("Go", Part.Go), [button("Inc", Part.Inc)]);
    assert_eq(click(part.map(App.Left), "Go"), Ok(App.Left(Part.Go)));
    assert_eq(click(part.map(App.Left), "Inc"), Ok(App.Left(Part.Inc)));
}

@test
fun a_menus_messages_map() {
    let part: View<Part> = button("Go", Part.Go).menu([item("Inc", Part.Inc)]);
    assert_eq(kivuli.testing.pick(part.map(App.Left), "Go", "Inc"), Ok(App.Left(Part.Inc)));
}

@test
fun a_button_withs_message_and_content_map() {
    let part: View<Part> = button_with(row([text("Go"), text("on")]), Part.Inc);
    let mapped = part.map(App.Left);
    assert_eq(click(mapped, "Go"), Ok(App.Left(Part.Inc)));
}

@test
fun a_disabled_check_box_has_no_toggle_and_keeps_none_when_mapped() {
    let off: View<Part> = checkbox("Show", false, Part.Shown).disabled(true);
    match off {
        Checkbox(_, _, on_toggle) => assert(on_toggle.is_none()),
        _ => panic("expected a check box"),
    }
    let styled: View<Part> = checkbox("Show", false, Part.Shown).style([]).disabled(true);
    match styled {
        Styled(Checkbox(_, _, on_toggle), _) => assert(on_toggle.is_none()),
        _ => panic("expected a styled check box"),
    }
    match off.map(fun(p: Part): i64 = 1) {
        Checkbox(_, _, on_toggle) => assert(on_toggle.is_none()),
        _ => panic("expected a check box"),
    }
}

@test
fun a_disabled_slider_has_no_handler_and_keeps_none_when_mapped() {
    let off: View<Part> = slider(0, 10, 5, Part.Level).disabled(true);
    match off {
        Slider(_, _, _, on_change) => assert(on_change.is_none()),
        _ => panic("expected a slider"),
    }
    match off.map(fun(p: Part): i64 = 1) {
        Slider(_, _, _, on_change) => assert(on_change.is_none()),
        _ => panic("expected a slider"),
    }
}
