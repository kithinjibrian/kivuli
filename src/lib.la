/**
 * kivuli's public API and the package's entry: `import kivuli;` loads this
 * module. It holds the view tree (types and modifiers from `views`, builders
 * from `widgets`) and effects (from `effects`),
 * re-exported, the two ways to run an app (`sandbox` and `application`), and
 * the testing helpers as `kivuli.testing`.
 *
 * Depends on: views, widgets, effects, testing, live
 */

public import views { View };
public import looks { Align, Fit };
public import theming { Color, Paint, hex, rgb };
public import styles {
    Styling,
    Font,
    Text,
    Family,
    Size,
    Weight,
    FontStyle,
    LineHeight,
    Decoration,
    Transform,
    Background,
    Gradient,
    Stop,
    Fill,
};
public import pictures { Image };
public import menus { MenuEntry, item, menu_separator };
public import widgets {
    text,
    button,
    button_with,
    column,
    row,
    input,
    checkbox,
    spacer,
    separator,
    scroll,
    keyed_column,
    wrap,
    keyed_wrap,
    overlay,
    lazy,
    text_area,
    dropdown,
    slider,
    icon,
    image,
};
public import effects { Cmd, Sub, App };
public import testing;
import live;

/**
 * Runs an app with no effects: shows `view(init)` in a window, and on each
 * message sets the model to `update(model, msg)` and shows the new view.
 *
 * @param id the application ID, reverse-DNS, such as `"org.kivuli.counter"`
 * @param init the model at start
 * @param update the next model, given the current one and a message
 * @param view what to show for a model
 * @returns GTK's exit status, for `main` to return
 *
 * Example:
 *     fun main(): i32 = kivuli.sandbox("org.kivuli.counter", Model { count: 0 }, update, view);
 */
public fun sandbox<Model, Msg>(
    id: string,
    init: Model,
    update: fun(Model, Msg): Model,
    view: fun(Model): View<Msg>,
): i32 = live.run(effects.sandbox_app(id, init, update, view));

/**
 * Runs an app with effects: like `sandbox`, but `init` and `update` also
 * return a `Cmd` (wait and send, quit), and `subscriptions` says what to keep
 * listening to (`Sub.every`) for the current model.
 *
 * @param app the app: its id, `init`, `update`, `view` and `subscriptions`
 * @returns GTK's exit status, for `main` to return
 *
 * Example:
 *     fun main(): i32 = kivuli.application(App {
 *         id: "org.kivuli.stopwatch",
 *         init: (Model { ms: 0, running: false }, Cmd.none()),
 *         update: update,
 *         view: view,
 *         subscriptions: subscriptions,
 *     });
 */
public fun application<Model, Msg>(app: App<Model, Msg>): i32 = live.run(app);
