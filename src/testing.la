/**
 * Testing helpers: what a user could do to a view, worked out from the view
 * alone, with no GTK and no display. `update` and `view` are pure, so an app
 * test builds a view, "clicks" or "types" through these, and checks the
 * message that comes back. Re-exported by the entry: `kivuli.testing.click`.
 *
 * Depends on: views, widgets, walk, keys
 * Used by: lib (re-exported), apps' tests
 */

import views { View };
import menus { MenuEntry };
import looks { Style };
import walk { nodes };
import keys;
import widgets { snap };

/** Why a helper couldn't do what was asked, naming what it looked for. */
public enum Lookup {
    /** Nothing in the view matches. */
    NotFound(string),
    /** More than one thing matches, this many. */
    Ambiguous(string, i64),
    /** It's there but sends nothing: a disabled button or text field, or a text field without `.on_submit`. */
    Silent(string),
}

/**
 * The message clicking the button labelled `label` sends; a button is also
 * found by its tooltip.
 * @returns `Ok(msg)`; `Err(NotFound)`, `Err(Ambiguous)`, or `Err(Silent)` when it's disabled
 *
 * Example:
 *     assert_eq(kivuli.testing.click(view(m), "Add"), Ok(Msg.Add));
 */
public fun click<Msg>(v: View<Msg>, label: string): Result<Msg, Lookup> {
    let what = "button \"{label}\"";
    let found = only(buttons(v, label), what)?;
    match found {
        Some(msg) => Ok(msg),
        None => Err(Lookup.Silent(what)),
    }
}

/**
 * The message picking the item labelled `item` in the context menu of the node
 * found by `owner`: a button's label or tooltip, or a node's `.name`.
 * @returns `Ok(msg)`; `Err(NotFound)` (no such node or item), `Err(Ambiguous)`
 * (two nodes or two items), or `Err(Silent)` when the item is disabled
 *
 * Example:
 *     assert_eq(kivuli.testing.pick(view(m), "news", "Close tab"), Ok(Msg.Close(1)));
 */
public fun pick<Msg>(v: View<Msg>, owner: string, item: string): Result<Msg, Lookup> {
    let mut owners: MenuEntry<Msg>[][] = [];
    for (node, style) of nodes(v) {
        match node {
            Menu(inside, entries) => if style.name == owner || match inside {
                Button(label, _, _) => label == owner || style.tooltip == owner,
                _ => false,
            } {
                owners.push(entries);
            },
            _ => {}
        }
    }
    let entries = only(owners, "menu on \"{owner}\"")?;
    let what = "menu item \"{item}\"";
    let mut found: Option<Msg>[] = [];
    for entry of entries {
        match entry {
            Item(label, msg) => if label == item {
                found.push(msg);
            },
            Separator => {}
        }
    }
    match only(found, what)? {
        Some(msg) => Ok(msg),
        None => Err(Lookup.Silent(what)),
    }
}

/**
 * Whether the button labelled `label` (or with that tooltip) is disabled.
 * @returns `Ok(disabled)`; `Err(NotFound)` or `Err(Ambiguous)`
 *
 * Example:
 *     assert_eq(kivuli.testing.is_disabled(view(m), "Reset"), Ok(true));
 */
public fun is_disabled<Msg>(v: View<Msg>, label: string): Result<bool, Lookup> {
    let found = only(buttons(v, label), "button \"{label}\"")?;
    Ok(found.is_none())
}

/**
 * The message pressing `shortcut` sends: that of the enabled button with that
 * shortcut. Keys are compared as GTK reads them (`"ctrl+n"` is `"Ctrl+N"`).
 * @returns `Ok(msg)`; `Err(NotFound)`, `Err(Silent)` when only a disabled
 * button has it, or `Err(Ambiguous)` when two enabled ones do. Panics on keys
 * kivuli can't read, as the app would.
 *
 * Example:
 *     assert_eq(kivuli.testing.press(view(m), "Ctrl+N"), Ok(Msg.Add));
 */
public fun press<Msg>(v: View<Msg>, shortcut: string): Result<Msg, Lookup> {
    let what = "shortcut \"{shortcut}\"";
    let wanted = match keys.parse(shortcut) {
        Ok(gtk) => gtk,
        Err(problem) => panic("kivuli: can't read the shortcut \"{shortcut}\": {problem}"),
    };
    let mut enabled: Msg[] = [];
    let mut disabled = 0;
    for (node, style) of nodes(v) {
        match node {
            Button(_, msg, _) => if style.shortcut != "" && keys.parse(style.shortcut) == Ok(
                wanted,
            ) {
                match msg {
                    Some(m) => enabled.push(m),
                    None => {
                        disabled = disabled + 1;
                    }
                }
            },
            _ => {}
        }
    }
    if enabled.len == 0 && disabled > 0 {
        return Err(Lookup.Silent(what));
    }
    only(enabled, what)
}

/**
 * The tooltip of the button labelled `label`: `""` when it has none.
 * @returns `Ok(text)`; `Err(NotFound)` or `Err(Ambiguous)`
 *
 * Example:
 *     assert_eq(kivuli.testing.tooltip(view(m), "✕"), Ok("Delete milk"));
 */
public fun tooltip<Msg>(v: View<Msg>, label: string): Result<string, Lookup> {
    let mut found: string[] = [];
    for (node, style) of nodes(v) {
        match node {
            Button(l, _, _) => if l == label {
                found.push(style.tooltip);
            },
            _ => {}
        }
    }
    only(found, "button \"{label}\"")
}

/**
 * The message typing `text` into the text field or text area with
 * placeholder or name `hint` sends: what its `on_change` makes of the whole
 * new text.
 * @returns `Ok(msg)`; `Err(NotFound)`, `Err(Ambiguous)`, or `Err(Silent)` when it's disabled
 *
 * Example:
 *     assert_eq(kivuli.testing.type_into(view(m), "Your name", "Ada"), Ok(Msg.Named("Ada")));
 */
public fun type_into<Msg>(v: View<Msg>, hint: string, text: string): Result<Msg, Lookup> {
    let what = "text field \"{hint}\"";
    let (on_change, _) = only(fields(v, hint), what)?;
    match on_change {
        Some(f) => Ok(f(text)),
        None => Err(Lookup.Silent(what)),
    }
}

/**
 * Whether the text field or text area with placeholder or name `hint` is
 * disabled (`.disabled(true)`), found as `type_into` finds it. Buttons use
 * `is_disabled`.
 * @returns `Ok(disabled)`; `Err(NotFound)` or `Err(Ambiguous)`
 *
 * Example:
 *     assert_eq(kivuli.testing.is_field_disabled(view(m), "Title"), Ok(true));
 */
public fun is_field_disabled<Msg>(v: View<Msg>, hint: string): Result<bool, Lookup> {
    let (on_change, _) = only(fields(v, hint), "text field \"{hint}\"")?;
    Ok(on_change.is_none())
}

/**
 * The message pressing Enter in the text field with placeholder `hint` sends.
 * @returns `Ok(msg)`; `Err(NotFound)`, `Err(Ambiguous)`, or `Err(Silent)` without `.on_submit`
 *
 * Example:
 *     assert_eq(kivuli.testing.submit(view(m), "New task"), Ok(Msg.Add));
 */
public fun submit<Msg>(v: View<Msg>, hint: string): Result<Msg, Lookup> {
    let what = "text field \"{hint}\"";
    let (_, on_submit) = only(fields(v, hint), what)?;
    match on_submit {
        Some(msg) => Ok(msg),
        None => Err(Lookup.Silent(what)),
    }
}

/**
 * The message clicking the check box labelled `label` sends: its `on_toggle`
 * of the opposite of its current state.
 * @returns `Ok(msg)`; `Err(NotFound)` or `Err(Ambiguous)`
 *
 * Example:
 *     assert_eq(kivuli.testing.toggle(view(m), "Done"), Ok(Msg.Done(true)));
 */
public fun toggle<Msg>(v: View<Msg>, label: string): Result<Msg, Lookup> {
    let (checked, on_toggle) = only(checkboxes(v, label), "check box \"{label}\"")?;
    Ok(on_toggle(!checked))
}

/**
 * The message picking the choice labelled `label` in the drop-down named
 * `name` sends. With two equal labels, the first counts.
 * @returns `Ok(msg)`; `Err(NotFound)` for no such drop-down or choice, or
 * `Err(Ambiguous)` when two drop-downs have that name
 *
 * Example:
 *     assert_eq(kivuli.testing.choose(view(m), "size", "Large"), Ok(Msg.Size(Size.Large)));
 */
public fun choose<Msg>(v: View<Msg>, name: string, label: string): Result<Msg, Lookup> {
    let mut found: (string, Msg)[][] = [];
    for (node, style) of nodes(v) {
        match node {
            Dropdown(choices, _) => if style.name == name {
                found.push(choices);
            },
            _ => {}
        }
    }
    let choices = only(found, "drop-down \"{name}\"")?;
    for (l, msg) of choices {
        if l == label {
            return Ok(msg);
        }
    }
    Err(Lookup.NotFound("choice \"{label}\" in \"{name}\""))
}

/**
 * The message moving the slider named `name` to `value` sends: the value is
 * clamped to the slider's range and put on its nearest step, as the widget
 * does. Panics when the slider's least value is greater than its greatest.
 * @returns `Ok(msg)`; `Err(NotFound)` or `Err(Ambiguous)`
 *
 * Example:
 *     assert_eq(kivuli.testing.slide(view(m), "volume", 42), Ok(Msg.Volume(42)));
 */
public fun slide<Msg>(v: View<Msg>, name: string, value: i64): Result<Msg, Lookup> {
    let mut found: (i64, i64, i64, fun(i64): Msg)[] = [];
    for (node, style) of nodes(v) {
        match node {
            Slider(min, max, _, on_change) => if style.name == name {
                found.push((min, max, style.step, on_change));
            },
            _ => {}
        }
    }
    let (min, max, step, on_change) = only(found, "slider \"{name}\"")?;
    Ok(on_change(snap(value, min, max, step)))
}

/**
 * Every line of text the view shows, in order: for checking what's on screen.
 *
 * Example:
 *     assert_eq(kivuli.testing.texts(view(m)), ["Clicked 3 times"]);
 */
public fun texts<Msg>(v: View<Msg>): string[] {
    let mut out: string[] = [];
    for (node, _) of nodes(v) {
        match node {
            Text(s) => out.push(s),
            _ => {}
        }
    }
    out
}

/** The one match in `found`, or why there isn't one. */
fun only<T>(found: T[], what: string): Result<T, Lookup> = if found.len == 0 {
    Err(Lookup.NotFound(what))
} else if found.len > 1 {
    Err(Lookup.Ambiguous(what, found.len))
} else {
    Ok(found[0])
};

/** The messages of the buttons whose label or tooltip is `s` (`None` for a disabled one). */
fun buttons<Msg>(v: View<Msg>, s: string): Option<Msg>[] {
    let mut out: Option<Msg>[] = [];
    for (node, style) of nodes(v) {
        match node {
            // One button whose label and tooltip both match is still one match.
            Button(l, msg, _) => if l == s || style.tooltip == s {
                out.push(msg);
            },
            _ => {}
        }
    }
    out
}

/**
 * The handlers of the text fields with placeholder or name `hint`, and of the
 * text areas named `hint`: `None` for a disabled one's edits (and its Enter).
 */
fun fields<Msg>(v: View<Msg>, hint: string): (Option<fun(string): Msg>, Option<Msg>)[] {
    let mut out: (Option<fun(string): Msg>, Option<Msg>)[] = [];
    for (node, style) of nodes(v) {
        match node {
            Input(_, messages) => if style.placeholder == hint || style.name == hint {
                out.push(match messages {
                    Some((on_change, on_submit)) => (Some(on_change), on_submit),
                    None => (None, None),
                });
            },
            // A text area has no Enter message: `submit` on it is `Silent`.
            TextArea(_, on_change) => if style.name == hint {
                out.push((on_change, None));
            },
            _ => {}
        }
    }
    out
}

/** The state and handler of the check boxes labelled `label`. */
fun checkboxes<Msg>(v: View<Msg>, label: string): (bool, fun(bool): Msg)[] {
    let mut out: (bool, fun(bool): Msg)[] = [];
    for (node, _) of nodes(v) {
        match node {
            Checkbox(l, checked, on_toggle) => if l == label {
                out.push((checked, on_toggle));
            },
            _ => {}
        }
    }
    out
}
