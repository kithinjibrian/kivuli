/**
 * Tree diff: compares the last view with the next and lists the changes that
 * turn the widgets showing one into widgets showing the other. Pure: never
 * calls GTK, so it is tested with no display. Not responsible for applying
 * the changes (that's `live`).
 *
 * Depends on: views
 * Used by: live (from step 3, part 2)
 */

import views { View };
import looks { Style, plain };
import pictures { Image, identity };
import menus { MenuEntry };
import box_rules { needs_clamp };

/**
 * One change to the live widgets. A path is the list of child indexes from
 * the root: `[]` is the root, `[2, 0]` the first child of the root's third. A
 * scroll's one child is index 0.
 */
enum Patch<Msg> {
    /** The label at the path shows new text. */
    SetText(i64[], string),
    /** The button or check box at the path shows a new label. */
    SetLabel(i64[], string),
    /** The button at the path sends this message from now on, or nothing (disabled) for `None`. */
    SetMsg(i64[], Option<Msg>),
    /** The text field or text area at the path shows this text. */
    SetValue(i64[], string),
    /**
     * The text field or text area at the path turns edits into messages with
     * this function from now on; `None` disables it (decision 6).
     */
    SetOnChange(i64[], Option<fun(string): Msg>),
    /** The text field at the path sends this message on Enter from now on, or nothing for `None`. */
    SetOnSubmit(i64[], Option<Msg>),
    /** The check box at the path is ticked (or not). */
    SetChecked(i64[], bool),
    /** The check box at the path turns toggles into messages with this function from now on. */
    SetOnToggle(i64[], fun(bool): Msg),
    /** The drop-down at the path offers these choices, the one labelled so shown picked. */
    SetChoices(i64[], (string, Msg)[], string),
    /** The slider at the path runs from the first number to the second. */
    SetRange(i64[], i64, i64),
    /** The slider at the path shows this number. */
    SetNumber(i64[], i64),
    /** The slider at the path turns moves into messages with this function from now on. */
    SetOnSlide(i64[], fun(i64): Msg),
    /** The image at the path shows this one (an icon another icon, a picture another file or bytes). */
    SetImage(i64[], Image),
    /** The button at the path shows this image before its label, or none. */
    SetButtonImage(i64[], Option<Image>),
    /** The widget at the path takes this whole style (every modifier, defaults included). */
    SetStyle(i64[], Style),
    /**
     * The widget at the path has this context menu from now on (`[]`: none).
     * Every update: its messages can't be compared.
     */
    SetMenu(i64[], MenuEntry<Msg>[]),
    /** The widget at the path is a different kind now: build this view in its place. */
    Replace(i64[], View<Msg>),
    /** The column or row at the path gains this view as its last child. */
    Append(i64[], View<Msg>),
    /** The widget at the path leaves its column or row. */
    Remove(i64[]),
    /** The keyed column at the path gains this view at this index. */
    Insert(i64[], i64, View<Msg>),
    /** In the keyed column at the path, the child at the first index moves to the second. */
    Move(i64[], i64, i64),
}

/**
 * Lists the changes that turn widgets showing `old` into widgets showing
 * `new`, in the order they must be applied. Two equal trees of text and
 * columns give no changes. Every button gives a `SetMsg`, every text field a
 * `SetOnChange`, every check box a `SetOnToggle`, every drop-down a
 * `SetChoices` and every slider a `SetOnSlide`, because messages and functions
 * can't be compared.
 */
fun diff<Msg>(old: View<Msg>, new: View<Msg>): Patch<Msg>[] = diff_at([], old, new);

fun diff_at<Msg>(path: i64[], old: View<Msg>, new: View<Msg>): Patch<Msg>[] = match (old, new) {
    // Lazies are transparent: same key, nothing to do; otherwise compare what they built.
    (Lazy(a, _, Some(x)), Lazy(b, _, Some(y))) => if a == b { [] } else { diff_at(path, x, y) },
    (Lazy(_, _, Some(x)), _) => diff_at(path, x, new),
    (_, Lazy(_, _, Some(y))) => diff_at(path, old, y),
    (Lazy(_, _, None), _) => panic("kivuli: a lazy node reached the diff unresolved"),
    (_, Lazy(_, _, None)) => panic("kivuli: a lazy node reached the diff unresolved"),
    _ => diff_node(path, old, new),
};

fun diff_node<Msg>(path: i64[], old: View<Msg>, new: View<Msg>): Patch<Msg>[] {
    let (old_inside, old_style) = split(old);
    let (new_inside, new_style) = split(new);
    let (old_node, old_menu) = unmenu(old_inside);
    let (new_node, new_menu) = unmenu(new_inside);
    // A node moving into or out of a clamp (`Sizing`'s exact size or maximum)
    // is rebuilt: a live widget is never re-parented into one.
    if needs_clamp(old_style.sheet.sizing) != needs_clamp(new_style.sheet.sizing) {
        return [Patch.Replace(path, new)];
    }
    let inside = diff_inside(path, old_node, new_node, new);
    // A different kind is rebuilt whole, its style and menu with it.
    if inside.len > 0 && replaces(inside[0], path) {
        return inside;
    }
    let mut out: Patch<Msg>[] = if old_style == new_style {
        inside
    } else {
        joined([Patch.SetStyle(path, new_style)], inside)
    };
    // A menu gained or lost is set on the same widget, not rebuilt with it.
    if old_menu.is_some() || new_menu.is_some() {
        let none: MenuEntry<Msg>[] = [];
        out.push(Patch.SetMenu(path, new_menu.unwrap_or(none)));
    }
    out
}

/** A node without its `Menu` wrapper, and the menu's entries, if it has one. */
fun unmenu<Msg>(v: View<Msg>): (View<Msg>, Option<MenuEntry<Msg>[]>) = match v {
    Menu(inside, entries) => (inside, Some(entries)),
    _ => (v, None),
};

/** A node without its `Styled` wrapper, and its style (`plain()` when it has none). */
fun split<Msg>(v: View<Msg>): (View<Msg>, Style) = match v {
    Styled(inside, s) => (inside, s),
    _ => (v, plain()),
};

fun replaces<Msg>(p: Patch<Msg>, path: i64[]): bool = match p {
    Replace(at, _) => at == path,
    _ => false,
};

/**
 * Compares two nodes' insides (no `Styled` wrappers). `styled` is the new node
 * as written, style and all, for a `Replace`.
 */
fun diff_inside<Msg>(
    path: i64[],
    old: View<Msg>,
    new: View<Msg>,
    styled: View<Msg>,
): Patch<Msg>[] = match (old, new) {
    (Text(a), Text(b)) => if a == b { [] } else { [Patch.SetText(path, b)] },
    (Button(a, _, img_a), Button(b, msg, img_b)) => diff_button(path, (a, img_a), (b, img_b), msg),
    // The content is child 0; always re-point the message, as for a button.
    (ButtonWith(a, _), ButtonWith(b, msg)) => joined(diff_at(child(path, 0), a, b), [
        Patch.SetMsg(path, msg),
    ]),
    (Column(xs), Column(ys)) => diff_children(path, xs, ys),
    (Row(xs), Row(ys)) => diff_children(path, xs, ys),
    (Input(a, _), Input(b, messages)) => diff_input(path, a, b, match messages {
        Some((on_change, on_submit)) => (Some(on_change), on_submit),
        // Disabled: no edits, no Enter.
        None => (None, None),
    }),
    (TextArea(a, _), TextArea(b, on_change)) => diff_text_area(path, a, b, on_change),
    (Checkbox(la, ca, _), Checkbox(lb, cb, on_toggle)) => diff_checkbox(
        path,
        la,
        lb,
        ca,
        cb,
        on_toggle,
    ),
    // Always: the choices' messages can't be compared (`patch` touches GTK only on a real change).
    (Dropdown(_, _), Dropdown(choices, selected)) => [Patch.SetChoices(path, choices, selected)],
    (Slider(min_a, max_a, a, _), Slider(min_b, max_b, b, on_change)) => diff_slider(
        path,
        (min_a, max_a, a),
        (min_b, max_b, b),
        on_change,
    ),
    // By identity, never by bytes; a theme icon and a picture are different widgets.
    (Image(a), Image(b)) => if identity(a) == identity(b) {
        []
    } else if is_icon(a) == is_icon(b) {
        [Patch.SetImage(path, b)]
    } else {
        [Patch.Replace(path, styled)]
    },
    (Spacer, Spacer) => [],
    (Separator, Separator) => [],
    // A scroll has one child, at index 0 of its path.
    (Scroll(a), Scroll(b)) => diff_at(child(path, 0), a, b),
    (Keyed(xs), Keyed(ys)) => diff_keyed(path, xs, ys),
    (Wrap(xs), Wrap(ys)) => diff_children(path, xs, ys),
    (KeyedWrap(xs), KeyedWrap(ys)) => diff_keyed(path, xs, ys),
    // The base is child 0, the layers child 1 (then each by position).
    (Overlay(base_a, layers_a), Overlay(base_b, layers_b)) => joined(
        diff_at(child(path, 0), base_a, base_b),
        diff_children(child(path, 1), layers_a, layers_b),
    ),
    // A header's parts are its children: 0 the body, 1 the title, 2 the start
    // views and 3 the end views, each list by position.
    (Framed(body_a, start_a, title_a, end_a), Framed(body_b, start_b, title_b, end_b)) => {
        let mut out = diff_at(child(path, 0), body_a, body_b);
        for p of diff_at(child(path, 1), title_a, title_b) {
            out.push(p);
        }
        for p of diff_children(child(path, 2), start_a, start_b) {
            out.push(p);
        }
        for p of diff_children(child(path, 3), end_a, end_b) {
            out.push(p);
        }
        out
    }
    _ => [Patch.Replace(path, styled)],
};

/** A button's label and image, old and new. */
fun diff_button<Msg>(
    path: i64[],
    old: (string, Option<Image>),
    new: (string, Option<Image>),
    msg: Option<Msg>,
): Patch<Msg>[] {
    let mut out: Patch<Msg>[] = [];
    if old.0 != new.0 {
        out.push(Patch.SetLabel(path, new.0));
    }
    if old.1.map(identity) != new.1.map(identity) {
        out.push(Patch.SetButtonImage(path, new.1));
    }
    // Always re-point: we can't tell whether the message changed.
    out.push(Patch.SetMsg(path, msg));
    out
}

fun diff_input<Msg>(
    path: i64[],
    old_value: string,
    value: string,
    messages: (Option<fun(string): Msg>, Option<Msg>),
): Patch<Msg>[] {
    let mut out: Patch<Msg>[] = [];
    if old_value != value {
        out.push(Patch.SetValue(path, value));
    }
    // Always re-point, as for buttons: functions and messages can't be compared.
    out.push(Patch.SetOnChange(path, messages.0));
    out.push(Patch.SetOnSubmit(path, messages.1));
    out
}

fun diff_checkbox<Msg>(
    path: i64[],
    old_label: string,
    label: string,
    old_checked: bool,
    checked: bool,
    on_toggle: fun(bool): Msg,
): Patch<Msg>[] {
    let mut out: Patch<Msg>[] = [];
    if old_label != label {
        out.push(Patch.SetLabel(path, label));
    }
    if old_checked != checked {
        out.push(Patch.SetChecked(path, checked));
    }
    out.push(Patch.SetOnToggle(path, on_toggle));
    out
}

/** A slider's range and number, as `(min, max, value)`, old and new. */
fun diff_slider<Msg>(
    path: i64[],
    old: (i64, i64, i64),
    new: (i64, i64, i64),
    on_change: fun(i64): Msg,
): Patch<Msg>[] {
    let mut out: Patch<Msg>[] = [];
    if old.0 != new.0 || old.1 != new.1 {
        out.push(Patch.SetRange(path, new.0, new.1));
    }
    if old.2 != new.2 {
        out.push(Patch.SetNumber(path, new.2));
    }
    out.push(Patch.SetOnSlide(path, on_change));
    out
}

/** As `diff_input`, without Enter: a text area has no `on_submit`. */
fun diff_text_area<Msg>(
    path: i64[],
    old_value: string,
    value: string,
    on_change: Option<fun(string): Msg>,
): Patch<Msg>[] {
    let mut out: Patch<Msg>[] = [];
    if old_value != value {
        out.push(Patch.SetValue(path, value));
    }
    out.push(Patch.SetOnChange(path, on_change));
    out
}

/**
 * Children are matched by position: the shared prefix is diffed, extra new
 * children are appended, and missing ones removed.
 */
fun diff_children<Msg>(path: i64[], xs: View<Msg>[], ys: View<Msg>[]): Patch<Msg>[] {
    let mut out: Patch<Msg>[] = [];
    let shared = if xs.len < ys.len { xs.len } else { ys.len };
    let mut i = 0;
    while i < shared {
        // Pushed in place: `out = joined(out, …)` copied the list every row.

        for p of diff_at(child(path, i), xs[i], ys[i]) {
            out.push(p);
        }
        i = i + 1;
    }
    while i < ys.len {
        out.push(Patch.Append(path, ys[i]));
        i = i + 1;
    }
    // Remove from the end backwards, so each path still points at the
    // widget it names when its patch is applied.
    let mut j = xs.len - 1;
    while j >= ys.len {
        out.push(Patch.Remove(child(path, j)));
        j = j - 1;
    }
    out
}

/**
 * Keyed children are matched by key. Each patch counts indexes in the list as
 * the patches before it left it: first the rows whose key is gone are removed
 * (from the end, so earlier indexes hold), then the new list is walked from the
 * front, inserting new keys and moving existing ones into place, and diffing
 * each kept row where it now stands. Keys are found by searching, so this is
 * quadratic in the number of rows: fine for the lists a window shows.
 */
fun diff_keyed<Msg>(
    path: i64[],
    xs: (string, View<Msg>)[],
    ys: (string, View<Msg>)[],
): Patch<Msg>[] {
    let mut wanted: Set<string> = #{};
    for (k, _) of ys {
        if !wanted.insert(k) {
            panic("kivuli: a keyed_column or keyed_wrap has two children keyed \"{k}\"");
        }
    }
    let mut out: Patch<Msg>[] = [];
    let mut i = xs.len - 1;
    while i >= 0 {
        if !wanted.has(xs[i].0) {
            out.push(Patch.Remove(child(path, i)));
        }
        i = i - 1;
    }
    // What the keyed column holds now: the kept rows, in their old order.
    let mut keys: string[] = [];
    let mut kept: View<Msg>[] = [];
    let mut present: Set<string> = #{};
    for (k, v) of xs {
        if wanted.has(k) {
            keys.push(k);
            kept.push(v);
            present.insert(k);
        }
    }
    let mut at = 0;
    while at < ys.len {
        let (k, v) = ys[at];
        if !present.has(k) {
            out.push(Patch.Insert(path, at, v));
            keys = inserted(keys, at, k);
            kept = inserted(kept, at, v);
            present.insert(k);
        } else {
            // Usually the row is already in place; a moved one is searched for
            // from here on (everything before `at` is settled).
            let j = if keys[at] == k { at } else { position(keys, k, at + 1) };
            if j != at {
                out.push(Patch.Move(path, j, at));
                keys = moved(keys, j, at);
                kept = moved(kept, j, at);
            }
            for p of diff_at(child(path, at), kept[at], v) {
                out.push(p);
            }
        }
        at = at + 1;
    }
    out
}

/** Where `key` is in `keys`, looking from index `from`; it must be there. */
fun position(keys: string[], key: string, from: i64): i64 {
    let mut i = from;
    while keys[i] != key {
        i = i + 1;
    }
    i
}

/** `xs` with `x` placed at index `at`, the elements from there on shifted down one. */
fun inserted<T>(xs: T[], at: i64, x: T): T[] {
    let mut out: T[] = [];
    let mut i = 0;
    while i < xs.len {
        if i == at {
            out.push(x);
        }
        out.push(xs[i]);
        i = i + 1;
    }
    if at == xs.len {
        out.push(x);
    }
    out
}

/** `xs` without the element at index `skip`. */
fun without<T>(xs: T[], skip: i64): T[] {
    let mut out: T[] = [];
    let mut i = 0;
    while i < xs.len {
        if i != skip {
            out.push(xs[i]);
        }
        i = i + 1;
    }
    out
}

/** `xs` with the element at `from` taken out and put back at index `to`. */
fun moved<T>(xs: T[], from: i64, to: i64): T[] = inserted(without(xs, from), to, xs[from]);

fun child(path: i64[], i: i64): i64[] {
    let mut p = path;
    p.push(i);
    p
}

fun joined<T>(a: T[], b: T[]): T[] {
    let mut out = a;
    for x of b {
        out.push(x);
    }
    out
}

/** Whether an image is a theme icon (a `GtkImage`) rather than a picture (a `GtkPicture`). */
fun is_icon(img: Image): bool = match img {
    Icon(_) => true,
    _ => false,
};
