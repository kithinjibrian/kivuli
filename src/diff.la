/**
 * Tree diff: compares the last view with the next and lists the changes that
 * turn the widgets showing one into widgets showing the other. Pure: never
 * calls GTK, so it is tested with no display. Not responsible for applying
 * the changes (that's `live`).
 *
 * Depends on: views
 * Used by: live (from step 3, part 2)
 */

import views { View, Style, plain };

/**
 * One change to the live widgets. A path is the list of child indexes from
 * the root: `[]` is the root, `[2, 0]` the first child of the root's third. A
 * scroll's one child is index 0.
 */
enum Patch<Msg> {
    /** The label at the path shows new text. */
    SetText(i64[], string),
    /** The button or check box at the path shows a new label. */
    SetLabel(i64[], string),
    /** The button at the path sends a new message from now on. */
    SetMsg(i64[], Msg),
    /** The text field at the path shows this text. */
    SetValue(i64[], string),
    /** The text field at the path turns edits into messages with this function from now on. */
    SetOnChange(i64[], fun(string): Msg),
    /** The check box at the path is ticked (or not). */
    SetChecked(i64[], bool),
    /** The check box at the path turns toggles into messages with this function from now on. */
    SetOnToggle(i64[], fun(bool): Msg),
    /** The widget at the path takes this whole style (every modifier, defaults included). */
    SetStyle(i64[], Style),
    /** The widget at the path is a different kind now: build this view in its place. */
    Replace(i64[], View<Msg>),
    /** The column or row at the path gains this view as its last child. */
    Append(i64[], View<Msg>),
    /** The widget at the path leaves its column or row. */
    Remove(i64[]),
    /** The keyed column at the path gains this view at this index. */
    Insert(i64[], i64, View<Msg>),
    /** In the keyed column at the path, the child at the first index moves to the second. */
    Move(i64[], i64, i64),
}

/**
 * Lists the changes that turn widgets showing `old` into widgets showing
 * `new`, in the order they must be applied. Two equal trees of text and
 * columns give no changes. Every button gives a `SetMsg`, every text field a
 * `SetOnChange` and every check box a `SetOnToggle`, because messages and
 * functions can't be compared.
 */
fun diff<Msg>(old: View<Msg>, new: View<Msg>): Patch<Msg>[] = diff_at([], old, new);

fun diff_at<Msg>(path: i64[], old: View<Msg>, new: View<Msg>): Patch<Msg>[] {
    let (old_inside, old_style) = split(old);
    let (new_inside, new_style) = split(new);
    let inside = diff_inside(path, old_inside, new_inside, new);
    // A different kind is rebuilt whole, its style with it: nothing to restyle.
    if inside.len > 0 && replaces(inside[0], path) {
        return inside;
    }
    if old_style == new_style { inside } else { joined([Patch.SetStyle(path, new_style)], inside) }
}

/** A node without its `Styled` wrapper, and its style (`plain()` when it has none). */
fun split<Msg>(v: View<Msg>): (View<Msg>, Style) = match v {
    Styled(inside, s) => (inside, s),
    _ => (v, plain()),
};

fun replaces<Msg>(p: Patch<Msg>, path: i64[]): bool = match p {
    Replace(at, _) => at == path,
    _ => false,
};

/**
 * Compares two nodes' insides (no `Styled` wrappers). `styled` is the new node
 * as written, style and all, for a `Replace`.
 */
fun diff_inside<Msg>(
    path: i64[],
    old: View<Msg>,
    new: View<Msg>,
    styled: View<Msg>,
): Patch<Msg>[] = match (old, new) {
    (Text(a), Text(b)) => if a == b { [] } else { [Patch.SetText(path, b)] },
    (Button(a, _), Button(b, msg)) => diff_button(path, a, b, msg),
    (Column(xs), Column(ys)) => diff_children(path, xs, ys),
    (Row(xs), Row(ys)) => diff_children(path, xs, ys),
    (Input(a, _), Input(b, on_change)) => diff_input(path, a, b, on_change),
    (Checkbox(la, ca, _), Checkbox(lb, cb, on_toggle)) => diff_checkbox(
        path,
        la,
        lb,
        ca,
        cb,
        on_toggle,
    ),
    (Spacer, Spacer) => [],
    (Separator, Separator) => [],
    // A scroll has one child, at index 0 of its path.
    (Scroll(a), Scroll(b)) => diff_at(child(path, 0), a, b),
    (Keyed(xs), Keyed(ys)) => diff_keyed(path, xs, ys),
    _ => [Patch.Replace(path, styled)],
};

fun diff_button<Msg>(path: i64[], old_label: string, label: string, msg: Msg): Patch<Msg>[] {
    let mut out: Patch<Msg>[] = [];
    if old_label != label {
        out.push(Patch.SetLabel(path, label));
    }
    // Always re-point: we can't tell whether the message changed.
    out.push(Patch.SetMsg(path, msg));
    out
}

fun diff_input<Msg>(
    path: i64[],
    old_value: string,
    value: string,
    on_change: fun(string): Msg,
): Patch<Msg>[] {
    let mut out: Patch<Msg>[] = [];
    if old_value != value {
        out.push(Patch.SetValue(path, value));
    }
    // Always re-point, as for buttons: functions can't be compared.
    out.push(Patch.SetOnChange(path, on_change));
    out
}

fun diff_checkbox<Msg>(
    path: i64[],
    old_label: string,
    label: string,
    old_checked: bool,
    checked: bool,
    on_toggle: fun(bool): Msg,
): Patch<Msg>[] {
    let mut out: Patch<Msg>[] = [];
    if old_label != label {
        out.push(Patch.SetLabel(path, label));
    }
    if old_checked != checked {
        out.push(Patch.SetChecked(path, checked));
    }
    out.push(Patch.SetOnToggle(path, on_toggle));
    out
}

/**
 * Children are matched by position: the shared prefix is diffed, extra new
 * children are appended, and missing ones removed.
 */
fun diff_children<Msg>(path: i64[], xs: View<Msg>[], ys: View<Msg>[]): Patch<Msg>[] {
    let mut out: Patch<Msg>[] = [];
    let shared = if xs.len < ys.len { xs.len } else { ys.len };
    let mut i = 0;
    while i < shared {
        out = joined(out, diff_at(child(path, i), xs[i], ys[i]));
        i = i + 1;
    }
    while i < ys.len {
        out.push(Patch.Append(path, ys[i]));
        i = i + 1;
    }
    // Remove from the end backwards, so each path still points at the
    // widget it names when its patch is applied.
    let mut j = xs.len - 1;
    while j >= ys.len {
        out.push(Patch.Remove(child(path, j)));
        j = j - 1;
    }
    out
}

/**
 * Keyed children are matched by key. Each patch counts indexes in the list as
 * the patches before it left it: first the rows whose key is gone are removed
 * (from the end, so earlier indexes hold), then the new list is walked from the
 * front, inserting new keys and moving existing ones into place, and diffing
 * each kept row where it now stands. Keys are found by searching, so this is
 * quadratic in the number of rows: fine for the lists a window shows.
 */
fun diff_keyed<Msg>(
    path: i64[],
    xs: (string, View<Msg>)[],
    ys: (string, View<Msg>)[],
): Patch<Msg>[] {
    let wanted = keys_of(ys);
    let mut seen: string[] = [];
    for k of wanted {
        if index_of(seen, k) >= 0 {
            panic("kivuli: a keyed_column has two children keyed \"{k}\"");
        }
        seen.push(k);
    }
    let mut out: Patch<Msg>[] = [];
    let mut i = xs.len - 1;
    while i >= 0 {
        if index_of(wanted, xs[i].0) < 0 {
            out.push(Patch.Remove(child(path, i)));
        }
        i = i - 1;
    }
    // What the keyed column holds now: the kept rows, in their old order.
    let mut keys: string[] = [];
    let mut kept: View<Msg>[] = [];
    for (k, v) of xs {
        if index_of(wanted, k) >= 0 {
            keys.push(k);
            kept.push(v);
        }
    }
    let mut at = 0;
    while at < ys.len {
        let (k, v) = ys[at];
        let j = index_of(keys, k);
        if j < 0 {
            out.push(Patch.Insert(path, at, v));
            keys = inserted(keys, at, k);
            kept = inserted(kept, at, v);
        } else {
            if j != at {
                out.push(Patch.Move(path, j, at));
                keys = moved(keys, j, at);
                kept = moved(kept, j, at);
            }
            out = joined(out, diff_at(child(path, at), kept[at], v));
        }
        at = at + 1;
    }
    out
}

fun keys_of<Msg>(children: (string, View<Msg>)[]): string[] {
    let mut out: string[] = [];
    for (k, _) of children {
        out.push(k);
    }
    out
}

/** Where `key` is in `keys`, or -1. */
fun index_of(keys: string[], key: string): i64 {
    let mut i = 0;
    while i < keys.len {
        if keys[i] == key {
            return i;
        }
        i = i + 1;
    }
    -1
}

/** `xs` with `x` placed at index `at`, the elements from there on shifted down one. */
fun inserted<T>(xs: T[], at: i64, x: T): T[] {
    let mut out: T[] = [];
    let mut i = 0;
    while i < xs.len {
        if i == at {
            out.push(x);
        }
        out.push(xs[i]);
        i = i + 1;
    }
    if at == xs.len {
        out.push(x);
    }
    out
}

/** `xs` without the element at index `skip`. */
fun without<T>(xs: T[], skip: i64): T[] {
    let mut out: T[] = [];
    let mut i = 0;
    while i < xs.len {
        if i != skip {
            out.push(xs[i]);
        }
        i = i + 1;
    }
    out
}

/** `xs` with the element at `from` taken out and put back at index `to`. */
fun moved<T>(xs: T[], from: i64, to: i64): T[] = inserted(without(xs, from), to, xs[from]);

fun child(path: i64[], i: i64): i64[] {
    let mut p = path;
    p.push(i);
    p
}

fun joined<T>(a: T[], b: T[]): T[] {
    let mut out = a;
    for x of b {
        out.push(x);
    }
    out
}
