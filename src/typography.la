/**
 * Styles as values (PRP-016): what `.style([…])` takes. A style is a list of
 * typed values, each applying to a `Sheet` in order: the last value that sets
 * a field wins, and a `Theme` value sets nothing, so a field nothing sets
 * stays the GTK theme's. `Font` picks the typeface and its size; `Text` says
 * what's done with the letters. Pure: `sheets` checks values and turns them
 * into CSS.
 *
 * Depends on: theming (`Color`, `Paint`)
 * Used by: lib, looks, views, sheets, paint
 */

import theming { Paint };

/** Something `.style([…])` can apply: a `Font` or a `Text`. */
public interface Styling {
    /** `s` with this value's fields over it; fields left `Theme` are skipped. */
    fun apply(self, s: Sheet): Sheet;
}

/** Everything `.style` has set on a node, merged: what kivuli turns into CSS. */
public struct Sheet {
    public font: Font,
    public text: Text,
}

impl Sheet {
    /** Nothing set: everything the GTK theme's. */
    public fun theme(): Sheet = Sheet { font: Font.theme(), text: Text.theme() };
}

/** Applies `items` to `s` in order. */
fun applied(s: Sheet, items: Styling[]): Sheet {
    let mut out = s;
    for item of items {
        out = item.apply(out);
    }
    out
}

/** `font-family`. */
public enum Family {
    Theme,
    /** `sans-serif` */
    Sans,
    /** `serif` */
    Serif,
    /** `monospace` */
    Monospace,
    /** A font by name, and the generic family to use when it isn't installed. */
    Named(string, Family),
}

/** `font-size`. */
public enum Size {
    Theme,
    /** Points. */
    Pt(i64),
    /** A multiple of the theme's size, like CSS `em`. */
    Scale(f64),
}

/** `font-weight`. */
public enum Weight {
    Theme,
    /** 100 */
    Thin,
    /** 300 */
    Light,
    /** 400 */
    Normal,
    /** 500 */
    Medium,
    /** 600 */
    Semibold,
    /** 700 */
    Bold,
    /** 900 */
    Black,
}

/** `font-style`. */
public enum FontStyle {
    Theme,
    Normal,
    Italic,
}

/**
 * Which typeface a node's text uses, and how big. Fields left `Theme` (and
 * `tabular` false) stay the GTK theme's.
 *
 * Example:
 *     text("Price").style([Font { weight: Weight.Medium, tabular: true, ..Font.theme() }])
 */
public struct Font {
    public family: Family,
    public size: Size,
    public weight: Weight,
    public style: FontStyle,
    /** Digits all one width, for numbers in columns. */
    public tabular: bool,
}

impl Font {
    /** Every field the theme's: start here and change what you need. */
    public fun theme(): Font = Font {
        family: Family.Theme,
        size: Size.Theme,
        weight: Weight.Theme,
        style: FontStyle.Theme,
        tabular: false,
    };

    /** `s` with every field this font sets. */
    public fun apply(self, s: Sheet): Sheet = Sheet {
        font: Font {
            family: if self.family == Family.Theme { s.font.family } else { self.family },
            size: if self.size == Size.Theme { s.font.size } else { self.size },
            weight: if self.weight == Weight.Theme { s.font.weight } else { self.weight },
            style: if self.style == FontStyle.Theme { s.font.style } else { self.style },
            tabular: self.tabular || s.font.tabular,
        },
        ..s,
    };
}

/** `line-height`. */
public enum LineHeight {
    Theme,
    /** A multiple of the font size. */
    Times(f64),
}

/** `text-decoration-line`. */
public enum Decoration {
    Theme,
    None,
    Underline,
    Strikethrough,
}

/** `text-transform`. */
public enum Transform {
    Theme,
    None,
    Uppercase,
    Lowercase,
    Capitalize,
}

/**
 * What's done with the letters once the font is chosen. Fields left `Theme`
 * (and `letter_spacing` 0, the font's own) stay the GTK theme's.
 *
 * Example:
 *     text("NEW").style([Text { transform: Transform.Uppercase, letter_spacing: 2, ..Text.theme() }])
 */
public struct Text {
    public color: Paint,
    public line_height: LineHeight,
    /** Pixels between letters, over the font's own; negative tightens. */
    public letter_spacing: i64,
    public decoration: Decoration,
    public transform: Transform,
}

impl Text {
    /** Every field the theme's: start here and change what you need. */
    public fun theme(): Text = Text {
        color: Paint.Theme,
        line_height: LineHeight.Theme,
        letter_spacing: 0,
        decoration: Decoration.Theme,
        transform: Transform.Theme,
    };

    /** `s` with every field this text value sets. */
    public fun apply(self, s: Sheet): Sheet = Sheet {
        text: Text {
            color: if self.color == Paint.Theme { s.text.color } else { self.color },
            line_height: if self.line_height == LineHeight.Theme {
                s.text.line_height
            } else {
                self.line_height
            },
            letter_spacing: if self.letter_spacing == 0 {
                s.text.letter_spacing
            } else {
                self.letter_spacing
            },
            decoration: if self.decoration == Decoration.Theme {
                s.text.decoration
            } else {
                self.decoration
            },
            transform: if self.transform == Transform.Theme {
                s.text.transform
            } else {
                self.transform
            },
        },
        ..s,
    };
}
