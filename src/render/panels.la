/**
 * Popovers of views (PRP-055): a `GtkPopover` parented to a box holding the
 * trigger, its child the content's widget, built whether open or not, and
 * opened or closed as the model says. GTK closing it (a click outside,
 * Escape) sends the close message; kivuli closing it sends nothing. Not
 * responsible for building the trigger or the content (`build`).
 *
 * Depends on: live_tree, styling (`flag`), motion (`Edge`), gtk.raw
 * Used by: build, patch
 */

import gtk {
    GSimpleAction,
    GVariant,
    GtkWidget,
    connect_action,
    connect_widget,
    g_action_map_add_action,
    g_simple_action_group_new,
    g_simple_action_group_unref,
    g_simple_action_new,
    g_simple_action_unref,
    g_timeout_add_full,
    gtk_box_append,
    gtk_box_new,
    gtk_popover_new,
    gtk_popover_popdown,
    gtk_popover_popup,
    gtk_popover_set_child,
    gtk_popover_set_has_arrow,
    gtk_popover_set_position,
    gtk_widget_activate_action_variant,
    gtk_widget_get_parent,
    gtk_widget_get_visible,
    gtk_widget_insert_action_group,
    gtk_widget_ref,
    gtk_widget_set_parent,
    gtk_widget_unparent,
    gtk_widget_unref,
};
import core.live_tree { Live, widget };
import render.styling { flag };
import styles.motion { Edge };

/**
 * A popover holding `content` beside `trigger` on `side`, open if `open`;
 * GTK closing it sends `close` through `send`.
 */
fun make_popover<Msg>(
    trigger: Live<Msg>,
    content: Live<Msg>,
    open: bool,
    close: Msg,
    side: Edge,
    arrow: bool,
    send: fun(Msg),
): Live<Msg> {
    let box = gtk_box_new(1, 0);
    gtk_box_append(box, widget(trigger));
    let pop = gtk_popover_new();
    gtk_widget_set_parent(pop, box);
    // Ours too, until the box's `destroy` (below): GTK's box takes its
    // children apart before `destroy`, which could free the popover first.
    gtk_widget_ref(pop);
    gtk_popover_set_child(pop, Some(widget(content)));
    let current = Ref.new(close);
    let quiet = Ref.new(false);
    // Connected once (rule 5): the message is read from `current`.
    connect_widget(
        pop,
        "closed",
        fun(p: GtkWidget) {
            if !quiet.get() {
                send(current.get());
                regrab_around(box);
            }
        },
        0,
    );
    let alive = Ref.new(true);
    // DECISION-045: a popover inside this one closing (a drop-down's list, a
    // menu, a popover) can drop this one's grab on Wayland (GTK ungrabs the
    // whole seat), so a click outside stops closing it. They ask for
    // `kvpop.regrab`, found up through their ancestors: this popover is
    // closed and shown again, quietly, once GTK has finished hiding theirs.
    let group = g_simple_action_group_new();
    let regrab = g_simple_action_new("regrab", None);
    connect_action(
        regrab,
        "activate",
        fun(action: GSimpleAction, arg: Option<GVariant>) {
            g_timeout_add_full(0, 0, fun(): i32 {
                if alive.get() && gtk_widget_get_visible(pop) != 0 {
                    quiet.set(true);
                    gtk_popover_popdown(pop);
                    gtk_popover_popup(pop);
                    quiet.set(false);
                }
                0
            });
        },
        0,
    );
    g_action_map_add_action(group, regrab);
    g_simple_action_unref(regrab);
    gtk_widget_insert_action_group(pop, "kvpop", Some(group));
    g_simple_action_group_unref(group);
    // A widget must not be freed with a popover still parented to it; the
    // box may have unparented it already (DECISION-044).
    connect_widget(
        box,
        "destroy",
        fun(gone: GtkWidget) {
            alive.set(false);
            if gtk_widget_get_parent(pop) == Some(box) {
                gtk_widget_unparent(pop);
            }
            gtk_widget_unref(pop);
        },
        0,
    );
    let node = Live.Popover(box, trigger, pop, content, current, quiet);
    show_popover(node, open, side, arrow, close);
    node
}

/**
 * Asks the kivuli popover around `w`, if any, to take its grab again: a popover
 * inside it just closed (DECISION-045). Nothing answers outside a popover.
 */
fun regrab_around(w: GtkWidget) {
    gtk_widget_activate_action_variant(w, "kvpop.regrab", None);
}

/** `node`'s popover as the view says: open or closed, its side, its arrow, its close message. */
fun show_popover<Msg>(node: Live<Msg>, open: bool, side: Edge, arrow: bool, close: Msg) {
    let Popover(_, _, pop, _, current, quiet) = node else {
        panic("kivuli: a popover's patch points at something that isn't a popover");
    };
    current.set(close);
    gtk_popover_set_position(pop, position(side));
    gtk_popover_set_has_arrow(pop, flag(arrow));
    let shown = gtk_widget_get_visible(pop) != 0;
    if open && !shown {
        gtk_popover_popup(pop);
    } else if !open && shown {
        // kivuli closing it: its `closed` mustn't send the close message.
        quiet.set(true);
        gtk_popover_popdown(pop);
        quiet.set(false);
    }
}

/** `GtkPositionType`: 0 left, 1 right, 2 top, 3 bottom. */
fun position(side: Edge): i32 = match side {
    Left => 0,
    Right => 1,
    Top => 2,
    Bottom => 3,
};
