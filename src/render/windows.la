/**
 * The app's window as the root of the view asks for it (split from `live`):
 * its title and size (`.window`), opening maximized (`.maximized`),
 * clicking away to clear keyboard focus (PRP-024), and hearing when it
 * comes to the front or leaves it (PRP-060, PRP-070), and its clipboard
 * (PRP-064). GTK.
 *
 * Depends on: views, looks, gtk.raw
 * Used by: live
 */

import gtk {
    GtkEventController,
    GtkWidget,
    connect_click,
    gtk_gesture_click_new,
    gtk_gesture_single_set_button,
    gtk_root_get_focus,
    gtk_widget_add_controller,
    gtk_widget_is_ancestor,
    gtk_widget_pick,
    gtk_window_maximize,
    gtk_window_set_default_size,
    gtk_window_set_focus,
    gtk_window_set_title,
    lgtk_window_is_front,
    lgtk_window_on_front,
    gdk_clipboard_set_text,
    gdk_display_get_clipboard,
    gtk_widget_get_display,
};
import view.views { View };
import view.looks { Window };

/** The window a view's root asks for with `.window(…)`, if any. */
fun window_of<Msg>(tree: View<Msg>): Option<Window> = match tree {
    Styled(_, style) => style.window,
    _ => None,
};

/** Retitles and resizes `window` when the root's `.window(…)` changed; a dropped one leaves it as it is. */
fun show_window(window: GtkWidget, old: Option<Window>, new: Option<Window>) {
    if new == old {
        return;
    }
    match new {
        Some(w) => {
            gtk_window_set_title(window, w.title);
            gtk_window_set_default_size(window, w.width as i32, w.height as i32);
        }
        None => {}
    }
}

/**
 * Clicking away clears keyboard focus, as a web page blurs a field (PRP-024):
 * a primary-button gesture on the window, in the bubble phase (GTK's
 * default), so it sees only clicks no widget under the pointer took (buttons,
 * fields and the like take their own). GTK otherwise keeps a field focused
 * whatever is clicked beside it. A click inside the focused widget keeps the
 * focus (DECISION-042): a text view takes the focus on a single press without
 * claiming it, so that press reaches the window too.
 */
fun click_away(window: GtkWidget): GtkEventController {
    let gesture = gtk_gesture_click_new();
    gtk_gesture_single_set_button(gesture, 1);
    connect_click(
        gesture,
        "pressed",
        fun(g: GtkEventController, n: i32, x: f64, y: f64) {
            // The gesture is the window's, so (x, y) is in the window's coordinates.
            if !keeps_focus(gtk_widget_pick(window, x, y, 0), gtk_root_get_focus(window)) {
                gtk_window_set_focus(window, None);
            }
        },
        0,
    );
    gtk_widget_add_controller(window, gesture);
    gesture
}

/** Whether a click on `picked` keeps the focus on `focus`: it landed on the focused widget or inside it. */
fun keeps_focus(picked: Option<GtkWidget>, focus: Option<GtkWidget>): bool = match (picked, focus) {
    (Some(p), Some(f)) => p == f || gtk_widget_is_ancestor(p, f) != 0,
    _ => false,
};

/**
 * Calls `on_change(front)` when the window comes to the front or leaves it
 * (`Sub.window_active`, PRP-060). Connected once, at mount; the caller drops
 * repeats.
 */
fun watch_active(window: GtkWidget, on_change: fun(bool)) {
    // Not `notify::is-active`: that follows keyboard focus on the window's own
    // surface, which its popovers take while open, so it flickers while the
    // window stays in front (DECISION-047, PRP-070).
    lgtk_window_on_front(window, fun(w: GtkWidget, front: i32) {
        on_change(front != 0);
    });
}

/** Puts `text` on the clipboard of the window's display (`Cmd.copy_text`, PRP-064). */
fun copy_text(window: GtkWidget, text: string) {
    gdk_clipboard_set_text(gdk_display_get_clipboard(gtk_widget_get_display(window)), text);
}

/** Whether the window is the one in front now (shown, and the desktop's front window). */
fun is_active(window: GtkWidget): bool = lgtk_window_is_front(window) != 0;

/** On the root, `.maximized()`: the window opens maximized. Read once, when it opens. */
fun show_maximized<Msg>(window: GtkWidget, tree: View<Msg>) {
    let Styled(_, style) = tree else {
        return;
    };
    if style.maximized {
        // Before the window is shown: it opens maximized.
        gtk_window_maximize(window);
    }
}
