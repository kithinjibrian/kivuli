/**
 * The app's window as the root of the view asks for it (split from `live`):
 * its title and size (`.window`), opening maximized (`.maximized`), and
 * clicking away to clear keyboard focus (PRP-024). GTK.
 *
 * Depends on: views, looks, gtk.raw
 * Used by: live
 */

import gtk {
    GtkEventController,
    GtkWidget,
    connect_click,
    gtk_gesture_click_new,
    gtk_gesture_single_set_button,
    gtk_widget_add_controller,
    gtk_window_maximize,
    gtk_window_set_default_size,
    gtk_window_set_focus,
    gtk_window_set_title,
};
import view.views { View };
import view.looks { Window };

/** The window a view's root asks for with `.window(…)`, if any. */
fun window_of<Msg>(tree: View<Msg>): Option<Window> = match tree {
    Styled(_, style) => style.window,
    _ => None,
};

/** Retitles and resizes `window` when the root's `.window(…)` changed; a dropped one leaves it as it is. */
fun show_window(window: GtkWidget, old: Option<Window>, new: Option<Window>) {
    if new == old {
        return;
    }
    match new {
        Some(w) => {
            gtk_window_set_title(window, w.title);
            gtk_window_set_default_size(window, w.width as i32, w.height as i32);
        }
        None => {}
    }
}

/**
 * Clicking away clears keyboard focus, as a web page blurs a field (PRP-024):
 * a primary-button gesture on the window, in the bubble phase (GTK's
 * default), so it sees only clicks no widget under the pointer took (buttons,
 * fields, text areas and the like take their own). GTK otherwise keeps a
 * field focused whatever is clicked beside it.
 */
fun click_away(window: GtkWidget): GtkEventController {
    let gesture = gtk_gesture_click_new();
    gtk_gesture_single_set_button(gesture, 1);
    connect_click(
        gesture,
        "pressed",
        fun(g: GtkEventController, n: i32, x: f64, y: f64) {
            gtk_window_set_focus(window, None);
        },
        0,
    );
    gtk_widget_add_controller(window, gesture);
    gesture
}

/** On the root, `.maximized()`: the window opens maximized. Read once, when it opens. */
fun show_maximized<Msg>(window: GtkWidget, tree: View<Msg>) {
    let Styled(_, style) = tree else {
        return;
    };
    if style.maximized {
        // Before the window is shown: it opens maximized.
        gtk_window_maximize(window);
    }
}
