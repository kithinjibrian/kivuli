/**
 * A context menu's check items and radio groups on real widgets: a stateful
 * action per check item and per radio group, in the menu's action group,
 * made once and kept, its state and whether it's enabled set from the view on
 * each refresh. Not responsible for the menu model naming them or for the
 * popover (`popovers`).
 *
 * Depends on: menus, live_tree, styling (`flag`), gtk.raw
 * Used by: popovers
 */

import gtk {
    GSimpleAction,
    GVariant,
    connect_action,
    g_action_map_add_action,
    g_simple_action_new_stateful,
    g_simple_action_set_enabled,
    g_simple_action_set_state,
    g_simple_action_unref,
    g_variant_new_boolean,
    g_variant_new_string,
    g_variant_type_free,
    g_variant_type_new,
    lgtk_variant_string,
};
import view.menus { MenuEntry, check_items, radio_groups };
import core.live_tree { Popup };
import render.styling { flag };

/**
 * A stateful action per check item, made once by its place among the check
 * items and kept; each refresh sets its state and whether it's enabled from
 * the view, so the tick follows the model. Picking one sends its toggle of
 * the opposite: an `activate` handler is connected, so GTK leaves the state
 * to the next refresh.
 */
fun sync_checks<Msg>(p: Popup<Msg>, entries: MenuEntry<Msg>[], send: fun(Msg)) {
    let wanted = check_items(entries);
    let mut actions = p.checks.get();
    while actions.len < wanted.len {
        let index = actions.len;
        let action = g_simple_action_new_stateful("check{index}", None, g_variant_new_boolean(0));
        connect_action(
            action,
            "activate",
            fun(a: GSimpleAction, param: Option<GVariant>) {
                let now = check_items(p.entries.get());
                if index < now.len {
                    match now[index].1 {
                        Some(f) => send(f(!now[index].0)),
                        None => {}
                    }
                }
            },
            0,
        );
        g_action_map_add_action(p.group, action);
        g_simple_action_unref(action);
        actions.push(action);
    }
    p.checks.set(actions);
    let mut j = 0;
    while j < actions.len {
        let (checked, on_toggle) = if j < wanted.len { wanted[j] } else { (false, None) };
        g_simple_action_set_state(actions[j], g_variant_new_boolean(flag(checked)));
        g_simple_action_set_enabled(actions[j], flag(on_toggle.is_some()));
        j = j + 1;
    }
}

/**
 * A stateful action per radio group (a string state, its items naming it with
 * their label as the target), made once and kept; each refresh sets the
 * selected label. Picking a choice sends that choice's message.
 */
fun sync_radios<Msg>(p: Popup<Msg>, entries: MenuEntry<Msg>[], send: fun(Msg)) {
    let wanted = radio_groups(entries);
    let mut actions = p.radios.get();
    while actions.len < wanted.len {
        let index = actions.len;
        let kind = g_variant_type_new("s");
        let action = g_simple_action_new_stateful(
            "radio{index}",
            Some(kind),
            g_variant_new_string(""),
        );
        g_variant_type_free(kind);
        connect_action(
            action,
            "activate",
            fun(a: GSimpleAction, param: Option<GVariant>) {
                let now = radio_groups(p.entries.get());
                match param {
                    Some(v) => if index < now.len {
                        let label = lgtk_variant_string(v);
                        for (choice, msg) of now[index].1 {
                            if choice == label {
                                match msg {
                                    Some(m) => send(m),
                                    None => {}
                                }
                            }
                        }
                    },
                    None => {}
                }
            },
            0,
        );
        g_action_map_add_action(p.group, action);
        g_simple_action_unref(action);
        actions.push(action);
    }
    p.radios.set(actions);
    let mut j = 0;
    while j < actions.len {
        let (selected, choices) = if j < wanted.len { wanted[j] } else { ("", []) };
        g_simple_action_set_state(actions[j], g_variant_new_string(selected));
        // One action for the group: enabled while any choice sends.
        g_simple_action_set_enabled(actions[j], flag(choices.iter().any(fun(c) = c.1.is_some())));
        j = j + 1;
    }
}
