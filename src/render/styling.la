/**
 * Styling widgets: gives a live widget every field of its `Style` (layout,
 * its style's CSS classes, long text, shortcut, tooltip), defaults included,
 * so a dropped modifier is undone. Used when widgets are made and by `SetStyle`.
 *
 * Depends on: live_tree, looks, style_values, box_rules, keys, widgets, gtk.raw
 * Used by: build, buttons, patch, paths, popovers
 */

import gtk {
    gtk_scrolled_window_get_propagate_natural_height,
    GVariant,
    GtkEventController,
    GtkShortcut,
    GtkWidget,
    emit_widget,
    gtk_box_set_spacing,
    gtk_callback_action_new,
    gtk_entry_set_placeholder_text,
    gtk_flow_box_set_column_spacing,
    gtk_flow_box_set_homogeneous,
    gtk_flow_box_set_max_children_per_line,
    gtk_flow_box_set_row_spacing,
    gtk_image_set_pixel_size,
    gtk_label_get_text,
    gtk_label_set_ellipsize,
    gtk_label_set_lines,
    gtk_label_set_max_width_chars,
    gtk_label_set_selectable,
    gtk_label_set_wrap,
    gtk_label_set_wrap_mode,
    gtk_range_set_increments,
    gtk_scale_set_draw_value,
    gtk_range_set_value,
    gtk_shortcut_controller_add_shortcut,
    gtk_shortcut_controller_remove_shortcut,
    gtk_shortcut_new,
    gtk_shortcut_trigger_parse_string,
    gtk_picture_set_content_fit,
    gtk_widget_add_css_class,
    gtk_widget_get_overflow,
    gtk_widget_has_css_class,
    gtk_widget_set_overflow,
    gtk_widget_get_halign,
    gtk_widget_get_hexpand,
    gtk_widget_get_valign,
    gtk_widget_get_vexpand,
    lgtk_clamp_set_limits,
    gtk_widget_get_visible,
    gtk_widget_set_visible,
    lgtk_remove_css_classes_with_prefix,
    gtk_widget_remove_css_class,
    gtk_label_set_justify,
    gtk_label_set_xalign,
    gtk_widget_set_can_focus,
    gtk_widget_set_can_target,
    gtk_widget_set_focusable,
    gtk_widget_get_parent,
    gtk_widget_set_halign,
    gtk_widget_set_hexpand,
    gtk_widget_set_size_request,
    gtk_widget_set_tooltip_text,
    gtk_widget_set_valign,
    gtk_widget_set_vexpand,
};
import core.live_tree { Choices, Live, widget };
import view.looks { Style, Align, Fit };
import styles.values { Radius, TextAlign, Width };
import styles.box_rules { clamp_limits };
import view.keys { parse };
import view.widgets { snap };
import render.controls { sync_choices };

/**
 * Gives `node`'s widget every field of `style`, defaults included, so a
 * modifier that's gone is undone. `axis` is its parent's (as for `create_in`):
 * `expand` grows along it and `align` places across it.
 */
fun apply_style<Msg>(node: Live<Msg>, style: Style, axis: i32) {
    // A header's modifiers are its body's: `.header` keeps them outside the frame.
    match node {
        Menu(inner, popup) => {
            // `.dropdown_menu`: a primary click opens it too.
            popup.on_click.set(style.menu_on_click);
            apply_style(inner, style, axis);
            return;
        }
        Clamp(inner, clamp) => {
            apply_style(inner, style, axis);
            let (min_w, max_w, min_h, max_h) = clamp_limits(style.sheet.sizing);
            lgtk_clamp_set_limits(clamp, min_w as i32, max_w as i32, min_h as i32, max_h as i32);
            // The parent holds the clamp: how the node takes room and sits
            // moves onto it, and the node fills the clamp.
            let w = widget(inner);
            gtk_widget_set_hexpand(clamp, gtk_widget_get_hexpand(w));
            gtk_widget_set_vexpand(clamp, gtk_widget_get_vexpand(w));
            gtk_widget_set_halign(clamp, gtk_widget_get_halign(w));
            gtk_widget_set_valign(clamp, gtk_widget_get_valign(w));
            gtk_widget_set_hexpand(w, 0);
            gtk_widget_set_vexpand(w, 0);
            gtk_widget_set_halign(w, 0);
            gtk_widget_set_valign(w, 0);
            return;
        }
        Framed(bar, body, _, _, _) => {
            apply_style(body, style, axis);
            // The bar's own style: on the bar only, its window controls untouched.
            lgtk_remove_css_classes_with_prefix(bar, "kv-");
            for class of style.bar_classes {
                gtk_widget_add_css_class(bar, class);
            }
            return;
        }
        _ => {}
    }
    let w = widget(node);
    // Read before kivuli's classes go: whether kivuli turned clipping on here.
    let clipped_by_us = gtk_widget_has_css_class(w, "kv-clip") != 0;
    // The style's values: only kivuli's own classes are replaced.
    lgtk_remove_css_classes_with_prefix(w, "kv-");
    for class of style.classes {
        gtk_widget_add_css_class(w, class);
    }
    // A rounded node clips its content to the curve (GTK rounds the node's own
    // background and border, not its children: probed, PRP-009). Only where
    // it was visible, marked so it can be undone; a widget GTK itself clips is
    // left as it is.
    if rounds(style.sheet.border.radius) {
        if clipped_by_us || gtk_widget_get_overflow(w) == 0 {
            gtk_widget_set_overflow(w, 1);
            gtk_widget_add_css_class(w, "kv-clip");
        }
    } else if clipped_by_us {
        gtk_widget_set_overflow(w, 0);
    }
    // `.inert`: GTK applies both to what's inside too (a page behind a dialog).
    gtk_widget_set_can_target(w, flag(!style.inert));
    gtk_widget_set_can_focus(w, flag(!style.inert));
    // `.focusable`: buttons only, which take focus by default; making a box
    // or a label focusable would put it in the Tab order.
    match node {
        Button(_, _, _, _, _, _) => gtk_widget_set_focusable(w, flag(style.focusable)),
        ButtonWith(_, _, _, _, _) => gtk_widget_set_focusable(w, flag(style.focusable)),
        _ => {}
    }
    // The label kivuli puts in a button or check box takes its decoration
    // classes: CSS doesn't inherit `text-decoration`; everything else it does.
    match node {
        Button(_, _, _, _, label, _) => {
            style_label(label, style);
            place_content(label, style.sheet.text.align);
        }
        Checkbox(_, label, _) => style_label(label, style),
        // Where text sits is the label's own setting (GTK's CSS has no
        // `text-align`); set every time, so a changed value lands.
        Label(w) => align_text(w, style.sheet.text.align),
        _ => {}
    }
    // Spacers and scrolls take spare room (see `create_in`), a fitting scroll
    // (`scroll_fit`) only when `.expand()`ed.
    let grows = style.expand || match node {
        Spacer(_) => true,
        Scroll(w, _) => gtk_scrolled_window_get_propagate_natural_height(w) == 0,
        _ => false,
    };
    if axis == LAYER {
        // An overlay's layer: `.place` sets both ways; it never grows the overlay.
        gtk_widget_set_halign(w, gtk_align(style.place_across));
        gtk_widget_set_valign(w, gtk_align(style.place_down));
    } else if axis == 1 {
        gtk_widget_set_vexpand(w, flag(grows));
        gtk_widget_set_halign(w, gtk_align(style.align));
    } else {
        gtk_widget_set_hexpand(w, flag(grows));
        gtk_widget_set_valign(w, gtk_align(style.align));
    }
    // Sizes are the style's (`Sizing`: CSS minimums, a clamp for the rest).
    // A text area keeps its default height (80 pixels) unless the style sets one.
    let z = style.sheet.sizing;
    let sets_height = z.height != Width.Theme || z.min_height != Width.Theme;
    let floor = match node {
        TextArea(_, _, _) => if sets_height { -1 } else { 80 },
        // A picture's `.size(n)` is its box (`style_picture` below).
        Image(_) => if style.size > 0 { style.size } else { -1 },
        _ => -1,
    };
    gtk_widget_set_size_request(
        w,
        match node {
            Image(_) => floor as i32,
            _ => -1,
        },
        floor as i32,
    );
    gtk_widget_set_tooltip_text(w, if style.tooltip == "" { None } else { Some(style.tooltip) });
    match node {
        // The gap is GTK's spacing, not CSS: a flow box reads no CSS gap.
        Box(box, _, _) => gtk_box_set_spacing(box, gap_of(style) as i32),
        Wrap(flow, _) => {
            // The gap across and down; equal widths; the cap on a line (0: none).
            gtk_flow_box_set_row_spacing(flow, gap_of(style) as u32);
            gtk_flow_box_set_column_spacing(flow, gap_of(style) as u32);
            gtk_flow_box_set_homogeneous(flow, flag(style.equal));
            gtk_flow_box_set_max_children_per_line(
                flow,
                if style.max_per_line > 0 {
                    style.max_per_line as u32
                } else {
                    NO_LINE_LIMIT as u32
                },
            );
        }
        Label(label) => {
            style_long_text(label, style);
            gtk_label_set_selectable(label, flag(style.selectable));
        }
        Checkbox(_, label, _) => style_long_text(label, style),
        Input(entry, _, _) => gtk_entry_set_placeholder_text(
            entry,
            if style.placeholder == "" { None } else { Some(style.placeholder) },
        ),
        Button(button, _, controller, shortcut, label, image) => {
            style_shortcut(controller, shortcut, style.shortcut);
            // The image itself is the node's (build, SetButtonImage); its size is a style.
            gtk_image_set_pixel_size(image, if style.size > 0 { style.size as i32 } else { -1 });
            show_content(button, label, image);
        }
        ButtonWith(_, _, controller, shortcut, _) => style_shortcut(
            controller,
            shortcut,
            style.shortcut,
        ),
        // Pixels on an icon; -1 is the theme's size.
        Icon(image) => gtk_image_set_pixel_size(
            image,
            if style.size > 0 { style.size as i32 } else { -1 },
        ),
        Image(picture) => {
            gtk_picture_set_content_fit(picture, content_fit(style.fit));
            // `.size(n)`: an n × n box (set with the node's size request, above).
        }
        Dropdown(drop, state) => {
            let now = state.get();
            // The blank item reads the placeholder; while GTK is inside the
            // drop-down's own signal, the next sync shows it instead.
            if now.placeholder != style.placeholder {
                state.set(Choices { placeholder: style.placeholder, ..now });
                if !now.busy {
                    sync_choices(drop, state);
                }
            }
        }
        Slider(scale, range, last, _) => {
            let (min, max, _) = range.get();
            range.set((min, max, style.step));
            // Arrow keys move one step, Page Up/Down ten.
            gtk_range_set_increments(scale, style.step as f64, (style.step * 10) as f64);
            gtk_scale_set_draw_value(scale, flag(style.show_value));
            show_number(scale, range, last, last.get());
        }
        _ => {}
    }
}

/**
 * Moves a slider's handle to `n`, put on its range and steps. `last` is set
 * first, so the `value-changed` this causes is seen as no change and sends
 * nothing, even outside a patch.
 */
fun show_number(scale: GtkWidget, range: Ref<(i64, i64, i64)>, last: Ref<i64>, n: i64) {
    let (min, max, step) = range.get();
    let v = snap(n, min, max, step);
    last.set(v);
    gtk_range_set_value(scale, v as f64);
}

/**
 * Gives a label the long-text fields of `style`, defaults included: wrapping
 * (at word boundaries, else characters), its width cap, and ellipsizing, which
 * with wrapping allows three lines.
 */
fun style_long_text(label: GtkWidget, style: Style) {
    gtk_label_set_wrap(label, flag(style.wrap));
    // PangoWrapMode 2: at word boundaries, breaking a word only if it's longer than a line.
    gtk_label_set_wrap_mode(label, 2);
    // PangoEllipsizeMode: 3 end, 0 none.
    gtk_label_set_ellipsize(label, if style.ellipsize { 3 } else { 0 });
    gtk_label_set_lines(label, if style.wrap && style.ellipsize { 3 } else { -1 });
    gtk_label_set_max_width_chars(
        label,
        if style.wrap && style.wrap_at > 0 { style.wrap_at as i32 } else { -1 },
    );
}

/**
 * Puts `combo` (keys as the app wrote them) in the button's shortcut controller in
 * place of the shortcut there now; `""` leaves it without one. Keys kivuli
 * can't read stop the app with a message naming them.
 */
fun style_shortcut(
    controller: GtkEventController,
    current: Ref<Option<GtkShortcut>>,
    combo: string,
) {
    match current.get() {
        Some(old) => gtk_shortcut_controller_remove_shortcut(controller, old),
        None => {}
    }
    current.set(None);
    if combo == "" {
        return;
    }
    let accel = match parse(combo) {
        Ok(g) => g,
        Err(problem) => panic("kivuli: can't read the shortcut \"{combo}\": {problem}"),
    };
    let Some(trigger) = gtk_shortcut_trigger_parse_string(accel) else {
        panic("kivuli: GTK can't read the shortcut \"{combo}\" (as \"{accel}\")");
    };
    // Pressing the keys clicks the button, so a disabled one (no message) sends
    // nothing. A callback action, not GTK's activate action: that one does
    // nothing until the window is on screen.
    let action = gtk_callback_action_new(fun(w: GtkWidget, args: Option<GVariant>): i32 {
        emit_widget(w, "clicked");
        1
    });
    let shortcut = gtk_shortcut_new(trigger, action);
    gtk_shortcut_controller_add_shortcut(controller, shortcut);
    current.set(Some(shortcut));
}

/**
 * Shows a button's label and icon as they're set now: the icon when it's been
 * given a name (visible), the label when it has text or there's no icon. The
 * theme classes are those GTK itself gives such a button: `text-button` for a
 * label, `image-button` for an icon, both for both (GTK's theme has no class
 * of its own for icon and label).
 */
fun show_content(button: GtkWidget, label: GtkWidget, image: GtkWidget) {
    let has_icon = gtk_widget_get_visible(image) != 0;
    let has_label = gtk_label_get_text(label) != "" || !has_icon;
    gtk_widget_set_visible(label, flag(has_label));
    css_class(button, "text-button", has_label);
    css_class(button, "image-button", has_icon);
}

/** Adds the CSS class to the widget, or removes it. */
fun css_class(w: GtkWidget, class: string, on: bool) {
    if on {
        gtk_widget_add_css_class(w, class);
    } else {
        gtk_widget_remove_css_class(w, class);
    }
}

/** GTK's `GtkContentFit` for a `Fit`. */
fun content_fit(fit: Fit): i32 = match fit {
    Fill => 0,
    Contain => 1,
    Cover => 2,
    ScaleDown => 3,
};

/** The style's gap between children in pixels; 0 is GTK's own. */
fun gap_of(style: Style): i64 = match style.sheet.spacing.gap {
    Px(n) => n,
    Theme => 0,
};

/** Whether `r` rounds any corner. */
fun rounds(r: Radius): bool = match r {
    Theme => false,
    All(n) => n > 0,
    Corners(a, b, c, d) => a > 0 || b > 0 || c > 0 || d > 0,
    // The palette's radius: rounded unless an app sets it to almost nothing.
    Small | Medium | Large | XLarge => true,
};

/** Gives a widget's own label the style's text-decoration classes, and no other of kivuli's. */
fun style_label(label: GtkWidget, style: Style) {
    lgtk_remove_css_classes_with_prefix(label, "kv-");
    for class of style.classes {
        // Only text decoration: it's the one text value a label doesn't
        // inherit from its button. A box value (padding, border, background,
        // shadow) on the label too would draw a second box inside the first.
        if class.contains("-td-") {
            gtk_widget_add_css_class(label, class);
        }
    }
}

/**
 * Places a button's content (the box holding its image and `label`) across
 * the button: GTK's centre unless the style says start or end.
 */
fun place_content(label: GtkWidget, a: TextAlign) {
    let at = match a {
        Theme | Center => 3,
        Start => 1,
        End => 2,
    };
    match gtk_widget_get_parent(label) {
        Some(content) => gtk_widget_set_halign(content, at as i32),
        None => {}
    }
}

/** Places `label`'s text in its width (`xalign`) and lines up its wrapped lines (`GtkJustification`). */
fun align_text(label: GtkWidget, a: TextAlign) {
    let (x, justify) = match a {
        // GTK centres; kivuli starts at the start, as the web does.
        Theme | Start => (0.0, 0),
        Center => (0.5, 2),
        End => (1.0, 1),
    };
    gtk_label_set_xalign(label, x as f32);
    gtk_label_set_justify(label, justify as i32);
}

/** `GtkAlign`: 0 fill, 1 start, 2 end, 3 center. */
fun gtk_align(a: Align): i32 = match a {
    Fill => 0,
    Start => 1,
    End => 2,
    Center => 3,
};

/** A Lugha `bool` as a C `gboolean`. */
fun flag(b: bool): i32 = if b { 1 } else { 0 };

/** What "no limit" on a wrap's line means to GTK: more children than any line holds. */
const NO_LINE_LIMIT: i64 = 65535;

/** The "axis" an overlay's layer is built and styled with: placed both ways by `.place`. */
const LAYER: i32 = 2;
