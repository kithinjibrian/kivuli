/**
 * Building widgets: turns a `View` into GTK widgets and gives them their
 * style. Used when a window opens and by the patches that add or replace
 * nodes; not responsible for running the app or deciding what changed
 * (`live`, `diff`).
 *
 * Depends on: live_tree, views, buttons, popovers, box_rules, styling, textures, widgets, controls, gtk.raw
 * Used by: live, patch
 */

import gtk {
    GParamSpec,
    GtkTextBuffer,
    GtkWidget,
    connect_buffer,
    connect_notify,
    connect_widget,
    g_free,
    g_timeout_add_full,
    gtk_box_append,
    gtk_box_new,
    gtk_check_button_get_active,
    gtk_check_button_new,
    gtk_check_button_set_active,
    gtk_check_button_set_child,
    gtk_drop_down_get_selected,
    gtk_drop_down_new,
    gtk_editable_get_text,
    gtk_editable_set_text,
    gtk_entry_new,
    gtk_flow_box_insert,
    gtk_flow_box_new,
    gtk_flow_box_set_max_children_per_line,
    gtk_flow_box_set_selection_mode,
    gtk_header_bar_new,
    gtk_header_bar_pack_end,
    gtk_header_bar_pack_start,
    gtk_header_bar_set_show_title_buttons,
    gtk_header_bar_set_title_widget,
    gtk_image_new_from_icon_name,
    gtk_label_new,
    gtk_overlay_add_overlay,
    gtk_overlay_new,
    gtk_overlay_set_child,
    gtk_picture_new,
    gtk_range_get_value,
    gtk_range_set_range,
    gtk_range_set_value,
    gtk_scale_new_with_range,
    gtk_scale_set_digits,
    gtk_scale_set_draw_value,
    gtk_scrolled_window_get_child,
    gtk_scrolled_window_new,
    gtk_scrolled_window_set_child,
    gtk_separator_new,
    gtk_text_buffer_set_text,
    gtk_text_view_get_buffer,
    gtk_text_view_new,
    gtk_text_view_set_wrap_mode,
    gtk_widget_grab_focus,
    gtk_widget_get_parent,
    gtk_widget_set_focusable,
    gtk_widget_set_hexpand,
    gtk_widget_set_sensitive,
    gtk_widget_set_size_request,
    gtk_widget_set_vexpand,
    lgtk_clamp_new,
    lgtk_clamp_set_child,
    lgtk_cstring_text,
    lgtk_text_get,
};
import core.live_tree { Choices, Live, widget };
import view.views { View };

import render.buttons { create_button, create_button_with };
import render.popovers { attach };
import styles.box_rules { needs_clamp };
import render.styling { LAYER, NO_LINE_LIMIT, align_text, apply_style, flag, show_number };
import styles.values { TextAlign };
import render.textures { show_picture };
import view.widgets { snap };
import render.controls { nearest, picked, sync_choices };

/** Builds the GTK widgets for `v` at the top of a window; each widget sends its messages through `send`. */
fun create<Msg>(v: View<Msg>, send: fun(Msg)): Live<Msg> = create_in(v, 1, send);

/**
 * Builds the GTK widgets for `v` inside a parent laid out along `axis`
 * (`GtkOrientation`: 1 vertical, a column; 0 horizontal, a row). Spacers grow
 * along it and separators cross it.
 */
fun create_in<Msg>(v: View<Msg>, axis: i32, send: fun(Msg)): Live<Msg> = match v {
    Text(s) => {
        // Placed now: a text with no style is never restyled, and GTK centres.
        let label = gtk_label_new(s);
        align_text(label, TextAlign.Theme);
        Live.Label(label)
    }
    Button(label, msg, img) => create_button(label, msg, img, send),
    // Its content is built as a scroll's child is: along a column.
    ButtonWith(content, msg) => create_button_with(create_in(content, 1, send), msg, send),
    // Spacing comes later as a modifier.
    Column(children) => create_box(1, children, send),
    Row(children) => create_box(0, children, send),
    Input(value, messages) => {
        let (on_change, on_submit) = match messages {
            Some((f, enter)) => (Some(f), enter),
            None => (None, None),
        };
        let entry = gtk_entry_new();
        // Set before connecting, so the first text isn't sent as an edit.
        gtk_editable_set_text(entry, value);
        // Disabled (no messages, decision 6): greyed out, and the handlers
        // below send nothing even if GTK delivers a signal.
        gtk_widget_set_sensitive(entry, flag(on_change.is_some()));
        let current = Ref.new(on_change);
        connect_widget(
            entry,
            "changed",
            fun(e: GtkWidget) {
                match current.get() {
                    Some(f) => send(f(gtk_editable_get_text(e))),
                    None => {}
                }
            },
            0,
        );
        let submit = Ref.new(on_submit);
        connect_widget(
            entry,
            "activate",
            fun(e: GtkWidget) {
                match submit.get() {
                    Some(m) => send(m),
                    None => {}
                }
            },
            0,
        );
        Live.Input(entry, current, submit)
    }
    TextArea(value, on_change) => {
        let view = gtk_text_view_new();
        // Word wrapping, breaking a word only when it's longer than the line.
        gtk_text_view_set_wrap_mode(view, 3);
        let buffer = gtk_text_view_get_buffer(view);
        // Set before connecting, so the first text isn't sent as an edit.
        gtk_text_buffer_set_text(buffer, value, -1);
        // Disabled: the editor is greyed out, not the scrolled window, so
        // long text can still be scrolled.
        gtk_widget_set_sensitive(view, flag(on_change.is_some()));
        let current = Ref.new(on_change);
        connect_buffer(
            buffer,
            "changed",
            fun(b: GtkTextBuffer) {
                match current.get() {
                    Some(f) => send(f(text_of(b))),
                    None => {}
                }
            },
            0,
        );
        // Its own scrolled window: long text scrolls instead of growing the window.
        let scrolled = gtk_scrolled_window_new();
        gtk_scrolled_window_set_child(scrolled, Some(view));
        gtk_widget_set_size_request(scrolled, -1, 80);
        Live.TextArea(scrolled, buffer, current)
    }
    Checkbox(label, checked, on_toggle) => {
        // Its own label child, so the long-text modifiers can reach it.
        let check = gtk_check_button_new();
        let text = gtk_label_new(label);
        gtk_check_button_set_child(check, Some(text));
        // Set before connecting, so the first state isn't sent as a toggle.
        gtk_check_button_set_active(check, flag(checked));
        let current = Ref.new(on_toggle);
        // Disabled means no message (rule 6): greyed, and nothing sent.
        gtk_widget_set_sensitive(check, flag(on_toggle.is_some()));
        connect_widget(
            check,
            "toggled",
            fun(c: GtkWidget) {
                match current.get() {
                    Some(f) => send(f(gtk_check_button_get_active(c) != 0)),
                    None => {}
                }
            },
            0,
        );
        Live.Checkbox(check, text, current)
    }
    Dropdown(choices, selected) => {
        let drop = gtk_drop_down_new(None, None);
        let state = Ref.new(Choices {
            offered: choices,
            pick: picked(choices, selected),
            shown: [],
            busy: false,
            placeholder: "",
        });
        // Filled before connecting, so the first pick isn't sent as a choice.
        sync_choices(drop, state);
        connect_notify(
            drop,
            "notify::selected",
            fun(d: GtkWidget, spec: Option<GParamSpec>) {
                let now = state.get();
                let i = gtk_drop_down_get_selected(d) as i64;
                // "None" (0xffffffff) and the blank item send nothing.
                if !now.busy && i < now.shown.len {
                    match now.shown[i].1 {
                        Some(msg) => {
                            // Busy while it's sent: the update's patch must not
                            // replace GTK's list inside this signal.
                            state.update(fun(s) = Choices { busy: true, ..s });
                            send(msg);
                            state.update(fun(s) = Choices { busy: false, ..s });
                        }
                        None => {}
                    }
                }
            },
            0,
        );
        Live.Dropdown(drop, state)
    }
    Slider(min, max, value, on_change) => {
        // Made on 0..1 (GTK refuses an empty range here) and then given its own,
        // which may be a single number.
        let scale = gtk_scale_new_with_range(0, 0.0, 1.0, 1.0);
        gtk_range_set_range(scale, min as f64, max as f64);
        // Whole numbers, drawn beside the handle.
        gtk_scale_set_digits(scale, 0);
        gtk_scale_set_draw_value(scale, 1);
        // Steps of 1 until `.step` styles it; `snap` panics on min > max.
        let range = Ref.new((min, max, 1));
        let last = Ref.new(snap(value, min, max, 1));
        // Set before connecting, so the first number isn't sent as a move.
        show_number(scale, range, last, value);
        let current = Ref.new(on_change);
        // Disabled means no message (rule 6): greyed, and nothing sent.
        gtk_widget_set_sensitive(scale, flag(on_change.is_some()));
        connect_widget(
            scale,
            "value-changed",
            fun(s: GtkWidget) {
                let (lo, hi, step) = range.get();
                let raw = gtk_range_get_value(s);
                let v = snap(nearest(raw), lo, hi, step);
                if v as f64 != raw {
                    // Between steps: put the handle on one; that move comes back here.
                    gtk_range_set_value(s, v as f64);
                } else if v != last.get() {
                    last.set(v);
                    match current.get() {
                        Some(f) => send(f(v)),
                        None => {}
                    }
                }
            },
            0,
        );
        Live.Slider(scale, range, last, current)
    }
    // A theme icon is a GtkImage; a file or bytes a GtkPicture (`textures`).
    Image(img) => match img {
        Icon(name) => Live.Icon(gtk_image_new_from_icon_name(name)),
        _ => {
            let picture = gtk_picture_new();
            show_picture(picture, img);
            Live.Image(picture)
        }
    },
    Spacer => {
        // An empty box given all the spare room along its parent's axis.
        let room = gtk_box_new(0, 0);
        if axis == 1 {
            gtk_widget_set_vexpand(room, 1);
        } else {
            gtk_widget_set_hexpand(room, 1);
        }
        Live.Spacer(room)
    }
    // Across the axis: a horizontal line in a column, a vertical one in a row.
    // Across the axis: a horizontal line in a column (or a layer), a vertical one in a row.
    Separator => Live.Separator(gtk_separator_new(if axis == 0 { 1 } else { 0 })),
    Scroll(child) => {
        let scrolled = gtk_scrolled_window_new();
        // A scrolled window asks for almost no room of its own: let it take
        // the spare room both ways, or it shows a sliver.
        gtk_widget_set_hexpand(scrolled, 1);
        gtk_widget_set_vexpand(scrolled, 1);
        let kid = create_in(child, 1, send);
        gtk_scrolled_window_set_child(scrolled, Some(widget(kid)));
        Live.Scroll(scrolled, kid)
    }
    // On screen a keyed column is a column: the keys matter only to the diff.
    // Transparent: the widgets are those of what it built.
    Lazy(_, build, built) => create_in(
        match built {
            Some(b) => b,
            None => build(),
        },
        axis,
        send,
    ),
    Keyed(children) => create_box(1, children.map(fun(pair) = pair.1), send),
    Overlay(base, layers) => {
        let over = gtk_overlay_new();
        let shown = create_in(base, 1, send);
        gtk_overlay_set_child(over, Some(widget(shown)));
        let mut kids: Live<Msg>[] = [];
        for layer of layers {
            // A layer is placed by `.place`, both ways (LAYER).
            let kid = create_in(layer, LAYER, send);
            gtk_overlay_add_overlay(over, widget(kid));
            kids.push(kid);
        }
        Live.Overlay(over, shown, Live.Layers(over, kids))
    }
    // On screen a keyed wrap is a wrap: the keys matter only to the diff.
    Wrap(children) => create_wrap(children, send),
    KeyedWrap(children) => create_wrap(children.map(fun(pair) = pair.1), send),
    Framed(body, start, title, end) => {
        let bar = gtk_header_bar_new();
        // GTK draws the window's controls, in the system's style.
        gtk_header_bar_set_show_title_buttons(bar, 1);
        // A header bar lays out across: its parts grow along a row.
        let shown = create_in(title, 0, send);
        gtk_header_bar_set_title_widget(bar, Some(widget(shown)));
        Live.Framed(
            bar,
            create_in(body, axis, send),
            shown,
            pack(bar, false, start, send),
            pack(bar, true, end, send),
        )
    }
    Menu(inside, entries) => {
        let node = create_in(inside, axis, send);
        Live.Menu(node, attach(widget(node), entries, send))
    }
    Styled(inside, style) => {
        let made = create_in(inside, axis, send);
        // An exact size or a maximum: the node goes in a clamp, which its parent holds.
        let node = if needs_clamp(style.sheet.sizing) {
            let clamp = lgtk_clamp_new();
            lgtk_clamp_set_child(clamp, Some(widget(made)));
            Live.Clamp(made, clamp)
        } else {
            made
        };
        apply_style(node, style, axis);
        if style.autofocus {
            // On the main loop's next turn: the widget is in its window by then
            // (GTK ignores a focus grab outside one).
            let target = focus_target(node);
            g_timeout_add_full(0, 0, fun(): i32 {
                gtk_widget_grab_focus(target);
                // G_SOURCE_REMOVE: once.
                0
            });
        }
        node
    }
};

/**
 * Builds the views for one end of a header bar and packs each into the bar
 * itself, in order, so the theme's spacing between them applies.
 */
fun pack<Msg>(bar: GtkWidget, at_end: bool, views_of: View<Msg>[], send: fun(Msg)): Live<Msg> {
    let mut kids: Live<Msg>[] = [];
    for v of views_of {
        let kid = create_in(v, 0, send);
        pack_one(bar, at_end, widget(kid));
        kids.push(kid);
    }
    Live.Pack(bar, at_end, kids)
}

/** Packs `w` after those already at that end of the bar (further in, at the end). */
fun pack_one(bar: GtkWidget, at_end: bool, w: GtkWidget) {
    if at_end {
        gtk_header_bar_pack_end(bar, w);
    } else {
        gtk_header_bar_pack_start(bar, w);
    }
}

/** A flow box holding the widgets for `children`, children laid out across. */
fun create_wrap<Msg>(children: View<Msg>[], send: fun(Msg)): Live<Msg> {
    let flow = gtk_flow_box_new();
    // It only lays out: no selection (clicks come from the children).
    gtk_flow_box_set_selection_mode(flow, 0);
    // GTK caps a line at 7 children by default; kivuli's default is no cap.
    gtk_flow_box_set_max_children_per_line(flow, NO_LINE_LIMIT as u32);
    let mut kids: Live<Msg>[] = [];
    for child of children {
        let kid = create_in(child, 0, send);
        add_to_wrap(flow, widget(kid), -1);
        kids.push(kid);
    }
    Live.Wrap(flow, kids)
}

/**
 * Puts `w` in a flow box at `position` (-1: the end). GTK wraps it in a
 * `GtkFlowBoxChild`, which kivuli makes no keyboard stop: Tab goes straight
 * to what's inside.
 */
fun add_to_wrap(flow: GtkWidget, w: GtkWidget, position: i64) {
    gtk_flow_box_insert(flow, w, position as i32);
    match gtk_widget_get_parent(w) {
        Some(wrapper) => gtk_widget_set_focusable(wrapper, 0),
        None => {}
    }
}

/** Builds a `GtkBox` of `orientation` holding the widgets for `children`. */
fun create_box<Msg>(orientation: i32, children: View<Msg>[], send: fun(Msg)): Live<Msg> {
    let box = gtk_box_new(orientation, 0);
    let mut kids: Live<Msg>[] = [];
    for child of children {
        let kid = create_in(child, orientation, send);
        gtk_box_append(box, widget(kid));
        kids.push(kid);
    }
    Live.Box(box, orientation, kids)
}

/** The widget that takes keyboard focus for `node`: a text area's editor, else the node's widget. */
fun focus_target<Msg>(node: Live<Msg>): GtkWidget = match node {
    TextArea(scrolled, _, _) => editor(scrolled),
    Menu(inner, _) => focus_target(inner),
    Clamp(inner, _) => focus_target(inner),
    _ => widget(node),
};

/** A text area's editor (the text view), inside its scrolled window. */
fun editor(scrolled: GtkWidget): GtkWidget = gtk_scrolled_window_get_child(scrolled).unwrap_or(
    scrolled,
);

/** A text buffer's whole text; the copy C allocated is freed. */
fun text_of(buffer: GtkTextBuffer): string {
    let owned = lgtk_text_get(buffer);
    let text = lgtk_cstring_text(owned);
    g_free(owned);
    text
}
