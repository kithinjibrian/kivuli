/**
 * Live widgets: builds real GTK widgets for a `View`, keeps a `Live` tree
 * mirroring them, and on each message applies the diff between the last view
 * and the next instead of rebuilding. The only module that calls GTK. Not
 * responsible for deciding what to show (the app's `view`) or what changed
 * (`diff`).
 *
 * Depends on: diff, lazies, views, effects, build, patch, paths, keys, walk, live_tree, paint, sheets, palettes, schemes, windows, gtk.raw
 * Used by: lib
 */

import gtk {
    GtkApplication,
    GtkCssProvider,
    GtkEventController,
    GtkWidget,
    g_application_quit,
    g_get_monotonic_time,
    g_get_real_time,
    g_source_remove,
    g_timeout_add_full,
    gtk_css_provider_load_from_string,
    lgtk_css_provider_new_for_scheme,
    gtk_style_context_add_provider_for_display,
    gtk_widget_get_display,
    gtk_widget_grab_focus,
    lgtk_scroll_to,
    gtk_window_set_child,
    gtk_window_set_titlebar,
};
import core.diff;
import view.lazies;
import view.views { View };
import core.effects { App, Cmd, Timer, active_listeners, commands, receivers, timers };
import std.task;
import render.build { create, focus_target };
import render.patch { apply };
import core.paths { at };
import view.keys { clash };
import view.walk { path_of_name };
import core.live_tree { Live, titlebar, widget };
import styles.paint { painted };
import styles.gathering { Gathering, gathered };
import styles.palettes { default_tokens };
import render.schemes { scheme_of, show_scheme };
import render.windows {
    click_away,
    copy_text,
    is_active,
    show_maximized,
    show_window,
    watch_active,
    window_of,
};
import styles.sheets { picture_css, url_of };

/** What changes as the app runs: the model, the view it gave, and the widgets showing it. */
struct State<Model, Msg> {
    model: Model,
    tree: View<Msg>,
    live: Live<Msg>,
}

/** A `Sub.every` timer that's running: its key, its GLib source, and the function its ticks call. */
struct Ticking<Msg> {
    key: string,
    source: u32,
    // Re-pointed when the subscription asks again, as buttons' handlers are.
    tick: Ref<fun(i64): Msg>,
}

/** A running app: what's fixed at start, plus what changes. */
struct Running<Model, Msg> {
    application: GtkApplication,
    window: GtkWidget,
    program: App<Model, Msg>,
    // `None` only while the first view is being built.
    state: Ref<Option<State<Model, Msg>>>,
    // True while patches are applied: a widget changed by a patch (an entry's
    // text) emits its signal, and that echo must not dispatch again.
    patching: Ref<bool>,
    timers: Ref<Ticking<Msg>[]>,
    // `Cmd.task`s not delivered yet: each sends its one message on its own channel.
    pending: Ref<Chan<Msg>[]>,
    // The current `Sub.receive`s, as functions taking their channel's next message.
    receiving: Ref<(fun(): Option<Msg>)[]>,
    // Whether the turn source (`turn`) is running.
    turning: Ref<bool>,
    // The app's stylesheet: every CSS rule a view has needed so far.
    styles: Styles,
    // The window's click-away gesture (tests press it).
    blur: GtkEventController,
    // The current `Sub.window_active`s, and the active state they last heard.
    listening: Ref<(fun(bool): Msg)[]>,
    active: Ref<bool>,
}

/**
 * The app's one stylesheet (priority 600, over the GTK theme) and the rules
 * in it. Rules are only ever added: a class's rule never changes, and a value
 * used once may come back.
 */
struct Styles {
    provider: GtkCssProvider,
    /** The rules' keys and pictures' classes in it. */
    classes: Ref<Set<string>>,
    /** The nodes' classes whose rules are in it: a node with only these adds nothing (PRP-069). */
    seen: Ref<Set<string>>,
    css: Ref<string[]>,
}

/**
 * Shows `program`'s first view in `window` and sets the app going: its
 * window title and size, `init`'s command, and its subscriptions.
 */
fun mount<Model, Msg>(
    application: GtkApplication,
    window: GtkWidget,
    program: App<Model, Msg>,
): Running<Model, Msg> {
    let none_yet: Ticking<Msg>[] = [];
    let no_tasks: Chan<Msg>[] = [];
    let no_receivers: (fun(): Option<Msg>)[] = [];
    let no_listeners: (fun(bool): Msg)[] = [];
    let app = Running {
        application: application,
        window: window,
        program: program,
        state: Ref.new(None),
        patching: Ref.new(false),
        timers: Ref.new(none_yet),
        pending: Ref.new(no_tasks),
        receiving: Ref.new(no_receivers),
        turning: Ref.new(false),
        styles: styles_for(window),
        blur: click_away(window),
        listening: Ref.new(no_listeners),
        active: Ref.new(is_active(window)),
    };
    watch_active(window, fun(now: bool) = on_active(app, now));
    let (model, cmd) = program.init;
    let view = program.view;
    let tree = paint_or_stop(lazies.resolve(view(model), None));
    add_rules(app.styles, checked(app.styles, tree));
    let live = create(tree, sender(app));
    gtk_window_set_child(window, widget(live));
    match titlebar(live) {
        Some(bar) => gtk_window_set_titlebar(window, Some(bar)),
        None => {}
    }
    show_maximized(window, tree);
    app.state.set(Some(State { model: model, tree: tree, live: live }));
    show_window(window, None, window_of(tree));
    show_scheme(None, scheme_of(tree));
    perform(app, cmd);
    resubscribe(app, model);
    app
}

/**
 * The window's active state is `now` (GTK's `notify::is-active`): on a real
 * change, each `Sub.window_active` listener sends its message, in order.
 */
fun on_active<Model, Msg>(app: Running<Model, Msg>, now: bool) {
    // GTK may notify without a change: the same value twice sends nothing.
    if now == app.active.get() {
        return;
    }
    app.active.set(now);
    let send = sender(app);
    for f of app.listening.get() {
        send(f(now));
    }
}

/** The widgets `app` shows now. */
fun live_of<Model, Msg>(app: Running<Model, Msg>): Live<Msg> {
    let Some(s) = app.state.get() else {
        panic("kivuli: the app has no view yet");
    };
    s.live
}

/** The function every widget and timer calls to send a message to `app`. */
fun sender<Model, Msg>(app: Running<Model, Msg>): fun(Msg) = fun(msg: Msg) {
    // An echo of our own patch, not the user: the model already has it.
    if !app.patching.get() {
        dispatch(app, msg);
    }
};

/**
 * update → view → diff → patch the widgets → store → retitle the window →
 * carry out the command → start and stop timers to match the subscriptions.
 */
fun dispatch<Model, Msg>(app: Running<Model, Msg>, msg: Msg) {
    let Some(s) = app.state.get() else {
        panic("kivuli: a message arrived before the first view was shown");
    };
    let update = app.program.update;
    let view = app.program.view;
    let (model, cmd) = update(s.model, msg);
    // Lazy nodes whose keys are unchanged at their place reuse what they built.
    let tree = paint_or_stop(lazies.resolve(view(model), Some(s.tree)));
    // Before the patches: a new value's class has its rule when it lands.
    add_rules(app.styles, checked(app.styles, tree));
    let mut live = s.live;
    app.patching.set(true);
    for change of diff.diff(s.tree, tree) {
        live = apply(app.window, live, change, sender(app));
    }
    app.patching.set(false);
    app.state.set(Some(State { model: model, tree: tree, live: live }));
    show_window(app.window, window_of(s.tree), window_of(tree));
    show_scheme(scheme_of(s.tree), scheme_of(tree));
    perform(app, cmd);
    resubscribe(app, model);
}

/** `v` with its looks' classes filled in (`paint`); what the app got wrong stops it. */
fun paint_or_stop<Msg>(v: View<Msg>): View<Msg> = match painted(v) {
    Ok(p) => p,
    Err(problem) => panic("kivuli: {problem}"),
};

/** The app's stylesheet, applied to `window`'s display; its `prefers-color-scheme` rules follow GTK's scheme. */
fun styles_for(window: GtkWidget): Styles {
    let provider = lgtk_css_provider_new_for_scheme();
    // The display keeps the provider for the app's life.
    gtk_style_context_add_provider_for_display(gtk_widget_get_display(window), provider, 600);
    Styles {
        provider: provider,
        classes: Ref.new(#{}),
        seen: Ref.new(#{}),
        css: Ref.new([default_tokens().1]),
    }
}

/**
 * What the painted `tree` needs that `styles` lacks, and its shortcuts, in
 * one pass; two enabled buttons with one shortcut stop the app (GTK would
 * pick one).
 */
fun checked<Msg>(styles: Styles, tree: View<Msg>): Gathering {
    let g = gathered(tree, styles.classes.get(), styles.seen.get());
    match clash(g.shortcuts) {
        Some(combo) => panic("kivuli: two enabled buttons have the shortcut \"{combo}\""),
        None => {}
    }
    g
}

/** Adds the rules and pictures `g` found new to the stylesheet, reloading it only then. */
fun add_rules(styles: Styles, g: Gathering) {
    if g.rules.len == 0 && g.pictures.len == 0 {
        // Nothing new; `seen` may have grown, by classes whose rules are in.
        if g.seen.len != styles.seen.get().len {
            styles.seen.set(g.seen);
        }
        return;
    }
    let mut css = styles.css.get();
    for (_, rule) of g.rules {
        css.push(rule);
    }
    // A picture's rule needs its bytes: read (a file) and checked once, the
    // first time its class is seen.
    for (class, img, gradient, fill) of g.pictures {
        let url = url_of(img, fun(path: string): Option<u8[]> = read_bytes(path).ok());
        css.push(".{class} {{ {picture_css(url, gradient, fill)} }}");
    }
    styles.classes.set(g.known);
    styles.seen.set(g.seen);
    styles.css.set(css);
    gtk_css_provider_load_from_string(styles.provider, css.join("\n"));
}

/** Gives keyboard focus to the node named `name` in the view shown now; nothing if there's none. */
fun focus_named<Model, Msg>(app: Running<Model, Msg>, name: string) {
    let Some(s) = app.state.get() else {
        return;
    };
    match path_of_name(s.tree, name) {
        Some(path) => {
            gtk_widget_grab_focus(focus_target(at(s.live, path)));
        }
        None => {}
    }
}

/**
 * Scrolls the node named `name` in the view shown now into view (GTK does it
 * at the scroll's next layout, so a node added by this update is reached
 * too); nothing if there's none or it's in no scroll.
 */
fun scroll_named<Model, Msg>(app: Running<Model, Msg>, name: string) {
    let Some(s) = app.state.get() else {
        return;
    };
    match path_of_name(s.tree, name) {
        Some(path) => {
            let _ = lgtk_scroll_to(widget(at(s.live, path)));
        }
        None => {}
    }
}

/** Carries out `cmd`: timers for `Cmd.after`, quitting for `Cmd.quit`. */
fun perform<Model, Msg>(app: Running<Model, Msg>, cmd: Cmd<Msg>) {
    for c of commands(cmd) {
        match c {
            After(ms, msg) => {
                let send = sender(app);
                g_timeout_add_full(0, ms as u32, fun(): i32 {
                    send(msg);
                    // G_SOURCE_REMOVE: once only.
                    0
                });
            }
            Quit => g_application_quit(app.application),
            Focus(name) => focus_named(app, name),
            ScrollTo(name) => scroll_named(app, name),
            Copy(text) => copy_text(app.window, text),
            Task(job) => {
                // A green thread does the work; its one message waits on its own channel.
                let result: Chan<Msg> = Chan.buffered(1);
                let _ = spawn deliver(job, result);
                app.pending.update(fun(xs) {
                    let mut ys = xs;
                    ys.push(result);
                    ys
                });
                start_turns(app);
            }
            _ => {}
        }
    }
}

/**
 * Starts and stops `Sub.every` timers so they match what `subscriptions`
 * asks for now. A timer asked for again (same key) keeps running, with its
 * tick re-pointed; one no longer asked for is removed.
 */
fun resubscribe<Model, Msg>(app: Running<Model, Msg>, model: Model) {
    let subscriptions = app.program.subscriptions;
    let wanted = timers(subscriptions(model));
    let mut wanted_keys: Set<string> = #{};
    for w of wanted {
        wanted_keys.insert(w.key);
    }
    let mut kept: Map<string, Ticking<Msg>> = #{};
    for t of app.timers.get() {
        if wanted_keys.has(t.key) {
            kept[t.key] = t;
        } else {
            g_source_remove(t.source);
        }
    }
    let mut next: Ticking<Msg>[] = [];
    for w of wanted {
        match kept.get(w.key) {
            Some(t) => {
                t.tick.set(w.tick);
                next.push(t);
            }
            None => next.push(start_timer(app, w)),
        }
    }
    app.timers.set(next);
    app.receiving.set(receivers(subscriptions(model)));
    app.listening.set(active_listeners(subscriptions(model)));
    if app.receiving.get().len > 0 {
        start_turns(app);
    }
}

/** A task's green thread: the work, then its message on `result`. */
fun deliver<Msg>(job: fun(): Msg, result: Chan<Msg>) {
    result.send(job());
}

/**
 * Starts the turn source if it isn't running. GTK's main loop holds the one
 * OS thread every green thread shares (it's one `extern` call), so tasks and
 * workers only run when kivuli hands Lugha's scheduler a turn.
 */
fun start_turns<Model, Msg>(app: Running<Model, Msg>) {
    if app.turning.get() {
        return;
    }
    app.turning.set(true);
    g_timeout_add_full(0, TURN_EVERY_MS as u32, fun(): i32 = turn(app));
}

/** How often green threads get a turn while any task or `Sub.receive` is active. */
const TURN_EVERY_MS: i64 = 4;

/** The most of each turn green threads may keep, in microseconds: the window keeps the rest. */
const TURN_BUDGET_US: i64 = 2000;

/** A `yield_now` shorter than this found nothing ready (it only checked sockets and sleepers). */
const NOTHING_RAN_US: i64 = 25;

/** The most messages one turn delivers from `Sub.receive`s, so a flood can't hold the window. */
const MAX_RECEIVED_PER_TURN: i64 = 256;

/**
 * One turn: green threads run (`yield_now` wakes sleepers, polls sockets
 * without waiting, and runs what's ready one round) while they keep finding
 * work, up to the budget; then finished tasks' messages and received values
 * are dispatched, in order. The source stops when nothing is left.
 * @returns 1 to run again (G_SOURCE_CONTINUE), 0 to stop
 */
fun turn<Model, Msg>(app: Running<Model, Msg>): i32 {
    let start = g_get_monotonic_time();
    let mut busy = true;
    while busy {
        let before = g_get_monotonic_time();
        task.yield_now();
        let after = g_get_monotonic_time();
        busy = after - before >= NOTHING_RAN_US && after - start < TURN_BUDGET_US;
    }
    // Finished tasks, oldest first; each delivers exactly once.
    let mut waiting: Chan<Msg>[] = [];
    let mut done: Msg[] = [];
    for result of app.pending.get() {
        match result.try_recv() {
            Some(msg) => done.push(msg),
            None => waiting.push(result),
        }
    }
    app.pending.set(waiting);
    for msg of done {
        dispatch(app, msg);
    }
    // Received values: the receivers are read again after each message, so a
    // subscription an update drops gets nothing more.
    let mut delivered = 0;
    let mut i = 0;
    while delivered < MAX_RECEIVED_PER_TURN && i < app.receiving.get().len {
        let poll = app.receiving.get()[i];
        match poll() {
            Some(msg) => {
                dispatch(app, msg);
                delivered = delivered + 1;
                i = 0;
            }
            None => {
                i = i + 1;
            }
        }
    }
    if app.pending.get().len == 0 && app.receiving.get().len == 0 {
        app.turning.set(false);
        // G_SOURCE_REMOVE: an idle app costs nothing.
        0
    } else {
        1
    }
}

fun start_timer<Model, Msg>(app: Running<Model, Msg>, timer: Timer<Msg>): Ticking<Msg> {
    let tick = Ref.new(timer.tick);
    let send = sender(app);
    let source = g_timeout_add_full(0, timer.ms as u32, fun(): i32 {
        let f = tick.get();
        // Milliseconds since 1970.
        send(f(g_get_real_time() / 1000));
        // G_SOURCE_CONTINUE: until `resubscribe` removes it.
        1
    });
    Ticking { key: timer.key, source: source, tick: tick }
}
