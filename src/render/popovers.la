/**
 * Context menus on real widgets: a `GtkPopoverMenu` parented to the node's
 * widget, showing a `GMenu` whose items name actions (`kv.item0`, …) in an
 * action group on the widget; a right-click, a long press and the Menu key
 * (Shift+F10) open it. Not responsible for what the entries are (`menus`) or
 * when they change (`diff`).
 *
 * Depends on: menus, live_tree, styling (`flag`), gtk.raw
 * Used by: build, patch
 */

import gtk {
    GMenu,
    GSimpleAction,
    GVariant,
    GdkRectangle,
    GtkEventController,
    GtkWidget,
    connect_action,
    connect_click,
    connect_long_press,
    connect_widget,
    g_action_map_add_action,
    g_menu_append,
    g_menu_append_section,
    g_menu_new,
    g_menu_unref,
    g_simple_action_group_new,
    g_simple_action_group_unref,
    g_simple_action_new,
    g_simple_action_set_enabled,
    g_simple_action_unref,
    gtk_callback_action_new,
    gtk_gesture_click_new,
    gtk_gesture_long_press_new,
    gtk_gesture_single_set_button,
    GMenuItem,
    g_menu_append_item,
    g_menu_append_submenu,
    g_menu_item_new,
    g_menu_item_set_action_and_target_value,
    g_simple_action_new_stateful,
    g_simple_action_set_state,
    g_variant_new_boolean,
    g_variant_new_string,
    g_variant_type_free,
    g_variant_type_new,
    lgtk_variant_string,
    g_menu_item_unref,
    gtk_event_controller_set_propagation_phase,
    gtk_gesture_set_state,
    gtk_popover_menu_new_from_model_full,
    lgtk_menu_item_set_string,
    gtk_popover_menu_set_menu_model,
    gtk_popover_popdown,
    gtk_popover_popup,
    gtk_popover_set_has_arrow,
    gtk_popover_set_pointing_to,
    gtk_shortcut_action_ref,
    gtk_shortcut_controller_add_shortcut,
    gtk_shortcut_controller_new,
    gtk_shortcut_controller_set_scope,
    gtk_shortcut_new,
    gtk_shortcut_trigger_parse_string,
    gtk_widget_add_controller,
    gtk_widget_get_height,
    gtk_widget_get_width,
    gtk_widget_insert_action_group,
    gtk_widget_get_parent,
    gtk_widget_ref,
    gtk_widget_set_parent,
    gtk_widget_unparent,
    gtk_widget_unref,
};
import view.menus { MenuEntry, check_items, items, layout, message_of, plain_items, radio_groups };
import view.keys { parse };
import core.live_tree { Popup };
import render.styling { flag };

/**
 * Gives `w` a context menu showing `entries`: the popover, the action group,
 * the gestures and the shortcut, each made and connected once for the
 * widget's whole life (`refresh` changes what they show and send).
 */
fun attach<Msg>(w: GtkWidget, entries: MenuEntry<Msg>[], send: fun(Msg)): Popup<Msg> {
    let group = g_simple_action_group_new();
    gtk_widget_insert_action_group(w, "kv", Some(group));
    // The widget holds the group now; ours is dropped, and the group lives as long as it.
    g_simple_action_group_unref(group);
    let empty = g_menu_new();
    // Nested: a submenu opens beside its item, not in its menu's place.
    let popover = gtk_popover_menu_new_from_model_full(Some(empty), 1);
    gtk_widget_set_parent(popover, w);
    // Ours too, until `w`'s `destroy` (below): a box takes its children
    // apart before `destroy`, which could free the popover first.
    gtk_widget_ref(popover);
    // A context menu opens where it was asked for, without an arrow.
    gtk_popover_set_has_arrow(popover, 0);
    // A widget must not be freed with a popover still parented to it (GTK warns,
    // and the popover leaks): it goes when the widget does, unless the widget
    // unparented it already (DECISION-044).
    connect_widget(
        w,
        "destroy",
        fun(gone: GtkWidget) {
            if gtk_widget_get_parent(popover) == Some(w) {
                gtk_widget_unparent(popover);
            }
            gtk_widget_unref(popover);
        },
        0,
    );
    let current: Ref<MenuEntry<Msg>[]> = Ref.new([]);
    // Opens the menu pointing at a rectangle of `w`, if it has an item: a node
    // whose menu was taken away (`[]`) keeps its gestures, which then do nothing.
    let open = fun(x: i32, y: i32, wide: i32, high: i32): bool {
        if layout(current.get()).len == 0 {
            return false;
        }
        gtk_popover_set_pointing_to(
            popover,
            ptr GdkRectangle { x: x, y: y, width: wide, height: high },
        );
        gtk_popover_popup(popover);
        true
    };
    let click = gtk_gesture_click_new();
    // The secondary button: the primary is the node's own (a button's click).
    gtk_gesture_single_set_button(click, 3);
    connect_click(
        click,
        "pressed",
        fun(g: GtkEventController, n: i32, x: f64, y: f64) {
            open(x as i32, y as i32, 1, 1);
        },
        0,
    );
    gtk_widget_add_controller(w, click);
    let hold = gtk_gesture_long_press_new();
    connect_long_press(
        hold,
        "pressed",
        fun(g: GtkEventController, x: f64, y: f64) {
            open(x as i32, y as i32, 1, 1);
        },
        0,
    );
    gtk_widget_add_controller(w, hold);
    // A primary click opens it too while `on_click` (`.dropdown_menu`): seen in
    // the capture phase and claimed, so a button under it doesn't get the click.
    let on_click = Ref.new(false);
    let primary = gtk_gesture_click_new();
    gtk_gesture_single_set_button(primary, 1);
    gtk_event_controller_set_propagation_phase(primary, 1);
    connect_click(
        primary,
        "pressed",
        fun(g: GtkEventController, n: i32, x: f64, y: f64) {
            // Below the whole node, as a drop-down opens.
            if on_click.get() && open(0, 0, gtk_widget_get_width(w), gtk_widget_get_height(w)) {
                // GTK_EVENT_SEQUENCE_CLAIMED.
                gtk_gesture_set_state(g, 1);
            }
        },
        0,
    );
    gtk_widget_add_controller(w, primary);
    // Local scope: the keys work while the node or something inside it has focus.
    let controller = gtk_shortcut_controller_new();
    gtk_shortcut_controller_set_scope(controller, 0);
    let menu_keys = gtk_callback_action_new(
        fun(owner: GtkWidget, args: Option<GVariant>): i32 = flag(
            open(0, 0, gtk_widget_get_width(owner), gtk_widget_get_height(owner)),
        ),
    );
    let trigger = gtk_shortcut_trigger_parse_string("Menu|<Shift>F10").expect(
        "GTK reads the Menu key and Shift+F10",
    );
    // The shortcut takes the action; ours is kept for tests to run it.
    gtk_shortcut_controller_add_shortcut(
        controller,
        gtk_shortcut_new(trigger, gtk_shortcut_action_ref(menu_keys)),
    );
    gtk_widget_add_controller(w, controller);
    let popup = Popup {
        popover: popover,
        group: group,
        actions: Ref.new([]),
        entries: current,
        model: Ref.new(empty),
        shown: Ref.new([]),
        click: click,
        hold: hold,
        primary: primary,
        on_click: on_click,
        checks: Ref.new([]),
        radios: Ref.new([]),
        keys: menu_keys,
    };
    g_menu_unref(empty);
    refresh(popup, entries, send);
    popup
}

/**
 * Shows `entries` from now on: the messages re-pointed always, the menu
 * model rebuilt only when labels or separators changed, and each item's
 * action enabled when it has a message. An open menu stays open.
 */
fun refresh<Msg>(p: Popup<Msg>, entries: MenuEntry<Msg>[], send: fun(Msg)) {
    p.entries.set(entries);
    let shape = layout(entries);
    if shape != p.shown.get() {
        let model = model_of(entries);
        gtk_popover_menu_set_menu_model(p.popover, Some(model));
        p.model.set(model);
        // The popover holds the model now.
        g_menu_unref(model);
        p.shown.set(shape);
    }
    // One action per item, by its place among the items, connected once;
    // each reads its message from `p.entries` when picked.
    let mut actions = p.actions.get();
    let mut i = actions.len;
    while i < plain_items(entries).len {
        let index = i;
        let action = g_simple_action_new("item{index}", None);
        connect_action(
            action,
            "activate",
            fun(a: GSimpleAction, param: Option<GVariant>) {
                match message_of(p.entries.get(), index) {
                    Some(msg) => send(msg),
                    None => {}
                }
            },
            0,
        );
        g_action_map_add_action(p.group, action);
        // The group holds it; the pointer stays valid as long as the group.
        g_simple_action_unref(action);
        actions.push(action);
        i = i + 1;
    }
    p.actions.set(actions);
    sync_checks(p, entries, send);
    sync_radios(p, entries, send);
    let mut j = 0;
    while j < actions.len {
        g_simple_action_set_enabled(actions[j], flag(message_of(entries, j).is_some()));
        j = j + 1;
    }
    if items_in(entries) == 0 {
        gtk_popover_popdown(p.popover);
    }
}

fun items_in<Msg>(entries: MenuEntry<Msg>[]): i64 = items(entries).len;

/**
 * A stateful action per check item, made once by its place among the check
 * items and kept; each refresh sets its state and whether it's enabled from
 * the view, so the tick follows the model. Picking one sends its toggle of
 * the opposite: an `activate` handler is connected, so GTK leaves the state
 * to the next refresh.
 */
fun sync_checks<Msg>(p: Popup<Msg>, entries: MenuEntry<Msg>[], send: fun(Msg)) {
    let wanted = check_items(entries);
    let mut actions = p.checks.get();
    while actions.len < wanted.len {
        let index = actions.len;
        let action = g_simple_action_new_stateful("check{index}", None, g_variant_new_boolean(0));
        connect_action(
            action,
            "activate",
            fun(a: GSimpleAction, param: Option<GVariant>) {
                let now = check_items(p.entries.get());
                if index < now.len {
                    match now[index].1 {
                        Some(f) => send(f(!now[index].0)),
                        None => {}
                    }
                }
            },
            0,
        );
        g_action_map_add_action(p.group, action);
        g_simple_action_unref(action);
        actions.push(action);
    }
    p.checks.set(actions);
    let mut j = 0;
    while j < actions.len {
        let (checked, on_toggle) = if j < wanted.len { wanted[j] } else { (false, None) };
        g_simple_action_set_state(actions[j], g_variant_new_boolean(flag(checked)));
        g_simple_action_set_enabled(actions[j], flag(on_toggle.is_some()));
        j = j + 1;
    }
}

/**
 * A stateful action per radio group (a string state, its items naming it with
 * their label as the target), made once and kept; each refresh sets the
 * selected label. Picking a choice sends that choice's message.
 */
fun sync_radios<Msg>(p: Popup<Msg>, entries: MenuEntry<Msg>[], send: fun(Msg)) {
    let wanted = radio_groups(entries);
    let mut actions = p.radios.get();
    while actions.len < wanted.len {
        let index = actions.len;
        let kind = g_variant_type_new("s");
        let action = g_simple_action_new_stateful(
            "radio{index}",
            Some(kind),
            g_variant_new_string(""),
        );
        g_variant_type_free(kind);
        connect_action(
            action,
            "activate",
            fun(a: GSimpleAction, param: Option<GVariant>) {
                let now = radio_groups(p.entries.get());
                match param {
                    Some(v) => if index < now.len {
                        let label = lgtk_variant_string(v);
                        for (choice, msg) of now[index].1 {
                            if choice == label {
                                match msg {
                                    Some(m) => send(m),
                                    None => {}
                                }
                            }
                        }
                    },
                    None => {}
                }
            },
            0,
        );
        g_action_map_add_action(p.group, action);
        g_simple_action_unref(action);
        actions.push(action);
    }
    p.radios.set(actions);
    let mut j = 0;
    while j < actions.len {
        let (selected, choices) = if j < wanted.len { wanted[j] } else { ("", []) };
        g_simple_action_set_state(actions[j], g_variant_new_string(selected));
        // One action for the group: enabled while any choice sends.
        g_simple_action_set_enabled(actions[j], flag(choices.iter().any(fun(c) = c.1.is_some())));
        j = j + 1;
    }
}

/**
 * The menu model: items in sections, a new section after each separator and
 * at each label (the section's title); submenus nested, their items numbered
 * on from the menu's (`items`' order).
 */
fun model_of<Msg>(entries: MenuEntry<Msg>[]): GMenu = model_from(entries, Counters {
    item: Ref.new(0),
    check: Ref.new(0),
    radio: Ref.new(0),
});

/** The next plain item's, check item's and radio group's numbers, as the model is built. */
struct Counters {
    item: Ref<i64>,
    check: Ref<i64>,
    radio: Ref<i64>,
}

fun model_from<Msg>(entries: MenuEntry<Msg>[], next: Counters): GMenu {
    let menu = g_menu_new();
    let section = Ref.new(g_menu_new());
    let title: Ref<Option<string>> = Ref.new(None);
    let filled = Ref.new(false);
    // An empty, untitled section would draw a stray separator: only a filled
    // or titled one is added.
    let close = fun() {
        if filled.get() || title.get().is_some() {
            g_menu_append_section(menu, title.get(), section.get());
        }
        g_menu_unref(section.get());
        section.set(g_menu_new());
        title.set(None);
        filled.set(false);
    };
    for e of entries {
        match e {
            Item(label, _) => {
                add_item(section.get(), label, "", "kv.item", next.item);
                filled.set(true);
            }
            Hinted(label, _, combo) => {
                add_item(section.get(), label, combo, "kv.item", next.item);
                filled.set(true);
            }
            Check(label, _, _, combo) => {
                add_item(section.get(), label, combo, "kv.check", next.check);
                filled.set(true);
            }
            Radio(_, choices) => {
                let group = "kv.radio{next.radio.get()}";
                next.radio.set(next.radio.get() + 1);
                for (label, _) of choices {
                    let item: GMenuItem = g_menu_item_new(Some(label), None);
                    // Each choice names the group's action with its label: GTK dots the one matching its state.
                    g_menu_item_set_action_and_target_value(
                        item,
                        group,
                        g_variant_new_string(label),
                    );
                    g_menu_append_item(section.get(), item);
                    g_menu_item_unref(item);
                }
                filled.set(true);
            }
            Separator => close(),
            Label(text) => {
                close();
                title.set(Some(text));
            }
            Submenu(label, inner) => {
                let sub = model_from(inner, next);
                g_menu_append_submenu(section.get(), Some(label), sub);
                g_menu_unref(sub);
                filled.set(true);
            }
        }
    }
    if filled.get() || title.get().is_some() {
        g_menu_append_section(menu, title.get(), section.get());
    }
    g_menu_unref(section.get());
    menu
}

/** Appends an item naming the next action `prefix{n}` to `section`, with `combo` shown at its end unless `""`. */
fun add_item(section: GMenu, label: string, combo: string, prefix: string, next: Ref<i64>) {
    let item: GMenuItem = g_menu_item_new(Some(label), Some("{prefix}{next.get()}"));
    next.set(next.get() + 1);
    if combo != "" {
        match parse(combo) {
            Ok(accel) => lgtk_menu_item_set_string(item, "accel", accel),
            Err(problem) => panic("kivuli: item(\"{label}\").hint(\"{combo}\"): {problem}"),
        }
    }
    g_menu_append_item(section, item);
    g_menu_item_unref(item);
}
