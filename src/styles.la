/**
 * Styles as values (PRPs 016, 017): what `.style([…])` takes. A style is a list of
 * typed values, each applying to a `Sheet` in order: the last value that sets
 * a field wins, and a `Theme` value sets nothing, so a field nothing sets
 * stays the GTK theme's. The groups themselves live in `styles/`: `fonts`
 * (`Font`, `Text`), `boxes` (`Background`, `Border`, `Outline`, `Spacing`,
 * `Sizing`) and `drawing` (`Shadow`, `Effects`). Pure: `sheets` checks values
 * and turns them into CSS.
 *
 * Depends on: styles.fonts, styles.boxes, styles.drawing, styles.motion
 * Used by: box_rules, lib, looks, paint, sheets, views, widgets, the files in styles/
 */

// The second allowed cycle (DECISION-025): each group's `apply` takes a
// `Sheet`, and `Sheet` holds every group.
import styles.fonts { Font, Text };
import styles.boxes { Background, Border, Outline, Spacing, Sizing };
import styles.drawing { Shadow, Effects, Mark };
import styles.motion { Motion };

/** Something `.style([…])` can apply: a `Font`, a `Text`, a `Background`, a `Border`, an `Outline`, a `Spacing` or a `Sizing`. */
public interface Styling {
    /** `s` with this value's fields over it; fields left `Theme` are skipped. */
    fun apply(self, s: Sheet): Sheet;
}

/** Everything `.style` has set on a node, merged: what kivuli turns into CSS. */
public struct Sheet {
    public font: Font,
    public text: Text,
    public background: Background,
    /** The four sides resolved (`all` folded in), and the corners. */
    public border: Border,
    public outline: Outline,
    /** Padding, margin (each side resolved) and the gap between children. */
    public spacing: Spacing,
    public sizing: Sizing,
    /** Each state's own values (`When`), merged over these while it's on; in the order first given. */
    public states: (State, Sheet)[],
    public shadow: Shadow,
    public effects: Effects,
    public motion: Motion,
    /** Each part's own values (`Inside`), in the order first given. */
    public parts: (Part, Sheet)[],
    /** The icon GTK draws in this part (`Mark.icon`): a check box's tick. */
    public mark: Mark,
}

impl Sheet {
    /** Nothing set: everything the GTK theme's. */
    public fun theme(): Sheet = Sheet {
        font: Font.theme(),
        text: Text.theme(),
        background: Background.theme(),
        border: Border.theme(),
        outline: Outline.theme(),
        spacing: Spacing.theme(),
        sizing: Sizing.theme(),
        states: [],
        shadow: Shadow.theme(),
        effects: Effects.theme(),
        motion: Motion.theme(),
        parts: [],
        mark: Mark.theme(),
    };
}

/**
 * Several style values as one: a component's variant (`Badge.outline()`), or
 * an app's own. Its items apply in order, as if written in its place.
 *
 * Example:
 *     fun quiet(): Look = look([Text.color(Token.MutedForeground), Font.sm()]);
 */
public struct Look {
    public items: Styling[],
}

impl Look {
    /** `s` with every item applied in order. */
    public fun apply(self, s: Sheet): Sheet = applied(s, self.items);
}

/** `items` as one style value. */
public fun look(items: Styling[]): Look = Look { items: items };

/** Applies `items` to `s` in order. */
fun applied(s: Sheet, items: Styling[]): Sheet {
    let mut out = s;
    for item of items {
        out = item.apply(out);
    }
    out
}

/**
 * A state a node can be in, as GTK's CSS names it. When two are on at once,
 * the later in this order wins: `Hover` < `Focus` < `FocusWithin` < `Press` < `Checked` < `Disabled`.
 */
public enum State {
    /** The pointer is over it (`:hover`). */
    Hover,
    /** It's being pressed (`:active`). */
    Press,
    /** It has keyboard focus (`:focus-visible`). */
    Focus,
    /**
     * It, or something inside it, has focus, however it got there
     * (`:focus-within`): a text field being typed in (its typing area takes
     * the focus, not the field).
     */
    FocusWithin,
    /** It sends nothing: greyed out (`:disabled`). */
    Disabled,
    /** A check box that's ticked (`:checked`). */
    Checked,
}

/** Style values for one state: made by `When`. */
public struct StateStyle {
    public state: State,
    public items: Styling[],
}

impl StateStyle {
    /** `s` with these values merged into its sheet for this state (a second `When` of it merges into the first). */
    public fun apply(self, s: Sheet): Sheet {
        let mut states = s.states;
        let mut i = 0;
        while i < states.len {
            if states[i].0 == self.state {
                states[i] = (self.state, applied(states[i].1, self.items));
                return Sheet { states: states, ..s };
            }
            i = i + 1;
        }
        states.push((self.state, applied(Sheet.theme(), self.items)));
        Sheet { states: states, ..s }
    }
}

/**
 * Style values that apply only while the node is in `state`, merged over its
 * own: a hovered button keeps its border and changes what this sets.
 *
 * Example:
 *     button("Save", Msg.Save).style([When(State.Hover, [Background { color: Paint.Color(hex("#3a62a8")), ..Background.theme() }])])
 */
public fun When(state: State, items: Styling[]): StateStyle = StateStyle {
    state: state,
    items: items,
};

/** A part inside a widget, as GTK's CSS names it. */
public enum Part {
    /** A check box's box (`check`), where GTK draws the tick. */
    Check,
    /** A slider's track (`trough`). */
    Trough,
    /** The filled part of a slider's track, up to the thumb (`highlight`). */
    Highlight,
    /** A slider's thumb (`slider`). */
    Knob,
    /** A drop-down's button (`> button`): its own, not one inside its list. */
    Trigger,
    /** A drop-down's arrow (`arrow`). */
    Arrow,
    /** A drop-down's pop-up list, its box (`popover > contents`). */
    List,
    /** An item in a drop-down's pop-up (`popover row`), not the one shown in the button. */
    Item,
    /** A menu's box (`popover.menu > contents`): `.menu`'s and `.dropdown_menu`'s. */
    MenuBox,
    /** A menu's item (`popover.menu modelbutton`). */
    MenuItem,
    /** A menu group's title (`popover.menu label.title`, from `menu_label`). */
    MenuLabel,
    /** A line between a menu's groups (`popover.menu separator`). */
    MenuSeparator,
    /** The shortcut shown at a menu item's end (`popover.menu accelerator`, from `.hint`). */
    MenuHint,
    /** A check item's box in a menu (`popover.menu check`): `:checked` while ticked. */
    MenuCheck,
    /** A radio item's circle in a menu (`popover.menu radio`): `:checked` while selected. */
    MenuRadio,
    /**
     * The tooltip windows (`~ tooltip`): GTK hangs them off the window, after
     * the root view, so this is for the root's style; elsewhere it matches nothing.
     */
    Tooltip,
    /** A progress bar's filled part (`progress`); its track is `Trough`. */
    Fill,
    /** A group's heading in a grouped drop-down's list (`popover listview > header`). */
    GroupHeading,
    /** The line above each group but the first in a grouped drop-down's list (`popover listview > header separator`). */
    GroupLine,
    /** A header bar's window controls, each of − □ × (`windowcontrols > button`): for a bar's `.style` only. */
    WindowButton,
    /** A header bar's close control alone (`windowcontrols > button.close`): for a bar's `.style` only. */
    WindowClose,
    /**
     * The icon inside each window control (`windowcontrols > button > image`),
     * where the themes draw their round hover circle: for a bar's `.style` only.
     */
    WindowIcon,
    /** The close control's icon alone (`windowcontrols > button.close > image`): for a bar's `.style` only. */
    WindowCloseIcon,
    /** A popover's panel (`> popover > contents`): `popover`'s own, not one inside its content. */
    Popover,
}

/** Style values for one part: made by `Inside`. */
public struct PartStyle {
    public part: Part,
    public items: Styling[],
}

impl PartStyle {
    /** `s` with these values merged into its sheet for this part (a second `Inside` of it merges into the first). */
    public fun apply(self, s: Sheet): Sheet {
        let mut parts = s.parts;
        let mut i = 0;
        while i < parts.len {
            if parts[i].0 == self.part {
                parts[i] = (self.part, applied(parts[i].1, self.items));
                return Sheet { parts: parts, ..s };
            }
            i = i + 1;
        }
        parts.push((self.part, applied(Sheet.theme(), self.items)));
        Sheet { parts: parts, ..s }
    }
}

/**
 * Style values for a part inside the node's widget, not the node: a check
 * box's box. Inside `When`, the state is the widget's.
 *
 * Example:
 *     checkbox("Accept", m.ok, Msg.Ok).style([When(State.Checked, [Inside(Part.Check, [Background.color(Token.Primary)])])])
 */
public fun Inside(part: Part, items: Styling[]): PartStyle = PartStyle { part: part, items: items };
