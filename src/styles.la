/**
 * Styles as values (PRPs 016, 017): what `.style([…])` takes. A style is a list of
 * typed values, each applying to a `Sheet` in order: the last value that sets
 * a field wins, and a `Theme` value sets nothing, so a field nothing sets
 * stays the GTK theme's. `Font` picks the typeface and its size; `Text` says
 * what's done with the letters. Pure: `sheets` checks values and turns them
 * into CSS.
 *
 * Depends on: theming (`Paint`), pictures (`Image`)
 * Used by: lib, looks, views, sheets, paint
 */

import theming { Paint };
import pictures { Image };

/** Something `.style([…])` can apply: a `Font`, a `Text`, a `Background`, a `Border` or an `Outline`. */
public interface Styling {
    /** `s` with this value's fields over it; fields left `Theme` are skipped. */
    fun apply(self, s: Sheet): Sheet;
}

/** Everything `.style` has set on a node, merged: what kivuli turns into CSS. */
public struct Sheet {
    public font: Font,
    public text: Text,
    public background: Background,
    /** The four sides resolved (`all` folded in), and the corners. */
    public border: Border,
    public outline: Outline,
}

impl Sheet {
    /** Nothing set: everything the GTK theme's. */
    public fun theme(): Sheet = Sheet {
        font: Font.theme(),
        text: Text.theme(),
        background: Background.theme(),
        border: Border.theme(),
        outline: Outline.theme(),
    };
}

/** Applies `items` to `s` in order. */
fun applied(s: Sheet, items: Styling[]): Sheet {
    let mut out = s;
    for item of items {
        out = item.apply(out);
    }
    out
}

/** `font-family`. */
public enum Family {
    Theme,
    /** `sans-serif` */
    Sans,
    /** `serif` */
    Serif,
    /** `monospace` */
    Monospace,
    /** A font by name, and the generic family to use when it isn't installed. */
    Named(string, Family),
}

/** `font-size`. */
public enum Size {
    Theme,
    /** Points. */
    Pt(i64),
    /** A multiple of the theme's size, like CSS `em`. */
    Scale(f64),
}

/** `font-weight`. */
public enum Weight {
    Theme,
    /** 100 */
    Thin,
    /** 300 */
    Light,
    /** 400 */
    Normal,
    /** 500 */
    Medium,
    /** 600 */
    Semibold,
    /** 700 */
    Bold,
    /** 900 */
    Black,
}

/** `font-style`. */
public enum FontStyle {
    Theme,
    Normal,
    Italic,
}

/**
 * Which typeface a node's text uses, and how big. Fields left `Theme` (and
 * `tabular` false) stay the GTK theme's.
 *
 * Example:
 *     text("Price").style([Font { weight: Weight.Medium, tabular: true, ..Font.theme() }])
 */
public struct Font {
    public family: Family,
    public size: Size,
    public weight: Weight,
    public style: FontStyle,
    /** Digits all one width, for numbers in columns. */
    public tabular: bool,
}

impl Font {
    /** Every field the theme's: start here and change what you need. */
    public fun theme(): Font = Font {
        family: Family.Theme,
        size: Size.Theme,
        weight: Weight.Theme,
        style: FontStyle.Theme,
        tabular: false,
    };

    /** `s` with every field this font sets. */
    public fun apply(self, s: Sheet): Sheet = Sheet {
        font: Font {
            family: if self.family == Family.Theme { s.font.family } else { self.family },
            size: if self.size == Size.Theme { s.font.size } else { self.size },
            weight: if self.weight == Weight.Theme { s.font.weight } else { self.weight },
            style: if self.style == FontStyle.Theme { s.font.style } else { self.style },
            tabular: self.tabular || s.font.tabular,
        },
        ..s,
    };
}

/** `line-height`. */
public enum LineHeight {
    Theme,
    /** A multiple of the font size. */
    Times(f64),
}

/** `text-decoration-line`. */
public enum Decoration {
    Theme,
    None,
    Underline,
    Strikethrough,
}

/** `text-transform`. */
public enum Transform {
    Theme,
    None,
    Uppercase,
    Lowercase,
    Capitalize,
}

/**
 * What's done with the letters once the font is chosen. Fields left `Theme`
 * (and `letter_spacing` 0, the font's own) stay the GTK theme's.
 *
 * Example:
 *     text("NEW").style([Text { transform: Transform.Uppercase, letter_spacing: 2, ..Text.theme() }])
 */
public struct Text {
    public color: Paint,
    public line_height: LineHeight,
    /** Pixels between letters, over the font's own; negative tightens. */
    public letter_spacing: i64,
    public decoration: Decoration,
    public transform: Transform,
}

impl Text {
    /** Every field the theme's: start here and change what you need. */
    public fun theme(): Text = Text {
        color: Paint.Theme,
        line_height: LineHeight.Theme,
        letter_spacing: 0,
        decoration: Decoration.Theme,
        transform: Transform.Theme,
    };

    /** `s` with every field this text value sets. */
    public fun apply(self, s: Sheet): Sheet = Sheet {
        text: Text {
            color: if self.color == Paint.Theme { s.text.color } else { self.color },
            line_height: if self.line_height == LineHeight.Theme {
                s.text.line_height
            } else {
                self.line_height
            },
            letter_spacing: if self.letter_spacing == 0 {
                s.text.letter_spacing
            } else {
                self.letter_spacing
            },
            decoration: if self.decoration == Decoration.Theme {
                s.text.decoration
            } else {
                self.decoration
            },
            transform: if self.transform == Transform.Theme {
                s.text.transform
            } else {
                self.transform
            },
        },
        ..s,
    };
}

/** A gradient, under a background's image and over its colour. */
public enum Gradient {
    Theme,
    /** Along an angle in degrees (0 points up, 90 right, 180 down), through its stops. */
    Linear(i64, Stop[]),
    /** A circle from the node's centre out, through its stops. */
    Radial(Stop[]),
}

/** One colour of a gradient, `at` its place along it: 0.0 the start, 1.0 the end. */
public struct Stop {
    public color: Paint,
    public at: f64,
}

/** How a background's image fills the node; images are always centred. */
public enum Fill {
    Theme,
    /** Fills the node, cropping what doesn't fit: the default with an image. */
    Cover,
    /** The whole picture, the rest showing what's beneath. */
    Contain,
    /** Repeated at its own size. */
    Tile,
    /** Stretched to the node exactly. */
    Stretch,
}

/**
 * What's behind a node's content: an image over a gradient over a colour,
 * stacked as CSS stacks them. Fields left `Theme` (and `image` `None`) stay
 * the GTK theme's. A picture from a file or bytes is checked before GTK sees
 * it; one that can't be shown shows nothing.
 *
 * Example:
 *     column(rows).style([Background { color: Paint.Faded(0.08), ..Background.theme() }])
 */
public struct Background {
    /** `Faded(x)` is a tint of the theme's text colour, following light and dark. */
    public color: Paint,
    public gradient: Gradient,
    public image: Option<Image>,
    public fill: Fill,
}

impl Background {
    /** Every field the theme's: start here and change what you need. */
    public fun theme(): Background = Background {
        color: Paint.Theme,
        gradient: Gradient.Theme,
        image: None,
        fill: Fill.Theme,
    };

    /** `s` with every field this background sets. */
    public fun apply(self, s: Sheet): Sheet = Sheet {
        background: Background {
            color: if self.color == Paint.Theme { s.background.color } else { self.color },
            gradient: if self.gradient == Gradient.Theme {
                s.background.gradient
            } else {
                self.gradient
            },
            image: if self.image.is_some() { self.image } else { s.background.image },
            fill: if self.fill == Fill.Theme { s.background.fill } else { self.fill },
        },
        ..s,
    };
}

/** A border's or outline's width. */
public enum Width {
    Theme,
    /** Pixels. */
    Px(i64),
}

/** How a border or outline is drawn. A width with the line left `Theme` is drawn `Solid`. */
public enum Line {
    Theme,
    /** Not drawn. */
    None,
    Solid,
    Dashed,
    Dotted,
    Double,
    Groove,
    Ridge,
    Inset,
    Outset,
}

/** How round a node's corners are, in pixels. A rounded node clips what's inside it. */
public enum Radius {
    Theme,
    /** Every corner. */
    All(i64),
    /** Top left, top right, bottom right, bottom left. */
    Corners(i64, i64, i64, i64),
}

/** One side of a border. Fields left `Theme` stay the theme's. */
public struct Side {
    public width: Width,
    /** `Faded(x)` is a hairline of the theme's text colour, following light and dark. */
    public color: Paint,
    public style: Line,
}

impl Side {
    /** Every field the theme's. */
    public fun theme(): Side = Side { width: Width.Theme, color: Paint.Theme, style: Line.Theme };

    /** `under` with every field this side sets. */
    public fun over(self, under: Side): Side = Side {
        width: if self.width == Width.Theme { under.width } else { self.width },
        color: if self.color == Paint.Theme { under.color } else { self.color },
        style: if self.style == Line.Theme { under.style } else { self.style },
    };
}

/**
 * A node's border: `all` for every side, each side on its own over it (field
 * by field), and the corners' radius. Across a style's values the later
 * wins, so a later `all` resets sides an earlier value set.
 *
 * Example:
 *     card.style([Border { all: hairline, radius: Radius.All(12), ..Border.theme() }])
 */
public struct Border {
    public all: Side,
    public top: Side,
    public right: Side,
    public bottom: Side,
    public left: Side,
    public radius: Radius,
}

impl Border {
    /** Every field the theme's: start here and change what you need. */
    public fun theme(): Border = Border {
        all: Side.theme(),
        top: Side.theme(),
        right: Side.theme(),
        bottom: Side.theme(),
        left: Side.theme(),
        radius: Radius.Theme,
    };

    /** `s` with every side and corner this border sets; `all` is folded into the sides. */
    public fun apply(self, s: Sheet): Sheet {
        let was = s.border;
        // A side's own field beats `all`; both beat what was there.
        let side = fun(own: Side, before: Side): Side = own.over(self.all.over(before));
        Sheet {
            border: Border {
                all: Side.theme(),
                top: side(self.top, was.top),
                right: side(self.right, was.right),
                bottom: side(self.bottom, was.bottom),
                left: side(self.left, was.left),
                radius: if self.radius == Radius.Theme { was.radius } else { self.radius },
            },
            ..s,
        }
    }
}

/**
 * A line around a node, outside its border, that doesn't take room: for
 * "selected" or a drop target. It hides while the node has keyboard focus,
 * so the theme's focus ring shows.
 *
 * Example:
 *     tile.style([Outline { width: Width.Px(2), color: Paint.Color(hex("#2a5298")), style: Line.Solid, offset: 2 }])
 */
public struct Outline {
    public width: Width,
    public color: Paint,
    public style: Line,
    /** Pixels outside the border; negative draws inside; 0 is the theme's. */
    public offset: i64,
}

impl Outline {
    /** Every field the theme's. */
    public fun theme(): Outline = Outline {
        width: Width.Theme,
        color: Paint.Theme,
        style: Line.Theme,
        offset: 0,
    };

    /** `s` with every field this outline sets. */
    public fun apply(self, s: Sheet): Sheet = Sheet {
        outline: Outline {
            width: if self.width == Width.Theme { s.outline.width } else { self.width },
            color: if self.color == Paint.Theme { s.outline.color } else { self.color },
            style: if self.style == Line.Theme { s.outline.style } else { self.style },
            offset: if self.offset == 0 { s.outline.offset } else { self.offset },
        },
        ..s,
    };
}
