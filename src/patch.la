/**
 * Applying patches: carries out one `diff.Patch` on the live widgets and
 * returns the `Live` tree that now mirrors them. Not responsible for deciding
 * what changed (`diff`) or for making widgets (`build`).
 *
 * Depends on: diff, live_tree, build, styling, gtk.raw
 * Used by: live
 */

import gtk {
    GtkWidget,
    gtk_box_append,
    gtk_box_insert_child_after,
    gtk_box_remove,
    gtk_box_reorder_child_after,
    gtk_image_set_from_icon_name,
    gtk_check_button_set_active,
    gtk_editable_get_text,
    gtk_editable_set_text,
    gtk_header_bar_remove,
    gtk_header_bar_set_title_widget,
    g_timeout_add_full,
    gtk_label_set_text,
    gtk_picture_set_filename,
    gtk_range_set_range,
    gtk_scrolled_window_set_child,
    gtk_text_buffer_set_text,
    gtk_widget_set_sensitive,
    gtk_widget_ref,
    gtk_widget_unref,
    gtk_widget_set_visible,
    gtk_window_set_child,
    lgtk_text_cursor,
    lgtk_text_place_cursor,
};
import diff;
import build { create, create_in, editor, pack_one, text_of };
import controls { picked, sync_choices };
import styling { apply_style, flag, show_content, show_number };
import textures { show_in_image, show_picture };
import live_tree { Choices, Live, titlebar, widget };

/** Applies one patch to the widgets, and returns the `Live` tree that now mirrors them. */
fun apply<Msg>(
    window: GtkWidget,
    live: Live<Msg>,
    patch: diff.Patch<Msg>,
    send: fun(Msg),
): Live<Msg> = match patch {
    SetText(path, s) => {
        gtk_label_set_text(widget(at(live, path)), s);
        live
    }
    SetLabel(path, s) => {
        match at(live, path) {
            Button(w, _, _, _, label, image) => {
                gtk_label_set_text(label, s);
                // An empty label may now hide, or show again.
                show_content(w, label, image);
            }
            Checkbox(_, label, _) => gtk_label_set_text(label, s),
            _ => panic("kivuli: a SetLabel patch points at something without a label"),
        }
        live
    }
    SetMsg(path, msg) => {
        match at(live, path) {
            Button(button, current, _, _, _, _) => {
                current.set(msg);
                gtk_widget_set_sensitive(button, flag(msg.is_some()));
            }
            _ => panic("kivuli: a SetMsg patch points at something that isn't a button"),
        }
        live
    }
    SetValue(path, value) => {
        match at(live, path) {
            Input(entry, _, _) => {
                // Only when the field shows something else: rewriting the same text
                // would move the cursor to the start while the user types.
                if gtk_editable_get_text(entry) != value {
                    gtk_editable_set_text(entry, value);
                }
            }
            TextArea(_, buffer, _) => {
                // As for an input; when the text really changes, the cursor keeps
                // its offset, clamped to the end of a shorter text.
                if text_of(buffer) != value {
                    let cursor = lgtk_text_cursor(buffer);
                    gtk_text_buffer_set_text(buffer, value, -1);
                    lgtk_text_place_cursor(buffer, cursor);
                }
            }
            _ => panic("kivuli: a SetValue patch points at something that isn't a text field"),
        }
        live
    }
    SetOnChange(path, on_change) => {
        match at(live, path) {
            // As SetMsg for buttons: no function is disabled, greyed out.
            Input(entry, current, _) => {
                current.set(on_change);
                gtk_widget_set_sensitive(entry, flag(on_change.is_some()));
            }
            TextArea(scrolled, _, current) => {
                current.set(on_change);
                gtk_widget_set_sensitive(editor(scrolled), flag(on_change.is_some()));
            }
            _ => panic("kivuli: a SetOnChange patch points at something that isn't a text field"),
        }
        live
    }
    SetOnSubmit(path, on_submit) => {
        match at(live, path) {
            Input(_, _, submit) => submit.set(on_submit),
            _ => panic("kivuli: a SetOnSubmit patch points at something that isn't a text field"),
        }
        live
    }
    SetChecked(path, checked) => {
        // GTK fires `toggled` only on a real change, and while patching the
        // echo is dropped, so this needs no same-state check of its own.
        gtk_check_button_set_active(widget(at(live, path)), flag(checked));
        live
    }
    SetOnToggle(path, on_toggle) => {
        match at(live, path) {
            Checkbox(_, _, current) => current.set(on_toggle),
            _ => panic("kivuli: a SetOnToggle patch points at something that isn't a check box"),
        }
        live
    }
    SetChoices(path, choices, selected) => {
        match at(live, path) {
            Dropdown(drop, state) => {
                let now = state.get();
                state.set(Choices { offered: choices, pick: picked(choices, selected), ..now });
                if now.busy {
                    // Sent from the drop-down's own pick, inside GTK's signal:
                    // synced on the next turn, with the latest state then. The
                    // widget is held alive until then, in case it's removed.
                    let held = gtk_widget_ref(drop);
                    g_timeout_add_full(0, 0, fun(): i32 {
                        sync_choices(held, state);
                        gtk_widget_unref(held);
                        // G_SOURCE_REMOVE: once.
                        0
                    });
                } else {
                    sync_choices(drop, state);
                }
            }
            _ => panic("kivuli: a SetChoices patch points at something that isn't a drop-down"),
        }
        live
    }
    SetRange(path, min, max) => {
        match at(live, path) {
            Slider(scale, range, last, _) => {
                let (_, _, step) = range.get();
                range.set((min, max, step));
                gtk_range_set_range(scale, min as f64, max as f64);
                // GTK clamps the handle; this also puts it on a step of the new range.
                show_number(scale, range, last, last.get());
            }
            _ => panic("kivuli: a SetRange patch points at something that isn't a slider"),
        }
        live
    }
    SetNumber(path, n) => {
        match at(live, path) {
            Slider(scale, range, last, _) => show_number(scale, range, last, n),
            _ => panic("kivuli: a SetNumber patch points at something that isn't a slider"),
        }
        live
    }
    SetOnSlide(path, on_change) => {
        match at(live, path) {
            Slider(_, _, _, current) => current.set(on_change),
            _ => panic("kivuli: a SetOnSlide patch points at something that isn't a slider"),
        }
        live
    }
    SetImage(path, img) => {
        // The diff replaces an icon that becomes a picture: here they stay their kind.
        match (at(live, path), img) {
            (Icon(image), Icon(name)) => gtk_image_set_from_icon_name(image, name),
            (Image(picture), _) => show_picture(picture, img),
            _ => panic(
                "kivuli: a SetImage patch points at something that isn't that kind of image",
            ),
        }
        live
    }
    SetButtonImage(path, img) => {
        match at(live, path) {
            Button(button, _, _, _, label, image) => {
                gtk_widget_set_visible(image, flag(show_in_image(image, img)));
                show_content(button, label, image);
            }
            _ => panic("kivuli: a SetButtonImage patch points at something that isn't a button"),
        }
        live
    }
    SetStyle(path, style) => {
        apply_style(at(live, path), style, axis_of(live, path));
        live
    }
    Append(path, v) => update_at(live, path, 0, fun(node: Live<Msg>): Live<Msg> = match node {
        Box(box, orientation, kids) => {
            let kid = create_in(v, orientation, send);
            gtk_box_append(box, widget(kid));
            let mut next = kids;
            next.push(kid);
            Live.Box(box, orientation, next)
        }
        Pack(bar, at_end, kids) => {
            let kid = create_in(v, 0, send);
            pack_one(bar, at_end, widget(kid));
            let mut next = kids;
            next.push(kid);
            Live.Pack(bar, at_end, next)
        }
        _ => panic("kivuli: an Append patch points at something that isn't a column or row"),
    }),
    Remove(path) => {
        let i = path[path.len - 1];
        update_at(live, parent(path), 0, fun(node: Live<Msg>): Live<Msg> = match node {
            Box(box, orientation, kids) => {
                gtk_box_remove(box, widget(kids[i]));
                Live.Box(box, orientation, diff.without(kids, i))
            }
            Pack(bar, at_end, kids) => {
                gtk_header_bar_remove(bar, widget(kids[i]));
                Live.Pack(bar, at_end, diff.without(kids, i))
            }
            _ => panic("kivuli: a Remove patch points into something that isn't a column or row"),
        })
    }
    Insert(path, at, v) => update_at(live, path, 0, fun(node: Live<Msg>): Live<Msg> = match node {
        Box(box, orientation, kids) => {
            let kid = create_in(v, orientation, send);
            gtk_box_insert_child_after(box, widget(kid), sibling_before(kids, at));
            Live.Box(box, orientation, diff.inserted(kids, at, kid))
        }
        _ => panic("kivuli: an Insert patch points at something that isn't a keyed column"),
    }),
    Move(path, from, to) => update_at(live, path, 0, fun(node: Live<Msg>): Live<Msg> = match node {
        Box(box, orientation, kids) => {
            let next = diff.moved(kids, from, to);
            gtk_box_reorder_child_after(box, widget(kids[from]), sibling_before(next, to));
            Live.Box(box, orientation, next)
        }
        _ => panic("kivuli: a Move patch points at something that isn't a keyed column"),
    }),
    Replace(path, v) => if path.len == 0 {
        let fresh = create(v, send);
        // A titlebar can't be added or dropped once the window is shown (PRP-007).
        if titlebar(live).is_some() || titlebar(fresh).is_some() {
            panic("kivuli: a view can't gain or lose its .header(…) while the app runs");
        }
        gtk_window_set_child(window, widget(fresh));
        fresh
    } else {
        let i = path[path.len - 1];
        update_at(live, parent(path), 0, fun(node: Live<Msg>): Live<Msg> = match node {
            Box(box, orientation, kids) => {
                let fresh = create_in(v, orientation, send);
                // Insert after the previous sibling (or first), then drop the
                // old widget, so the new one takes exactly its place.
                gtk_box_insert_child_after(box, widget(fresh), sibling_before(kids, i));
                gtk_box_remove(box, widget(kids[i]));
                let mut next = kids;
                next[i] = fresh;
                Live.Box(box, orientation, next)
            }
            Scroll(scrolled, _) => {
                // Setting a new child drops the old one (and the viewport GTK
                // may have wrapped it in).
                let fresh = create_in(v, 1, send);
                gtk_scrolled_window_set_child(scrolled, Some(widget(fresh)));
                Live.Scroll(scrolled, fresh)
            }
            // A header's body is the window's child; its title the bar's title widget.
            Framed(bar, body, title, start, end) => if i == 0 {
                let fresh = create_in(v, 1, send);
                gtk_window_set_child(window, widget(fresh));
                Live.Framed(bar, fresh, title, start, end)
            } else {
                let fresh = create_in(v, 0, send);
                gtk_header_bar_set_title_widget(bar, Some(widget(fresh)));
                Live.Framed(bar, body, fresh, start, end)
            },
            Pack(bar, at_end, kids) => {
                // A bar can't insert at a place: unpack from here on, then pack
                // the new one and the rest again, in order.
                let mut j = i;
                while j < kids.len {
                    gtk_header_bar_remove(bar, widget(kids[j]));
                    j = j + 1;
                }
                let fresh = create_in(v, 0, send);
                let mut next = kids;
                next[i] = fresh;
                j = i;
                while j < next.len {
                    pack_one(bar, at_end, widget(next[j]));
                    j = j + 1;
                }
                Live.Pack(bar, at_end, next)
            }
            _ => panic("kivuli: a Replace patch points into something with no children"),
        })
    },
};

/**
 * Rebuilds the `Live` tree with the node at `path` (from `depth` on) replaced
 * by `f(node)`. `f` also makes the matching change to the widgets.
 */
fun update_at<Msg>(
    node: Live<Msg>,
    path: i64[],
    depth: i64,
    f: fun(Live<Msg>): Live<Msg>,
): Live<Msg> = if depth == path.len {
    f(node)
} else {
    match node {
        Box(box, orientation, kids) => {
            let i = path[depth];
            let mut next = kids;
            next[i] = update_at(kids[i], path, depth + 1, f);
            Live.Box(box, orientation, next)
        }
        Scroll(scrolled, kid) => Live.Scroll(scrolled, update_at(kid, path, depth + 1, f)),
        Framed(bar, body, title, start, end) => match path[depth] {
            0 => Live.Framed(bar, update_at(body, path, depth + 1, f), title, start, end),
            1 => Live.Framed(bar, body, update_at(title, path, depth + 1, f), start, end),
            2 => Live.Framed(bar, body, title, update_at(start, path, depth + 1, f), end),
            _ => Live.Framed(bar, body, title, start, update_at(end, path, depth + 1, f)),
        },
        Pack(bar, at_end, kids) => {
            let i = path[depth];
            let mut next = kids;
            next[i] = update_at(kids[i], path, depth + 1, f);
            Live.Pack(bar, at_end, next)
        }
        _ => panic("kivuli: a patch's path leads through something with no children"),
    }
};

/**
 * The axis the node at `path` is laid out along in its parent: a box's
 * orientation; across in a header bar (all but the body); else vertical (the
 * root, a scroll's child, a header's body).
 */
fun axis_of<Msg>(live: Live<Msg>, path: i64[]): i32 = if path.len == 0 {
    1
} else {
    match at(live, parent(path)) {
        Box(_, orientation, _) => orientation,
        Framed(_, _, _, _, _) => if path[path.len - 1] == 0 { 1 } else { 0 },
        Pack(_, _, _) => 0,
        _ => 1,
    }
};

/** The node at `path`. */
fun at<Msg>(node: Live<Msg>, path: i64[]): Live<Msg> {
    let mut here = node;
    for i of path {
        here = match here {
            Box(_, _, kids) => kids[i],
            Scroll(_, kid) => kid,
            Framed(_, body, title, start, end) => match i {
                0 => body,
                1 => title,
                2 => start,
                _ => end,
            },
            Pack(_, _, kids) => kids[i],
            _ => panic("kivuli: a patch's path leads through something with no children"),
        };
    }
    here
}

fun parent(path: i64[]): i64[] {
    let mut p: i64[] = [];
    let mut i = 0;
    while i < path.len - 1 {
        p.push(path[i]);
        i = i + 1;
    }
    p
}

/** The widget to place a child after so it lands at index `at`: the one before it, or `None` (first). */
fun sibling_before<Msg>(kids: Live<Msg>[], at: i64): Option<GtkWidget> = if at == 0 {
    None
} else {
    Some(widget(kids[at - 1]))
};
