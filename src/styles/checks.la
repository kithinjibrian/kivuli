/**
 * A style's values checked before they become CSS (split from `sheets`):
 * what can't be shown, what a state or a part can't change, names that
 * would break out of a CSS string. Each problem is a message naming the
 * value. Pure.
 *
 * Depends on: styles, values, pictures, theming, box_rules, motion_rules
 * Used by: paint
 */

import styles { Sheet, State, Part };
import styles.values { TextAlign, Family, Size, LineHeight, Gradient, Stop, Width, Radius, Edges };
import view.pictures { Image, is_svg };
import styles.motion_rules { check_motion };
import styles.theming { Paint, token_title };
import styles.box_rules { check_effects, needs_clamp, sides };

/**
 * Whether every value in `s` can be shown.
 * @returns `Err` naming the first value that can't, and why
 */
fun check(s: Sheet): Result<(), string> {
    match s.font.family {
        Named(name, fallback) => {
            if name == "" {
                return Err("Family.Named(\"\"): a font needs a name");
            }
            if breaks_css(name) {
                return Err(
                    "Family.Named(\"{name}\"): a font name can't hold quotes, backslashes, ; {{ }} or line breaks",
                );
            }
            match fallback {
                Sans | Serif | Monospace => {}
                _ => {
                    return Err(
                        "Family.Named(\"{name}\"): a font's fallback must be Sans, Serif or Monospace",
                    );
                }
            }
        }
        _ => {}
    }
    match s.font.size {
        Pt(n) => if n <= 0 {
            return Err("Size.Pt({n}): a font size must be positive");
        },
        Scale(x) => if x <= 0.0 {
            return Err("Size.Scale({x}): a font scale must be positive");
        },
        Theme => {}
    }
    match s.text.line_height {
        Times(x) => if x <= 0.0 {
            return Err("LineHeight.Times({x}): a line height must be positive");
        },
        Theme => {}
    }
    check_paint(s.text.color)?;
    check_paint(s.background.color)?;
    match s.background.gradient {
        Linear(_, stops) => check_stops(stops)?,
        Radial(stops) => check_stops(stops)?,
        Theme => {}
    }
    let b = sides(s.border);
    for side of [b.top, b.right, b.bottom, b.left] {
        check_width(side.width)?;
        check_paint(side.color)?;
    }
    match s.border.radius {
        All(n) => if n < 0 {
            return Err("Radius.All({n}): a radius can't be negative");
        },
        Corners(a, b, c, d) => if a < 0 || b < 0 || c < 0 || d < 0 {
            return Err("Radius.Corners({a}, {b}, {c}, {d}): a radius can't be negative");
        },
        _ => {}
    }
    check_width(s.outline.width)?;
    check_effects(s)?;
    check_motion(s.motion)?;
    let p = s.spacing.padding.over(Edges.theme());
    for w of [p.top, p.right, p.bottom, p.left] {
        match w {
            Px(n) => if n < 0 {
                return Err("Spacing.padding: Width.Px({n}): padding can't be negative");
            },
            Theme => {}
        }
    }
    let z = s.sizing;
    for (name, w) of [
        ("width", z.width),
        ("min_width", z.min_width),
        ("max_width", z.max_width),
        ("height", z.height),
        ("min_height", z.min_height),
        ("max_height", z.max_height),
        ("icon", z.icon),
    ] {
        match w {
            Px(n) => if n < 0 {
                return Err("Sizing.{name}: Width.Px({n}): a size can't be negative");
            },
            Theme => {}
        }
    }
    for (way, low, high) of [
        ("width", z.min_width, z.max_width),
        ("height", z.min_height, z.max_height),
    ] {
        match (low, high) {
            (Px(lo), Px(hi)) => if lo > hi {
                return Err("Sizing: min_{way} {lo} is more than max_{way} {hi}");
            },
            _ => {}
        }
    }
    match s.spacing.gap {
        Px(n) => if n < 0 {
            return Err("Spacing.gap: Width.Px({n}): a gap can't be negative");
        },
        Theme => {}
    }
    check_paint(s.outline.color)?;
    match s.background.image {
        Some(Icon(name)) => if breaks_css(name) {
            return Err(
                "Image.Icon(\"{name}\"): an icon name can't hold quotes, backslashes, ; {{ }} or line breaks",
            );
        },
        // GTK's CSS draws an SVG with outside files allowed: no SVG there
        // (PRP-053). A file's bytes are read only when shown: it shows nothing.
        Some(Bytes(key, bytes)) => if is_svg(bytes) {
            return Err("Background.image(Image.Bytes(\"{key}\", …)): an SVG can't be a background");
        },
        _ => {}
    }
    if s.mark.icon != "" {
        let m = s.mark;
        if breaks_css(m.icon) {
            return Err(
                "Mark.icon(\"{m.icon}\", {m.size}): an icon name can't hold quotes, backslashes, ; {{ }} or line breaks",
            );
        }
        if m.size < 1 {
            return Err("Mark.icon(\"{m.icon}\", {m.size}): an icon's size is at least 1 pixel");
        }
    }
    for (part, sub) of s.parts {
        let named = "Inside(Part.{part}, …)";
        // A `When` inside a part is the part's own state; a part inside a part isn't a thing.
        if sub.parts.len > 0 {
            return Err("{named}: a part can't hold another Inside");
        }
        // A part is a descendant rule: what isn't a plain rule can't reach it.
        if sub.background.image.is_some() || needs_clamp(
            sub.sizing,
        ) || sub.spacing.gap != Width.Theme {
            return Err(
                "{named}: a part can't change a background image, an exact or maximum size, or the gap",
            );
        }
        check(sub)?;
    }
    for (state, sub) of s.states {
        let named = "When(State.{state}, …)";
        if sub.states.len > 0 {
            return Err("{named}: states can't nest");
        }
        // A label's alignment is its own setting, not CSS: a state can't switch it.
        if sub.text.align != TextAlign.Theme {
            return Err("{named}: a state can't change where text sits");
        }
        // A state is a CSS rule under a pseudo-class: what isn't a plain rule can't switch.
        if sub.background.image.is_some() || needs_clamp(
            sub.sizing,
        ) || sub.spacing.gap != Width.Theme {
            return Err(
                "{named}: a state can't change a background image, an exact or maximum size, or the gap",
            );
        }
        check(sub)?;
    }
    Ok(())
}

fun check_width(w: Width): Result<(), string> = match w {
    Px(n) => if n < 0 { Err("Width.Px({n}): a width can't be negative") } else { Ok(()) },
    Theme => Ok(()),
};

fun check_paint(p: Paint): Result<(), string> = match p {
    Faded(x) => if x < 0.0 || x > 1.0 {
        Err("Paint.Faded({x}): an opacity is between 0 and 1")
    } else {
        Ok(())
    },
    Alpha(t, x) => if x < 0.0 || x > 1.0 {
        Err("Token.{token_title(t)}.alpha({x}): an opacity is between 0 and 1")
    } else {
        Ok(())
    },
    _ => Ok(()),
};

fun check_stops(stops: Stop[]): Result<(), string> {
    if stops.len < 2 {
        return Err("Gradient: a gradient needs at least two stops");
    }
    let mut last = 0.0;
    for stop of stops {
        if stop.at < 0.0 || stop.at > 1.0 {
            return Err("Stop at {stop.at}: a stop is between 0 and 1");
        }
        if stop.at < last {
            return Err("Gradient: its stops must be in order");
        }
        last = stop.at;
        check_paint(stop.color)?;
    }
    Ok(())
}

/** Whether `name`, put inside a CSS string, could end it: quotes, backslashes, `;`, braces, line breaks. */
fun breaks_css(name: string): bool {
    for bad of ["\"", "\\", ";", "{{", "}}", "\n", "\r"] {
        if name.contains(bad) {
            return true;
        }
    }
    false
}
