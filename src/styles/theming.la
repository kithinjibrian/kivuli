/**
 * Colours: an app's own, read from hex or made from red, green and blue,
 * and `Paint`, what a colour field of a style takes (the theme's, an app
 * colour, or the theme's text colour faded). Pure: no GTK. Apps reach
 * `Color`, `Paint`, `hex` and `rgb` through the entry.
 *
 * Depends on: nothing
 * Used by: box_rules, lib, sheets, style_values, styles, styles/
 */

/** A colour, each channel 0–255; `alpha` 255 is opaque. Made by `hex` or `rgb`. */
public struct Color {
    public red: i64,
    public green: i64,
    public blue: i64,
    public alpha: i64,
}

/** A colour field's value in a style (`Text.color`). */
public enum Paint {
    /** The GTK theme's colour: follows light, dark and high contrast. */
    Theme,
    /** A colour of the app's own: `Paint.Color(hex("#e0e0e0"))`. */
    Color(Color),
    /** The theme's text colour at this opacity, 0 to 1: greyed text that still follows the theme. */
    Faded(f64),
    /** A named colour of the palette (`.palette(…)`), light or dark as the scheme is: `Paint.Token(Token.Primary)`. */
    Token(Token),
}

/**
 * A palette's named colours, shadcn's set: each has a light and a dark value
 * (`Palette`), and a `…Foreground` is the text colour on its partner.
 *
 * Example:
 *     text(m.note).style([Text.color(Token.MutedForeground)])
 */
public enum Token {
    /** The page. */
    Background,
    Foreground,
    /** A card on the page. */
    Card,
    CardForeground,
    /** A menu or popover. */
    Popover,
    PopoverForeground,
    /** The main action: a default button. */
    Primary,
    PrimaryForeground,
    /** A quieter action. */
    Secondary,
    SecondaryForeground,
    /** Quiet surfaces and secondary text. */
    Muted,
    MutedForeground,
    /** What's hovered or selected. */
    Accent,
    AccentForeground,
    /** A dangerous action. */
    Destructive,
    DestructiveForeground,
    /** Borders and separators. */
    Border,
    /** A text field's border. */
    Input,
    /** The focus ring. */
    Ring,
}

impl Token {
    /** This token as a `Paint`: what a colour field holds. */
    public fun paint(self): Paint = Paint.Token(self);
}

/**
 * What a colour utility takes: a `Color` (`hex("#e0e0e0")`), a `Token`
 * (`Token.Muted`) or any `Paint` (`Paint.Faded(0.5)`).
 */
public interface Colorish {
    /** The `Paint` a colour field holds for this value. */
    fun paint(self): Paint;
}

impl Color {
    /** This colour as a `Paint`: what a colour field holds. */
    public fun paint(self): Paint = Paint.Color(self);
}

impl Paint {
    /** Itself: a `Paint` is a colour value too. */
    public fun paint(self): Paint = self;
}

/** A token's name in CSS: `MutedForeground` is `muted-foreground` (`var(--kv-muted-foreground)`). */
fun token_name(t: Token): string = match t {
    Background => "background",
    Foreground => "foreground",
    Card => "card",
    CardForeground => "card-foreground",
    Popover => "popover",
    PopoverForeground => "popover-foreground",
    Primary => "primary",
    PrimaryForeground => "primary-foreground",
    Secondary => "secondary",
    SecondaryForeground => "secondary-foreground",
    Muted => "muted",
    MutedForeground => "muted-foreground",
    Accent => "accent",
    AccentForeground => "accent-foreground",
    Destructive => "destructive",
    DestructiveForeground => "destructive-foreground",
    Border => "border",
    Input => "input",
    Ring => "ring",
};

/**
 * Reads a colour from `#rgb`, `#rrggbb` or `#rrggbbaa` (hex digits, either
 * case). The app stops with a message for anything else.
 *
 * Example:
 *     hex("#242424")
 */
public fun hex(s: string): Color = match read_hex(s) {
    Ok(c) => c,
    Err(problem) => panic("kivuli: {problem}"),
};

/** A colour from red, green and blue, each 0–255; opaque. */
public fun rgb(red: i64, green: i64, blue: i64): Color = Color {
    red: red,
    green: green,
    blue: blue,
    alpha: 255,
};

/** The colour `s` spells, or what's wrong with it. */
fun read_hex(s: string): Result<Color, string> {
    if !s.starts_with("#") {
        return Err("a colour starts with #: \"{s}\"");
    }
    let mut digits: i64[] = [];
    let mut first = true;
    for b of s {
        if first {
            // The '#'.
            first = false;
        } else {
            match hex_digit(b as i64) {
                Some(d) => digits.push(d),
                None => {
                    return Err("not a hex digit in \"{s}\"");
                }
            }
        }
    }
    if digits.len == 3 {
        // #rgb: each digit doubled, as in CSS.
        Ok(Color { red: digits[0] * 17, green: digits[1] * 17, blue: digits[2] * 17, alpha: 255 })
    } else if digits.len == 6 || digits.len == 8 {
        Ok(Color {
            red: digits[0] * 16 + digits[1],
            green: digits[2] * 16 + digits[3],
            blue: digits[4] * 16 + digits[5],
            alpha: if digits.len == 8 { digits[6] * 16 + digits[7] } else { 255 },
        })
    } else {
        Err("a colour has 3, 6 or 8 hex digits: \"{s}\"")
    }
}

/** The value of one ASCII hex digit. */
fun hex_digit(b: i64): Option<i64> = if b >= 48 && b <= 57 {
    Some(b - 48)
} else if b >= 97 && b <= 102 {
    Some(b - 87)
} else if b >= 65 && b <= 70 {
    Some(b - 55)
} else {
    None
};

/** A colour as eight lowercase hex digits, `rrggbbaa`: CSS reads it after a `#`. */
fun digits(c: Color): string = [c.red, c.green, c.blue, c.alpha].map(two_digits).join("");

fun two_digits(n: i64): string {
    let all = "0123456789abcdef";
    let high = n / 16 % 16;
    let low = n % 16;
    all.slice(high, high + 1) + all.slice(low, low + 1)
}

/** A positive number in thousandths, rounded: a class name can't hold a dot. */
fun permille(x: f64): i64 = (x * 1000.0 + 0.5) as i64;

/** A colour as CSS: the theme's text colour for `Theme`, faded for `Faded`, a variable for a token. */
fun paint_css(p: Paint): string = match p {
    Theme => "currentColor",
    Color(c) => "#{digits(c)}",
    Faded(x) => "alpha(currentColor, {x})",
    Token(t) => "var(--kv-{token_name(t)})",
};

/** `s` in hex: any text as a valid, unique part of a class name. */
fun hexed(s: string): string {
    let mut out = "";
    for b of s {
        out = out + two_digits(b as i64);
    }
    out
}
