/**
 * Painting a view: before each diff, every node's style (`.style`) becomes
 * the CSS classes of its values, kept in its style, so classes diff and
 * patch like any other modifier. Also where what an app got wrong about
 * styles and headers is found, before GTK. Pure.
 *
 * Depends on: views, walk, looks, sheets, pictures
 * Used by: live
 */

import view.views { View };
import view.walk { check_content, nodes };
import view.looks { Style };
import styles.sheets { picture, rules };
import styles.checks { check };
import styles.box_rules { needs_clamp };
import styles.values { Width };
import styles { Sheet };
import view.pictures { Image };
import styles.motion_rules { rule_text };
import styles.palettes { palette_bar_rule, palette_class, palette_rule };

/**
 * `v` with every node's `classes` filled in from its style; or what's wrong:
 * a value that can't be shown, `.size` on text, or a `.header` below the root.
 */
fun painted<Msg>(v: View<Msg>): Result<View<Msg>, string> = match v {
    // The root alone may be framed by a header.
    Styled(inside, s) => {
        let own = paint_style(inside, s)?;
        let mut classes = own.classes;
        let mut bar = bar_classes(s.bar)?;
        // The palette's class first, so the root's own `.style` wins over its page colours.
        match s.palette {
            Some(p) => {
                classes = [palette_class(p)] + classes;
                bar = ["{palette_class(p)}-bar"] + bar;
            }
            None => {}
        }
        Ok(View.Styled(painted(inside)?, Style { classes: classes, bar_classes: bar, ..own }))
    }
    Framed(body, start, title, end) => Ok(
        View.Framed(paint(body)?, paint_all(start)?, paint(title)?, paint_all(end)?),
    ),
    _ => paint(v),
};

fun paint<Msg>(v: View<Msg>): Result<View<Msg>, string> = match v {
    Styled(inside, s) => {
        if s.palette.is_some() {
            return Err(".palette(…) belongs on the root of the view only");
        }
        if s.scheme.is_some() {
            return Err(".scheme(…) belongs on the root of the view only");
        }
        if s.dialog_root {
            return Err(".dialog(…) belongs on the root of the view only");
        }
        Ok(View.Styled(paint(inside)?, paint_style(inside, s)?))
    }
    Column(xs) => Ok(View.Column(paint_all(xs)?)),
    Row(xs) => Ok(View.Row(paint_all(xs)?)),
    Scroll(x) => Ok(View.Scroll(paint(x)?)),
    Keyed(pairs) => Ok(View.Keyed(paint_keyed(pairs)?)),
    Wrap(xs) => Ok(View.Wrap(paint_all(xs)?)),
    KeyedWrap(pairs) => Ok(View.KeyedWrap(paint_keyed(pairs)?)),
    Overlay(base, layers) => Ok(View.Overlay(paint(base)?, paint_all(layers)?)),
    Menu(x, entries) => Ok(View.Menu(paint(x)?, entries)),
    ButtonWith(content, msg) => {
        check_content(content)?;
        Ok(View.ButtonWith(paint(content)?, msg))
    }
    Lazy(key, build, Some(built)) => Ok(View.Lazy(key, build, Some(paint(built)?))),
    Framed(_, _, _, _) => Err(".header(…) belongs on the root of the view only"),
    _ => Ok(v),
};

fun paint_keyed<Msg>(pairs: (string, View<Msg>)[]): Result<(string, View<Msg>)[], string> {
    let mut out: (string, View<Msg>)[] = [];
    for (k, x) of pairs {
        out.push((k, paint(x)?));
    }
    Ok(out)
}

fun paint_all<Msg>(xs: View<Msg>[]): Result<View<Msg>[], string> {
    let mut out: View<Msg>[] = [];
    for x of xs {
        out.push(paint(x)?);
    }
    Ok(out)
}

/** The style of `node`, its values checked and turned into classes. */
fun paint_style<Msg>(node: View<Msg>, s: Style): Result<Style, string> {
    // A text's size is a Font's now: an old `.size` would otherwise vanish quietly.
    match node {
        Text(_) => if s.size > 0 {
            return Err(
                ".size(n) on text is gone: use .style([Font {{ size: Size.Pt(n), ..Font.theme() }}])",
            );
        },
        _ => {}
    }
    check(s.sheet)?;
    window_parts(s.sheet)?;
    // A rule's key may carry its selector's tail (`:not(:focus-visible)`): the class is before it.
    // A state's key repeats its class (`.c.c:active`): the class is before the first `.` too.
    let mut classes = rules(s.sheet).map(
        fun(rule) = rule.0.split(":")[0].split(".")[0].split(" ")[0],
    );
    match picture(s.sheet) {
        Some((class, _, _, _)) => classes.push(class),
        None => {}
    }
    Ok(Style { classes: classes, ..s })
}

/**
 * Refuses the window controls' parts on a view node: they match only under
 * a header bar, so there they'd do nothing.
 */
fun window_parts(s: Sheet): Result<(), string> {
    let mut all = [s];
    for (_, sub) of s.states {
        all.push(sub);
    }
    for sheet of all {
        for (part, _) of sheet.parts {
            match part {
                WindowButton | WindowClose | WindowIcon => {
                    return Err("Part.{part} belongs in a header bar's style");
                }
                _ => {}
            }
        }
    }
    Ok(())
}

/** A header bar's classes, its values checked: what the window decides is refused. */
fun bar_classes(bar: Sheet): Result<string[], string> {
    if needs_clamp(bar.sizing) || bar.spacing.gap != Width.Theme {
        return Err("header_bar(…): a header bar's size and gap are the window's");
    }
    if bar.background.image.is_some() {
        return Err("header_bar(…): a header bar can't have a background image");
    }
    check(bar)?;
    Ok(rules(bar).map(fun(rule) = rule.0.split(":")[0].split(".")[0].split(" ")[0]))
}

/**
 * Every CSS rule a painted view's classes need, as (class, the whole rule),
 * each once: the palette's first, then in the order nodes first use them.
 */
fun stylesheet<Msg>(v: View<Msg>): (string, string)[] {
    let mut seen: Set<string> = #{};
    let mut out: (string, string)[] = [];
    for (_, style) of nodes(v) {
        // Only the root has one (`paint` refuses it below), and its dark
        // values need an `@media` block, so it comes whole.
        match style.palette {
            Some(p) => {
                for rule of [palette_rule(p), palette_bar_rule(p)] {
                    if seen.insert(rule.0) {
                        out.push(rule);
                    }
                }
            }
            None => {}
        }
    }
    for (_, style) of nodes(v) {
        // A root with a header bar carries the bar's rules too.
        for sheet of [style.sheet, style.bar] {
            for (key, body) of rules(sheet) {
                if seen.insert(key) {
                    out.push((key, rule_text(key, body)));
                }
            }
        }
    }
    out
}

/**
 * Every background picture a painted view uses, each once: its class, the
 * image, and the gradient and fill its rule needs (`sheets.picture`). Their
 * rules need the pictures' bytes, so `live` builds them.
 */
fun background_pictures<Msg>(v: View<Msg>): (string, Image, string, string)[] {
    let mut seen: Set<string> = #{};
    let mut out: (string, Image, string, string)[] = [];
    for (_, style) of nodes(v) {
        match picture(style.sheet) {
            Some(p) => if seen.insert(p.0) {
                out.push(p);
            },
            None => {}
        }
    }
    out
}
