/**
 * A style's values turned into CSS (`checks` checks them first). The CSS is atomic: one class
 * per property and value (`kv-fw-700`), so every node using a value shares
 * its class and a class's rule never changes. Pure: `paint` gives nodes their
 * classes, `live` loads the rules.
 *
 * Depends on: styles, style_values, pictures, theming, box_rules, motion_rules
 * Used by: live, paint (their checks are `checks`)
 */

import styles { Sheet, State, Part };
import styles.values { Family, Weight, Gradient, Stop, Fill };
import view.pictures { Image, data_url, identity };
import styles.motion_rules { motion_css };
import styles.theming { Paint, digits, hexed, paint_css, permille, token_name };
import styles.box_rules { box_css };

/** Each value `s` sets, as its class and CSS declarations, font first; checked values only. */
fun rules(s: Sheet): (string, string)[] {
    let mut out: (string, string)[] = [];
    match s.font.family {
        Theme => {}
        Named(name, fallback) => {
            // The class spells the name in hex: any name is a valid, unique class.
            let id = hexed(name);
            out.push(
                ("kv-ff-{id}-{short(fallback)}", "font-family: \"{name}\", {generic(fallback)};"),
            );
        }
        _ => out.push(("kv-ff-{short(s.font.family)}", "font-family: {generic(s.font.family)};")),
    }
    match s.font.size {
        Theme => {}
        Pt(n) => out.push(("kv-fs-{n}pt", "font-size: {n}pt;")),
        Scale(x) => {
            let p = permille(x);
            out.push(("kv-fs-s{p}", "font-size: {p / 10}.{p % 10}%;"));
        }
    }
    match number(s.font.weight) {
        Some(w) => out.push(("kv-fw-{w}", "font-weight: {w};")),
        None => {}
    }
    match s.font.style {
        Theme => {}
        Normal => out.push(("kv-fst-normal", "font-style: normal;")),
        Italic => out.push(("kv-fst-italic", "font-style: italic;")),
    }
    if s.font.tabular {
        out.push(("kv-tnum", "font-variant-numeric: tabular-nums;"));
    }
    match s.text.color {
        Theme => {}
        Color(c) => out.push(("kv-fg-{digits(c)}", "color: #{digits(c)};")),
        // `currentColor` is the colour the theme gives the node: faded, it
        // still follows light and dark, as the theme's `dim-label` does.
        Faded(x) => out.push(("kv-fade-{permille(x)}", "color: alpha(currentColor, {x});")),
        Token(t) => out.push(("kv-fgt-{token_name(t)}", "color: var(--kv-{token_name(t)});")),
        Alpha(t, x) => out.push(
            ("kv-fgt-{token_name(t)}-a{permille(x)}", "color: {paint_css(s.text.color)};"),
        ),
    }
    match s.text.line_height {
        Theme => {}
        Times(x) => out.push(("kv-lh-{permille(x)}", "line-height: {x};")),
    }
    let n = s.text.letter_spacing;
    if n > 0 {
        out.push(("kv-ls-{n}", "letter-spacing: {n}px;"));
    } else if n < 0 {
        out.push(("kv-ls-m{-n}", "letter-spacing: {n}px;"));
    }
    match s.text.decoration {
        Theme => {}
        None => out.push(("kv-td-none", "text-decoration-line: none;")),
        Underline => out.push(("kv-td-underline", "text-decoration-line: underline;")),
        Strikethrough => out.push(("kv-td-strike", "text-decoration-line: line-through;")),
    }
    match s.text.transform {
        Theme => {}
        None => out.push(("kv-tt-none", "text-transform: none;")),
        Uppercase => out.push(("kv-tt-upper", "text-transform: uppercase;")),
        Lowercase => out.push(("kv-tt-lower", "text-transform: lowercase;")),
        Capitalize => out.push(("kv-tt-cap", "text-transform: capitalize;")),
    }
    let b = s.background;
    match b.color {
        Theme => {}
        Color(c) => out.push(("kv-bg-{digits(c)}", "background-color: #{digits(c)};")),
        Faded(x) => out.push(
            ("kv-bgfade-{permille(x)}", "background-color: alpha(currentColor, {x});"),
        ),
        Token(t) => out.push(
            ("kv-bgt-{token_name(t)}", "background-color: var(--kv-{token_name(t)});"),
        ),
        Alpha(t, x) => out.push(
            ("kv-bgt-{token_name(t)}-a{permille(x)}", "background-color: {paint_css(b.color)};"),
        ),
    }
    // `background-image` is one property: the gradient and the image are one
    // rule, so two classes never set it differently. An image's is `picture`'s.
    if b.image.is_none() {
        let g = gradient_css(b.gradient);
        if g != "" {
            out.push(("kv-bgi-g{hexed(g)}", "background-image: {g};"));
        } else if b.color != Paint.Theme {
            // A colour alone: a themed widget's own background image (a
            // button's) would cover it, so it goes.
            out.push(("kv-bgi-none", "background-image: none;"));
        }
    }
    for rule of box_css(s) {
        out.push(rule);
    }
    for rule of motion_css(s.motion) {
        out.push(rule);
    }
    if s.mark.icon != "" {
        let m = s.mark;
        out.push(
            (
                "kv-mk-{hexed(m.icon)}-{m.size}",
                "-gtk-icon-source: -gtk-icontheme(\"{m.icon}\"); -gtk-icon-size: {m.size}px;",
            ),
        );
    }
    for (part, sub) of s.parts {
        for rule of part_rules(part, rules(sub)) {
            out.push(rule);
        }
    }
    for (state, sub) of s.states {
        for rule of state_rules(state, rules(sub)) {
            out.push(rule);
        }
    }
    out
}

/**
 * A part's selector under the widget: a node, or a path where a bare node
 * would match too much (a drop-down's trigger also holds a `row`; its list
 * has scrollbars with their own `trough` and `slider`).
 */
fun part_node(part: Part): string = match part {
    Check => "check",
    Trough => "trough",
    Highlight => "highlight",
    // GTK calls a slider's thumb `slider`.
    Knob => "slider",
    Trigger => "> button",
    Arrow => "arrow",
    List => "popover > contents",
    Item => "popover row",
    MenuBox => "popover.menu > contents",
    MenuItem => "popover.menu modelbutton",
    MenuLabel => "popover.menu label.title",
    MenuSeparator => "popover.menu separator",
    MenuHint => "popover.menu accelerator",
};

/** The code a part's classes carry (`kv-item-…`). */
fun part_code(part: Part): string = match part {
    Check => "check",
    Trough => "trough",
    Highlight => "highlight",
    Knob => "slider",
    Trigger => "trigger",
    Arrow => "arrow",
    List => "list",
    Item => "item",
    MenuBox => "menu",
    MenuItem => "menuitem",
    MenuLabel => "menulabel",
    MenuSeparator => "menuseparator",
    MenuHint => "menuhint",
};

/**
 * `rules` for one part: each class gets the part's prefix, and its rule the
 * part's node after it (a descendant), before any tail the rule had.
 */
fun part_rules(part: Part, base: (string, string)[]): (string, string)[] = base.map(fun(rule) {
    let pieces = rule.0.split(":");
    // A state's rule repeats its class for rank (`c.c:active`): one is enough
    // on a part, whose own state sits after its node.
    let class = pieces[0].split(".")[0];
    let mut tail = "";
    let mut i = 1;
    while i < pieces.len {
        tail = tail + ":" + pieces[i];
        i = i + 1;
    }
    ("kv-{part_code(part)}-{class.slice(3, class.len)} {part_node(part)}{tail}", rule.1)
});

/**
 * `rules` for one state: each class gets the state's prefix, and its rule the
 * state's pseudo-class, its class repeated to the state's rank so a later
 * state in the order (Hover < Focus < FocusWithin < Press < Checked < Disabled) wins.
 */
fun state_rules(state: State, base: (string, string)[]): (string, string)[] {
    let (code, pseudo, rank) = match state {
        Hover => ("hover", ":hover", 1),
        Focus => ("focus", ":focus-visible", 2),
        FocusWithin => ("within", ":focus-within", 3),
        Press => ("press", ":active", 4),
        Checked => ("checked", ":checked", 5),
        Disabled => ("disabled", ":disabled", 6),
    };
    base.map(fun(rule) {
        // A part's rule carries its node after a space: the class is before it.
        let class = rule.0.split(":")[0].split(" ")[0];
        // An outline steps aside for the focus ring (`:not(:focus-visible)`),
        // except in the focus state, where it is the app's focus ring.
        let full = rule.0.slice(class.len, rule.0.len);
        // In the focus state only the outline's "step aside" goes; a part's node stays.
        let tail = if state == State.Focus {
            full.split(":not(:focus-visible)").join("")
        } else {
            full
        };
        let named = "kv-{code}-{class.slice(3, class.len)}";
        let mut selector = named;
        let mut i = 1;
        while i < rank {
            selector = selector + ".{named}";
            i = i + 1;
        }
        // The state is the widget's: its pseudo-class sits before a part's node.
        if tail.starts_with(" ") {
            ("{selector}{pseudo}{tail}", rule.1)
        } else {
            ("{selector}{tail}{pseudo}", rule.1)
        }
    })
}

/**
 * A background's picture, when it has one: its class, the image, the
 * gradient under it (CSS, or `""`) and how it fills the node. Its rule needs
 * the picture's bytes, so `live` builds it (`url_of`, `picture_css`) when the
 * class is first seen.
 */
fun picture(s: Sheet): Option<(string, Image, string, string)> = match s.background.image {
    Some(img) => {
        let g = gradient_css(s.background.gradient);
        let fill = fill_css(s.background.fill);
        Some(("kv-bgp-{hexed("{identity(img)}|{g}|{fill}")}", img, g, fill))
    }
    None => None,
};

/** A picture's rule from its url (`None`: it can't be shown), the gradient under it, and its fill. */
fun picture_css(url: Option<string>, gradient: string, fill: string): string {
    let mut layers: string[] = [];
    match url {
        Some(u) => layers.push(u),
        None => {}
    }
    if gradient != "" {
        layers.push(gradient);
    }
    if layers.len == 0 {
        "background-image: none;"
    } else {
        "background-image: {layers.join(", ")}; {fill}"
    }
}

/**
 * An image as a CSS image: a theme icon by name, or a file's or bytes'
 * checked bytes as a `data:` URL, so GTK never decodes what kivuli hasn't
 * checked or opens a path from CSS. `read` gives a file's bytes (`None`:
 * missing). `None` for what can't be shown.
 */
fun url_of(img: Image, read: fun(string): Option<u8[]>): Option<string> = match img {
    // The name was checked (`check`): it can't end the CSS string.
    Icon(name) => Some("-gtk-icontheme(\"{name}\")"),
    File(path) => match read(path) {
        Some(bytes) => data_url(bytes).map(fun(u) = "url(\"{u}\")"),
        None => None,
    },
    Bytes(_, bytes) => data_url(bytes).map(fun(u) = "url(\"{u}\")"),
};

/** A gradient as CSS; `""` for the theme's (none). */
fun gradient_css(g: Gradient): string = match g {
    Theme => "",
    Linear(angle, stops) => "linear-gradient({angle}deg, {stops_css(stops)})",
    Radial(stops) => "radial-gradient(circle, {stops_css(stops)})",
};

fun stops_css(stops: Stop[]): string = stops.map(fun(stop) {
    let p = permille(stop.at);
    "{paint_css(stop.color)} {p / 10}.{p % 10}%"
}).join(", ");

/** How an image fills the node; the theme's is `Cover`. Always centred. */
fun fill_css(f: Fill): string = match f {
    Contain => "background-size: contain; background-position: center; background-repeat: no-repeat;",
    Tile => "background-size: auto; background-position: center; background-repeat: repeat;",
    Stretch => "background-size: 100% 100%; background-position: center; background-repeat: no-repeat;",
    _ => "background-size: cover; background-position: center; background-repeat: no-repeat;",
};

/** CSS's numeric `font-weight`; `None` for the theme's. */
fun number(w: Weight): Option<i64> = match w {
    Theme => None,
    Thin => Some(100),
    Light => Some(300),
    Normal => Some(400),
    Medium => Some(500),
    Semibold => Some(600),
    Bold => Some(700),
    Black => Some(900),
};

/** A generic family as CSS names it. */
fun generic(f: Family): string = match f {
    Serif => "serif",
    Monospace => "monospace",
    // Checked: a named font's fallback is generic, and Theme writes no rule.
    _ => "sans-serif",
};

/** A generic family's part of a class name. */
fun short(f: Family): string = match f {
    Serif => "serif",
    Monospace => "mono",
    _ => "sans",
};
