/**
 * The CSS for a node's box: its border's sides and corners and its outline
 * and its padding and margin, one class per side, property and value.
 * Moved out of `sheets` (file size). Pure.
 *
 * Depends on: styles, styles.boxes, styles.drawing, style_values, theming
 * Used by: build, diff, sheets, styling
 */

import styles { Sheet };
import styles.boxes { Border, Sizing };
import styles.values { Side, Width, Line, Edges, Drop, Filter, Move };
import styles.theming { Paint, digits, hexed, paint_css, permille, token_name };
import styles.drawing { Shadow, Effects };

/** The rules for `s`'s border and outline, in that order. */
fun box_css(s: Sheet): (string, string)[] {
    let mut out: (string, string)[] = [];
    let edges = sides(s.border);
    for (name, side) of [
        ("top", edges.top),
        ("right", edges.right),
        ("bottom", edges.bottom),
        ("left", edges.left),
    ] {
        for rule of line_rules(
            "b",
            "border-{name}",
            "-{name}",
            side.width,
            side.style,
            side.color,
        ) {
            out.push(rule);
        }
    }
    let corners = match s.border.radius {
        Theme => [],
        All(n) => [n, n, n, n].map(fun(n) = ("{n}", "{n}px")),
        Corners(a, b, c, d) => [a, b, c, d].map(fun(n) = ("{n}", "{n}px")),
        // The palette's radius is a CSS variable, so it changes with the palette.
        Small => [0, 0, 0, 0].map(fun(n) = ("sm", "calc(var(--kv-radius) - 4px)")),
        Medium => [0, 0, 0, 0].map(fun(n) = ("md", "calc(var(--kv-radius) - 2px)")),
        Large => [0, 0, 0, 0].map(fun(n) = ("lg", "var(--kv-radius)")),
    };
    let names = [
        ("tl", "top-left"),
        ("tr", "top-right"),
        ("br", "bottom-right"),
        ("bl", "bottom-left"),
    ];
    let mut i = 0;
    while i < corners.len {
        out.push(
            ("kv-br-{names[i].0}-{corners[i].0}", "border-{names[i].1}-radius: {corners[i].1};"),
        );
        i = i + 1;
    }
    // Only while the node doesn't have keyboard focus: the theme's focus ring
    // is an outline too, and must still show. The key carries the selector's
    // tail; `paint` takes the class before the `:`.
    let o = s.outline;
    for (class, body) of line_rules("o", "outline", "", o.width, o.style, o.color) {
        out.push(("{class}:not(:focus-visible)", body));
    }
    if o.offset != 0 {
        let id = if o.offset < 0 { "m{-o.offset}" } else { "{o.offset}" };
        out.push(("kv-oo-{id}:not(:focus-visible)", "outline-offset: {o.offset}px;"));
    }
    // Padding and margin, side by side; a margin may be negative.
    let room = fun(e: Edges): (string, Width)[] {
        // `all` folded into the sides, as `.style` leaves it.
        let resolved = e.over(Edges.theme());
        [
            ("top", resolved.top),
            ("right", resolved.right),
            ("bottom", resolved.bottom),
            ("left", resolved.left),
        ]
    };
    for (side, w) of room(s.spacing.padding) {
        match w {
            Px(n) => out.push(("kv-p-{side}-{n}", "padding-{side}: {n}px;")),
            Theme => {}
        }
    }
    // A minimum is GTK's CSS; an exact size and a maximum are the clamp's (`clamp_limits`).
    match s.sizing.min_width {
        Px(n) => out.push(("kv-minw-{n}", "min-width: {n}px;")),
        Theme => {}
    }
    match s.sizing.min_height {
        Px(n) => out.push(("kv-minh-{n}", "min-height: {n}px;")),
        Theme => {}
    }
    // Each list is one rule: CSS draws its shadows, filters and moves together.
    if s.shadow.boxes.len > 0 {
        let css = s.shadow.boxes.map(fun(d) = drop_css(d, true)).join(", ");
        out.push(("kv-bsh-{hexed(css)}", "box-shadow: {css};"));
    }
    if s.shadow.text.len > 0 {
        let css = s.shadow.text.map(fun(d) = drop_css(d, false)).join(", ");
        out.push(("kv-tsh-{hexed(css)}", "text-shadow: {css};"));
    }
    match s.effects.opacity {
        Some(x) => out.push(("kv-op-{permille(x)}", "opacity: {x};")),
        None => {}
    }
    if s.effects.filters.len > 0 {
        let css = s.effects.filters.map(filter_css).join(" ");
        out.push(("kv-flt-{hexed(css)}", "filter: {css};"));
    }
    if s.effects.transform.len > 0 {
        let css = s.effects.transform.map(move_css).join(" ");
        out.push(("kv-tf-{hexed(css)}", "transform: {css};"));
    }
    for (side, w) of room(s.spacing.margin) {
        match w {
            Px(n) => out.push(
                ("kv-m-{side}-{if n < 0 { "m{-n}" } else { "{n}" }}", "margin-{side}: {n}px;"),
            ),
            Theme => {}
        }
    }
    out
}

/**
 * The rules for one border side or an outline (`kind` "b" or "o", `prop` the
 * CSS property's stem, `tail` the class's side): width, line, colour. A width
 * whose line is left `Theme` is drawn solid: CSS draws nothing without a style.
 */
fun line_rules(
    kind: string,
    prop: string,
    tail: string,
    width: Width,
    style: Line,
    color: Paint,
): (string, string)[] {
    let mut out: (string, string)[] = [];
    match width {
        Px(n) => out.push(("kv-{kind}w{tail}-{n}", "{prop}-width: {n}px;")),
        Theme => {}
    }
    let line = if style == Line.Theme && width != Width.Theme { Line.Solid } else { style };
    match keyword(line) {
        Some(k) => out.push(("kv-{kind}s{tail}-{k}", "{prop}-style: {k};")),
        None => {}
    }
    match color {
        Theme => {}
        Color(c) => out.push(("kv-{kind}c{tail}-{digits(c)}", "{prop}-color: #{digits(c)};")),
        Faded(x) => out.push(
            ("kv-{kind}cfade{tail}-{permille(x)}", "{prop}-color: alpha(currentColor, {x});"),
        ),
        Token(t) => out.push(
            ("kv-{kind}ct{tail}-{token_name(t)}", "{prop}-color: var(--kv-{token_name(t)});"),
        ),
    }
    out
}

/** `b` with `all` folded into each side (a side's own fields over it), as `.style` leaves it. */
fun sides(b: Border): Border = Border {
    all: Side.theme(),
    top: b.top.over(b.all),
    right: b.right.over(b.all),
    bottom: b.bottom.over(b.all),
    left: b.left.over(b.all),
    radius: b.radius,
};

/** A line's CSS keyword; `None` for the theme's. */
fun keyword(l: Line): Option<string> = match l {
    Theme => None,
    None => Some("none"),
    Solid => Some("solid"),
    Dashed => Some("dashed"),
    Dotted => Some("dotted"),
    Double => Some("double"),
    Groove => Some("groove"),
    Ridge => Some("ridge"),
    Inset => Some("inset"),
    Outset => Some("outset"),
};

/** Whether a node with `z` needs a clamp: an exact size or a maximum (GTK's CSS has neither). */
fun needs_clamp(
    z: Sizing,
): bool = z.width != Width.Theme || z.max_width != Width.Theme || z.height != Width.Theme || z.max_height != Width.Theme;

/**
 * A clamp's limits for `z`, as (min width, max width, min height, max height),
 * -1 for none: an exact size is kept within the minimum and the maximum (the
 * minimum winning) and becomes both limits.
 */
fun clamp_limits(z: Sizing): (i64, i64, i64, i64) {
    let (min_w, max_w) = limits(z.width, z.min_width, z.max_width);
    let (min_h, max_h) = limits(z.height, z.min_height, z.max_height);
    (min_w, max_w, min_h, max_h)
}

fun limits(exact: Width, low: Width, high: Width): (i64, i64) {
    let lo = px(low);
    let hi = px(high);
    match exact {
        Px(n) => {
            let mut size = n;
            if hi >= 0 && size > hi {
                size = hi;
            }
            if lo >= 0 && size < lo {
                size = lo;
            }
            (size, size)
        }
        Theme => (lo, hi),
    }
}

/** A width in pixels; -1 for the theme's. */
fun px(w: Width): i64 = match w {
    Px(n) => n,
    Theme => -1,
};

/** A shadow as CSS; a box's has its spread and inset. */
fun drop_css(d: Drop, box: bool): string = if box {
    "{d.x}px {d.y}px {d.blur}px {d.spread}px {paint_css(d.color)}{if d.inset { " inset" } else { "" }}"
} else {
    "{d.x}px {d.y}px {d.blur}px {paint_css(d.color)}"
};

fun filter_css(f: Filter): string = match f {
    Blur(n) => "blur({n}px)",
    Brightness(x) => "brightness({x})",
    Contrast(x) => "contrast({x})",
    Grayscale(x) => "grayscale({x})",
    HueRotate(n) => "hue-rotate({n}deg)",
    Invert(x) => "invert({x})",
    Saturate(x) => "saturate({x})",
    Sepia(x) => "sepia({x})",
};

fun move_css(m: Move): string = match m {
    Translate(x, y) => "translate({x}px, {y}px)",
    Rotate(n) => "rotate({n}deg)",
    Scale(x) => "scale({x})",
    ScaleXY(x, y) => "scale({x}, {y})",
};

/** Whether `s`'s shadows and effects can be shown; `Err` naming the first that can't. */
fun check_effects(s: Sheet): Result<(), string> {
    let mut drops = s.shadow.boxes;
    for d of s.shadow.text {
        if d.spread != 0 || d.inset {
            return Err("Shadow.text: a text shadow has no spread or inset");
        }
        drops.push(d);
    }
    for d of drops {
        if d.blur < 0 {
            return Err("Drop: a shadow's blur can't be negative");
        }
    }
    match s.effects.opacity {
        Some(x) => if x < 0.0 || x > 1.0 {
            return Err("Effects.opacity: {x}: an opacity is between 0 and 1");
        },
        None => {}
    }
    for f of s.effects.filters {
        let problem = match f {
            Blur(n) => if n < 0 { Some("a blur can't be negative") } else { None },
            Grayscale(x) | Invert(x) | Sepia(x) => if x < 0.0 || x > 1.0 {
                Some("Grayscale, Invert and Sepia are between 0 and 1")
            } else {
                None
            },
            Brightness(x) | Contrast(x) | Saturate(x) => if x < 0.0 {
                Some("Brightness, Contrast and Saturate can't be negative")
            } else {
                None
            },
            HueRotate(_) => None,
        };
        match problem {
            Some(why) => {
                return Err("Filter.{f}: {why}");
            }
            None => {}
        }
    }
    Ok(())
}
