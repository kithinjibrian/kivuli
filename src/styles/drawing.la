/**
 * The drawing groups (PRP-022): `Shadow` and `Effects`. Imports `styles` for
 * `Sheet`, which imports this back (DECISION-025). Pure.
 *
 * Depends on: styles (`Sheet`), style_values, theming
 * Used by: box_rules, lib, styles
 */

import styles { Sheet };
import styles.values { Drop, Filter, Move };
import styles.theming { Color, Paint };

/** A black `Drop` at `alpha` of 255, straight down: the shadows' utilities. */
fun black_drop(y: i64, blur: i64, spread: i64, alpha: i64): Drop = Drop {
    y: y,
    blur: blur,
    spread: spread,
    color: Paint.Color(Color { red: 0, green: 0, blue: 0, alpha: alpha }),
    ..Drop.theme(),
};

/**
 * A node's shadows: under its box (a card lifting off the page), and under
 * its text (readable over a picture), each a list of `Drop`s drawn together.
 * `[]` is the theme's; a later list replaces the earlier.
 *
 * Example:
 *     card.style([Shadow { boxes: [Drop { y: 2, blur: 8, color: Paint.Color(hex("#00000040")), ..Drop.theme() }], ..Shadow.theme() }])
 */
public struct Shadow {
    public boxes: Drop[],
    public text: Drop[],
}

impl Shadow {
    /** The theme's shadows. */
    public fun theme(): Shadow = Shadow { boxes: [], text: [] };

    /** No box shadow at all: removes the theme's own (a button's). */
    public fun off(): Shadow = Shadow {
        boxes: [
            Drop {
                color: Paint.Color(Color { red: 0, green: 0, blue: 0, alpha: 0 }),
                ..Drop.theme(),
            },
        ],
        text: [],
    };

    /** A small shadow, just off the page (Tailwind's `shadow-sm`). */
    public fun sm(): Shadow = Shadow { boxes: [black_drop(1, 2, 0, 13)], text: [] };

    /** A medium shadow, for cards (Tailwind's `shadow-md`). */
    public fun md(): Shadow = Shadow {
        boxes: [black_drop(4, 6, -1, 26), black_drop(2, 4, -2, 26)],
        text: [],
    };

    /** A large shadow, for popovers (Tailwind's `shadow-lg`). */
    public fun lg(): Shadow = Shadow {
        boxes: [black_drop(10, 15, -3, 26), black_drop(4, 6, -4, 26)],
        text: [],
    };

    /** The largest shadow, for dialogs (Tailwind's `shadow-xl`). */
    public fun xl(): Shadow = Shadow {
        boxes: [black_drop(20, 25, -5, 26), black_drop(8, 10, -6, 26)],
        text: [],
    };

    /** `s` with every list this shadow sets. */
    public fun apply(self, s: Sheet): Sheet = Sheet {
        shadow: Shadow {
            boxes: if self.boxes.len > 0 { self.boxes } else { s.shadow.boxes },
            text: if self.text.len > 0 { self.text } else { s.shadow.text },
        },
        ..s,
    };
}

/**
 * How the whole node is drawn: its opacity (children and all), filters in
 * order, and transforms in order. A transform never changes the room the
 * node takes, so its neighbours don't move.
 *
 * Example:
 *     tile.style([When(State.Hover, [Effects { transform: [Move.Scale(1.05)], ..Effects.theme() }])])
 */
public struct Effects {
    /** 0 (invisible) to 1. */
    public opacity: Option<f64>,
    public filters: Filter[],
    public transform: Move[],
}

impl Effects {
    /** The theme's: nothing changed. */
    public fun theme(): Effects = Effects { opacity: None, filters: [], transform: [] };

    /** The whole node at opacity `x` (0 invisible to 1). */
    public fun opacity(x: f64): Effects = Effects { opacity: Some(x), ..Effects.theme() };

    /** The node blurred by `px`. */
    public fun blur(px: i64): Effects = Effects { filters: [Filter.Blur(px)], ..Effects.theme() };

    /** The node in greys. */
    public fun grayscale(): Effects = Effects {
        filters: [Filter.Grayscale(1.0)],
        ..Effects.theme(),
    };

    /** The node turned `deg` degrees clockwise. */
    public fun rotate(deg: i64): Effects = Effects {
        transform: [Move.Rotate(deg)],
        ..Effects.theme(),
    };

    /** The node drawn `x` times its size. */
    public fun scale(x: f64): Effects = Effects { transform: [Move.Scale(x)], ..Effects.theme() };

    /** The node drawn `x` right and `y` down. */
    public fun translate(x: i64, y: i64): Effects = Effects {
        transform: [Move.Translate(x, y)],
        ..Effects.theme(),
    };

    /** `s` with every field these effects set. */
    public fun apply(self, s: Sheet): Sheet = Sheet {
        effects: Effects {
            opacity: if self.opacity.is_some() { self.opacity } else { s.effects.opacity },
            filters: if self.filters.len > 0 { self.filters } else { s.effects.filters },
            transform: if self.transform.len > 0 { self.transform } else { s.effects.transform },
        },
        ..s,
    };
}

/**
 * The icon GTK draws in a part (`Inside(Part.Check, …)`): a check box's
 * tick. Symbolic icons take the part's text colour. `icon` `""` is the
 * theme's.
 *
 * Example:
 *     When(State.Checked, [Inside(Part.Check, [Mark.icon("object-select-symbolic", 14)])])
 */
public struct Mark {
    public icon: string,
    /** Pixels. */
    public size: i64,
}

impl Mark {
    /** The theme's mark. */
    public fun theme(): Mark = Mark { icon: "", size: 0 };

    /** The theme icon `name`, `px` pixels square. */
    public fun icon(name: string, px: i64): Mark = Mark { icon: name, size: px };

    /** `s` with this mark, if it names one. */
    public fun apply(self, s: Sheet): Sheet = if self.icon == "" {
        s
    } else {
        Sheet { mark: self, ..s }
    };
}
