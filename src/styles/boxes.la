/**
 * The box groups (PRPs 017–019): what's behind a node, its border and
 * outline, the room around it and its size. Imports `styles` for `Sheet`,
 * which imports this back (DECISION-025). Pure.
 *
 * Depends on: styles (`Sheet`), style_values, theming, pictures
 * Used by: box_rules, lib, styles
 */

import styles { Sheet };
import styles.theming { Color, Paint };
import view.pictures { Image };
import styles.values { Gradient, Stop, Fill, Width, Line, Radius, Side, Edges };

/**
 * What's behind a node's content: an image over a gradient over a colour,
 * stacked as CSS stacks them. Fields left `Theme` (and `image` `None`) stay
 * the GTK theme's. A picture from a file or bytes is checked before GTK sees
 * it; one that can't be shown shows nothing.
 *
 * Example:
 *     column(rows).style([Background { color: Paint.Faded(0.08), ..Background.theme() }])
 */
public struct Background {
    /** `Faded(x)` is a tint of the theme's text colour, following light and dark. */
    public color: Paint,
    public gradient: Gradient,
    public image: Option<Image>,
    public fill: Fill,
}

impl Background {
    /** Every field the theme's: start here and change what you need. */
    public fun theme(): Background = Background {
        color: Paint.Theme,
        gradient: Gradient.Theme,
        image: None,
        fill: Fill.Theme,
    };

    /** A plain colour. */
    public fun color(c: Color): Background = Background {
        color: Paint.Color(c),
        ..Background.theme(),
    };

    /** A tint of the theme's text colour at `x`, following light and dark. */
    public fun tint(x: f64): Background = Background {
        color: Paint.Faded(x),
        ..Background.theme(),
    };

    /** A gradient along `angle` degrees (0 is upwards, 90 to the right). */
    public fun linear(angle: i64, stops: Stop[]): Background = Background {
        gradient: Gradient.Linear(angle, stops),
        ..Background.theme(),
    };

    /** A gradient from the centre outwards. */
    public fun radial(stops: Stop[]): Background = Background {
        gradient: Gradient.Radial(stops),
        ..Background.theme(),
    };

    /** A picture covering the node, cropped to fit. */
    public fun image(img: Image): Background = Background {
        image: Some(img),
        fill: Fill.Cover,
        ..Background.theme(),
    };

    /** `s` with every field this background sets. */
    public fun apply(self, s: Sheet): Sheet = Sheet {
        background: Background {
            color: if self.color == Paint.Theme { s.background.color } else { self.color },
            gradient: if self.gradient == Gradient.Theme {
                s.background.gradient
            } else {
                self.gradient
            },
            image: if self.image.is_some() { self.image } else { s.background.image },
            fill: if self.fill == Fill.Theme { s.background.fill } else { self.fill },
        },
        ..s,
    };
}

/**
 * A node's border: `all` for every side, each side on its own over it (field
 * by field), and the corners' radius. Across a style's values the later
 * wins, so a later `all` resets sides an earlier value set.
 *
 * Example:
 *     card.style([Border { all: hairline, radius: Radius.All(12), ..Border.theme() }])
 */
public struct Border {
    public all: Side,
    public top: Side,
    public right: Side,
    public bottom: Side,
    public left: Side,
    public radius: Radius,
}

impl Border {
    /** Every field the theme's: start here and change what you need. */
    public fun theme(): Border = Border {
        all: Side.theme(),
        top: Side.theme(),
        right: Side.theme(),
        bottom: Side.theme(),
        left: Side.theme(),
        radius: Radius.Theme,
    };

    /** A solid line `px` wide on every side. */
    public fun all(px: i64, paint: Paint): Border = Border {
        all: Side { width: Width.Px(px), color: paint, style: Line.Solid },
        ..Border.theme(),
    };

    /** A solid line `px` wide on top. */
    public fun top(px: i64, paint: Paint): Border = Border {
        top: Side { width: Width.Px(px), color: paint, style: Line.Solid },
        ..Border.theme(),
    };

    /** A solid line `px` wide on the right. */
    public fun right(px: i64, paint: Paint): Border = Border {
        right: Side { width: Width.Px(px), color: paint, style: Line.Solid },
        ..Border.theme(),
    };

    /** A solid line `px` wide along the bottom. */
    public fun bottom(px: i64, paint: Paint): Border = Border {
        bottom: Side { width: Width.Px(px), color: paint, style: Line.Solid },
        ..Border.theme(),
    };

    /** A solid line `px` wide on the left. */
    public fun left(px: i64, paint: Paint): Border = Border {
        left: Side { width: Width.Px(px), color: paint, style: Line.Solid },
        ..Border.theme(),
    };

    /** Every corner rounded by `px`. */
    public fun rounded(px: i64): Border = Border { radius: Radius.All(px), ..Border.theme() };

    /** Each corner's own radius: top left, top right, bottom right, bottom left. */
    public fun corners(tl: i64, tr: i64, br: i64, bl: i64): Border = Border {
        radius: Radius.Corners(tl, tr, br, bl),
        ..Border.theme(),
    };

    /** No border on any side, the theme's removed too. */
    public fun none(): Border = Border {
        all: Side { style: Line.None, ..Side.theme() },
        ..Border.theme(),
    };

    /** `s` with every side and corner this border sets; `all` is folded into the sides. */
    public fun apply(self, s: Sheet): Sheet {
        let was = s.border;
        // A side's own field beats `all`; both beat what was there.
        let side = fun(own: Side, before: Side): Side = own.over(self.all.over(before));
        Sheet {
            border: Border {
                all: Side.theme(),
                top: side(self.top, was.top),
                right: side(self.right, was.right),
                bottom: side(self.bottom, was.bottom),
                left: side(self.left, was.left),
                radius: if self.radius == Radius.Theme { was.radius } else { self.radius },
            },
            ..s,
        }
    }
}

/**
 * A line around a node, outside its border, that doesn't take room: for
 * "selected" or a drop target. It hides while the node has keyboard focus,
 * so the theme's focus ring shows.
 *
 * Example:
 *     tile.style([Outline { width: Width.Px(2), color: Paint.Color(hex("#2a5298")), style: Line.Solid, offset: 2 }])
 */
public struct Outline {
    public width: Width,
    public color: Paint,
    public style: Line,
    /** Pixels outside the border; negative draws inside; 0 is the theme's. */
    public offset: i64,
}

impl Outline {
    /** Every field the theme's. */
    public fun theme(): Outline = Outline {
        width: Width.Theme,
        color: Paint.Theme,
        style: Line.Theme,
        offset: 0,
    };

    /** A solid outline `px` wide. */
    public fun ring(px: i64, paint: Paint): Outline = Outline {
        width: Width.Px(px),
        color: paint,
        style: Line.Solid,
        offset: 0,
    };

    /** The outline `px` outside the border (negative draws inside). */
    public fun offset(px: i64): Outline = Outline { offset: px, ..Outline.theme() };

    /** `s` with every field this outline sets. */
    public fun apply(self, s: Sheet): Sheet = Sheet {
        outline: Outline {
            width: if self.width == Width.Theme { s.outline.width } else { self.width },
            color: if self.color == Paint.Theme { s.outline.color } else { self.color },
            style: if self.style == Line.Theme { s.outline.style } else { self.style },
            offset: if self.offset == 0 { s.outline.offset } else { self.offset },
        },
        ..s,
    };
}

/**
 * The room around and between things: padding inside the border, margin
 * outside it (it may be negative), and the gap between a column's, row's or
 * wrap's children. Each side as a border's: `all`, a side's own value over it.
 *
 * Example:
 *     card.style([Spacing { padding: Edges { all: Width.Px(16), ..Edges.theme() }, gap: Width.Px(8), ..Spacing.theme() }])
 */
public struct Spacing {
    public padding: Edges,
    public margin: Edges,
    public gap: Width,
}

impl Spacing {
    /** Every field the theme's: start here and change what you need. */
    public fun theme(): Spacing = Spacing {
        padding: Edges.theme(),
        margin: Edges.theme(),
        gap: Width.Theme,
    };

    /** `px` padding on every side (inside the border). */
    public fun padding(px: i64): Spacing = Spacing {
        padding: Edges { all: Width.Px(px), ..Edges.theme() },
        ..Spacing.theme(),
    };

    /** `px` padding left and right. */
    public fun padding_x(px: i64): Spacing = Spacing {
        padding: Edges { left: Width.Px(px), right: Width.Px(px), ..Edges.theme() },
        ..Spacing.theme(),
    };

    /** `px` padding top and bottom. */
    public fun padding_y(px: i64): Spacing = Spacing {
        padding: Edges { top: Width.Px(px), bottom: Width.Px(px), ..Edges.theme() },
        ..Spacing.theme(),
    };

    /** `px` padding on top. */
    public fun padding_top(px: i64): Spacing = Spacing {
        padding: Edges { top: Width.Px(px), ..Edges.theme() },
        ..Spacing.theme(),
    };

    /** `px` padding on the right. */
    public fun padding_right(px: i64): Spacing = Spacing {
        padding: Edges { right: Width.Px(px), ..Edges.theme() },
        ..Spacing.theme(),
    };

    /** `px` padding at the bottom. */
    public fun padding_bottom(px: i64): Spacing = Spacing {
        padding: Edges { bottom: Width.Px(px), ..Edges.theme() },
        ..Spacing.theme(),
    };

    /** `px` padding on the left. */
    public fun padding_left(px: i64): Spacing = Spacing {
        padding: Edges { left: Width.Px(px), ..Edges.theme() },
        ..Spacing.theme(),
    };

    /** `px` margin on every side (outside the border; negative pulls neighbours in). */
    public fun margin(px: i64): Spacing = Spacing {
        margin: Edges { all: Width.Px(px), ..Edges.theme() },
        ..Spacing.theme(),
    };

    /** `px` margin left and right. */
    public fun margin_x(px: i64): Spacing = Spacing {
        margin: Edges { left: Width.Px(px), right: Width.Px(px), ..Edges.theme() },
        ..Spacing.theme(),
    };

    /** `px` margin top and bottom. */
    public fun margin_y(px: i64): Spacing = Spacing {
        margin: Edges { top: Width.Px(px), bottom: Width.Px(px), ..Edges.theme() },
        ..Spacing.theme(),
    };

    /** `px` margin on top. */
    public fun margin_top(px: i64): Spacing = Spacing {
        margin: Edges { top: Width.Px(px), ..Edges.theme() },
        ..Spacing.theme(),
    };

    /** `px` margin on the right. */
    public fun margin_right(px: i64): Spacing = Spacing {
        margin: Edges { right: Width.Px(px), ..Edges.theme() },
        ..Spacing.theme(),
    };

    /** `px` margin at the bottom. */
    public fun margin_bottom(px: i64): Spacing = Spacing {
        margin: Edges { bottom: Width.Px(px), ..Edges.theme() },
        ..Spacing.theme(),
    };

    /** `px` margin on the left. */
    public fun margin_left(px: i64): Spacing = Spacing {
        margin: Edges { left: Width.Px(px), ..Edges.theme() },
        ..Spacing.theme(),
    };

    /** `px` between a column's, row's or wrap's children. */
    public fun gap(px: i64): Spacing = Spacing { gap: Width.Px(px), ..Spacing.theme() };

    /** `s` with every side and the gap this spacing sets. */
    public fun apply(self, s: Sheet): Sheet = Sheet {
        spacing: Spacing {
            padding: self.padding.over(s.spacing.padding),
            margin: self.margin.over(s.spacing.margin),
            gap: if self.gap == Width.Theme { s.spacing.gap } else { self.gap },
        },
        ..s,
    };
}

/**
 * How big a node is, each way: exactly, at least and at most, combined as CSS
 * combines them (an exact size kept within the minimum and the maximum, the
 * minimum winning). A node is never smaller than its content's own minimum.
 * A minimum is GTK's CSS; an exact size or a maximum puts the node in a clamp.
 *
 * Example:
 *     text(m.body).wrap().style([Sizing { max_width: Width.Px(560), ..Sizing.theme() }])
 */
public struct Sizing {
    public width: Width,
    public min_width: Width,
    public max_width: Width,
    public height: Width,
    public min_height: Width,
    public max_height: Width,
}

impl Sizing {
    /** Every field the theme's: start here and change what you need. */
    public fun theme(): Sizing = Sizing {
        width: Width.Theme,
        min_width: Width.Theme,
        max_width: Width.Theme,
        height: Width.Theme,
        min_height: Width.Theme,
        max_height: Width.Theme,
    };

    /** Exactly `px` wide (within the minimum and maximum). */
    public fun width(px: i64): Sizing = Sizing { width: Width.Px(px), ..Sizing.theme() };

    /** At least `px` wide. */
    public fun min_width(px: i64): Sizing = Sizing { min_width: Width.Px(px), ..Sizing.theme() };

    /** At most `px` wide. */
    public fun max_width(px: i64): Sizing = Sizing { max_width: Width.Px(px), ..Sizing.theme() };

    /** Exactly `px` high (within the minimum and maximum). */
    public fun height(px: i64): Sizing = Sizing { height: Width.Px(px), ..Sizing.theme() };

    /** At least `px` high. */
    public fun min_height(px: i64): Sizing = Sizing { min_height: Width.Px(px), ..Sizing.theme() };

    /** At most `px` high. */
    public fun max_height(px: i64): Sizing = Sizing { max_height: Width.Px(px), ..Sizing.theme() };

    /** `s` with every size this value sets. */
    public fun apply(self, s: Sheet): Sheet {
        let was = s.sizing;
        let pick = fun(own: Width, before: Width): Width = if own == Width.Theme {
            before
        } else {
            own
        };
        Sheet {
            sizing: Sizing {
                width: pick(self.width, was.width),
                min_width: pick(self.min_width, was.min_width),
                max_width: pick(self.max_width, was.max_width),
                height: pick(self.height, was.height),
                min_height: pick(self.min_height, was.min_height),
                max_height: pick(self.max_height, was.max_height),
            },
            ..s,
        }
    }
}
