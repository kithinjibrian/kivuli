/**
 * Building widgets: turns a `View` into GTK widgets and gives them their
 * style. Used when a window opens and by the patches that add or replace
 * nodes; not responsible for running the app or deciding what changed
 * (`live`, `diff`).
 *
 * Depends on: views, live_tree, gtk.raw
 * Used by: live
 */

import gtk {
    GVariant,
    GtkEventController,
    GtkShortcut,
    GtkTextBuffer,
    GtkWidget,
    connect_buffer,
    connect_widget,
    emit_widget,
    g_free,
    g_timeout_add_full,
    gtk_box_append,
    gtk_box_new,
    gtk_box_set_spacing,
    gtk_button_new_with_label,
    gtk_callback_action_new,
    gtk_check_button_get_active,
    gtk_check_button_new,
    gtk_check_button_set_active,
    gtk_check_button_set_child,
    gtk_editable_get_text,
    gtk_editable_set_text,
    gtk_entry_new,
    gtk_entry_set_placeholder_text,
    gtk_label_new,
    gtk_label_set_attributes,
    gtk_label_set_ellipsize,
    gtk_label_set_lines,
    gtk_label_set_max_width_chars,
    gtk_label_set_selectable,
    gtk_label_set_wrap,
    gtk_label_set_wrap_mode,
    gtk_scrolled_window_get_child,
    gtk_scrolled_window_new,
    gtk_scrolled_window_set_child,
    gtk_separator_new,
    gtk_shortcut_controller_add_shortcut,
    gtk_shortcut_controller_new,
    gtk_shortcut_controller_remove_shortcut,
    gtk_shortcut_controller_set_scope,
    gtk_shortcut_new,
    gtk_shortcut_trigger_parse_string,
    gtk_text_buffer_set_text,
    gtk_text_view_get_buffer,
    gtk_text_view_new,
    gtk_text_view_set_wrap_mode,
    gtk_widget_add_controller,
    gtk_widget_add_css_class,
    gtk_widget_grab_focus,
    gtk_widget_remove_css_class,
    gtk_widget_set_halign,
    gtk_widget_set_hexpand,
    gtk_widget_set_margin_bottom,
    gtk_widget_set_margin_end,
    gtk_widget_set_margin_start,
    gtk_widget_set_margin_top,
    gtk_widget_set_sensitive,
    gtk_widget_set_size_request,
    gtk_widget_set_tooltip_text,
    gtk_widget_set_valign,
    gtk_widget_set_vexpand,
    lgtk_cstring_text,
    lgtk_text_get,
    pango_attr_list_insert,
    pango_attr_list_new,
    pango_attr_list_unref,
    pango_attr_size_new,
    pango_attr_weight_new,
};
import live_tree { Live, widget };
import views { View, Style, Align, ButtonStyle };
import keys { parse };

/** Builds the GTK widgets for `v` at the top of a window; each widget sends its messages through `send`. */
fun create<Msg>(v: View<Msg>, send: fun(Msg)): Live<Msg> = create_in(v, 1, send);

/**
 * Builds the GTK widgets for `v` inside a parent laid out along `axis`
 * (`GtkOrientation`: 1 vertical, a column; 0 horizontal, a row). Spacers grow
 * along it and separators cross it.
 */
fun create_in<Msg>(v: View<Msg>, axis: i32, send: fun(Msg)): Live<Msg> = match v {
    Text(s) => Live.Label(gtk_label_new(s)),
    Button(label, msg) => {
        let button = gtk_button_new_with_label(label);
        let current = Ref.new(msg);
        // No message means disabled (decision 6): greyed out, and the handler
        // below sends nothing even if GTK delivers a click.
        gtk_widget_set_sensitive(button, flag(msg.is_some()));
        // Connected once, for the widget's whole life: a SetMsg patch changes
        // `current`, never the connection.
        connect_widget(
            button,
            "clicked",
            fun(b: GtkWidget) {
                match current.get() {
                    Some(m) => send(m),
                    None => {}
                }
            },
            0,
        );
        // One shortcut controller per button, global: its keys work anywhere in
        // the window. `apply_style` puts the button's shortcut in it.
        let controller = gtk_shortcut_controller_new();
        gtk_shortcut_controller_set_scope(controller, 2);
        gtk_widget_add_controller(button, controller);
        Live.Button(button, current, controller, Ref.new(None))
    }
    // Spacing comes later as a modifier.
    Column(children) => create_box(1, children, send),
    Row(children) => create_box(0, children, send),
    Input(value, on_change, on_submit) => {
        let entry = gtk_entry_new();
        // Set before connecting, so the first text isn't sent as an edit.
        gtk_editable_set_text(entry, value);
        let current = Ref.new(on_change);
        connect_widget(
            entry,
            "changed",
            fun(e: GtkWidget) {
                let f = current.get();
                send(f(gtk_editable_get_text(e)));
            },
            0,
        );
        let submit = Ref.new(on_submit);
        connect_widget(
            entry,
            "activate",
            fun(e: GtkWidget) {
                match submit.get() {
                    Some(m) => send(m),
                    None => {}
                }
            },
            0,
        );
        Live.Input(entry, current, submit)
    }
    TextArea(value, on_change) => {
        let view = gtk_text_view_new();
        // Word wrapping, breaking a word only when it's longer than the line.
        gtk_text_view_set_wrap_mode(view, 3);
        let buffer = gtk_text_view_get_buffer(view);
        // Set before connecting, so the first text isn't sent as an edit.
        gtk_text_buffer_set_text(buffer, value, -1);
        let current = Ref.new(on_change);
        connect_buffer(
            buffer,
            "changed",
            fun(b: GtkTextBuffer) {
                let f = current.get();
                send(f(text_of(b)));
            },
            0,
        );
        // Its own scrolled window: long text scrolls instead of growing the window.
        let scrolled = gtk_scrolled_window_new();
        gtk_scrolled_window_set_child(scrolled, Some(view));
        gtk_widget_set_size_request(scrolled, -1, 80);
        Live.TextArea(scrolled, buffer, current)
    }
    Checkbox(label, checked, on_toggle) => {
        // Its own label child, so the long-text modifiers can reach it.
        let check = gtk_check_button_new();
        let text = gtk_label_new(label);
        gtk_check_button_set_child(check, Some(text));
        // Set before connecting, so the first state isn't sent as a toggle.
        gtk_check_button_set_active(check, flag(checked));
        let current = Ref.new(on_toggle);
        connect_widget(
            check,
            "toggled",
            fun(c: GtkWidget) {
                let f = current.get();
                send(f(gtk_check_button_get_active(c) != 0));
            },
            0,
        );
        Live.Checkbox(check, text, current)
    }
    Spacer => {
        // An empty box given all the spare room along its parent's axis.
        let room = gtk_box_new(0, 0);
        if axis == 1 {
            gtk_widget_set_vexpand(room, 1);
        } else {
            gtk_widget_set_hexpand(room, 1);
        }
        Live.Spacer(room)
    }
    // Across the axis: a horizontal line in a column, a vertical one in a row.
    Separator => Live.Separator(gtk_separator_new(1 - axis)),
    Scroll(child) => {
        let scrolled = gtk_scrolled_window_new();
        // A scrolled window asks for almost no room of its own: let it take
        // the spare room both ways, or it shows a sliver.
        gtk_widget_set_hexpand(scrolled, 1);
        gtk_widget_set_vexpand(scrolled, 1);
        let kid = create_in(child, 1, send);
        gtk_scrolled_window_set_child(scrolled, Some(widget(kid)));
        Live.Scroll(scrolled, kid)
    }
    // On screen a keyed column is a column: the keys matter only to the diff.
    // Transparent: the widgets are those of what it built.
    Lazy(_, build, built) => create_in(
        match built {
            Some(b) => b,
            None => build(),
        },
        axis,
        send,
    ),
    Keyed(children) => {
        let mut views_of: View<Msg>[] = [];
        for (_, v) of children {
            views_of.push(v);
        }
        create_box(1, views_of, send)
    }
    Styled(inside, style) => {
        let node = create_in(inside, axis, send);
        apply_style(node, style, axis);
        if style.autofocus {
            // On the main loop's next turn: the widget is in its window by then
            // (GTK ignores a focus grab outside one).
            let target = focus_target(node);
            g_timeout_add_full(0, 0, fun(): i32 {
                gtk_widget_grab_focus(target);
                // G_SOURCE_REMOVE: once.
                0
            });
        }
        node
    }
};

/** Builds a `GtkBox` of `orientation` holding the widgets for `children`. */
fun create_box<Msg>(orientation: i32, children: View<Msg>[], send: fun(Msg)): Live<Msg> {
    let box = gtk_box_new(orientation, 0);
    let mut kids: Live<Msg>[] = [];
    for child of children {
        let kid = create_in(child, orientation, send);
        gtk_box_append(box, widget(kid));
        kids.push(kid);
    }
    Live.Box(box, orientation, kids)
}

/**
 * Gives `node`'s widget every field of `style`, defaults included, so a
 * modifier that's gone is undone. `axis` is its parent's (as for `create_in`):
 * `expand` grows along it and `align` places across it.
 */
fun apply_style<Msg>(node: Live<Msg>, style: Style, axis: i32) {
    let w = widget(node);
    let pad = style.padding as i32;
    gtk_widget_set_margin_top(w, pad);
    gtk_widget_set_margin_bottom(w, pad);
    gtk_widget_set_margin_start(w, pad);
    gtk_widget_set_margin_end(w, pad);
    // Spacers and scrolls always take spare room (see `create_in`).
    let grows = style.expand || match node {
        Spacer(_) => true,
        Scroll(_, _) => true,
        _ => false,
    };
    if axis == 1 {
        gtk_widget_set_vexpand(w, flag(grows));
        gtk_widget_set_halign(w, gtk_align(style.align));
    } else {
        gtk_widget_set_hexpand(w, flag(grows));
        gtk_widget_set_valign(w, gtk_align(style.align));
    }
    // A text area keeps its default height (80 pixels) until `.height` sets one.
    let height = match node {
        TextArea(_, _, _) => if style.height < 0 { 80 } else { style.height },
        _ => style.height,
    };
    gtk_widget_set_size_request(w, style.width as i32, height as i32);
    gtk_widget_set_tooltip_text(w, if style.tooltip == "" { None } else { Some(style.tooltip) });
    match node {
        Box(box, _, _) => gtk_box_set_spacing(box, style.spacing as i32),
        Label(label) => {
            style_text(label, style);
            style_long_text(label, style);
            gtk_label_set_selectable(label, flag(style.selectable));
        }
        Checkbox(_, label, _) => style_long_text(label, style),
        Input(entry, _, _) => gtk_entry_set_placeholder_text(
            entry,
            if style.placeholder == "" { None } else { Some(style.placeholder) },
        ),
        Button(button, _, controller, shortcut) => {
            style_button(button, style.look);
            style_shortcut(controller, shortcut, style.shortcut);
        }
        _ => {}
    }
}

/**
 * Gives a label the long-text fields of `style`, defaults included: wrapping
 * (at word boundaries, else characters), its width cap, and ellipsizing, which
 * with wrapping allows three lines.
 */
fun style_long_text(label: GtkWidget, style: Style) {
    gtk_label_set_wrap(label, flag(style.wrap));
    // PangoWrapMode 2: at word boundaries, breaking a word only if it's longer than a line.
    gtk_label_set_wrap_mode(label, 2);
    // PangoEllipsizeMode: 3 end, 0 none.
    gtk_label_set_ellipsize(label, if style.ellipsize { 3 } else { 0 });
    gtk_label_set_lines(label, if style.wrap && style.ellipsize { 3 } else { -1 });
    gtk_label_set_max_width_chars(
        label,
        if style.wrap && style.wrap_at > 0 { style.wrap_at as i32 } else { -1 },
    );
}

/**
 * Puts `combo` (keys as the app wrote them) in the button's shortcut controller in
 * place of the shortcut there now; `""` leaves it without one. Keys kivuli
 * can't read stop the app with a message naming them.
 */
fun style_shortcut(
    controller: GtkEventController,
    current: Ref<Option<GtkShortcut>>,
    combo: string,
) {
    match current.get() {
        Some(old) => gtk_shortcut_controller_remove_shortcut(controller, old),
        None => {}
    }
    current.set(None);
    if combo == "" {
        return;
    }
    let accel = match parse(combo) {
        Ok(g) => g,
        Err(problem) => panic("kivuli: can't read the shortcut \"{combo}\": {problem}"),
    };
    let Some(trigger) = gtk_shortcut_trigger_parse_string(accel) else {
        panic("kivuli: GTK can't read the shortcut \"{combo}\" (as \"{accel}\")");
    };
    // Pressing the keys clicks the button, so a disabled one (no message) sends
    // nothing. A callback action, not GTK's activate action: that one does
    // nothing until the window is on screen.
    let action = gtk_callback_action_new(fun(w: GtkWidget, args: Option<GVariant>): i32 {
        emit_widget(w, "clicked");
        1
    });
    let shortcut = gtk_shortcut_new(trigger, action);
    gtk_shortcut_controller_add_shortcut(controller, shortcut);
    current.set(Some(shortcut));
}

/** The widget that takes keyboard focus for `node`: a text area's editor, else the node's widget. */
fun focus_target<Msg>(node: Live<Msg>): GtkWidget = match node {
    TextArea(scrolled, _, _) => gtk_scrolled_window_get_child(scrolled).unwrap_or(scrolled),
    _ => widget(node),
};

/** Gives a button the theme's CSS class for `look`, and only that one. */
fun style_button(button: GtkWidget, look: ButtonStyle) {
    gtk_widget_remove_css_class(button, "suggested-action");
    gtk_widget_remove_css_class(button, "destructive-action");
    gtk_widget_remove_css_class(button, "flat");
    match look {
        Normal => {}
        Primary => gtk_widget_add_css_class(button, "suggested-action"),
        Danger => gtk_widget_add_css_class(button, "destructive-action"),
        Subtle => gtk_widget_add_css_class(button, "flat"),
    }
}

/**
 * Gives a label the text fields of `style`: size and bold as Pango attributes
 * (a fresh list each time, or none), dim as the theme's `dim-label` class.
 */
fun style_text(label: GtkWidget, style: Style) {
    if style.size > 0 || style.bold {
        let list = pango_attr_list_new();
        if style.bold {
            // PangoWeight: 700 is bold.
            pango_attr_list_insert(list, pango_attr_weight_new(700));
        }
        if style.size > 0 {
            // Pango sizes are points times PANGO_SCALE (1024).
            pango_attr_list_insert(list, pango_attr_size_new((style.size * 1024) as i32));
        }
        gtk_label_set_attributes(label, Some(list));
        // The label holds its own reference now.
        pango_attr_list_unref(list);
    } else {
        gtk_label_set_attributes(label, None);
    }
    if style.dim {
        gtk_widget_add_css_class(label, "dim-label");
    } else {
        gtk_widget_remove_css_class(label, "dim-label");
    }
}

/** `GtkAlign`: 0 fill, 1 start, 2 end, 3 center. */
fun gtk_align(a: Align): i32 = match a {
    Fill => 0,
    Start => 1,
    End => 2,
    Center => 3,
};

/** A Lugha `bool` as a C `gboolean`. */
fun flag(b: bool): i32 = if b { 1 } else { 0 };

/** A text buffer's whole text; the copy C allocated is freed. */
fun text_of(buffer: GtkTextBuffer): string {
    let owned = lgtk_text_get(buffer);
    let text = lgtk_cstring_text(owned);
    g_free(owned);
    text
}
