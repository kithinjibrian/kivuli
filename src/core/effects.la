/**
 * Effects as data: the commands `update` returns, the subscriptions an app
 * asks for, and the `App` record `application` runs. Pure: nothing here runs
 * a timer or quits anything (that's `live`), so it's tested headlessly.
 *
 * Depends on: views
 * Used by: lib, live
 */

import view.views { View };

/**
 * Something for kivuli to do after an update: wait and send a message, run
 * work in the background, quit, or several of those. Build one with
 * `Cmd.none()`, `Cmd.after(ms, msg)`, `Cmd.task(work, done)`, `Cmd.quit()` or
 * `Cmd.batch(cmds)`.
 */
public enum Cmd<Msg> {
    Nothing,
    Batch(Cmd<Msg>[]),
    /** Send the message after this many milliseconds. */
    After(i64, Msg),
    Quit,
    /** Give keyboard focus to the node with this `.name`. */
    Focus(string),
    /** Scroll the node with this `.name` into view, the focus left where it is. */
    ScrollTo(string),
    /** Run this on a green thread; send what it returns (its work then `done`). */
    Task(fun(): Msg),
}

impl Cmd<Msg> {
    /** Does nothing: what most updates return. */
    public fun none(): Cmd<Msg> = Cmd.Nothing;

    /**
     * Runs every command in `cmds`.
     *
     * Example:
     *     Cmd.batch([Cmd.after(1000, Msg.Tick), Cmd.after(5000, Msg.Timeout)])
     */
    public fun batch(cmds: Cmd<Msg>[]): Cmd<Msg> = Cmd.Batch(cmds);

    /**
     * Sends `msg` to `update` once, `ms` milliseconds from now.
     *
     * Example:
     *     (Model { saving: true, ..m }, Cmd.after(2000, Msg.Saved))
     */
    public fun after(ms: i64, msg: Msg): Cmd<Msg> = Cmd.After(ms, msg);

    /**
     * Runs `work` in the background, on a green thread, and sends
     * `done(result)` to `update` when it returns: exactly one message.
     * Downloads (`std.http`, `std.net`) and `task.sleep` wait without holding
     * the window; Lugha computation shares it in slices; a single blocking
     * call (reading a file, a DNS lookup, `std.crypto`, `std.process`) still
     * holds it until it returns. `work` runs on a copy of what it captured,
     * must not call kivuli or GTK, and can't be cancelled: ignore a result
     * you no longer want. A panic in it ends the program.
     *
     * Example:
     *     Open(url) => (Model { page: Page.Loading(url), ..m },
     *                   Cmd.task(fun(): Result<u8[], string> = download(url), Msg.Got))
     */
    public fun task<T>(work: fun(): T, done: fun(T): Msg): Cmd<Msg> = Cmd.Task(
        fun(): Msg = done(work()),
    );

    /** Closes the window and ends the app; `main` returns. */
    public fun quit(): Cmd<Msg> = Cmd.Quit;

    /**
     * Moves keyboard focus to the node named `name` (`.name(name)`) once the
     * update is shown; nothing happens if no node has that name.
     *
     * Example:
     *     Add => (Model { draft: "", ..m }, Cmd.focus("task"))
     */
    public fun focus(name: string): Cmd<Msg> = Cmd.Focus(name);

    /**
     * Scrolls the nearest `scroll` or `scroll_fit` around the node named
     * `name` (`.name(name)`) as little as it can to show it, once the update
     * is shown: nothing if it's already in view, if no node has that name or
     * if it's in no scroll. The keyboard focus stays where it is.
     *
     * Example:
     *     Opened(id) => (Model { current: id, ..m }, Cmd.scroll_to("app-{id}"))
     */
    public fun scroll_to(name: string): Cmd<Msg> = Cmd.ScrollTo(name);

    /**
     * The same command, sending `f(msg)` wherever it would send `msg`: for a
     * component's commands inside a bigger app.
     *
     * Example:
     *     let (next, cmd) = timer.update(m.timer, t);
     *     (Model { timer: next, ..m }, cmd.map(Msg.Timer))
     */
    public fun map<B>(self, f: fun(Msg): B): Cmd<B> = match self {
        Nothing => Cmd.Nothing,
        Batch(cmds) => Cmd.Batch(cmds.map(fun(c) = c.map(f))),
        After(ms, msg) => Cmd.After(ms, f(msg)),
        Quit => Cmd.Quit,
        Focus(name) => Cmd.Focus(name),
        ScrollTo(name) => Cmd.ScrollTo(name),
        Task(job) => Cmd.Task(fun(): B = f(job())),
    };
}

/**
 * What an app keeps listening to while its model is as it is: asked for again
 * after every update, and kivuli starts and stops timers to match. Build one
 * with `Sub.none()`, `Sub.every(ms, f)`, `Sub.receive(chan, f)`,
 * `Sub.window_active(f)` or `Sub.batch(subs)`.
 */
public enum Sub<Msg> {
    Quiet,
    Batch(Sub<Msg>[]),
    /** Every this many milliseconds, send `f(now)`, now in milliseconds since 1970. */
    Every(i64, fun(i64): Msg),
    /** A channel's next value as a message, if one is ready (never waits). */
    Receive(fun(): Option<Msg>),
    /** When the window becomes active, `f(true)`; when it stops being active, `f(false)`. */
    WindowActive(fun(bool): Msg),
}

impl Sub<Msg> {
    /** Listens to nothing. */
    public fun none(): Sub<Msg> = Sub.Quiet;

    /**
     * Listens to every subscription in `subs`.
     *
     * Example:
     *     Sub.batch([Sub.every(1000, Msg.Tick), Sub.every(60000, Msg.Save)])
     */
    public fun batch(subs: Sub<Msg>[]): Sub<Msg> = Sub.Batch(subs);

    /**
     * Sends `f(now)` every `ms` milliseconds, `now` being milliseconds since
     * 1970, for as long as `subscriptions` keeps returning it.
     *
     * Example:
     *     if m.running { Sub.every(10, Msg.Tick) } else { Sub.none() }
     */
    public fun every(ms: i64, f: fun(i64): Msg): Sub<Msg> = Sub.Every(ms, f);

    /**
     * Sends `f(value)` for every value sent on `chan`, in order, for as long
     * as `subscriptions` keeps returning it: how a worker built with Lugha's
     * own `spawn`, channels or actors reports to `update`. Values sent while
     * nobody listens wait in the channel.
     *
     * Example:
     *     fun subscriptions(m: Model): Sub<Msg> = Sub.receive(m.progress, Msg.Progress);
     */
    public fun receive<T>(
        chan: Chan<T>,
        f: fun(T): Msg,
    ): Sub<Msg> = Sub.Receive(fun(): Option<Msg> = match chan.try_recv() {
        Some(value) => Some(f(value)),
        None => None,
    });

    /**
     * Sends `f(true)` when the app's window becomes the active one (in front,
     * with the desktop's keyboard focus) and `f(false)` when it stops being
     * active, for as long as `subscriptions` keeps returning it. Changes only:
     * nothing when it starts listening, never the same value twice in a row.
     *
     * Example:
     *     Sub.window_active(Msg.WindowActive)   // WindowActive(bool)
     */
    public fun window_active(f: fun(bool): Msg): Sub<Msg> = Sub.WindowActive(f);

    /**
     * The same subscription, sending `f(msg)` wherever it would send `msg`.
     *
     * Example:
     *     timer.subscriptions(m.timer).map(Msg.Timer)
     */
    public fun map<B>(self, f: fun(Msg): B): Sub<B> = match self {
        Quiet => Sub.Quiet,
        Batch(subs) => Sub.Batch(subs.map(fun(x) = x.map(f))),
        Every(ms, tick) => Sub.Every(ms, fun(now: i64): B = f(tick(now))),
        Receive(poll) => Sub.Receive(fun(): Option<B> = match poll() {
            Some(msg) => Some(f(msg)),
            None => None,
        }),
        WindowActive(on) => Sub.WindowActive(fun(active: bool): B = f(on(active))),
    };
}

/**
 * An app with effects, for `application`: like `sandbox`'s arguments, but
 * `init` and `update` also return a command, and `subscriptions` says what to
 * listen to for a given model.
 */
public struct App<Model, Msg> {
    /** The application ID, reverse-DNS, such as `"org.kivuli.stopwatch"`. */
    public id: string,
    public init: (Model, Cmd<Msg>),
    public update: fun(Model, Msg): (Model, Cmd<Msg>),
    public view: fun(Model): View<Msg>,
    public subscriptions: fun(Model): Sub<Msg>,
}

/** The `App` a `sandbox` runs: no commands, no subscriptions. */
fun sandbox_app<Model, Msg>(
    id: string,
    init: Model,
    update: fun(Model, Msg): Model,
    view: fun(Model): View<Msg>,
): App<Model, Msg> = App {
    id: id,
    init: (init, Cmd.none()),
    update: fun(m: Model, msg: Msg): (Model, Cmd<Msg>) = (update(m, msg), Cmd.none()),
    view: view,
    subscriptions: fun(m: Model): Sub<Msg> = Sub.none(),
};

/** The commands in `c` to carry out, in order: batches flattened, `none`s dropped. */
fun commands<Msg>(c: Cmd<Msg>): Cmd<Msg>[] = match c {
    Nothing => [],
    Batch(cs) => {
        let mut out: Cmd<Msg>[] = [];
        for each of cs {
            for leaf of commands(each) {
                out.push(leaf);
            }
        }
        out
    }
    _ => [c],
};

/** One timer a subscription asks for, and the key that names it across updates. */
struct Timer<Msg> {
    /**
     * The interval and its count among timers of that interval: `"1000#0"`,
     * `"1000#1"`. A timer whose key is asked for again keeps running.
     */
    key: string,
    ms: i64,
    tick: fun(i64): Msg,
}

/** The timers `s` asks for, in order, each with its key. */
fun timers<Msg>(s: Sub<Msg>): Timer<Msg>[] {
    let mut out: Timer<Msg>[] = [];
    for (ms, f) of every_of(s) {
        let mut n = 0;
        for t of out {
            if t.ms == ms {
                n = n + 1;
            }
        }
        out.push(Timer { key: "{ms}#{n}", ms: ms, tick: f });
    }
    out
}

/** Each `Sub.receive` in `s`, in order, as the function taking its channel's next message. */
fun receivers<Msg>(s: Sub<Msg>): (fun(): Option<Msg>)[] = match s {
    Batch(subs) => {
        let mut out: (fun(): Option<Msg>)[] = [];
        for each of subs {
            for poll of receivers(each) {
                out.push(poll);
            }
        }
        out
    }
    Receive(poll) => [poll],
    _ => [],
};

/** Each `Sub.window_active` in `s`, in order: what a change of the window's active state sends. */
fun active_listeners<Msg>(s: Sub<Msg>): (fun(bool): Msg)[] = match s {
    Batch(subs) => {
        let mut out: (fun(bool): Msg)[] = [];
        for each of subs {
            for f of active_listeners(each) {
                out.push(f);
            }
        }
        out
    }
    WindowActive(f) => [f],
    _ => [],
};

fun every_of<Msg>(s: Sub<Msg>): (i64, fun(i64): Msg)[] = match s {
    Quiet => [],
    Batch(subs) => {
        let mut out: (i64, fun(i64): Msg)[] = [];
        for each of subs {
            for pair of every_of(each) {
                out.push(pair);
            }
        }
        out
    }
    Every(ms, f) => [(ms, f)],
    _ => [],
};
