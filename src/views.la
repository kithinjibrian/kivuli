/**
 * The view tree: what an app's `view` function returns, and the functions
 * that build it. Plain data: it describes a screen and touches no GTK. Apps
 * reach it through the package entry, `lib.la`, which re-exports it.
 *
 * Used by: lib, diff, live
 */

/**
 * A description of what's on screen. `Msg` is the app's message type: what a
 * widget sends to `update` when the user acts on it.
 */
public enum View<Msg> {
    /** A line of text. */
    Text(string),
    /** A button with its label and the message one click sends; `None` when disabled. */
    Button(string, Option<Msg>),
    /** Children stacked top to bottom. */
    Column(View<Msg>[]),
    /** Children side by side, left to right. */
    Row(View<Msg>[]),
    /** A one-line text field: what it shows, the message each edit sends, and the message Enter sends. */
    Input(string, fun(string): Msg, Option<Msg>),
    /** A check box: its label, whether it's ticked, and the message each toggle sends. */
    Checkbox(string, bool, fun(bool): Msg),
    /** Empty room that grows along its column or row, pushing what follows to the end. */
    Spacer,
    /** A thin line across its column or row. */
    Separator,
    /** One child, scrolled when it's bigger than the room it's given. */
    Scroll(View<Msg>),
    /** Children stacked top to bottom, each with a key naming it across views. */
    Keyed((string, View<Msg>)[]),
    /** A node and its modifiers: built by the modifier methods, never by hand. */
    Styled(View<Msg>, Style),
    /**
     * A subtree built only when its key changes: the key, the function that
     * builds it, and the subtree once kivuli has built or reused it.
     */
    Lazy(string, fun(): View<Msg>, Option<View<Msg>>),
}

/**
 * Builds a line of text.
 *
 * Example:
 *     text("Clicked {m.count} times")
 */
public fun text<Msg>(s: string): View<Msg> = View.Text(s);

/**
 * Builds a button that sends `msg` each time it's clicked.
 *
 * Example:
 *     button("Add", Msg.Add)
 */
public fun button<Msg>(label: string, msg: Msg): View<Msg> = View.Button(label, Some(msg));

/**
 * Stacks `children` top to bottom.
 *
 * Example:
 *     column([text("Hi"), button("Add", Msg.Add)])
 */
public fun column<Msg>(children: View<Msg>[]): View<Msg> = View.Column(children);

/**
 * Lays `children` out side by side, left to right.
 *
 * Example:
 *     row([button("Add", Msg.Add), button("Reset", Msg.Reset)])
 */
public fun row<Msg>(children: View<Msg>[]): View<Msg> = View.Row(children);

/**
 * Builds a one-line text field showing `value`. Each edit sends
 * `on_change(text)`, the field's whole new text; store it in the model and
 * pass it back as `value`.
 *
 * Example:
 *     input(m.name, Msg.Named)
 */
public fun input<Msg>(value: string, on_change: fun(string): Msg): View<Msg> = View.Input(
    value,
    on_change,
    None,
);

/**
 * Builds a check box labelled `label`, ticked when `checked`. Each toggle
 * sends `on_toggle(ticked)`; store it in the model and pass it back as
 * `checked`.
 *
 * Example:
 *     checkbox("Done", item.done, Msg.Done)
 */
public fun checkbox<Msg>(
    label: string,
    checked: bool,
    on_toggle: fun(bool): Msg,
): View<Msg> = View.Checkbox(label, checked, on_toggle);

/**
 * Builds empty room that grows along its column (down) or row (across), so
 * what follows is pushed to the far end.
 *
 * Example:
 *     row([text("Total"), spacer(), text("42")])
 */
public fun spacer<Msg>(): View<Msg> = View.Spacer;

/**
 * Builds a thin line across its column (horizontal) or row (vertical).
 *
 * Example:
 *     column([text("Header"), separator(), text("Body")])
 */
public fun separator<Msg>(): View<Msg> = View.Separator;

/**
 * Shows `child` in a scrolled area that takes the room it's given and scrolls
 * when the child is bigger.
 *
 * Example:
 *     scroll(column(rows))
 */
public fun scroll<Msg>(child: View<Msg>): View<Msg> = View.Scroll(child);

/**
 * Stacks `children` top to bottom, like `column`, but matches them across
 * views by their keys rather than their positions: reordering, inserting or
 * deleting rows moves, adds or removes just those widgets. Keys must be
 * unique within one keyed column.
 *
 * Example:
 *     keyed_column(todos.map(fun(t: Todo) = (t.id, checkbox(t.title, t.done, Msg.Done))))
 */
public fun keyed_column<Msg>(children: (string, View<Msg>)[]): View<Msg> = View.Keyed(children);

/** The app's window, as `.window(title, width, height)` sets it. */
public struct Window {
    title: string,
    /** The size it opens at, in pixels. */
    width: i64,
    height: i64,
}

/** How a button looks, from the theme (docs/DESIGN.md). */
public enum ButtonStyle {
    Normal,
    /** The one main action in a view. */
    Primary,
    /** Deletes or discards. */
    Danger,
    /** Low emphasis, toolbar-like. */
    Subtle,
}

/** Where a node sits across its column (left to right) or row (top to bottom). */
public enum Align {
    /** Stretched across the whole width (in a column) or height (in a row): the default. */
    Fill,
    Start,
    Center,
    End,
}

/**
 * Every modifier a node can carry. Built by the modifier methods; a field
 * that doesn't fit a node is kept and ignored when it's shown.
 */
public struct Style {
    /** Pixels of empty room on all four sides. */
    padding: i64,
    /** Pixels between a column's or row's children. */
    spacing: i64,
    /** Whether the node takes spare room along its column (down) or row (across). */
    expand: bool,
    align: Align,
    /** The smallest width and height in pixels; -1 leaves it to the widget. */
    width: i64,
    height: i64,
    /** Text size in points; 0 keeps the theme's. Text only. */
    size: i64,
    /** Bold text. Text only. */
    bold: bool,
    /** Faded text, for secondary information. Text only. */
    dim: bool,
    /** How a button looks in the theme. Buttons only. */
    look: ButtonStyle,
    /** The window's title and size, from the root of `view`. Root only. */
    window: Option<Window>,
    /** Hint text an empty text field shows; "" for none. Text fields only. */
    placeholder: string,
}

/** The style of a node with no modifiers: what GTK does by default. */
fun plain(): Style = Style {
    padding: 0,
    spacing: 0,
    expand: false,
    align: Align.Fill,
    width: -1,
    height: -1,
    size: 0,
    bold: false,
    dim: false,
    look: ButtonStyle.Normal,
    window: None,
    placeholder: "",
};

/** `v` with its style changed by `f`: one `Styled` wrapper, however many modifiers. */
fun restyle<Msg>(v: View<Msg>, f: fun(Style): Style): View<Msg> = match v {
    Styled(inner, s) => View.Styled(inner, f(s)),
    // A lazy subtree's style is whatever `build` gives it (DECISION-002).
    Lazy(_, _, _) => v,
    _ => View.Styled(v, f(plain())),
};

impl View<Msg> {
    /**
     * Leaves `n` pixels of empty room on all four sides.
     *
     * Example:
     *     column(rows).padding(24)
     */
    public fun padding(self, n: i64): View<Msg> = restyle(
        self,
        fun(s: Style) = Style { padding: n, ..s },
    );

    /**
     * Puts `n` pixels between a column's or row's children; ignored on other nodes.
     *
     * Example:
     *     row([button("Add", Msg.Add), button("Reset", Msg.Reset)]).spacing(8)
     */
    public fun spacing(self, n: i64): View<Msg> = restyle(
        self,
        fun(s: Style) = Style { spacing: n, ..s },
    );

    /**
     * Lets the node take the spare room along its column (down) or row (across).
     *
     * Example:
     *     row([input(m.draft, Msg.Draft).expand(), button("Add", Msg.Add)])
     */
    public fun expand(self): View<Msg> = restyle(self, fun(s: Style) = Style { expand: true, ..s });

    /**
     * Places the node across its column (left to right) or row (top to bottom)
     * instead of stretching it.
     *
     * Example:
     *     text("Done").align(Align.Center)
     */
    public fun align(self, a: Align): View<Msg> = restyle(
        self,
        fun(s: Style) = Style { align: a, ..s },
    );

    /**
     * Makes the node at least `n` pixels wide.
     *
     * Example:
     *     input(m.name, Msg.Named).width(240)
     */
    public fun width(self, n: i64): View<Msg> = restyle(
        self,
        fun(s: Style) = Style { width: n, ..s },
    );

    /**
     * Makes the node at least `n` pixels tall.
     *
     * Example:
     *     scroll(column(rows)).height(200)
     */
    public fun height(self, n: i64): View<Msg> = restyle(
        self,
        fun(s: Style) = Style { height: n, ..s },
    );

    /**
     * Shows text at `n` points instead of the theme's size; ignored on other nodes.
     *
     * Example:
     *     text("Total").size(18)
     */
    public fun size(self, n: i64): View<Msg> = restyle(
        self,
        fun(s: Style) = Style { size: n, ..s },
    );

    /**
     * Shows text in bold; ignored on other nodes.
     *
     * Example:
     *     text(m.title).bold()
     */
    public fun bold(self): View<Msg> = restyle(self, fun(s: Style) = Style { bold: true, ..s });

    /**
     * Shows text faded, for secondary information; ignored on other nodes.
     *
     * Example:
     *     text("{m.count} left").dim()
     */
    public fun dim(self): View<Msg> = restyle(self, fun(s: Style) = Style { dim: true, ..s });

    /**
     * Gives a button the theme's look for its role; ignored on other nodes.
     *
     * Example:
     *     button("Delete", Msg.Delete).style(ButtonStyle.Danger)
     */
    public fun style(self, look: ButtonStyle): View<Msg> = restyle(
        self,
        fun(s: Style) = Style { look: look, ..s },
    );

    /**
     * When `off`, takes a button's message away: it's greyed out and clicks
     * send nothing. `disabled(false)` changes nothing. Ignored on other nodes.
     *
     * Example:
     *     button("Reset", Msg.Reset).disabled(m.count == 0)
     */
    public fun disabled(self, off: bool): View<Msg> = if !off {
        self
    } else {
        match self {
            Button(label, _) => View.Button(label, None),
            Styled(inside, s) => View.Styled(inside.disabled(true), s),
            _ => self,
        }
    };

    /**
     * Titles the app's window and sets the size it opens at, in pixels. On
     * the root of `view` only (elsewhere ignored), so the title may follow the
     * model.
     *
     * Example:
     *     column(rows).window("To-do ({m.left} left)", 360, 480)
     */
    public fun window(self, title: string, width: i64, height: i64): View<Msg> = restyle(
        self,
        fun(s: Style) = Style {
            window: Some(Window { title: title, width: width, height: height }),
            ..s,
        },
    );

    /**
     * Shows `hint` in an empty text field; ignored on other nodes. Tests find
     * text fields by it (`kivuli.testing.type_into`).
     *
     * Example:
     *     input(m.name, Msg.Named).placeholder("Your name")
     */
    public fun placeholder(self, hint: string): View<Msg> = restyle(
        self,
        fun(s: Style) = Style { placeholder: hint, ..s },
    );

    /**
     * Sends `msg` when Enter is pressed in a text field; ignored on other nodes.
     *
     * Example:
     *     input(m.draft, Msg.Draft).on_submit(Msg.Add)
     */
    public fun on_submit(self, msg: Msg): View<Msg> = match self {
        Input(value, on_change, _) => View.Input(value, on_change, Some(msg)),
        Styled(inside, s) => View.Styled(inside.on_submit(msg), s),
        _ => self,
    };
}

/**
 * Builds `build()` only when `key` differs from the key this lazy node had
 * last update; otherwise kivuli reuses what it built before, and doesn't diff
 * it either. The key must cover everything the subtree shows: leave something
 * out and a change to it won't appear. Modifiers belong inside `build`;
 * modifiers on the lazy node itself are ignored.
 *
 * Example:
 *     lazy("{t.id}:{t.done}:{t.title}", fun() = todo_row(t))
 */
public fun lazy<Msg>(key: string, build: fun(): View<Msg>): View<Msg> = View.Lazy(key, build, None);
