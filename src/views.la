/**
 * The view tree: what an app's `view` function returns, and the functions
 * that build it. Plain data: it describes a screen and touches no GTK. Apps
 * reach it through the package entry, `lib.la`, which re-exports it.
 *
 * Used by: lib, diff, live
 */

import looks { Style, Window, ButtonStyle, Align, Fit, plain };
import theming { Theme };

/**
 * A description of what's on screen. `Msg` is the app's message type: what a
 * widget sends to `update` when the user acts on it.
 */
public enum View<Msg> {
    /** A line of text. */
    Text(string),
    /** A button with its label and the message one click sends; `None` when disabled. */
    Button(string, Option<Msg>),
    /** Children stacked top to bottom. */
    Column(View<Msg>[]),
    /** Children side by side, left to right. */
    Row(View<Msg>[]),
    /**
     * A one-line text field: what it shows, and its messages: the one each
     * edit sends and the one Enter sends. `None` when disabled (decision 6):
     * the two go together, so Enter can't send while editing can't.
     */
    Input(string, Option<(fun(string): Msg, Option<Msg>)>),
    /** A multi-line text field: what it shows, and the message each edit sends; `None` when disabled. */
    TextArea(string, Option<fun(string): Msg>),
    /** A check box: its label, whether it's ticked, and the message each toggle sends. */
    Checkbox(string, bool, fun(bool): Msg),
    /** A drop-down: each choice's label and the message picking it sends, and the label shown picked. */
    Dropdown((string, Msg)[], string),
    /** A whole-number slider: its least and greatest value, its value, and the message each move sends. */
    Slider(i64, i64, i64, fun(i64): Msg),
    /** A theme icon, by name. */
    Icon(string),
    /** A picture from the file at this path. */
    Image(string),
    /** Empty room that grows along its column or row, pushing what follows to the end. */
    Spacer,
    /** A thin line across its column or row. */
    Separator,
    /** One child, scrolled when it's bigger than the room it's given. */
    Scroll(View<Msg>),
    /** Children stacked top to bottom, each with a key naming it across views. */
    Keyed((string, View<Msg>)[]),
    /**
     * The root of a view with a header bar (`.header`): the body, the views at
     * the bar's start, its title view, and the views at its end.
     */
    Framed(View<Msg>, View<Msg>[], View<Msg>, View<Msg>[]),
    /** A node and its modifiers: built by the modifier methods, never by hand. */
    Styled(View<Msg>, Style),
    /**
     * A subtree built only when its key changes: the key, the function that
     * builds it, and the subtree once kivuli has built or reused it.
     */
    Lazy(string, fun(): View<Msg>, Option<View<Msg>>),
}

/** `v` with its style changed by `f`: one `Styled` wrapper, however many modifiers. */
fun restyle<Msg>(v: View<Msg>, f: fun(Style): Style): View<Msg> = match v {
    Styled(inner, s) => View.Styled(inner, f(s)),
    // A lazy subtree's style is whatever `build` gives it (DECISION-002).
    Lazy(_, _, _) => v,
    _ => View.Styled(v, f(plain())),
};

impl View<Msg> {
    /**
     * Leaves `n` pixels of empty room on all four sides.
     *
     * Example:
     *     column(rows).padding(24)
     */
    public fun padding(self, n: i64): View<Msg> = restyle(
        self,
        fun(s: Style) = Style { padding: n, ..s },
    );

    /**
     * Puts `n` pixels between a column's or row's children; ignored on other nodes.
     *
     * Example:
     *     row([button("Add", Msg.Add), button("Reset", Msg.Reset)]).spacing(8)
     */
    public fun spacing(self, n: i64): View<Msg> = restyle(
        self,
        fun(s: Style) = Style { spacing: n, ..s },
    );

    /**
     * Lets the node take the spare room along its column (down) or row (across).
     *
     * Example:
     *     row([input(m.draft, Msg.Draft).expand(), button("Add", Msg.Add)])
     */
    public fun expand(self): View<Msg> = restyle(self, fun(s: Style) = Style { expand: true, ..s });

    /**
     * Places the node across its column (left to right) or row (top to bottom)
     * instead of stretching it.
     *
     * Example:
     *     text("Done").align(Align.Center)
     */
    public fun align(self, a: Align): View<Msg> = restyle(
        self,
        fun(s: Style) = Style { align: a, ..s },
    );

    /**
     * Makes the node at least `n` pixels wide.
     *
     * Example:
     *     input(m.name, Msg.Named).width(240)
     */
    public fun width(self, n: i64): View<Msg> = restyle(
        self,
        fun(s: Style) = Style { width: n, ..s },
    );

    /**
     * Makes the node at least `n` pixels tall.
     *
     * Example:
     *     scroll(column(rows)).height(200)
     */
    public fun height(self, n: i64): View<Msg> = restyle(
        self,
        fun(s: Style) = Style { height: n, ..s },
    );

    /**
     * Shows text at `n` points instead of the theme's size; ignored on other nodes.
     *
     * Example:
     *     text("Total").size(18)
     */
    public fun size(self, n: i64): View<Msg> = restyle(
        self,
        fun(s: Style) = Style { size: n, ..s },
    );

    /**
     * Shows text in bold; ignored on other nodes.
     *
     * Example:
     *     text(m.title).bold()
     */
    public fun bold(self): View<Msg> = restyle(self, fun(s: Style) = Style { bold: true, ..s });

    /**
     * Shows text faded, for secondary information; ignored on other nodes.
     *
     * Example:
     *     text("{m.count} left").dim()
     */
    public fun dim(self): View<Msg> = restyle(self, fun(s: Style) = Style { dim: true, ..s });

    /**
     * Gives a button the theme's look for its role; ignored on other nodes.
     *
     * Example:
     *     button("Delete", Msg.Delete).button_style(ButtonStyle.Danger)
     */
    public fun button_style(self, look: ButtonStyle): View<Msg> = restyle(
        self,
        fun(s: Style) = Style { button: look, ..s },
    );

    /**
     * When `off`, takes the messages of a button, text field or text area
     * away: it's greyed out, a button's clicks send nothing, and a field
     * can't be edited (its value still shows and follows the model).
     * `disabled(false)` changes nothing. Ignored on other nodes.
     *
     * Example:
     *     button("Reset", Msg.Reset).disabled(m.count == 0)
     *     input(m.title, Msg.Title).disabled(m.locked)
     */
    public fun disabled(self, off: bool): View<Msg> = if !off {
        self
    } else {
        match self {
            Button(label, _) => View.Button(label, None),
            Input(value, _) => View.Input(value, None),
            TextArea(value, _) => View.TextArea(value, None),
            Styled(inside, s) => View.Styled(inside.disabled(true), s),
            _ => self,
        }
    };

    /**
     * Titles the app's window and sets the size it opens at, in pixels. On
     * the root of `view` only (elsewhere ignored), so the title may follow the
     * model.
     *
     * Example:
     *     column(rows).window("To-do ({m.left} left)", 360, 480)
     */
    public fun window(self, title: string, width: i64, height: i64): View<Msg> = restyle(
        self,
        fun(s: Style) = Style {
            window: Some(Window { title: title, width: width, height: height }),
            ..s,
        },
    );

    /**
     * Shows `hint` in an empty text field; ignored on other nodes. Tests find
     * text fields by it (`kivuli.testing.type_into`).
     *
     * Example:
     *     input(m.name, Msg.Named).placeholder("Your name")
     */
    public fun placeholder(self, hint: string): View<Msg> = restyle(
        self,
        fun(s: Style) = Style { placeholder: hint, ..s },
    );

    /**
     * Sends `msg` when Enter is pressed in a text field; ignored on other nodes.
     *
     * Example:
     *     input(m.draft, Msg.Draft).on_submit(Msg.Add)
     */
    /**
     * Lets long text flow onto more lines, breaking at word boundaries; on
     * text and check box labels (ignored elsewhere).
     *
     * Example:
     *     text(m.description).wrap()
     */
    public fun wrap(self): View<Msg> = restyle(self, fun(s: Style) = Style { wrap: true, ..s });

    /**
     * Wraps long text, asking for at most `chars` characters of width so it
     * doesn't widen the window; `chars <= 0` is plain `.wrap()`.
     *
     * Example:
     *     text(m.description).wrap_at(50)
     */
    public fun wrap_at(self, chars: i64): View<Msg> = restyle(
        self,
        fun(s: Style) = Style { wrap: true, wrap_at: chars, ..s },
    );

    /**
     * Keeps long text on one line, cut at the end with "…"; with `.wrap()`,
     * at most three lines, the last cut. On text and check box labels.
     *
     * Example:
     *     checkbox(t.title, t.done, Msg.Done).ellipsize().tooltip(t.title)
     */
    public fun ellipsize(self): View<Msg> = restyle(
        self,
        fun(s: Style) = Style { ellipsize: true, ..s },
    );

    /**
     * Lets the user select and copy the text; text only.
     *
     * Example:
     *     text(m.error).wrap().selectable()
     */
    public fun selectable(self): View<Msg> = restyle(
        self,
        fun(s: Style) = Style { selectable: true, ..s },
    );

    /**
     * Shows `hint` when the pointer rests on the node; `""` removes it. Tests
     * can click a button by its tooltip (`kivuli.testing.click`).
     *
     * Example:
     *     button("✕", Msg.Delete(t.id)).tooltip("Delete {t.title}")
     */
    public fun tooltip(self, hint: string): View<Msg> = restyle(
        self,
        fun(s: Style) = Style { tooltip: hint, ..s },
    );

    /**
     * Lets `keys` press the button from anywhere in the window: modifiers
     * (`Ctrl`, `Shift`, `Alt`, `Super`) and a key joined with `+`, such as
     * `"Ctrl+N"` or `"Ctrl+Shift+Delete"`. A disabled button's shortcut does
     * nothing. Unreadable keys, or two enabled buttons with the same ones,
     * stop the app with a message naming them. Ignored on other nodes.
     *
     * Example:
     *     button("Add", Msg.Add).shortcut("Ctrl+N")
     */
    public fun shortcut(self, keys: string): View<Msg> = restyle(
        self,
        fun(s: Style) = Style { shortcut: keys, ..s },
    );

    /**
     * Gives the node keyboard focus when it's first shown: when the window
     * opens, or when an update adds it.
     *
     * Example:
     *     input(m.draft, Msg.Draft).placeholder("New task").autofocus()
     */
    public fun autofocus(self): View<Msg> = restyle(
        self,
        fun(s: Style) = Style { autofocus: true, ..s },
    );

    /**
     * Names the node for tests: `kivuli.testing.type_into(v, id, text)` finds
     * a text field or text area by it. Not shown on screen.
     *
     * Example:
     *     text_area(m.notes, Msg.Notes).name("notes")
     */
    public fun name(self, id: string): View<Msg> = restyle(
        self,
        fun(s: Style) = Style { name: id, ..s },
    );

    /**
     * Makes a slider move in steps of `n`, counted from its least value: with
     * `slider(8, 72, …).step(2)` it stops at 8, 10, 12 … `n <= 0` is 1.
     *
     * Example:
     *     slider(8, 72, m.font, Msg.Font).step(2)
     */
    public fun step(self, n: i64): View<Msg> = restyle(
        self,
        fun(s: Style) = Style { step: if n <= 0 { 1 } else { n }, ..s },
    );

    /**
     * Shows a theme icon on a button, before its label; with the label `""`,
     * an icon-only button (give it a `.tooltip`: it's what tests find it by,
     * and what screen readers and hovering users get). Ignored on other nodes.
     *
     * Example:
     *     button("", Msg.Delete(t.id)).icon("user-trash-symbolic").tooltip("Delete {t.title}")
     */
    public fun icon(self, name: string): View<Msg> = restyle(
        self,
        fun(s: Style) = Style { icon: name, ..s },
    );

    /**
     * How a picture fills the room it's given (`Fit.Contain` by default).
     * Ignored on other nodes.
     *
     * Example:
     *     image(m.avatar).width(48).height(48).fit(Fit.Cover)
     */
    public fun fit(self, how: Fit): View<Msg> = restyle(
        self,
        fun(s: Style) = Style { fit: how, ..s },
    );

    /**
     * Paints the node with the app's looks, from the root's `.theme(…)`: each
     * look's fields over the last's, so a later look wins. `[]` is no look.
     * A look the theme doesn't have stops the app with a message.
     *
     * Example:
     *     tab.style([Look.Rail, Look.Selected])
     */
    public fun style<L>(self, chosen: L[]): View<Msg> = restyle(
        self,
        fun(s: Style) = Style { looks: chosen.map(fun(l) = "{l}"), ..s },
    );

    /**
     * On the root of `view`: the app's theme, every look it uses and what
     * each looks like (`theme(…)`). Applied when the window opens; a different
     * theme in a later view is ignored. Ignored below the root.
     *
     * Example:
     *     column([...]).theme(theme([Look.Bar, Look.Home], surface))
     */
    public fun theme(self, t: Theme): View<Msg> = restyle(
        self,
        fun(s: Style) = Style { theme: Some(t), ..s },
    );

    /**
     * On the root of `view`: the window opens maximized; `.window`'s size is
     * its size when unmaximized. Read when the window opens. Ignored below
     * the root.
     */
    public fun maximized(self): View<Msg> = restyle(
        self,
        fun(s: Style) = Style { maximized: true, ..s },
    );

    /**
     * On the root of `view`: a header bar as the window's title bar, with
     * `start` views at its start, `title` in the middle (`.expand()` lets it
     * fill the bar, as for an address box) and `end` views at its end. GTK
     * draws the window's controls. Its widgets send messages like any others.
     * Anywhere but the root, the app stops with a message.
     *
     * Example:
     *     column([...]).header([back, forward], address(m).expand(), [menu])
     */
    public fun header(
        self,
        start: View<Msg>[],
        title: View<Msg>,
        end: View<Msg>[],
    ): View<Msg> = match self {
        // Modifiers stay outside the frame, where the runtime reads the root's.
        Styled(inside, s) => View.Styled(inside.header(start, title, end), s),
        _ => View.Framed(self, start, title, end),
    };

    public fun on_submit(self, msg: Msg): View<Msg> = match self {
        Input(value, Some((on_change, _))) => View.Input(value, Some((on_change, Some(msg)))),
        // Disabled: there are no messages to add Enter's to.
        Input(_, None) => self,
        Styled(inside, s) => View.Styled(inside.on_submit(msg), s),
        _ => self,
    };

    /**
     * The same view, sending `f(msg)` wherever it would send `msg`: how a
     * component with its own message type sits inside a bigger app. Map its
     * commands and subscriptions too (`Cmd.map`, `Sub.map`).
     *
     * Example:
     *     row([counter.view(m.left).map(Msg.Left), counter.view(m.right).map(Msg.Right)])
     */
    public fun map<B>(self, f: fun(Msg): B): View<B> = match self {
        Text(s) => View.Text(s),
        Button(label, msg) => View.Button(label, msg.map(f)),
        Column(xs) => View.Column(xs.map(fun(x) = x.map(f))),
        Row(xs) => View.Row(xs.map(fun(x) = x.map(f))),
        TextArea(value, on_change) => View.TextArea(value, match on_change {
            Some(g) => Some(fun(s: string): B = f(g(s))),
            None => None,
        }),
        Input(value, messages) => View.Input(value, match messages {
            Some((on_change, on_submit)) => Some(
                (fun(s: string): B = f(on_change(s)), on_submit.map(f)),
            ),
            None => None,
        }),
        Checkbox(label, checked, on_toggle) => View.Checkbox(
            label,
            checked,
            fun(b: bool): B = f(on_toggle(b)),
        ),
        Dropdown(choices, selected) => View.Dropdown(
            choices.map(fun(choice) = (choice.0, f(choice.1))),
            selected,
        ),
        Slider(min, max, value, on_change) => View.Slider(
            min,
            max,
            value,
            fun(n: i64): B = f(on_change(n)),
        ),
        Icon(name) => View.Icon(name),
        Image(path) => View.Image(path),
        Spacer => View.Spacer,
        Separator => View.Separator,
        Scroll(x) => View.Scroll(x.map(f)),
        Keyed(pairs) => View.Keyed(pairs.map(fun(pair) = (pair.0, pair.1.map(f)))),
        Styled(x, style) => View.Styled(x.map(f), style),
        Framed(body, start, title, end) => View.Framed(
            body.map(f),
            start.map(fun(x) = x.map(f)),
            title.map(f),
            end.map(fun(x) = x.map(f)),
        ),
        // The key stays: what's built is the same, only its messages change.
        Lazy(key, build, built) => View.Lazy(
            key,
            fun(): View<B> = build().map(f),
            built.map(fun(b) = b.map(f)),
        ),
    };
}
