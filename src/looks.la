/**
 * The style types: what modifiers set on a node (`Style`) and the values its
 * fields take. Plain data, no GTK. The modifiers that build a `Style` are
 * methods of `View`, in `views` (an `impl` must sit with its type).
 *
 * Depends on: typography
 * Used by: views, lib, diff, walk, paint, testing, live, build, styling
 */

import typography { Sheet };

/** The app's window, as `.window(title, width, height)` sets it. */
public struct Window {
    title: string,
    /** The size it opens at, in pixels. */
    width: i64,
    height: i64,
}

/** How a picture fills the room it's given, as `.fit(…)` sets it. */
public enum Fit {
    /** The whole picture, scaled to fit, keeping its shape: the default. */
    Contain,
    /** Fills the room, keeping its shape, cropping what doesn't fit. */
    Cover,
    /** As `Contain`, but never larger than the picture itself. */
    ScaleDown,
    /** Stretched to fill the room exactly. */
    Fill,
}

/** Where a node sits across its column (left to right) or row (top to bottom). */
public enum Align {
    /** Stretched across the whole width (in a column) or height (in a row): the default. */
    Fill,
    Start,
    Center,
    End,
}

/**
 * Every modifier a node can carry. Built by the modifier methods; a field
 * that doesn't fit a node is kept and ignored when it's shown.
 */
public struct Style {
    /** Pixels of empty room on all four sides. */
    padding: i64,
    /** Pixels between a column's or row's children. */
    spacing: i64,
    /** Whether the node takes spare room along its column (down) or row (across). */
    expand: bool,
    align: Align,
    /** The smallest width and height in pixels; -1 leaves it to the widget. */
    width: i64,
    height: i64,
    /** An icon's or picture's size in pixels (on a button: its image's); 0 keeps the theme's. Not text. */
    size: i64,
    /** The window's title and size, from the root of `view`. Root only. */
    window: Option<Window>,
    /** Hint text an empty text field shows; "" for none. Text fields only. */
    placeholder: string,
    /** A name for tests to find the node by (`kivuli.testing`); not shown. */
    name: string,
    /** Long text flows onto more lines. Text and check box labels. */
    wrap: bool,
    /** With `wrap`, the most characters of width the text asks for; 0 for no cap. */
    wrap_at: i64,
    /** Long text stays one line, cut with "…" (with `wrap`: at most 3 lines). Text and check box labels. */
    ellipsize: bool,
    /** The user can select and copy the text. Text only. */
    selectable: bool,
    /** Hover text; "" for none. Any node. */
    tooltip: string,
    /** Keys that press the button from anywhere in the window, as "Ctrl+N"; "" for none. Buttons only. */
    shortcut: string,
    /** Takes keyboard focus when first shown. Any node. */
    autofocus: bool,
    /** How far a slider's handle moves at a time, counted from its least value; 1 by default. Sliders only. */
    step: i64,
    /** How a picture fills the room it's given. Images only. */
    fit: Fit,
    /** Everything `.style` set, merged. Any node. */
    sheet: Sheet,
    /** The CSS classes `sheet` gives: filled in by `paint`, never by hand. */
    classes: string[],
    /** The window opens maximized (`.maximized()`). Root only. */
    maximized: bool,
    /** Every child as wide as the widest (`.equal()`). Wraps only. */
    equal: bool,
    /** At most this many children on a line, 0 for no limit (`.max_per_line`). Wraps only. */
    max_per_line: i64,
    /** Where an overlay's layer sits on its base, across and down (`.place`). Layers only. */
    place_across: Align,
    place_down: Align,
}

/** The style of a node with no modifiers: what GTK does by default. */
fun plain(): Style = Style {
    padding: 0,
    spacing: 0,
    expand: false,
    align: Align.Fill,
    width: -1,
    height: -1,
    size: 0,
    window: None,
    placeholder: "",
    name: "",
    wrap: false,
    wrap_at: 0,
    ellipsize: false,
    selectable: false,
    tooltip: "",
    shortcut: "",
    autofocus: false,
    step: 1,
    fit: Fit.Contain,
    sheet: Sheet.theme(),
    classes: [],
    maximized: false,
    equal: false,
    max_per_line: 0,
    place_across: Align.Fill,
    place_down: Align.Fill,
};
