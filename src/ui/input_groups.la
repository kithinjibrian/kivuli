/**
 * Input group (PRP-034): one frame around a field and what sits beside it.
 * The frame draws the border and the focus ring (`State.FocusWithin`); the
 * field inside (`group_input`) has none of its own; add-ons are muted, with
 * icons at 16 px. Pure.
 *
 * Depends on: views, looks, widgets, pictures, styles, theming, values, boxes, fonts, drawing, motion, inputs, buttons
 * Used by: ui
 */

// The public items the entry re-exports, by their own modules (rule 2: no `lib`).
import view.views { View };
import view.looks { Align };
import view.widgets { row, text };
import view.pictures { Image };
import styles { Look, look, When, State };
import styles.theming { Color, Paint, Token };
import styles.values { Drop, Line };
import styles.boxes { Background, Border, Outline, Sizing, Spacing };
import styles.fonts { Font, Text };
import styles.drawing { Shadow };
import styles.motion { Motion };
import ui.inputs { input as ui_input };
import ui.buttons { button as ui_button, button_with as ui_button_with, Button };

fun clear(): Color = Color { red: 0, green: 0, blue: 0, alpha: 0 };

/** The faint shadow under a field: one pixel down, black at 5%. */
fun hairline_shadow(): Shadow = Shadow {
    boxes: [
        Drop {
            y: 1,
            blur: 2,
            color: Paint.Color(Color { red: 0, green: 0, blue: 0, alpha: 13 }),
            ..Drop.theme(),
        },
    ],
    text: [],
};

/** A 3 px halo of `paint`: the focus ring. */
fun halo(paint: Paint): Shadow = Shadow {
    boxes: [Drop { spread: 3, color: paint, ..Drop.theme() }],
    text: [],
};

/** The frame's border at rest and its ring while anything inside has focus. */
fun frame(border: Paint, ring_border: Paint, ring: Paint): Look = look([
    Border.all(1, border),
    When(State.FocusWithin, [
        Border.all(1, ring_border),
        halo(ring),
        Outline { style: Line.None, ..Outline.theme() },
    ]),
]);

/** `v` at 16 pixels if it's an icon given no size of its own. */
fun sized<Msg>(v: View<Msg>): View<Msg> = match v {
    Image(Icon(_)) => v.size(16),
    Styled(inner, s) => match inner {
        Image(Icon(_)) => if s.size == 0 { v.size(16) } else { v },
        _ => v,
    },
    _ => v,
};

/** Whether `v` is an icon alone. */
fun is_icon<Msg>(v: View<Msg>): bool = match v {
    Image(Icon(_)) => true,
    Styled(inner, _) => is_icon(inner),
    _ => false,
};

/** One side's add-ons in a row, muted, 12 px from the frame's edge (`first`: the start side). */
fun add_ons<Msg>(items: View<Msg>[], first: bool): View<Msg>[] {
    if items.len == 0 {
        return [];
    }
    let edge = if first { Spacing.padding_left(12) } else { Spacing.padding_right(12) };
    [
        row(items.map(fun(v: View<Msg>): View<Msg> = sized(v).align(Align.Center))).style([
            Spacing.gap(8),
            Text.color(Token.MutedForeground),
            edge,
        ]).align(Align.Center),
    ]
}

/**
 * One frame around `control` (a `group_input`) and the add-ons at its
 * `start` and `end`: icons, `group_text`, `group_button`s. Either side may
 * be `[]`.
 *
 * Example:
 *     input_group([group_text("https://")], group_input(m.site, Msg.Site), [group_text(".com")])
 */
public fun input_group<Msg>(start: View<Msg>[], control: View<Msg>, end: View<Msg>[]): View<Msg> {
    // Text sits close to a prefix: 8 beside add-ons, the field's own 12 elsewhere.
    let left = if start.len > 0 { 8 } else { 12 };
    let right = if end.len > 0 { 8 } else { 12 };
    let middle = control.style([Spacing.padding_left(left), Spacing.padding_right(right)]).expand();
    row(add_ons(start, true) + [middle] + add_ons(end, false)).style([
        Border.rounded_md(),
        Sizing.min_height(36),
        Background.color(clear()),
        hairline_shadow(),
        frame(Token.Input.paint(), Token.Ring.paint(), Token.Ring.alpha(0.5)),
        Motion.colors(150),
        Motion.shadow(150),
    ])
}

/**
 * The field inside an `input_group`: a `ui.input` with no border,
 * background, shadow or ring of its own, so the frame's show.
 *
 * Example:
 *     group_input(m.query, Msg.Query).placeholder("Search…")
 */
public fun group_input<Msg>(value: string, on_change: fun(string): Msg): View<Msg> = ui_input(
    value,
    on_change,
).style([
    Border.none(),
    Shadow.off(),
    // Inside the frame's 1 px border, so the group stays 36 px high.
    Sizing.min_height(34),
    When(State.FocusWithin, [Border.none(), Shadow.off()]),
    When(State.Disabled, [Border.none()]),
]);

/**
 * Text beside a group's field: a prefix, a suffix, a unit. The group shows
 * it muted.
 *
 * Example:
 *     group_text("https://")
 */
public fun group_text<Msg>(t: string): View<Msg> = text(t).style([Font.sm()]);

/** The compact size buttons in a group take: 24 px high, 8 px across, small corners. */
fun compact(): Look = look([
    Button.ghost(),
    Sizing.min_height(24),
    Spacing.padding_x(8),
    Border.rounded_sm(),
]);

/**
 * A compact ghost button inside a group.
 *
 * Example:
 *     input_group([], group_input(m.q, Msg.Q), [group_button("Search", Msg.Go)])
 */
public fun group_button<Msg>(label: string, msg: Msg): View<Msg> = ui_button(label, msg).style([
    compact(),
]);

/**
 * A compact ghost button showing `content` inside a group; an icon alone
 * makes it a 24 px square.
 *
 * Example:
 *     group_button_with([icon("view-reveal-symbolic")], Msg.Show)
 */
public fun group_button_with<Msg>(content: View<Msg>[], msg: Msg): View<Msg> {
    let square = content.len == 1 && is_icon(content[0]);
    let b = ui_button_with(content, msg).style([compact()]);
    if square { b.style([Sizing.min_width(24), Spacing.padding_x(0)]) } else { b }
}

/** A group's variants, given through `.style`: `input_group(…).style([InputGroup.invalid()])`. */
public struct InputGroup {}

impl InputGroup {
    /** What was typed is wrong: a red frame, and a red ring while typed in. */
    public fun invalid(): Look = frame(
        Token.Destructive.paint(),
        Token.Destructive.paint(),
        Token.Destructive.alpha(0.2),
    );
}
