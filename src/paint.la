/**
 * Painting a view: before each diff, every node's style (`.style`) becomes
 * the CSS classes of its values, kept in its style, so classes diff and
 * patch like any other modifier. Also where what an app got wrong about
 * styles and headers is found, before GTK. Pure.
 *
 * Depends on: views, walk, looks, sheets, pictures
 * Used by: live
 */

import views { View };
import walk { check_content, nodes };
import looks { Style };
import sheets { check, picture, rules };
import pictures { Image };

/**
 * `v` with every node's `classes` filled in from its style; or what's wrong:
 * a value that can't be shown, `.size` on text, or a `.header` below the root.
 */
fun painted<Msg>(v: View<Msg>): Result<View<Msg>, string> = match v {
    // The root alone may be framed by a header.
    Styled(inside, s) => Ok(View.Styled(painted(inside)?, paint_style(inside, s)?)),
    Framed(body, start, title, end) => Ok(
        View.Framed(paint(body)?, paint_all(start)?, paint(title)?, paint_all(end)?),
    ),
    _ => paint(v),
};

fun paint<Msg>(v: View<Msg>): Result<View<Msg>, string> = match v {
    Styled(inside, s) => Ok(View.Styled(paint(inside)?, paint_style(inside, s)?)),
    Column(xs) => Ok(View.Column(paint_all(xs)?)),
    Row(xs) => Ok(View.Row(paint_all(xs)?)),
    Scroll(x) => Ok(View.Scroll(paint(x)?)),
    Keyed(pairs) => Ok(View.Keyed(paint_keyed(pairs)?)),
    Wrap(xs) => Ok(View.Wrap(paint_all(xs)?)),
    KeyedWrap(pairs) => Ok(View.KeyedWrap(paint_keyed(pairs)?)),
    Overlay(base, layers) => Ok(View.Overlay(paint(base)?, paint_all(layers)?)),
    Menu(x, entries) => Ok(View.Menu(paint(x)?, entries)),
    ButtonWith(content, msg) => {
        check_content(content)?;
        Ok(View.ButtonWith(paint(content)?, msg))
    }
    Lazy(key, build, Some(built)) => Ok(View.Lazy(key, build, Some(paint(built)?))),
    Framed(_, _, _, _) => Err(".header(…) belongs on the root of the view only"),
    _ => Ok(v),
};

fun paint_keyed<Msg>(pairs: (string, View<Msg>)[]): Result<(string, View<Msg>)[], string> {
    let mut out: (string, View<Msg>)[] = [];
    for (k, x) of pairs {
        out.push((k, paint(x)?));
    }
    Ok(out)
}

fun paint_all<Msg>(xs: View<Msg>[]): Result<View<Msg>[], string> {
    let mut out: View<Msg>[] = [];
    for x of xs {
        out.push(paint(x)?);
    }
    Ok(out)
}

/** The style of `node`, its values checked and turned into classes. */
fun paint_style<Msg>(node: View<Msg>, s: Style): Result<Style, string> {
    // A text's size is a Font's now: an old `.size` would otherwise vanish quietly.
    match node {
        Text(_) => if s.size > 0 {
            return Err(
                ".size(n) on text is gone: use .style([Font {{ size: Size.Pt(n), ..Font.theme() }}])",
            );
        },
        _ => {}
    }
    check(s.sheet)?;
    // A rule's key may carry its selector's tail (`:not(:focus-visible)`): the class is before it.
    // A state's key repeats its class (`.c.c:active`): the class is before the first `.` too.
    let mut classes = rules(s.sheet).map(fun(rule) = rule.0.split(":")[0].split(".")[0]);
    match picture(s.sheet) {
        Some((class, _, _, _)) => classes.push(class),
        None => {}
    }
    Ok(Style { classes: classes, ..s })
}

/**
 * Every CSS rule a painted view's classes need, as (class, declarations),
 * each once, in the order nodes first use them.
 */
fun stylesheet<Msg>(v: View<Msg>): (string, string)[] {
    let mut seen: Set<string> = #{};
    let mut out: (string, string)[] = [];
    for (_, style) of nodes(v) {
        for rule of rules(style.sheet) {
            if seen.insert(rule.0) {
                out.push(rule);
            }
        }
    }
    out
}

/**
 * Every background picture a painted view uses, each once: its class, the
 * image, and the gradient and fill its rule needs (`sheets.picture`). Their
 * rules need the pictures' bytes, so `live` builds them.
 */
fun background_pictures<Msg>(v: View<Msg>): (string, Image, string, string)[] {
    let mut seen: Set<string> = #{};
    let mut out: (string, Image, string, string)[] = [];
    for (_, style) of nodes(v) {
        match picture(style.sheet) {
            Some(p) => if seen.insert(p.0) {
                out.push(p);
            },
            None => {}
        }
    }
    out
}
