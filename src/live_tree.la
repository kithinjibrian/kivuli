/**
 * The live tree: the GTK widgets on screen, shaped like the `View` they show.
 * Data only; making widgets is `build`, running the app and patching is `live`.
 *
 * Depends on: gtk.raw
 * Used by: build, live
 */

import gtk { GtkEventController, GtkShortcut, GtkTextBuffer, GtkWidget };

/** The widgets on screen, shaped exactly like the `View` they show. */
enum Live<Msg> {
    Label(GtkWidget),
    /**
     * The button, the message it sends (its click handler reads it), its
     * shortcut controller, the shortcut in it now, if any, and kivuli's own
     * content: its label and its icon (each hidden when empty).
     */
    Button(GtkWidget, Ref<Option<Msg>>, GtkEventController, Ref<Option<GtkShortcut>>, GtkWidget, GtkWidget),
    /**
     * A column or a row: both are a `GtkBox`, and patch the same way. The
     * orientation (`GtkOrientation`: 1 vertical, 0 horizontal) lays out
     * children added later.
     */
    Box(GtkWidget, i32, Live<Msg>[]),
    /**
     * A text field, the function turning its text into a message, and the
     * message Enter sends: its `changed` and `activate` handlers read these
     * boxes. No function: disabled (insensitive, and it sends nothing).
     */
    Input(GtkWidget, Ref<Option<fun(string): Msg>>, Ref<Option<Msg>>),
    /**
     * A check box, the label kivuli gave it (long-text modifiers style it), and
     * the function turning its state into a message: its `toggled` handler reads it.
     */
    Checkbox(GtkWidget, GtkWidget, Ref<fun(bool): Msg>),
    /**
     * A text area: the scrolled window holding it, its buffer, and the
     * function turning its text into a message (its `changed` handler reads
     * it); none when disabled.
     */
    TextArea(GtkWidget, GtkTextBuffer, Ref<Option<fun(string): Msg>>),
    /** A drop-down, and the state its `notify::selected` handler and patches share. */
    Dropdown(GtkWidget, Ref<Choices<Msg>>),
    /**
     * A slider (a `GtkScale`), its `(min, max, step)`, the number it last
     * showed or sent, and the function turning a move into a message: its
     * `value-changed` handler reads all three.
     */
    Slider(GtkWidget, Ref<(i64, i64, i64)>, Ref<i64>, Ref<fun(i64): Msg>),
    /** A theme icon (a `GtkImage`). */
    Icon(GtkWidget),
    /** A picture from a file (a `GtkPicture`). */
    Image(GtkWidget),
    Spacer(GtkWidget),
    Separator(GtkWidget),
    /** A scrolled window and the one child it shows. */
    Scroll(GtkWidget, Live<Msg>),
    /**
     * A wrap or keyed wrap: a `GtkFlowBox` and its children, each inside a
     * `GtkFlowBoxChild` the box made (the children's widgets are what's here).
     */
    Wrap(GtkWidget, Live<Msg>[]),
    /** An overlay: the `GtkOverlay`, its base (child 0), and its layers (child 1). */
    Overlay(GtkWidget, Live<Msg>, Live<Msg>),
    /** An overlay's layers, bottom to top; no widget of their own, so their widget is the overlay's. */
    Layers(GtkWidget, Live<Msg>[]),
    /**
     * The root framed by a header bar: the bar, the body (the window's child),
     * the title widget, and the views packed at the bar's start and end.
     */
    Framed(GtkWidget, Live<Msg>, Live<Msg>, Live<Msg>, Live<Msg>),
    /**
     * The views packed at one end of a header bar (`true`: the end), in
     * order; no widget of its own, so its widget is the bar's.
     */
    Pack(GtkWidget, bool, Live<Msg>[]),
}

/**
 * A drop-down's state. What the view asks for (`offered`, `pick`) can run
 * ahead of GTK's list (`shown`) for one turn of the main loop: see
 * `build.sync_choices`.
 */
struct Choices<Msg> {
    /** The choices the view offers. */
    offered: (string, Msg)[],
    /** The index of the one shown picked; `None` shows the blank item. */
    pick: Option<i64>,
    /** GTK's list now, item by item: its label and the message picking it sends (`None`: the blank). */
    shown: (string, Option<Msg>)[],
    /** True while kivuli changes the widget or a pick is being sent: the handler then does nothing. */
    busy: bool,
}

/** The GTK widget showing `node`. */
fun widget<Msg>(node: Live<Msg>): GtkWidget = match node {
    Label(w) => w,
    Button(w, _, _, _, _, _) => w,
    Box(w, _, _) => w,
    Input(w, _, _) => w,
    Checkbox(w, _, _) => w,
    TextArea(w, _, _) => w,
    Dropdown(w, _) => w,
    Slider(w, _, _, _) => w,
    Icon(w) => w,
    Image(w) => w,
    Spacer(w) => w,
    Separator(w) => w,
    Scroll(w, _) => w,
    Wrap(w, _) => w,
    Overlay(w, _, _) => w,
    Layers(w, _) => w,
    // The window's child; the bar is its titlebar.
    Framed(_, body, _, _, _) => widget(body),
    Pack(bar, _, _) => bar,
};

/** The header bar to show as the window's titlebar, if the root has one. */
fun titlebar<Msg>(root: Live<Msg>): Option<GtkWidget> = match root {
    Framed(bar, _, _, _, _) => Some(bar),
    _ => None,
};
