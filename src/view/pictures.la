/**
 * Images, without GTK: where one comes from (`Image`), what makes two the
 * same (their identity, never their bytes), what kind of image bytes are
 * (PNG, JPEG or SVG: PRP-053), and the size a PNG's or JPEG's header claims,
 * read before anything is decoded, so hostile bytes (a small file claiming a
 * huge image, a cut header, an unknown format, an SVG GTK would crash on)
 * never reach GTK. Pure.
 *
 * Depends on: nothing
 * Used by: buttons, diff, lib, mapping, paint, sheets, styles, textures, views, widgets
 */

/**
 * Where an image comes from. The diff compares an image's kind and name,
 * path or key, never its bytes: a new key replaces the image, the same key
 * keeps it.
 *
 * Example:
 *     image(Image.Bytes("counter:icon", icon_bytes)).size(64)
 */
public enum Image {
    /** A theme icon, by name (`"user-trash-symbolic"`). */
    Icon(string),
    /** A PNG, JPEG or SVG file, by path. A file changed on disk under the same path isn't noticed. */
    File(string),
    /** PNG, JPEG or SVG bytes, with a key naming them: a new key for new bytes. */
    Bytes(string, u8[]),
}

/** What kind of image bytes are, told from how they start. */
public enum Kind {
    Png,
    Jpeg,
    Svg,
}

/** The widest or tallest image shown, in pixels: larger ones show nothing. */
const MAX_SIDE: i64 = 4096;

/** The most bytes an image may have (16 MB): larger ones show nothing. */
const MAX_BYTES: i64 = 16777216;

/** What makes two images the same: their kind and name, path or key. */
fun identity(img: Image): string = match img {
    Icon(name) => "icon:{name}",
    File(path) => "file:{path}",
    Bytes(key, _) => "bytes:{key}",
};

/**
 * The width and height a PNG or JPEG says it has, from its header alone, or
 * why it won't be shown: over `MAX_BYTES`, not a PNG or JPEG, a header cut
 * short, or larger than `MAX_SIDE` either way.
 */
fun size_of(bytes: u8[]): Result<(i64, i64), string> {
    if bytes.len > MAX_BYTES {
        return Err("the image is over 16 MB");
    }
    let (width, height) = if starts(bytes, [137, 80, 78, 71, 13, 10, 26, 10]) {
        png_size(bytes)?
    } else if starts(bytes, [255, 216]) {
        jpeg_size(bytes)?
    } else {
        return Err("not a PNG or JPEG image");
    };
    if width <= 0 || height <= 0 {
        return Err("the image has no size");
    }
    if width > MAX_SIDE || height > MAX_SIDE {
        return Err("the image is {width} x {height}: larger than {MAX_SIDE} x {MAX_SIDE}");
    }
    Ok((width, height))
}

/** How far into an SVG with an XML prolog its `<svg` may start: 1 KB. */
const SVG_START: i64 = 1024;

/**
 * What kind of image `bytes` are, or why they won't be shown: over
 * `MAX_BYTES`, none of the three, or an SVG holding an `<image>` element
 * (GTK 4.22 crashes on one with outside files turned off: DECISION-030).
 * A PNG's or JPEG's size is `size_of`'s to check; an SVG's is read by GTK.
 */
fun kind_of(bytes: u8[]): Result<Kind, string> {
    if bytes.len > MAX_BYTES {
        return Err("the image is over 16 MB");
    }
    if starts(bytes, [137, 80, 78, 71]) {
        return Ok(Kind.Png);
    }
    if starts(bytes, [255, 216]) {
        return Ok(Kind.Jpeg);
    }
    if !is_svg(bytes) {
        return Err("not a PNG, JPEG or SVG image");
    }
    if holds_image(bytes) {
        return Err("an SVG holding <image> isn't shown");
    }
    Ok(Kind.Svg)
}

/**
 * Whether `bytes` start, after a UTF-8 byte-order mark and white space, with
 * `<svg`, or with `<?xml` and hold `<svg` in their first `SVG_START` bytes.
 */
fun is_svg(bytes: u8[]): bool {
    let mut i = if starts(bytes, [239, 187, 191]) { 3 } else { 0 };
    while i < bytes.len && is_space(bytes[i]) {
        i = i + 1;
    }
    if at(bytes, i, "<svg") {
        return true;
    }
    if !at(bytes, i, "<?xml") {
        return false;
    }
    let mut j = i;
    while j < bytes.len && j < SVG_START {
        if at(bytes, j, "<svg") {
            return true;
        }
        j = j + 1;
    }
    false
}

/**
 * Whether an `<image` element appears anywhere, with or without a namespace
 * prefix (`<s:image`), comments too: an element only named like one
 * (`<imagery`) doesn't count. Erring on the side of refusing.
 */
fun holds_image(bytes: u8[]): bool {
    let mut i = 0;
    while i < bytes.len {
        if bytes[i] == 60 {
            // `<`, then an optional `prefix:`, then `image` and the name's end.
            let mut j = i + 1;
            while j < bytes.len && is_name(bytes[j]) {
                j = j + 1;
            }
            let name_at = if j < bytes.len && bytes[j] == 58 { j + 1 } else { i + 1 };
            let end = name_at + 5;
            if at(bytes, name_at, "image") && (end >= bytes.len || !is_name(bytes[end])) {
                return true;
            }
        }
        i = i + 1;
    }
    false
}

/** Whether `bytes` hold `text` at `i`. */
fun at(bytes: u8[], i: i64, text: string): bool {
    if i < 0 || i + text.len > bytes.len {
        return false;
    }
    let mut k = 0;
    while k < text.len {
        if bytes[i + k] != text[k] {
            return false;
        }
        k = k + 1;
    }
    true
}

/** XML white space: space, tab, line feed, carriage return. */
fun is_space(b: u8): bool = b == 32 || b == 9 || b == 10 || b == 13;

/** A byte of an XML name (ASCII letters, digits, `-`, `_`, `.`) or any byte of a UTF-8 one. */
fun is_name(
    b: u8,
): bool = b >= 97 && b <= 122 || b >= 65 && b <= 90 || b >= 48 && b <= 57 || b == 45 || b == 95 || b == 46 || b >= 128;

/** A PNG's size: its first chunk is IHDR, width then height, big-endian. */
fun png_size(bytes: u8[]): Result<(i64, i64), string> {
    if bytes.len < 24 {
        return Err("the image's header is cut short");
    }
    // "IHDR" after the 8-byte signature and the chunk's 4-byte length.
    if !(bytes[12] == 73 && bytes[13] == 72 && bytes[14] == 68 && bytes[15] == 82) {
        return Err("not a PNG or JPEG image");
    }
    Ok((be(bytes, 16, 4), be(bytes, 20, 4)))
}

/**
 * A JPEG's size, from its first start-of-frame marker: segments are walked
 * by their lengths (at most 64 of them), stopping at the scan or the end.
 */
fun jpeg_size(bytes: u8[]): Result<(i64, i64), string> {
    let mut i = 2;
    let mut segments = 0;
    while segments < 64 {
        if i + 4 > bytes.len {
            return Err("the image's header is cut short");
        }
        if bytes[i] != 255 {
            return Err("not a PNG or JPEG image");
        }
        let marker = bytes[i + 1] as i64;
        if marker == 255 {
            // A fill byte before the marker.
            i = i + 1;
        } else if marker == 1 || marker >= 208 && marker <= 215 {
            // TEM and RST0-7 stand alone, with no length.
            i = i + 2;
        } else if is_start_of_frame(marker) {
            if i + 9 > bytes.len {
                return Err("the image's header is cut short");
            }
            // Length (2), precision (1), then height and width.
            return Ok((be(bytes, i + 7, 2), be(bytes, i + 5, 2)));
        } else if marker == 218 {
            // The scan began before any frame said its size.
            return Err("not a PNG or JPEG image");
        } else {
            let length = be(bytes, i + 2, 2);
            if length < 2 {
                return Err("not a PNG or JPEG image");
            }
            i = i + 2 + length;
        }
        segments = segments + 1;
    }
    Err("not a PNG or JPEG image")
}

/** SOF0–SOF15, less DHT (0xC4), JPG (0xC8) and DAC (0xCC), which share the range. */
fun is_start_of_frame(
    marker: i64,
): bool = marker >= 192 && marker <= 207 && marker != 196 && marker != 200 && marker != 204;

/** Whether `bytes` begins with `prefix`. */
fun starts(bytes: u8[], prefix: i64[]): bool {
    if bytes.len < prefix.len {
        return false;
    }
    let mut i = 0;
    while i < prefix.len {
        if bytes[i] as i64 != prefix[i] {
            return false;
        }
        i = i + 1;
    }
    true
}

/** The big-endian number in `count` bytes from `at`; the caller checked they're there. */
fun be(bytes: u8[], at: i64, count: i64): i64 {
    let mut n = 0;
    let mut i = 0;
    while i < count {
        n = n * 256 + bytes[at + i] as i64;
        i = i + 1;
    }
    n
}

/**
 * Checked PNG or JPEG bytes as a `data:` URL, for a stylesheet; `None` for
 * bytes that fail `size_of`'s checks, so they never reach GTK.
 */
fun data_url(bytes: u8[]): Option<string> {
    if size_of(bytes).is_err() {
        return None;
    }
    // `size_of` passed: the bytes start as one or the other.
    let kind = if starts(bytes, [137, 80, 78, 71]) { "png" } else { "jpeg" };
    Some("data:image/{kind};base64,{base64(bytes)}")
}

/** `bytes` in base64 (RFC 4648, with `=` padding). */
fun base64(bytes: u8[]): string {
    let alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
    let mut parts: string[] = [];
    let mut i = 0;
    while i < bytes.len {
        let left = bytes.len - i;
        let a = bytes[i] as i64;
        let b = if left > 1 { bytes[i + 1] as i64 } else { 0 };
        let c = if left > 2 { bytes[i + 2] as i64 } else { 0 };
        let n = a * 65536 + b * 256 + c;
        let mut four = "";
        let mut k = 0;
        while k < 4 {
            // Bytes missing at the end are `=`: 1 left gives 2 letters, 2 give 3.
            if k > left {
                four = four + "=";
            } else {
                let six = n / [262144, 4096, 64, 1][k] % 64;
                four = four + alphabet.slice(six, six + 1);
            }
            k = k + 1;
        }
        parts.push(four);
        i = i + 3;
    }
    parts.join("")
}
