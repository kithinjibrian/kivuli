/**
 * The widget builders: the functions an app's `view` calls to make each kind
 * of node (`text`, `button`, `column`, …). The node types and the modifiers
 * live in `views`; apps get both through the entry.
 *
 * Depends on: views, pictures
 * Used by: build, lib; `snap` by build and testing, styling, testing
 */

import view.views { Bar, View };
import styles { Sheet };
import view.pictures { Image };
import styles.motion { Edge };

/**
 * Builds a line of text.
 *
 * Example:
 *     text("Clicked {m.count} times")
 */
public fun text<Msg>(s: string): View<Msg> = View.Text(s);

/**
 * Builds a button that sends `msg` each time it's clicked.
 *
 * Example:
 *     button("Add", Msg.Add)
 */
public fun button<Msg>(label: string, msg: Msg): View<Msg> = View.Button(label, Some(msg), None);

/**
 * Builds a button showing `content`, any view, that sends `msg` each time it's
 * clicked: a whole row (label, summary, arrow) as one click target. The theme
 * draws it as a button; `.style`, `.disabled`, `.tooltip`, `.shortcut`
 * and `.menu` work as on `button`. The content fills the button and holds
 * nothing interactive (no buttons, fields, check boxes, drop-downs or
 * sliders): kivuli stops with a message naming what it found. Tests find it
 * by its tooltip, its `.name`, or any text inside it.
 *
 * Example:
 *     button_with(row([text("Account").expand(), text(summary), icon("go-next-symbolic")]), Msg.Open(Page.Account))
 */
public fun button_with<Msg>(content: View<Msg>, msg: Msg): View<Msg> = View.ButtonWith(
    content,
    Some(msg),
);

/**
 * Stacks `children` top to bottom.
 *
 * Example:
 *     column([text("Hi"), button("Add", Msg.Add)])
 */
public fun column<Msg>(children: View<Msg>[]): View<Msg> = View.Column(children);

/**
 * Lays `children` out side by side, left to right.
 *
 * Example:
 *     row([button("Add", Msg.Add), button("Reset", Msg.Reset)])
 */
public fun row<Msg>(children: View<Msg>[]): View<Msg> = View.Row(children);

/**
 * Builds a one-line text field showing `value`. Each edit sends
 * `on_change(text)`, the field's whole new text; store it in the model and
 * pass it back as `value`.
 *
 * Example:
 *     input(m.name, Msg.Named)
 */
public fun input<Msg>(value: string, on_change: fun(string): Msg): View<Msg> = View.Input(
    value,
    Some((on_change, None)),
);

/**
 * Builds a progress bar filled to `value` out of 100; past either end it's
 * full or empty. It sends nothing: change the value in the model.
 *
 * Example:
 *     column([text("Uploading…"), progress(m.uploaded)])
 */
public fun progress<Msg>(value: i64): View<Msg> = View.Progress(value);

/**
 * Builds a switch, on when `on`. Each flip sends `on_toggle(on)`; store it in
 * the model and pass it back as `on`. It has no label of its own: put one
 * beside it, and `.name(…)` lets tests find it.
 *
 * Example:
 *     row([switch(m.wifi, Msg.Wifi), text("Wi-Fi")])
 */
public fun switch<Msg>(on: bool, on_toggle: fun(bool): Msg): View<Msg> = View.Switch(
    on,
    Some(on_toggle),
);

/**
 * Builds a check box labelled `label`, ticked when `checked`. Each toggle
 * sends `on_toggle(ticked)`; store it in the model and pass it back as
 * `checked`.
 *
 * Example:
 *     checkbox("Done", item.done, Msg.Done)
 */
public fun checkbox<Msg>(
    label: string,
    checked: bool,
    on_toggle: fun(bool): Msg,
): View<Msg> = View.Checkbox(label, checked, Some(on_toggle));

/**
 * Builds empty room that grows along its column (down) or row (across), so
 * what follows is pushed to the far end.
 *
 * Example:
 *     row([text("Total"), spacer(), text("42")])
 */
public fun spacer<Msg>(): View<Msg> = View.Spacer;

/**
 * Builds a thin line across its column (horizontal) or row (vertical).
 *
 * Example:
 *     column([text("Header"), separator(), text("Body")])
 */
public fun separator<Msg>(): View<Msg> = View.Separator;

/**
 * Shows `child` in a scrolled area that takes the room it's given and scrolls
 * when the child is bigger.
 *
 * Example:
 *     scroll(column(rows))
 */
public fun scroll<Msg>(child: View<Msg>): View<Msg> = View.Scroll(child, false);

/**
 * Shows `child` in a scrolled area as big as the child, until its parent
 * can't give that much: then it scrolls. Unlike `scroll`, it takes no spare
 * room, so what comes after it follows it.
 *
 * Example:
 *     column([scroll_fit(column(apps)), plus_button])
 */
public fun scroll_fit<Msg>(child: View<Msg>): View<Msg> = View.Scroll(child, true);

/**
 * Stacks `children` top to bottom, like `column`, but matches them across
 * views by their keys rather than their positions: reordering, inserting or
 * deleting rows moves, adds or removes just those widgets. Keys must be
 * unique within one keyed column.
 *
 * Example:
 *     keyed_column(todos.map(fun(t: Todo) = (t.id, checkbox(t.title, t.done, Msg.Done))))
 */
public fun keyed_column<Msg>(children: (string, View<Msg>)[]): View<Msg> = View.Keyed(children);

/**
 * Lays `children` side by side, moving to a new line when a line is full, so
 * they re-flow as the window resizes. Children keep their natural widths
 * (`.equal()` makes a tidy grid); `.max_per_line(n)` caps a line;
 * a `Spacing`'s `gap` is the room across and down. Children are matched by position.
 *
 * Example:
 *     wrap(m.tags.map(chip)).style([Spacing { gap: Width.Px(6), ..Spacing.theme() }])
 */
public fun wrap<Msg>(children: View<Msg>[]): View<Msg> = View.Wrap(children);

/**
 * As `wrap`, but children are matched by key, like `keyed_column`: adding,
 * removing or reordering one moves just that widget. Keys must be unique.
 *
 * Example:
 *     keyed_wrap(m.apps.map(fun(a) = (a.id, tile(a)))).equal().max_per_line(6)
 */
public fun keyed_wrap<Msg>(children: (string, View<Msg>)[]): View<Msg> = View.KeyedWrap(children);

/**
 * Draws `layers` on top of `base`, in order (a later one above an earlier
 * one); `[]` shows only the base. Each layer sits where `.place(across, down)`
 * says, covering the whole base without it. The base takes the size; layers
 * never grow the window. A layer takes the clicks in its own area; for "click
 * outside to close", put a full-size layer under it that sends a message.
 *
 * Example:
 *     overlay(page(m), if m.panel_open { [info(m).place(Align.End, Align.Fill)] } else { [] })
 */
public fun overlay<Msg>(base: View<Msg>, layers: View<Msg>[]): View<Msg> = View.Overlay(
    base,
    layers,
);

/**
 * Shows `trigger`, and `content` in a popover below it while `open`. GTK
 * closes it on a click outside or Escape and `on_close` is sent: the model
 * says whether it's open (rule 7), so a button inside closes it by setting
 * the model. The content is built while closed too, so its fields keep
 * their text. GTK's own look, with its arrow.
 *
 * Example:
 *     popover(button("Dimensions", Msg.Open(true)), m.editing, form(m), Msg.Open(false))
 */
public fun popover<Msg>(
    trigger: View<Msg>,
    open: bool,
    content: View<Msg>,
    on_close: Msg,
): View<Msg> = View.Popover(trigger, open, content, on_close, Edge.Bottom, true);

/**
 * As `popover`, on `side` of the trigger (`Edge.Top`, `Bottom`, `Left`,
 * `Right`); GTK flips it when there's no room there.
 *
 * Example:
 *     popover_at(Edge.Top, button("Info", Msg.Info(true)), m.info, details(m), Msg.Info(false))
 */
public fun popover_at<Msg>(
    side: Edge,
    trigger: View<Msg>,
    open: bool,
    content: View<Msg>,
    on_close: Msg,
): View<Msg> = View.Popover(trigger, open, content, on_close, side, true);

/**
 * Builds `build()` only when `key` differs from the key this lazy node had
 * last update; otherwise kivuli reuses what it built before, and doesn't diff
 * it either. The key must cover everything the subtree shows: leave something
 * out and a change to it won't appear. Modifiers belong inside `build`;
 * modifiers on the lazy node itself are ignored.
 *
 * Example:
 *     lazy("{t.id}:{t.done}:{t.title}", fun() = todo_row(t))
 */
public fun lazy<Msg>(key: string, build: fun(): View<Msg>): View<Msg> = View.Lazy(key, build, None);

/**
 * Builds a multi-line text field showing `value`, scrolling inside itself and
 * wrapping long lines. Each edit sends `on_change(text)`, the whole new text;
 * Enter starts a new line. It's 80 pixels tall unless a `Sizing` sets its height;
 * `.name(id)` lets tests find it.
 *
 * Example:
 *     text_area(m.notes, Msg.Notes).name("notes").style([Sizing { min_height: Width.Px(120), ..Sizing.theme() }])
 */
public fun text_area<Msg>(value: string, on_change: fun(string): Msg): View<Msg> = View.TextArea(
    value,
    Some(on_change),
);

/**
 * Builds a drop-down offering `choices`, each a label and the message picking
 * it sends; `selected` is the label shown picked. When it matches no label, a
 * blank item is shown picked (picking it sends nothing). With two equal
 * labels, `selected` picks the first. `.disabled(true)` greys it, sending
 * nothing. `.name(id)` lets tests find it.
 *
 * Example:
 *     dropdown([("Normal", Msg.Weight(false)), ("Bold", Msg.Weight(true))], if m.bold { "Bold" } else { "Normal" })
 */
public fun dropdown<Msg>(choices: (string, Msg)[], selected: string): View<Msg> = View.Dropdown(
    offered(choices),
    selected,
    [],
);

/** `choices` each sending its message: a drop-down's until `.disabled` takes them away. */
fun offered<Msg>(choices: (string, Msg)[]): (string, Option<Msg>)[] = choices.map(
    fun(c) = (c.0, Some(c.1)),
);

/**
 * Builds a drop-down whose open list shows `groups`' choices under their
 * headings, a line between groups; a heading `""` shows the line alone, and a
 * group with no choices is left out. `selected` picks the first choice so
 * labelled in any group, as `dropdown` does.
 *
 * Example:
 *     dropdown_grouped([("Fruits", [("Apple", Msg.Pick("apple"))]), ("Vegetables", [("Carrot", Msg.Pick("carrot"))])], m.picked)
 */
public fun dropdown_grouped<Msg>(groups: (string, (string, Msg)[])[], selected: string): View<Msg> {
    let mut choices: (string, Msg)[] = [];
    let mut sizes: (string, i64)[] = [];
    for (heading, members) of groups {
        if members.len > 0 {
            choices = choices + members;
            sizes.push((heading, members.len));
        }
    }
    View.Dropdown(offered(choices), selected, sizes)
}

/**
 * Builds a horizontal slider from `min` to `max` showing `value` (clamped to
 * the range) and its number beside the handle. Each move to a new whole step
 * sends `on_change(value)`. `.step(n)` makes it move in steps of `n`;
 * `.name(id)` lets tests find it. `min > max` panics when it's shown.
 *
 * Example:
 *     slider(0, 100, m.volume, Msg.Volume).name("volume")
 */
public fun slider<Msg>(
    min: i64,
    max: i64,
    value: i64,
    on_change: fun(i64): Msg,
): View<Msg> = View.Slider(min, max, value, Some(on_change));

/**
 * Builds a theme icon by name, at the theme's size; `.size(n)` makes it `n`
 * pixels. Symbolic icons (`…-symbolic`) take the theme's text colour. A name
 * the theme doesn't have shows GTK's "missing image" icon.
 *
 * Example:
 *     icon("emblem-ok-symbolic").size(64)
 */
public fun icon<Msg>(name: string): View<Msg> = View.Image(Image.Icon(name));

/**
 * Builds an image: a theme icon (as `icon`), or a PNG or JPEG from a file or
 * from bytes, scaled to the room it's given as `.fit` says (`.width`,
 * `.height`, or `.size(n)` for an n × n box). A relative path is relative to
 * the directory the app was started from. An image that can't be shown (not
 * PNG or JPEG, corrupt, over 4096 × 4096 px or 16 MB, a missing file) shows
 * nothing, and the app keeps running. Bytes are known by their key: give new
 * bytes a new key.
 *
 * Example:
 *     image(Image.Bytes("counter:banner", banner)).fit(Fit.Cover).style([Sizing { width: Width.Px(320), height: Width.Px(120), ..Sizing.theme() }])
 */
public fun image<Msg>(img: Image): View<Msg> = View.Image(img);

/**
 * Where a slider from `min` to `max` moving in `step`s stops for `value`:
 * clamped to the range, then the nearest step from `min` (half-way rounds up),
 * never past `max`. Shared by the live slider and `kivuli.testing.slide`, so
 * tests round as the widget does.
 */
fun snap(value: i64, min: i64, max: i64, step: i64): i64 {
    if min > max {
        panic("kivuli: a slider's least value {min} is greater than its greatest {max}");
    }
    let by = if step <= 0 { 1 } else { step };
    let clamped = if value < min { min } else if value > max { max } else { value };
    let near = min + (clamped - min + by / 2) / by * by;
    if near > max { near - by } else { near }
}

/**
 * A header bar: `start` views at its start, `title` in the middle
 * (`.expand()` lets it fill the bar, as for an address box) and `end` views
 * at its end. Put it in the window's title bar with `.header(…)` on the root;
 * style it with `.style([...])`.
 *
 * Example:
 *     page.header(header_bar([back], address(m).expand(), [menu]))
 */
public fun header_bar<Msg>(start: View<Msg>[], title: View<Msg>, end: View<Msg>[]): Bar<Msg> = Bar {
    start: start,
    title: title,
    end: end,
    sheet: Sheet.theme(),
};
