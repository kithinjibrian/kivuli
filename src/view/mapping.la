/**
 * The bodies of `View`'s methods that rewrite nodes rather than their style:
 * `map`, `.disabled`, `.image`/`.icon`, `.on_submit`, `.menu`; and the header
 * bar before it goes in `.header(…)`, `Bar`. Moved out of `views.la`
 * (DECISION-018, file size), where every method must stay with `View`;
 * `views` and `mapping` import each other, the one import cycle kivuli allows.
 *
 * Depends on: views, pictures, menus
 * Used by: views (`View.map`)
 */

import view.views { View };
import view.pictures { Image };
import view.menus { MenuEntry };
import view.clips { Overflowing };
import view.looks { Align, Style, plain };
import styles.theming { Color, Paint };
import styles.boxes { Background, Border, Spacing };
import styles.drawing { Shadow };
import styles.motion { Motion };
import styles.values { Radius };
import styles { Sheet, Styling, When, State, applied };

/** `v` sending `f(msg)` wherever it would send `msg`; what's shown is unchanged. */
fun mapped<Msg, B>(v: View<Msg>, f: fun(Msg): B): View<B> = match v {
    Text(s) => View.Text(s),
    Button(label, msg, img) => View.Button(label, msg.map(f), img),
    ButtonWith(content, msg) => View.ButtonWith(content.map(f), msg.map(f)),
    Column(xs) => View.Column(xs.map(fun(x) = x.map(f))),
    Row(xs) => View.Row(xs.map(fun(x) = x.map(f))),
    TextArea(value, on_change) => View.TextArea(value, match on_change {
        Some(g) => Some(fun(s: string): B = f(g(s))),
        None => None,
    }),
    Input(value, messages) => View.Input(value, match messages {
        Some((on_change, on_submit)) => Some(
            (fun(s: string): B = f(on_change(s)), on_submit.map(f)),
        ),
        None => None,
    }),
    Checkbox(label, checked, on_toggle) => View.Checkbox(label, checked, match on_toggle {
        Some(g) => Some(fun(b: bool): B = f(g(b))),
        None => None,
    }),
    Dropdown(choices, selected, groups) => View.Dropdown(
        choices.map(fun(choice) = (choice.0, match choice.1 {
            Some(msg) => Some(f(msg)),
            None => None,
        })),
        selected,
        groups,
    ),
    Progress(n) => View.Progress(n),
    Switch(on, on_toggle) => View.Switch(on, match on_toggle {
        Some(g) => Some(fun(b: bool): B = f(g(b))),
        None => None,
    }),
    Slider(min, max, value, on_change) => View.Slider(min, max, value, match on_change {
        Some(g) => Some(fun(n: i64): B = f(g(n))),
        None => None,
    }),
    Image(img) => View.Image(img),
    Spacer => View.Spacer,
    Separator => View.Separator,
    Scroll(x, fit) => View.Scroll(x.map(f), fit),
    Clip(x, on_overflow) => View.Clip(x.map(f), match on_overflow {
        Some(g) => Some(fun(o: Overflowing): B = f(g(o))),
        None => None,
    }),
    Fit(xs, more, on_hidden) => View.Fit(xs.map(fun(x) = x.map(f)), more.map(f), match on_hidden {
        Some(g) => Some(fun(n: i64): B = f(g(n))),
        None => None,
    }),
    Keyed(pairs) => View.Keyed(pairs.map(fun(pair) = (pair.0, pair.1.map(f)))),
    Wrap(xs) => View.Wrap(xs.map(fun(x) = x.map(f))),
    KeyedWrap(pairs) => View.KeyedWrap(pairs.map(fun(pair) = (pair.0, pair.1.map(f)))),
    Overlay(base, layers) => View.Overlay(base.map(f), layers.map(fun(x) = x.map(f))),
    Popover(trigger, open, content, close, side, arrow) => View.Popover(
        trigger.map(f),
        open,
        content.map(f),
        f(close),
        side,
        arrow,
    ),
    Menu(x, entries) => View.Menu(x.map(f), entries.map(fun(e) = e.map(f))),
    Styled(x, style) => View.Styled(x.map(f), style),
    Framed(body, start, title, end) => View.Framed(
        body.map(f),
        start.map(fun(x) = x.map(f)),
        title.map(f),
        end.map(fun(x) = x.map(f)),
    ),
    // The key stays: what's built is the same, only its messages change, and
    // what it found holds no messages.
    Lazy(key, build, built, found) => View.Lazy(
        key,
        fun(): View<B> = build().map(f),
        built.map(fun(b) = b.map(f)),
        found,
    ),
};

/** `.disabled`: when `off`, a button's, field's, text area's, check box's, slider's, switch's or drop-down's messages taken away. */
fun disabled_node<Msg>(v: View<Msg>, off: bool): View<Msg> = if !off {
    v
} else {
    match v {
        Button(label, _, img) => View.Button(label, None, img),
        ButtonWith(content, _) => View.ButtonWith(content, None),
        Input(value, _) => View.Input(value, None),
        TextArea(value, _) => View.TextArea(value, None),
        Checkbox(label, checked, _) => View.Checkbox(label, checked, None),
        Slider(min, max, value, _) => View.Slider(min, max, value, None),
        Switch(on, _) => View.Switch(on, None),
        Dropdown(choices, selected, groups) => View.Dropdown(
            choices.map(fun(c) = (c.0, None)),
            selected,
            groups,
        ),
        Styled(inside, s) => View.Styled(disabled_node(inside, true), s),
        Menu(inside, entries) => View.Menu(disabled_node(inside, true), entries),
        _ => v,
    }
};

/** `.image` / `.icon`: a button's image set, or taken away with `None`. */
fun button_image<Msg>(v: View<Msg>, img: Option<Image>): View<Msg> = match v {
    Button(label, msg, _) => View.Button(label, msg, img),
    Styled(inside, s) => View.Styled(button_image(inside, img), s),
    Menu(inside, entries) => View.Menu(button_image(inside, img), entries),
    _ => v,
};

/** `.on_submit`: the message Enter sends, on an input that isn't disabled. */
fun with_submit<Msg>(v: View<Msg>, msg: Msg): View<Msg> = match v {
    Input(value, Some((on_change, _))) => View.Input(value, Some((on_change, Some(msg)))),
    // Disabled: there are no messages to add Enter's to.
    Input(_, None) => v,
    Styled(inside, s) => View.Styled(with_submit(inside, msg), s),
    Menu(inside, entries) => View.Menu(with_submit(inside, msg), entries),
    _ => v,
};

/** `.on_overflow`: a clip's message set, inside its style; other nodes unchanged. */
fun with_overflow<Msg>(v: View<Msg>, f: fun(Overflowing): Msg): View<Msg> = match v {
    Clip(child, _) => View.Clip(child, Some(f)),
    Styled(inside, s) => View.Styled(with_overflow(inside, f), s),
    Menu(inside, entries) => View.Menu(with_overflow(inside, f), entries),
    _ => v,
};

/** `.on_hidden`: a fit row's message set, inside its style; other nodes unchanged. */
fun with_hidden<Msg>(v: View<Msg>, f: fun(i64): Msg): View<Msg> = match v {
    Fit(xs, more, _) => View.Fit(xs, more, Some(f)),
    Styled(inside, s) => View.Styled(with_hidden(inside, f), s),
    Menu(inside, entries) => View.Menu(with_hidden(inside, f), entries),
    _ => v,
};

/**
 * `.menu`: the node's context menu set, inside its style so modifiers keep one
 * wrapper; `[]` takes it away.
 */
fun with_menu<Msg>(v: View<Msg>, entries: MenuEntry<Msg>[]): View<Msg> = match v {
    Styled(inside, s) => View.Styled(with_menu(inside, entries), s),
    Menu(inside, _) => with_menu(inside, entries),
    // As for styles (DECISION-002): a lazy subtree is what `build` gives it.
    Lazy(_, _, _, _) => v,
    _ => if entries.len == 0 { v } else { View.Menu(v, entries) },
};

/** A dialog (`ui.dialog`): its card and the message closing it (the backdrop, the ✕, Escape). */
public struct Dialog<Msg> {
    public close: Msg,
    public card: View<Msg>,
}

/** `.dialog`: the root as an overlay over `page`, with `d`'s backdrop and card while it's `Some`. */
fun with_dialog<Msg>(page: View<Msg>, d: Option<Dialog<Msg>>): View<Msg> {
    let layers: View<Msg>[] = match d {
        // The card places itself: centred for a dialog, on an edge for a sheet.
        Some(dialog) => [backdrop(dialog.close), dialog.card],
        None => [],
    };
    // The overlay is there open or not: opening adds layers, the page is kept.
    View.Styled(View.Overlay(page.inert(d.is_some()), layers), Style {
        dialog_root: true,
        ..plain(),
    })
}

/** The backdrop: the whole window, black at 50%; a click sends `close`; it never takes focus. */
fun backdrop<Msg>(close: Msg): View<Msg> {
    let dim = Paint.Color(Color { red: 0, green: 0, blue: 0, alpha: 128 });
    let look = applied(Sheet.theme(), [
        Background.color(dim),
        Border { radius: Radius.All(0), ..Border.theme() },
        Border.all(0, dim),
        Spacing.padding(0),
        Shadow.off(),
        // GTK's own button rules for these states: the same dim.
        When(State.Hover, [Background.color(dim)]),
        When(State.Press, [Background.color(dim)]),
        Motion.fade_in(150),
    ]);
    View.Styled(View.ButtonWith(View.Column([]), Some(close)), Style {
        sheet: look,
        focusable: false,
        ..plain(),
    })
}

/**
 * A header bar, before it goes in `.header(…)`: the views at its start, its
 * title view and the views at its end, and its own style. Made by
 * `header_bar`; styled like a node.
 */
public struct Bar<Msg> {
    start: View<Msg>[],
    title: View<Msg>,
    end: View<Msg>[],
    sheet: Sheet,
}

impl Bar<Msg> {
    /**
     * How the bar looks, as `.style` on a node: its window controls stay
     * GTK's. An exact or maximum size, a gap and a background image are the
     * window's, and stop the app with a message.
     *
     * Example:
     *     header_bar([back], title, []).style([Background { color: Paint.Color(hex("#242424")), ..Background.theme() }])
     */
    public fun style(self, items: Styling[]): Bar<Msg> = Bar {
        sheet: applied(self.sheet, items),
        ..self,
    };
}
