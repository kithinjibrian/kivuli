/**
 * Walking a view: every node in order, with the style it carries and lazy
 * nodes built and looked through, or, over a painted view, a painted lazy
 * taken as what it found (PRP-068). Pure. Used to find things in a view: the
 * testing helpers, the stylesheet, the shortcut duplicate check, and
 * `Cmd.focus` (finding a named node's path).
 *
 * Depends on: views, looks
 * Used by: keys, live, paint, testing
 */

import view.views { View };
import view.looks { Style, plain };

/**
 * Every node of `v` in order, without its `Styled` wrapper but with the style
 * it carries; lazy nodes are built and looked through.
 */
fun nodes<Msg>(v: View<Msg>): (View<Msg>, Style)[] = walk(v, plain(), true, false);

/**
 * As `nodes`, but a lazy that `paint` found things in is one node, not looked
 * into: its `Found` says what it holds. What each message's checks walk, so
 * an unchanged lazy costs them nothing for its size. Buttons' content isn't
 * checked: `paint` checked it.
 */
fun nodes_painted<Msg>(v: View<Msg>): (View<Msg>, Style)[] = walk(v, plain(), false, true);

fun walk<Msg>(
    v: View<Msg>,
    style: Style,
    check: bool,
    painted: bool,
): (View<Msg>, Style)[] = match v {
    Styled(inside, s) => walk(inside, s, check, painted),
    Lazy(_, build, built, found) => if painted && found.is_some() {
        [(v, plain())]
    } else {
        // Modifiers on a lazy node are ignored; what it builds carries its own.
        walk(
            match built {
                Some(b) => b,
                None => build(),
            },
            plain(),
            check,
            painted,
        )
    },
    Column(xs) => with_children(v, style, xs, check, painted),
    Row(xs) => with_children(v, style, xs, check, painted),
    Keyed(pairs) => with_children(v, style, pairs.map(fun(pair) = pair.1), check, painted),
    Wrap(xs) => with_children(v, style, xs, check, painted),
    KeyedWrap(pairs) => with_children(v, style, pairs.map(fun(pair) = pair.1), check, painted),
    Overlay(base, layers) => {
        let mut xs = [base];
        for x of layers {
            xs.push(x);
        }
        with_children(v, style, xs, check, painted)
    }
    Popover(trigger, _, content, _, _, _) => with_children(
        v,
        style,
        [trigger, content],
        check,
        painted,
    ),
    Scroll(x, _) => with_children(v, style, [x], check, painted),
    Clip(x, _) => with_children(v, style, [x], check, painted),
    Fit(xs, more, _) => {
        let mut all = xs;
        all.push(more);
        with_children(v, style, all, check, painted)
    }
    // Every walk checks a button's content, so an app's pure tests stop on it too.
    ButtonWith(content, _) => {
        if check {
            match check_content(content) {
                Ok(_) => {}
                Err(problem) => panic("kivuli: {problem}"),
            }
        }
        with_children(v, style, [content], check, painted)
    }
    // The menu, then its node with the same style: a button with a menu is
    // still found by its label or tooltip.
    Menu(inside, _) => {
        let mut out = [(v, style)];
        for pair of walk(inside, style, check, painted) {
            out.push(pair);
        }
        out
    }
    Framed(body, start, title, end) => {
        let mut xs = [body, title];
        for x of start {
            xs.push(x);
        }
        for x of end {
            xs.push(x);
        }
        with_children(v, style, xs, check, painted)
    }
    _ => [(v, style)],
};

fun with_children<Msg>(
    v: View<Msg>,
    style: Style,
    xs: View<Msg>[],
    check: bool,
    painted: bool,
): (View<Msg>, Style)[] {
    let mut out: (View<Msg>, Style)[] = [(v, style)];
    for x of xs {
        for pair of walk(x, plain(), check, painted) {
            out.push(pair);
        }
    }
    out
}

/**
 * The path (as patches count it) of the first node named `name` with
 * `.name(…)`, if any: through styles and lazy nodes, by position in columns,
 * rows and keyed columns, index 0 in a scroll.
 */
fun path_of_name<Msg>(v: View<Msg>, name: string): Option<i64[]> = find_name(v, name, []);

fun find_name<Msg>(v: View<Msg>, name: string, path: i64[]): Option<i64[]> = match v {
    Styled(inside, style) => if style.name == name {
        Some(path)
    } else {
        find_name(inside, name, path)
    },
    Lazy(_, _, Some(built), _) => find_name(built, name, path),
    Menu(inside, _) => find_name(inside, name, path),
    Column(xs) => find_in(xs, name, path),
    Row(xs) => find_in(xs, name, path),
    Keyed(pairs) => find_in(pairs.map(fun(pair) = pair.1), name, path),
    Wrap(xs) => find_in(xs, name, path),
    KeyedWrap(pairs) => find_in(pairs.map(fun(pair) = pair.1), name, path),
    // As the diff counts an overlay: the base 0, the layers 1 (then each by index).
    Overlay(base, layers) => match find_name(base, name, with_index(path, 0)) {
        Some(found) => Some(found),
        None => find_in(layers, name, with_index(path, 1)),
    },
    // As the diff counts a popover: the trigger 0, the content 1.
    Popover(trigger, _, content, _, _, _) => match find_name(trigger, name, with_index(path, 0)) {
        Some(found) => Some(found),
        None => find_name(content, name, with_index(path, 1)),
    },
    Scroll(x, _) => find_name(x, name, with_index(path, 0)),
    Clip(x, _) => find_name(x, name, with_index(path, 0)),
    // As the diff counts a fit row: its children in a row at 0, `more` at 1.
    Fit(xs, more, _) => match find_in(xs, name, with_index(path, 0)) {
        Some(found) => Some(found),
        None => find_name(more, name, with_index(path, 1)),
    },
    ButtonWith(content, _) => find_name(content, name, with_index(path, 0)),
    // As the diff counts a header's parts: body 0, title 1, start 2, end 3.
    Framed(body, start, title, end) => match find_name(body, name, with_index(path, 0)) {
        Some(found) => Some(found),
        None => match find_name(title, name, with_index(path, 1)) {
            Some(found) => Some(found),
            None => match find_in(start, name, with_index(path, 2)) {
                Some(found) => Some(found),
                None => find_in(end, name, with_index(path, 3)),
            },
        },
    },
    _ => None,
};

fun find_in<Msg>(xs: View<Msg>[], name: string, path: i64[]): Option<i64[]> {
    let mut i = 0;
    while i < xs.len {
        match find_name(xs[i], name, with_index(path, i)) {
            Some(found) => {
                return Some(found);
            }
            None => {}
        }
        i = i + 1;
    }
    None
}

fun with_index(path: i64[], i: i64): i64[] {
    let mut out = path;
    out.push(i);
    out
}

/**
 * Whether `content` can sit in a `button_with`: nothing in it may be
 * interactive (a button in a button fights it for clicks and focus).
 * @returns `Err` naming the first thing that is
 */
fun check_content<Msg>(content: View<Msg>): Result<(), string> = match interactive(content) {
    Some(what) => Err("a button_with's content can't hold {what}"),
    None => Ok(()),
};

/**
 * The first interactive thing in `v` (`"a button (\"Save\")"`), if any; a
 * painted lazy answers from what it found.
 */
fun interactive<Msg>(v: View<Msg>): Option<string> {
    for (node, _) of nodes_painted(v) {
        let found = match node {
            Button(label, _, _) => Some("a button (\"{label}\")"),
            ButtonWith(_, _) => Some("a button_with"),
            Input(_, _) => Some("a text field"),
            TextArea(_, _) => Some("a text area"),
            Checkbox(label, _, _) => Some("a check box (\"{label}\")"),
            Switch(_, _) => Some("a switch"),
            Dropdown(_, _, _) => Some("a drop-down"),
            Slider(_, _, _, _) => Some("a slider"),
            Lazy(_, _, _, Some(f)) => f.interactive,
            _ => None,
        };
        if found.is_some() {
            return found;
        }
    }
    None
}
