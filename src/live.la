/**
 * Live widgets: builds real GTK widgets for a `View`, keeps a `Live` tree
 * mirroring them, and on each message applies the diff between the last view
 * and the next instead of rebuilding. The only module that calls GTK. Not
 * responsible for deciding what to show (the app's `view`) or what changed
 * (`diff`).
 *
 * Depends on: views, effects, diff, live_tree, build, gtk.raw
 * Used by: lib
 */

import gtk {
    GtkApplication,
    GtkWidget,
    connect_app,
    g_application_quit,
    g_application_run,
    g_get_real_time,
    g_object_unref,
    g_source_remove,
    g_timeout_add_full,
    gtk_application_new,
    gtk_application_window_new,
    gtk_box_append,
    gtk_box_insert_child_after,
    gtk_box_remove,
    gtk_box_reorder_child_after,
    gtk_button_set_label,
    gtk_check_button_set_active,
    gtk_check_button_set_label,
    gtk_editable_get_text,
    gtk_editable_set_text,
    gtk_label_set_text,
    gtk_scrolled_window_set_child,
    gtk_widget_set_sensitive,
    gtk_window_present,
    gtk_window_set_child,
    gtk_window_set_default_size,
    gtk_window_set_title,
};
import diff;
import views { View, Window };
import effects { App, Cmd, Timer, commands, timers };
import build { create, create_in, apply_style, flag };
import live_tree { Live, widget };

/** What changes as the app runs: the model, the view it gave, and the widgets showing it. */
struct State<Model, Msg> {
    model: Model,
    tree: View<Msg>,
    live: Live<Msg>,
}

/** A `Sub.every` timer that's running: its key, its GLib source, and the function its ticks call. */
struct Ticking<Msg> {
    key: string,
    source: u32,
    // Re-pointed when the subscription asks again, as buttons' handlers are.
    tick: Ref<fun(i64): Msg>,
}

/** A running app: what's fixed at start, plus what changes. */
struct Running<Model, Msg> {
    application: GtkApplication,
    window: GtkWidget,
    program: App<Model, Msg>,
    // `None` only while the first view is being built.
    state: Ref<Option<State<Model, Msg>>>,
    // True while patches are applied: a widget changed by a patch (an entry's
    // text) emits its signal, and that echo must not dispatch again.
    patching: Ref<bool>,
    timers: Ref<Ticking<Msg>[]>,
    // Subtrees lazy nodes built, by key, for the next update to reuse.
    built: Ref<Map<string, View<Msg>>>,
}

/**
 * Starts the GTK application `program.id` and runs it until its window closes
 * or a command quits it.
 * @returns GTK's exit status, for `main` to return.
 */
fun run<Model, Msg>(program: App<Model, Msg>): i32 {
    let application = gtk_application_new(program.id, 0);
    connect_app(
        application,
        "activate",
        fun(a: GtkApplication) {
            let window = gtk_application_window_new(a);
            mount(a, window, program);
            gtk_window_present(window);
        },
        0,
    );
    let status = g_application_run(application, 0, None);
    g_object_unref(application);
    status
}

/**
 * Shows `program`'s first view in `window` and sets the app going: its
 * window title and size, `init`'s command, and its subscriptions.
 */
fun mount<Model, Msg>(
    application: GtkApplication,
    window: GtkWidget,
    program: App<Model, Msg>,
): Running<Model, Msg> {
    let none_yet: Ticking<Msg>[] = [];
    let nothing_built: Map<string, View<Msg>> = #{};
    let app = Running {
        application: application,
        window: window,
        program: program,
        state: Ref.new(None),
        patching: Ref.new(false),
        timers: Ref.new(none_yet),
        built: Ref.new(nothing_built),
    };
    let (model, cmd) = program.init;
    let view = program.view;
    let (tree, built) = diff.resolve(view(model), app.built.get());
    app.built.set(built);
    let live = create(tree, sender(app));
    gtk_window_set_child(window, widget(live));
    app.state.set(Some(State { model: model, tree: tree, live: live }));
    show_window(window, None, window_of(tree));
    perform(app, cmd);
    resubscribe(app, model);
    app
}

/** The widgets `app` shows now. */
fun live_of<Model, Msg>(app: Running<Model, Msg>): Live<Msg> {
    let Some(s) = app.state.get() else {
        panic("kivuli: the app has no view yet");
    };
    s.live
}

/** The function every widget and timer calls to send a message to `app`. */
fun sender<Model, Msg>(app: Running<Model, Msg>): fun(Msg) = fun(msg: Msg) {
    // An echo of our own patch, not the user: the model already has it.
    if !app.patching.get() {
        dispatch(app, msg);
    }
};

/**
 * update → view → diff → patch the widgets → store → retitle the window →
 * carry out the command → start and stop timers to match the subscriptions.
 */
fun dispatch<Model, Msg>(app: Running<Model, Msg>, msg: Msg) {
    let Some(s) = app.state.get() else {
        panic("kivuli: a message arrived before the first view was shown");
    };
    let update = app.program.update;
    let view = app.program.view;
    let (model, cmd) = update(s.model, msg);
    // Lazy nodes whose keys are unchanged reuse what they built last time.
    let (tree, built) = diff.resolve(view(model), app.built.get());
    app.built.set(built);
    let mut live = s.live;
    app.patching.set(true);
    for patch of diff.diff(s.tree, tree) {
        live = apply(app.window, live, patch, sender(app));
    }
    app.patching.set(false);
    app.state.set(Some(State { model: model, tree: tree, live: live }));
    show_window(app.window, window_of(s.tree), window_of(tree));
    perform(app, cmd);
    resubscribe(app, model);
}

/** The window a view's root asks for with `.window(…)`, if any. */
fun window_of<Msg>(tree: View<Msg>): Option<Window> = match tree {
    Styled(_, style) => style.window,
    _ => None,
};

/** Retitles and resizes `window` when the root's `.window(…)` changed; a dropped one leaves it as it is. */
fun show_window(window: GtkWidget, old: Option<Window>, new: Option<Window>) {
    if new == old {
        return;
    }
    match new {
        Some(w) => {
            gtk_window_set_title(window, w.title);
            gtk_window_set_default_size(window, w.width as i32, w.height as i32);
        }
        None => {}
    }
}

/** Carries out `cmd`: timers for `Cmd.after`, quitting for `Cmd.quit`. */
fun perform<Model, Msg>(app: Running<Model, Msg>, cmd: Cmd<Msg>) {
    for c of commands(cmd) {
        match c {
            After(ms, msg) => {
                let send = sender(app);
                g_timeout_add_full(0, ms as u32, fun(): i32 {
                    send(msg);
                    // G_SOURCE_REMOVE: once only.
                    0
                });
            }
            Quit => g_application_quit(app.application),
            _ => {}
        }
    }
}

/**
 * Starts and stops `Sub.every` timers so they match what `subscriptions`
 * asks for now. A timer asked for again (same key) keeps running, with its
 * tick re-pointed; one no longer asked for is removed.
 */
fun resubscribe<Model, Msg>(app: Running<Model, Msg>, model: Model) {
    let subscriptions = app.program.subscriptions;
    let wanted = timers(subscriptions(model));
    let mut keys: Set<string> = #{};
    for w of wanted {
        keys.insert(w.key);
    }
    let mut kept: Map<string, Ticking<Msg>> = #{};
    for t of app.timers.get() {
        if keys.has(t.key) {
            kept[t.key] = t;
        } else {
            g_source_remove(t.source);
        }
    }
    let mut next: Ticking<Msg>[] = [];
    for w of wanted {
        match kept.get(w.key) {
            Some(t) => {
                t.tick.set(w.tick);
                next.push(t);
            }
            None => next.push(start_timer(app, w)),
        }
    }
    app.timers.set(next);
}

fun start_timer<Model, Msg>(app: Running<Model, Msg>, timer: Timer<Msg>): Ticking<Msg> {
    let tick = Ref.new(timer.tick);
    let send = sender(app);
    let source = g_timeout_add_full(0, timer.ms as u32, fun(): i32 {
        let f = tick.get();
        // Milliseconds since 1970.
        send(f(g_get_real_time() / 1000));
        // G_SOURCE_CONTINUE: until `resubscribe` removes it.
        1
    });
    Ticking { key: timer.key, source: source, tick: tick }
}

/** Applies one patch to the widgets, and returns the `Live` tree that now mirrors them. */
fun apply<Msg>(
    window: GtkWidget,
    live: Live<Msg>,
    patch: diff.Patch<Msg>,
    send: fun(Msg),
): Live<Msg> = match patch {
    SetText(path, s) => {
        gtk_label_set_text(widget(at(live, path)), s);
        live
    }
    SetLabel(path, s) => {
        match at(live, path) {
            Button(w, _) => gtk_button_set_label(w, s),
            Checkbox(w, _) => gtk_check_button_set_label(w, s),
            _ => panic("kivuli: a SetLabel patch points at something without a label"),
        }
        live
    }
    SetMsg(path, msg) => {
        match at(live, path) {
            Button(button, current) => {
                current.set(msg);
                gtk_widget_set_sensitive(button, flag(msg.is_some()));
            }
            _ => panic("kivuli: a SetMsg patch points at something that isn't a button"),
        }
        live
    }
    SetValue(path, value) => {
        let entry = widget(at(live, path));
        // Only when the field shows something else: rewriting the same text
        // would move the cursor to the end while the user types.
        if gtk_editable_get_text(entry) != value {
            gtk_editable_set_text(entry, value);
        }
        live
    }
    SetOnChange(path, on_change) => {
        match at(live, path) {
            Input(_, current, _) => current.set(on_change),
            _ => panic("kivuli: a SetOnChange patch points at something that isn't a text field"),
        }
        live
    }
    SetOnSubmit(path, on_submit) => {
        match at(live, path) {
            Input(_, _, submit) => submit.set(on_submit),
            _ => panic("kivuli: a SetOnSubmit patch points at something that isn't a text field"),
        }
        live
    }
    SetChecked(path, checked) => {
        // GTK fires `toggled` only on a real change, and while patching the
        // echo is dropped, so this needs no same-state check of its own.
        gtk_check_button_set_active(widget(at(live, path)), flag(checked));
        live
    }
    SetOnToggle(path, on_toggle) => {
        match at(live, path) {
            Checkbox(_, current) => current.set(on_toggle),
            _ => panic("kivuli: a SetOnToggle patch points at something that isn't a check box"),
        }
        live
    }
    SetStyle(path, style) => {
        apply_style(at(live, path), style, axis_at(live, parent_or_root(path)));
        live
    }
    Append(path, v) => update_at(live, path, 0, fun(node: Live<Msg>): Live<Msg> = match node {
        Box(box, orientation, kids) => {
            let kid = create_in(v, orientation, send);
            gtk_box_append(box, widget(kid));
            let mut next = kids;
            next.push(kid);
            Live.Box(box, orientation, next)
        }
        _ => panic("kivuli: an Append patch points at something that isn't a column or row"),
    }),
    Remove(path) => {
        let i = path[path.len - 1];
        update_at(live, parent(path), 0, fun(node: Live<Msg>): Live<Msg> = match node {
            Box(box, orientation, kids) => {
                gtk_box_remove(box, widget(kids[i]));
                Live.Box(box, orientation, diff.without(kids, i))
            }
            _ => panic("kivuli: a Remove patch points into something that isn't a column or row"),
        })
    }
    Insert(path, at, v) => update_at(live, path, 0, fun(node: Live<Msg>): Live<Msg> = match node {
        Box(box, orientation, kids) => {
            let kid = create_in(v, orientation, send);
            gtk_box_insert_child_after(box, widget(kid), sibling_before(kids, at));
            Live.Box(box, orientation, diff.inserted(kids, at, kid))
        }
        _ => panic("kivuli: an Insert patch points at something that isn't a keyed column"),
    }),
    Move(path, from, to) => update_at(live, path, 0, fun(node: Live<Msg>): Live<Msg> = match node {
        Box(box, orientation, kids) => {
            let next = diff.moved(kids, from, to);
            gtk_box_reorder_child_after(box, widget(kids[from]), sibling_before(next, to));
            Live.Box(box, orientation, next)
        }
        _ => panic("kivuli: a Move patch points at something that isn't a keyed column"),
    }),
    Replace(path, v) => if path.len == 0 {
        let fresh = create(v, send);
        gtk_window_set_child(window, widget(fresh));
        fresh
    } else {
        let i = path[path.len - 1];
        update_at(live, parent(path), 0, fun(node: Live<Msg>): Live<Msg> = match node {
            Box(box, orientation, kids) => {
                let fresh = create_in(v, orientation, send);
                // Insert after the previous sibling (or first), then drop the
                // old widget, so the new one takes exactly its place.
                gtk_box_insert_child_after(box, widget(fresh), sibling_before(kids, i));
                gtk_box_remove(box, widget(kids[i]));
                let mut next = kids;
                next[i] = fresh;
                Live.Box(box, orientation, next)
            }
            Scroll(scrolled, _) => {
                // Setting a new child drops the old one (and the viewport GTK
                // may have wrapped it in).
                let fresh = create_in(v, 1, send);
                gtk_scrolled_window_set_child(scrolled, Some(widget(fresh)));
                Live.Scroll(scrolled, fresh)
            }
            _ => panic("kivuli: a Replace patch points into something with no children"),
        })
    },
};

/**
 * Rebuilds the `Live` tree with the node at `path` (from `depth` on) replaced
 * by `f(node)`. `f` also makes the matching change to the widgets.
 */
fun update_at<Msg>(
    node: Live<Msg>,
    path: i64[],
    depth: i64,
    f: fun(Live<Msg>): Live<Msg>,
): Live<Msg> = if depth == path.len {
    f(node)
} else {
    match node {
        Box(box, orientation, kids) => {
            let i = path[depth];
            let mut next = kids;
            next[i] = update_at(kids[i], path, depth + 1, f);
            Live.Box(box, orientation, next)
        }
        Scroll(scrolled, kid) => Live.Scroll(scrolled, update_at(kid, path, depth + 1, f)),
        _ => panic("kivuli: a patch's path leads through something with no children"),
    }
};

/** The axis children of the node at `path` are laid out along: a box's orientation, else vertical. */
fun axis_at<Msg>(live: Live<Msg>, path: i64[]): i32 = match at(live, path) {
    Box(_, orientation, _) => orientation,
    _ => 1,
};

/** The parent's path, or the root's own for the root (whose children are laid out vertically). */
fun parent_or_root(path: i64[]): i64[] = if path.len == 0 { path } else { parent(path) };

/** The node at `path`. */
fun at<Msg>(node: Live<Msg>, path: i64[]): Live<Msg> {
    let mut here = node;
    for i of path {
        here = match here {
            Box(_, _, kids) => kids[i],
            Scroll(_, kid) => kid,
            _ => panic("kivuli: a patch's path leads through something with no children"),
        };
    }
    here
}

fun parent(path: i64[]): i64[] {
    let mut p: i64[] = [];
    let mut i = 0;
    while i < path.len - 1 {
        p.push(path[i]);
        i = i + 1;
    }
    p
}

/** The widget to place a child after so it lands at index `at`: the one before it, or `None` (first). */
fun sibling_before<Msg>(kids: Live<Msg>[], at: i64): Option<GtkWidget> = if at == 0 {
    None
} else {
    Some(widget(kids[at - 1]))
};
