/**
 * Live widgets: builds real GTK widgets for a `View`, keeps a `Live` tree
 * mirroring them, and on each message applies the diff between the last view
 * and the next instead of rebuilding. The only module that calls GTK. Not
 * responsible for deciding what to show (the app's `view`) or what changed
 * (`diff`).
 *
 * Depends on: views, effects, diff, live_tree, build, patch, gtk.raw
 * Used by: lib
 */

import gtk {
    GtkApplication,
    GtkWidget,
    connect_app,
    g_application_quit,
    g_application_run,
    g_get_real_time,
    g_object_unref,
    g_source_remove,
    g_timeout_add_full,
    gtk_application_new,
    gtk_application_window_new,
    gtk_window_present,
    gtk_window_set_child,
    gtk_window_set_default_size,
    gtk_window_set_title,
};
import diff;
import views { View, Window };
import effects { App, Cmd, Timer, commands, timers };
import build { create };
import patch { apply };
import live_tree { Live, widget };

/** What changes as the app runs: the model, the view it gave, and the widgets showing it. */
struct State<Model, Msg> {
    model: Model,
    tree: View<Msg>,
    live: Live<Msg>,
}

/** A `Sub.every` timer that's running: its key, its GLib source, and the function its ticks call. */
struct Ticking<Msg> {
    key: string,
    source: u32,
    // Re-pointed when the subscription asks again, as buttons' handlers are.
    tick: Ref<fun(i64): Msg>,
}

/** A running app: what's fixed at start, plus what changes. */
struct Running<Model, Msg> {
    application: GtkApplication,
    window: GtkWidget,
    program: App<Model, Msg>,
    // `None` only while the first view is being built.
    state: Ref<Option<State<Model, Msg>>>,
    // True while patches are applied: a widget changed by a patch (an entry's
    // text) emits its signal, and that echo must not dispatch again.
    patching: Ref<bool>,
    timers: Ref<Ticking<Msg>[]>,
}

/**
 * Starts the GTK application `program.id` and runs it until its window closes
 * or a command quits it.
 * @returns GTK's exit status, for `main` to return.
 */
fun run<Model, Msg>(program: App<Model, Msg>): i32 {
    let application = gtk_application_new(program.id, 0);
    connect_app(
        application,
        "activate",
        fun(a: GtkApplication) {
            let window = gtk_application_window_new(a);
            mount(a, window, program);
            gtk_window_present(window);
        },
        0,
    );
    let status = g_application_run(application, 0, None);
    g_object_unref(application);
    status
}

/**
 * Shows `program`'s first view in `window` and sets the app going: its
 * window title and size, `init`'s command, and its subscriptions.
 */
fun mount<Model, Msg>(
    application: GtkApplication,
    window: GtkWidget,
    program: App<Model, Msg>,
): Running<Model, Msg> {
    let none_yet: Ticking<Msg>[] = [];
    let app = Running {
        application: application,
        window: window,
        program: program,
        state: Ref.new(None),
        patching: Ref.new(false),
        timers: Ref.new(none_yet),
    };
    let (model, cmd) = program.init;
    let view = program.view;
    let tree = diff.resolve(view(model), None);
    let live = create(tree, sender(app));
    gtk_window_set_child(window, widget(live));
    app.state.set(Some(State { model: model, tree: tree, live: live }));
    show_window(window, None, window_of(tree));
    perform(app, cmd);
    resubscribe(app, model);
    app
}

/** The widgets `app` shows now. */
fun live_of<Model, Msg>(app: Running<Model, Msg>): Live<Msg> {
    let Some(s) = app.state.get() else {
        panic("kivuli: the app has no view yet");
    };
    s.live
}

/** The function every widget and timer calls to send a message to `app`. */
fun sender<Model, Msg>(app: Running<Model, Msg>): fun(Msg) = fun(msg: Msg) {
    // An echo of our own patch, not the user: the model already has it.
    if !app.patching.get() {
        dispatch(app, msg);
    }
};

/**
 * update → view → diff → patch the widgets → store → retitle the window →
 * carry out the command → start and stop timers to match the subscriptions.
 */
fun dispatch<Model, Msg>(app: Running<Model, Msg>, msg: Msg) {
    let Some(s) = app.state.get() else {
        panic("kivuli: a message arrived before the first view was shown");
    };
    let update = app.program.update;
    let view = app.program.view;
    let (model, cmd) = update(s.model, msg);
    // Lazy nodes whose keys are unchanged at their place reuse what they built.
    let tree = diff.resolve(view(model), Some(s.tree));
    let mut live = s.live;
    app.patching.set(true);
    for change of diff.diff(s.tree, tree) {
        live = apply(app.window, live, change, sender(app));
    }
    app.patching.set(false);
    app.state.set(Some(State { model: model, tree: tree, live: live }));
    show_window(app.window, window_of(s.tree), window_of(tree));
    perform(app, cmd);
    resubscribe(app, model);
}

/** The window a view's root asks for with `.window(…)`, if any. */
fun window_of<Msg>(tree: View<Msg>): Option<Window> = match tree {
    Styled(_, style) => style.window,
    _ => None,
};

/** Retitles and resizes `window` when the root's `.window(…)` changed; a dropped one leaves it as it is. */
fun show_window(window: GtkWidget, old: Option<Window>, new: Option<Window>) {
    if new == old {
        return;
    }
    match new {
        Some(w) => {
            gtk_window_set_title(window, w.title);
            gtk_window_set_default_size(window, w.width as i32, w.height as i32);
        }
        None => {}
    }
}

/** Carries out `cmd`: timers for `Cmd.after`, quitting for `Cmd.quit`. */
fun perform<Model, Msg>(app: Running<Model, Msg>, cmd: Cmd<Msg>) {
    for c of commands(cmd) {
        match c {
            After(ms, msg) => {
                let send = sender(app);
                g_timeout_add_full(0, ms as u32, fun(): i32 {
                    send(msg);
                    // G_SOURCE_REMOVE: once only.
                    0
                });
            }
            Quit => g_application_quit(app.application),
            _ => {}
        }
    }
}

/**
 * Starts and stops `Sub.every` timers so they match what `subscriptions`
 * asks for now. A timer asked for again (same key) keeps running, with its
 * tick re-pointed; one no longer asked for is removed.
 */
fun resubscribe<Model, Msg>(app: Running<Model, Msg>, model: Model) {
    let subscriptions = app.program.subscriptions;
    let wanted = timers(subscriptions(model));
    let mut keys: Set<string> = #{};
    for w of wanted {
        keys.insert(w.key);
    }
    let mut kept: Map<string, Ticking<Msg>> = #{};
    for t of app.timers.get() {
        if keys.has(t.key) {
            kept[t.key] = t;
        } else {
            g_source_remove(t.source);
        }
    }
    let mut next: Ticking<Msg>[] = [];
    for w of wanted {
        match kept.get(w.key) {
            Some(t) => {
                t.tick.set(w.tick);
                next.push(t);
            }
            None => next.push(start_timer(app, w)),
        }
    }
    app.timers.set(next);
}

fun start_timer<Model, Msg>(app: Running<Model, Msg>, timer: Timer<Msg>): Ticking<Msg> {
    let tick = Ref.new(timer.tick);
    let send = sender(app);
    let source = g_timeout_add_full(0, timer.ms as u32, fun(): i32 {
        let f = tick.get();
        // Milliseconds since 1970.
        send(f(g_get_real_time() / 1000));
        // G_SOURCE_CONTINUE: until `resubscribe` removes it.
        1
    });
    Ticking { key: timer.key, source: source, tick: tick }
}
