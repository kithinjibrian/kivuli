/**
 * Live widgets: builds real GTK widgets for a `View`, keeps a `Live` tree
 * mirroring them, and on each message applies the diff between the last view
 * and the next instead of rebuilding. The only module that calls GTK. Not
 * responsible for deciding what to show (the app's `view`) or what changed
 * (`diff`).
 *
 * Depends on: views, diff, gtk.raw
 * Used by: lib
 */

import gtk;
import diff;
import views { View };

/** The widgets on screen, shaped exactly like the `View` they show. */
enum Live<Msg> {
    Label(gtk.raw.GtkWidget),
    /** The button and the message it sends: its click handler reads this box. */
    Button(gtk.raw.GtkWidget, Ref<Msg>),
    /**
     * A column or a row: both are a `GtkBox`, and patch the same way. The
     * orientation (`GtkOrientation`: 1 vertical, 0 horizontal) lays out
     * children added later.
     */
    Box(gtk.raw.GtkWidget, i32, Live<Msg>[]),
    /** A text field and the function turning its text into a message: its `changed` handler reads this box. */
    Input(gtk.raw.GtkWidget, Ref<fun(string): Msg>),
    /** A check box and the function turning its state into a message: its `toggled` handler reads this box. */
    Checkbox(gtk.raw.GtkWidget, Ref<fun(bool): Msg>),
    Spacer(gtk.raw.GtkWidget),
    Separator(gtk.raw.GtkWidget),
    /** A scrolled window and the one child it shows. */
    Scroll(gtk.raw.GtkWidget, Live<Msg>),
}

/** What changes as the app runs: the model, the view it gave, and the widgets showing it. */
struct State<Model, Msg> {
    model: Model,
    tree: View<Msg>,
    live: Live<Msg>,
}

/** A running app: what's fixed at start, plus its changing `State`. */
struct Running<Model, Msg> {
    window: gtk.raw.GtkWidget,
    update_fn: fun(Model, Msg): Model,
    view_fn: fun(Model): View<Msg>,
    // `None` only while the first view is being built.
    state: Ref<Option<State<Model, Msg>>>,
    // True while patches are applied: a widget changed by a patch (an entry's
    // text) emits its signal, and that echo must not dispatch again.
    patching: Ref<bool>,
}

/**
 * Starts the GTK application `id` and runs it until its window closes:
 * shows `view(init)`, then on each message replaces the model with
 * `update(model, msg)` and patches the widgets to show the new view.
 * @returns GTK's exit status, for `main` to return.
 */
fun run<Model, Msg>(
    id: string,
    init: Model,
    update: fun(Model, Msg): Model,
    view: fun(Model): View<Msg>,
): i32 {
    let application = gtk.raw.gtk_application_new(id, 0);
    gtk.raw.connect_app(
        application,
        "activate",
        fun(a: gtk.raw.GtkApplication) {
            let window = gtk.raw.gtk_application_window_new(a);
            let state: Ref<Option<State<Model, Msg>>> = Ref.new(None);
            let app = Running {
                window: window,
                update_fn: update,
                view_fn: view,
                state: state,
                patching: Ref.new(false),
            };
            let tree = view(init);
            let live = create(tree, sender(app));
            gtk.raw.gtk_window_set_child(window, widget(live));
            state.set(Some(State { model: init, tree: tree, live: live }));
            gtk.raw.gtk_window_present(window);
        },
        0,
    );
    let status = gtk.raw.g_application_run(application, 0, None);
    gtk.raw.g_object_unref(application);
    status
}

/** The function every widget calls to send a message to `app`. */
fun sender<Model, Msg>(app: Running<Model, Msg>): fun(Msg) = fun(msg: Msg) {
    // An echo of our own patch, not the user: the model already has it.
    if !app.patching.get() {
        dispatch(app, msg);
    }
};

/** update → view → diff → patch the widgets → store. */
fun dispatch<Model, Msg>(app: Running<Model, Msg>, msg: Msg) {
    let Some(s) = app.state.get() else {
        panic("kivuli: a message arrived before the first view was shown");
    };
    let update = app.update_fn;
    let view = app.view_fn;
    let model = update(s.model, msg);
    let tree = view(model);
    let mut live = s.live;
    app.patching.set(true);
    for patch of diff.diff(s.tree, tree) {
        live = apply(app.window, live, patch, sender(app));
    }
    app.patching.set(false);
    app.state.set(Some(State { model: model, tree: tree, live: live }));
}

/** Builds the GTK widgets for `v` at the top of a window; each widget sends its messages through `send`. */
fun create<Msg>(v: View<Msg>, send: fun(Msg)): Live<Msg> = create_in(v, 1, send);

/**
 * Builds the GTK widgets for `v` inside a parent laid out along `axis`
 * (`GtkOrientation`: 1 vertical, a column; 0 horizontal, a row). Spacers grow
 * along it and separators cross it.
 */
fun create_in<Msg>(v: View<Msg>, axis: i32, send: fun(Msg)): Live<Msg> = match v {
    Text(s) => Live.Label(gtk.raw.gtk_label_new(s)),
    Button(label, msg) => {
        let button = gtk.raw.gtk_button_new_with_label(label);
        let current = Ref.new(msg);
        // Connected once, for the widget's whole life: a SetMsg patch changes
        // `current`, never the connection.
        gtk.raw.connect_widget(
            button,
            "clicked",
            fun(b: gtk.raw.GtkWidget) {
                send(current.get());
            },
            0,
        );
        Live.Button(button, current)
    }
    // Spacing comes later as a modifier.
    Column(children) => create_box(1, children, send),
    Row(children) => create_box(0, children, send),
    Input(value, on_change) => {
        let entry = gtk.raw.gtk_entry_new();
        // Set before connecting, so the first text isn't sent as an edit.
        gtk.raw.gtk_editable_set_text(entry, value);
        let current = Ref.new(on_change);
        gtk.raw.connect_widget(
            entry,
            "changed",
            fun(e: gtk.raw.GtkWidget) {
                let f = current.get();
                send(f(gtk.raw.gtk_editable_get_text(e)));
            },
            0,
        );
        Live.Input(entry, current)
    }
    Checkbox(label, checked, on_toggle) => {
        let check = gtk.raw.gtk_check_button_new_with_label(label);
        // Set before connecting, so the first state isn't sent as a toggle.
        gtk.raw.gtk_check_button_set_active(check, flag(checked));
        let current = Ref.new(on_toggle);
        gtk.raw.connect_widget(
            check,
            "toggled",
            fun(c: gtk.raw.GtkWidget) {
                let f = current.get();
                send(f(gtk.raw.gtk_check_button_get_active(c) != 0));
            },
            0,
        );
        Live.Checkbox(check, current)
    }
    Spacer => {
        // An empty box given all the spare room along its parent's axis.
        let room = gtk.raw.gtk_box_new(0, 0);
        if axis == 1 {
            gtk.raw.gtk_widget_set_vexpand(room, 1);
        } else {
            gtk.raw.gtk_widget_set_hexpand(room, 1);
        }
        Live.Spacer(room)
    }
    // Across the axis: a horizontal line in a column, a vertical one in a row.
    Separator => Live.Separator(gtk.raw.gtk_separator_new(1 - axis)),
    Scroll(child) => {
        let scrolled = gtk.raw.gtk_scrolled_window_new();
        // A scrolled window asks for almost no room of its own: let it take
        // the spare room both ways, or it shows a sliver.
        gtk.raw.gtk_widget_set_hexpand(scrolled, 1);
        gtk.raw.gtk_widget_set_vexpand(scrolled, 1);
        let kid = create_in(child, 1, send);
        gtk.raw.gtk_scrolled_window_set_child(scrolled, Some(widget(kid)));
        Live.Scroll(scrolled, kid)
    }
    // On screen a keyed column is a column: the keys matter only to the diff.
    Keyed(children) => {
        let mut views_of: View<Msg>[] = [];
        for (_, v) of children {
            views_of.push(v);
        }
        create_box(1, views_of, send)
    }
};

/** Builds a `GtkBox` of `orientation` holding the widgets for `children`. */
fun create_box<Msg>(orientation: i32, children: View<Msg>[], send: fun(Msg)): Live<Msg> {
    let box = gtk.raw.gtk_box_new(orientation, 0);
    let mut kids: Live<Msg>[] = [];
    for child of children {
        let kid = create_in(child, orientation, send);
        gtk.raw.gtk_box_append(box, widget(kid));
        kids.push(kid);
    }
    Live.Box(box, orientation, kids)
}

/** Applies one patch to the widgets, and returns the `Live` tree that now mirrors them. */
fun apply<Msg>(
    window: gtk.raw.GtkWidget,
    live: Live<Msg>,
    patch: diff.Patch<Msg>,
    send: fun(Msg),
): Live<Msg> = match patch {
    SetText(path, s) => {
        gtk.raw.gtk_label_set_text(widget(at(live, path)), s);
        live
    }
    SetLabel(path, s) => {
        match at(live, path) {
            Button(w, _) => gtk.raw.gtk_button_set_label(w, s),
            Checkbox(w, _) => gtk.raw.gtk_check_button_set_label(w, s),
            _ => panic("kivuli: a SetLabel patch points at something without a label"),
        }
        live
    }
    SetMsg(path, msg) => {
        match at(live, path) {
            Button(_, current) => current.set(msg),
            _ => panic("kivuli: a SetMsg patch points at something that isn't a button"),
        }
        live
    }
    SetValue(path, value) => {
        let entry = widget(at(live, path));
        // Only when the field shows something else: rewriting the same text
        // would move the cursor to the end while the user types.
        if gtk.raw.gtk_editable_get_text(entry) != value {
            gtk.raw.gtk_editable_set_text(entry, value);
        }
        live
    }
    SetOnChange(path, on_change) => {
        match at(live, path) {
            Input(_, current) => current.set(on_change),
            _ => panic("kivuli: a SetOnChange patch points at something that isn't a text field"),
        }
        live
    }
    SetChecked(path, checked) => {
        // GTK fires `toggled` only on a real change, and while patching the
        // echo is dropped, so this needs no same-state check of its own.
        gtk.raw.gtk_check_button_set_active(widget(at(live, path)), flag(checked));
        live
    }
    SetOnToggle(path, on_toggle) => {
        match at(live, path) {
            Checkbox(_, current) => current.set(on_toggle),
            _ => panic("kivuli: a SetOnToggle patch points at something that isn't a check box"),
        }
        live
    }
    Append(path, v) => update_at(live, path, 0, fun(node: Live<Msg>): Live<Msg> = match node {
        Box(box, orientation, kids) => {
            let kid = create_in(v, orientation, send);
            gtk.raw.gtk_box_append(box, widget(kid));
            let mut next = kids;
            next.push(kid);
            Live.Box(box, orientation, next)
        }
        _ => panic("kivuli: an Append patch points at something that isn't a column or row"),
    }),
    Remove(path) => {
        let i = path[path.len - 1];
        update_at(live, parent(path), 0, fun(node: Live<Msg>): Live<Msg> = match node {
            Box(box, orientation, kids) => {
                gtk.raw.gtk_box_remove(box, widget(kids[i]));
                Live.Box(box, orientation, diff.without(kids, i))
            }
            _ => panic("kivuli: a Remove patch points into something that isn't a column or row"),
        })
    }
    Insert(path, at, v) => update_at(live, path, 0, fun(node: Live<Msg>): Live<Msg> = match node {
        Box(box, orientation, kids) => {
            let kid = create_in(v, orientation, send);
            gtk.raw.gtk_box_insert_child_after(box, widget(kid), sibling_before(kids, at));
            Live.Box(box, orientation, diff.inserted(kids, at, kid))
        }
        _ => panic("kivuli: an Insert patch points at something that isn't a keyed column"),
    }),
    Move(path, from, to) => update_at(live, path, 0, fun(node: Live<Msg>): Live<Msg> = match node {
        Box(box, orientation, kids) => {
            let next = diff.moved(kids, from, to);
            gtk.raw.gtk_box_reorder_child_after(box, widget(kids[from]), sibling_before(next, to));
            Live.Box(box, orientation, next)
        }
        _ => panic("kivuli: a Move patch points at something that isn't a keyed column"),
    }),
    Replace(path, v) => if path.len == 0 {
        let fresh = create(v, send);
        gtk.raw.gtk_window_set_child(window, widget(fresh));
        fresh
    } else {
        let i = path[path.len - 1];
        update_at(live, parent(path), 0, fun(node: Live<Msg>): Live<Msg> = match node {
            Box(box, orientation, kids) => {
                let fresh = create_in(v, orientation, send);
                // Insert after the previous sibling (or first), then drop the
                // old widget, so the new one takes exactly its place.
                gtk.raw.gtk_box_insert_child_after(box, widget(fresh), sibling_before(kids, i));
                gtk.raw.gtk_box_remove(box, widget(kids[i]));
                let mut next = kids;
                next[i] = fresh;
                Live.Box(box, orientation, next)
            }
            Scroll(scrolled, _) => {
                // Setting a new child drops the old one (and the viewport GTK
                // may have wrapped it in).
                let fresh = create_in(v, 1, send);
                gtk.raw.gtk_scrolled_window_set_child(scrolled, Some(widget(fresh)));
                Live.Scroll(scrolled, fresh)
            }
            _ => panic("kivuli: a Replace patch points into something with no children"),
        })
    },
};

/**
 * Rebuilds the `Live` tree with the node at `path` (from `depth` on) replaced
 * by `f(node)`. `f` also makes the matching change to the widgets.
 */
fun update_at<Msg>(
    node: Live<Msg>,
    path: i64[],
    depth: i64,
    f: fun(Live<Msg>): Live<Msg>,
): Live<Msg> = if depth == path.len {
    f(node)
} else {
    match node {
        Box(box, orientation, kids) => {
            let i = path[depth];
            let mut next = kids;
            next[i] = update_at(kids[i], path, depth + 1, f);
            Live.Box(box, orientation, next)
        }
        Scroll(scrolled, kid) => Live.Scroll(scrolled, update_at(kid, path, depth + 1, f)),
        _ => panic("kivuli: a patch's path leads through something with no children"),
    }
};

/** The node at `path`. */
fun at<Msg>(node: Live<Msg>, path: i64[]): Live<Msg> {
    let mut here = node;
    for i of path {
        here = match here {
            Box(_, _, kids) => kids[i],
            Scroll(_, kid) => kid,
            _ => panic("kivuli: a patch's path leads through something with no children"),
        };
    }
    here
}

/** The GTK widget showing `node`. */
fun widget<Msg>(node: Live<Msg>): gtk.raw.GtkWidget = match node {
    Label(w) => w,
    Button(w, _) => w,
    Box(w, _, _) => w,
    Input(w, _) => w,
    Checkbox(w, _) => w,
    Spacer(w) => w,
    Separator(w) => w,
    Scroll(w, _) => w,
};

/** A Lugha `bool` as a C `gboolean`. */
fun flag(b: bool): i32 = if b {
    1
} else {
    0
};

fun parent(path: i64[]): i64[] {
    let mut p: i64[] = [];
    let mut i = 0;
    while i < path.len - 1 {
        p.push(path[i]);
        i = i + 1;
    }
    p
}

/** The widget to place a child after so it lands at index `at`: the one before it, or `None` (first). */
fun sibling_before<Msg>(kids: Live<Msg>[], at: i64): Option<gtk.raw.GtkWidget> = if at == 0 {
    None
} else {
    Some(widget(kids[at - 1]))
};
