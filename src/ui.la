/**
 * kivuli's public API: the `View` tree an app's `view` function returns, and
 * the functions that build it. A `View` is plain data: it describes a screen
 * and touches no GTK.
 *
 * Depends on: live (to run an app)
 */

import live;

/**
 * A description of what's on screen. `Msg` is the app's message type: what a
 * widget sends to `update` when the user acts on it.
 */
public enum View<Msg> {
    /** A line of text. */
    Text(string),
    /** A button with its label and the message one click sends. */
    Button(string, Msg),
    /** Children stacked top to bottom. */
    Column(View<Msg>[]),
}

/**
 * Builds a line of text.
 *
 * Example:
 *     text("Clicked {m.count} times")
 */
public fun text<Msg>(s: string): View<Msg> = View.Text(s);

/**
 * Builds a button that sends `msg` each time it's clicked.
 *
 * Example:
 *     button("Add", Msg.Add)
 */
public fun button<Msg>(label: string, msg: Msg): View<Msg> = View.Button(label, msg);

/**
 * Stacks `children` top to bottom.
 *
 * Example:
 *     column([text("Hi"), button("Add", Msg.Add)])
 */
public fun column<Msg>(children: View<Msg>[]): View<Msg> = View.Column(children);

/**
 * Runs an app with no effects: shows `view(init)` in a window, and on each
 * message sets the model to `update(model, msg)` and shows the new view.
 *
 * @param id the application ID, reverse-DNS, such as `"org.kivuli.counter"`
 * @param init the model at start
 * @param update the next model, given the current one and a message
 * @param view what to show for a model
 * @returns GTK's exit status, for `main` to return
 *
 * Example:
 *     fun main(): i32 = ui.sandbox("org.kivuli.counter", Model { count: 0 }, update, view);
 */
public fun sandbox<Model, Msg>(
    id: string,
    init: Model,
    update: fun(Model, Msg): Model,
    view: fun(Model): View<Msg>,
): i32 = live.run(id, init, update, view);
