/**
 * kivuli.ui: components drawn from the palette's tokens
 * (`import kivuli.ui { badge, Badge };`, then `ui.button(…)` beside the native `button`). Each is built only from the public
 * style API, so an app can copy one and change it. A variant is a `Look`
 * given through `.style`.
 *
 * Depends on: ui/ (each component's file)
 * Used by: apps
 */

public import ui.badges { badge, badge_with, Badge };
public import ui.buttons { button, button_with, Button };
public import ui.inputs { input, Input };
public import ui.fields {
    field,
    field_horizontal,
    field_label,
    field_description,
    field_error,
    field_group,
    Field,
};
public import ui.input_groups {
    input_group,
    group_input,
    group_text,
    group_button,
    group_button_with,
    InputGroup,
};
public import ui.separators { separator, separator_with };
public import ui.checkboxes { checkbox };
public import ui.sliders { slider };
public import ui.dropdowns { dropdown, dropdown_grouped, Dropdown };
public import ui.switches { switch };
public import ui.tab_bars { tab, tab_with, tabs, tabs_line, tabs_line_vertical, tabs_vertical };
public import ui.menu_looks { dropdown_menu, Menu };
public import ui.tooltip_looks { Tooltip };
public import ui.window_controls { WindowControls };
public import ui.popover_looks { popover, popover_at };
public import ui.progress_bars { progress };
public import ui.avatars { avatar, avatar_group, Avatar };
public import ui.dialogs { dialog, dialog_header, dialog_footer, sheet };
// The type `.dialog` takes, re-exported where `ui.dialog` makes it.
public import view.mapping { Dialog };

public import ui.cards { card, card_header, card_header_with, card_content, card_footer };
