// Two copies of one component in one app: each counter has its own model,
// messages, update and view, and `map` turns its messages into the app's.
import kivuli {
    Align,
    View,
    Font,
    Text,
    Size,
    Weight,
    Paint,
    button,
    column,
    lazy,
    row,
    sandbox,
    separator,
    text,
};

// The component.
struct Counter {
    count: i64,
}

enum Step {
    Up,
    Down,
}

fun step(c: Counter, s: Step): Counter = match s {
    Up => Counter { count: c.count + 1 },
    Down => Counter { count: c.count - 1 },
};

// Lazy, keyed on the count: both counters use the same key, and each keeps
// its own build (lazies are reused per place).
fun counter(title: string, c: Counter): View<Step> = lazy(
    "{title}:{c.count}",
    fun(): View<Step> = column([
        text(title).style([Text { color: Paint.Faded(0.55), ..Text.theme() }]).align(Align.Center),
        text("{c.count}").style([
            Font { size: Size.Pt(28), weight: Weight.Bold, tabular: true, ..Font.theme() },
        ]).align(Align.Center),
        row([button("−", Step.Down), button("+", Step.Up)]).spacing(6).align(Align.Center),
    ]).spacing(6),
);

// The app.
struct Model {
    left: Counter,
    right: Counter,
}

enum Msg {
    Left(Step),
    Right(Step),
}

fun update(m: Model, msg: Msg): Model = match msg {
    Left(s) => Model { left: step(m.left, s), ..m },
    Right(s) => Model { right: step(m.right, s), ..m },
};

fun view(m: Model): View<Msg> = column([
    row([
        counter("Left", m.left).map(Msg.Left),
        separator(),
        counter("Right", m.right).map(Msg.Right),
    ]).spacing(16).align(Align.Center),
    text("Total {m.left.count + m.right.count}").align(Align.Center),
]).padding(24).spacing(16).window("Split", 360, 220);

fun main(): i32 = sandbox(
    "org.kivuli.split",
    Model { left: Counter { count: 0 }, right: Counter { count: 0 } },
    update,
    view,
);
