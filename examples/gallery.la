// Icons and pictures: theme icons at the theme's size and larger, buttons with
// an icon, one picture shown with each `.fit`, and the same picture from
// bytes in memory, as an app holding a bundle's images shows them. Run it from the repository's
// root (`lughac run examples/gallery.la`): the picture's path is relative to
// where the app starts. Its tests are at the bottom: `lughac test examples/gallery.la`.
// examples/assets/sample.png was generated for kivuli (a sky, a sun, a hill),
// GPL-3.0-only like the rest of the repository.
import kivuli {
    Align,
    ButtonStyle,
    Fit,
    Image,
    View,
    button,
    column,
    icon,
    image,
    row,
    sandbox,
    spacer,
    text,
};
// For the tests at the bottom; `lughac build` leaves tests out.
import kivuli.testing { click, is_disabled, texts };

struct Counts {
    added: i64,
    deleted: i64,
    /** The sample picture's bytes, read once at start (empty if it's missing: nothing shows). */
    sample: u8[],
}

enum Msg {
    Add,
    Delete,
    Reset,
}

fun update(c: Counts, msg: Msg): Counts = match msg {
    Add => Counts { added: c.added + 1, ..c },
    Delete => Counts { deleted: c.deleted + 1, ..c },
    Reset => Counts { added: 0, deleted: 0, ..c },
};

fun heading(s: string): View<Msg> = text(s).bold();

fun icons(size: i64): View<Msg> {
    let mut shown: View<Msg>[] = [];
    for name of [
        "list-add-symbolic",
        "user-trash-symbolic",
        "emblem-ok-symbolic",
        "starred-symbolic",
        "document-open-symbolic",
    ] {
        let one: View<Msg> = icon(name);
        shown.push(if size > 0 { one.size(size) } else { one });
    }
    row(shown).spacing(12)
}

/** The sample picture in a 160-pixel square, fitted one way, with its name under it. */
fun fitted(fit: Fit, name: string): View<Msg> = column([
    image(Image.File("examples/assets/sample.png")).width(160).height(160).fit(fit),
    text(name).dim().align(Align.Center),
]).spacing(4);

fun view(c: Counts): View<Msg> = column([
    heading("Theme icons"),
    icons(0),
    icons(32),
    icons(64),
    heading("Buttons"),
    row([
        button("Add", Msg.Add).icon("list-add-symbolic").button_style(ButtonStyle.Primary),
        button("", Msg.Delete).icon("user-trash-symbolic").tooltip("Delete"),
        button("Reset", Msg.Reset).disabled(c.added == 0 && c.deleted == 0),
        spacer(),
        text("Added {c.added} · deleted {c.deleted}").dim().align(Align.Center),
    ]).spacing(8),
    heading("One picture, four fits"),
    row([
        fitted(Fit.Contain, "Contain"),
        fitted(Fit.Cover, "Cover"),
        fitted(Fit.ScaleDown, "ScaleDown"),
        fitted(Fit.Fill, "Fill"),
    ]).spacing(12),
    heading("From bytes in memory"),
    row([
        // The key names the bytes: the same key, and they're never decoded again.
        image(Image.Bytes("sample", c.sample)).width(160).height(80),
        // An image-only button: its tooltip names it, for people and tests.
        button("", Msg.Add).image(Image.Bytes("sample", c.sample)).size(32).tooltip("Add from the picture"),
    ]).spacing(12),
]).padding(16).spacing(12).window("Gallery", 720, 760);

fun main(): i32 = sandbox("org.kivuli.gallery", start(), update, view);

// Tests: what a user does, worked out from the view and fed back through `update`.

/** No counts yet, and the sample picture's bytes (as an app would hold a bundle's). */
fun start(): Counts = Counts {
    added: 0,
    deleted: 0,
    sample: read_bytes("examples/assets/sample.png").unwrap_or([]),
};

fun clicked(c: Counts, label: string): Counts = update(
    c,
    click(view(c), label).unwrap_or(Msg.Reset),
);

@test
fun the_icon_buttons_count_and_the_icon_only_one_is_found_by_its_tooltip() {
    let c = clicked(clicked(clicked(start(), "Add"), "Add"), "Delete");
    assert_eq((c.added, c.deleted), (2, 1));
    assert_eq(texts(view(c))[2], "Added 2 · deleted 1");
}

@test
fun reset_is_disabled_until_something_is_counted() {
    assert_eq(is_disabled(view(start()), "Reset"), Ok(true));
    let c = clicked(start(), "Delete");
    assert_eq(is_disabled(view(c), "Reset"), Ok(false));
    assert_eq((clicked(c, "Reset").added, clicked(c, "Reset").deleted), (0, 0));
}

@test
fun the_picture_button_adds_too() {
    assert_eq(clicked(start(), "Add from the picture").added, 1);
}

@test
fun each_fit_is_named_under_its_picture() {
    let shown = texts(view(start()));
    assert_eq([shown[4], shown[5], shown[6], shown[7]], ["Contain", "Cover", "ScaleDown", "Fill"]);
}
