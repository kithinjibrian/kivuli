// The components gallery's buttons, badges, inputs, dialog and menus.
import kivuli {
    View,
    Edge,
    Align,
    Token,
    look,
    Border,
    Spacing,
    Text,
    button,
    column,
    radio_group,
    check_item,
    submenu,
    menu_separator,
    menu_label,
    item,
    icon,
    row,
    text,
    Effects,
    State,
    When,
    Motion,
    Group,
    overlay,
    Sizing,
};
import kivuli.ui {
    badge,
    badge_with,
    Badge,
    Button,
    Input,
    Dropdown,
    Menu,
    Dialog,
    field,
    field_label,
    field_horizontal,
    dialog_header,
    dialog_footer,
};
import gallery.state { Model, Msg, section, centred };

/** The dialog the Dialog section opens: Escape, the backdrop, the ✕ and Cancel close it. */
public fun delete_dialog(): Dialog<Msg> = ui.dialog(Msg.Deleting(false), [
    dialog_header(
        "Delete project?",
        "This can't be undone. The project and its files will be removed for good.",
    ),
    dialog_footer([
        ui.button("Cancel", Msg.Deleting(false)).style([Button.outline()]),
        ui.button("Delete", Msg.Picked("Deleted the project")).style([Button.destructive()]),
    ]),
]);

/** The sheet the Sheet section opens, on the edge the model says: Escape, the backdrop, the ✕ and Cancel close it. */
public fun edit_sheet(m: Model): Dialog<Msg> = ui.sheet(
    Msg.Sheet(-1),
    if m.sheet == 0 {
        Edge.Top
    } else if m.sheet == 2 {
        Edge.Bottom
    } else if m.sheet == 3 {
        Edge.Left
    } else {
        Edge.Right
    },
    [
        dialog_header(
            "Edit profile",
            "Make changes to your profile here. Click save when you're done.",
        ),
        field([field_label("Name"), ui.input(m.user, Msg.User).placeholder("Pedro Duarte")]),
        dialog_footer([
            ui.button("Cancel", Msg.Sheet(-1)).style([Button.outline()]),
            ui.button("Save changes", Msg.Picked("Saved the profile")),
        ]),
    ],
);

/** The Button, Badge, Input, Dialog, Sheet, Popover and Dropdown menu sections, top to bottom. */
public fun sections(m: Model): View<Msg>[] = [
    section(
        "Button",
        column([
            row([
                centred(ui.button("Button", Msg.Base(m.base)).tooltip("Add to library")),
                centred(ui.button("Secondary", Msg.Base(m.base)).style([Button.secondary()])),
                centred(ui.button("Destructive", Msg.Base(m.base)).style([Button.destructive()])),
                centred(ui.button("Outline", Msg.Base(m.base)).style([Button.outline()])),
                centred(ui.button("Ghost", Msg.Base(m.base)).style([Button.ghost()])),
                centred(ui.button("Link", Msg.Base(m.base)).style([Button.link()])),
            ]).style([Spacing.gap(8)]),
            row([
                centred(ui.button("Small", Msg.Base(m.base)).style([Button.sm()])),
                centred(ui.button("Default", Msg.Base(m.base))),
                centred(ui.button("Large", Msg.Base(m.base)).style([Button.lg()])),
                centred(ui.button_with([icon("list-add-symbolic"), text("New")], Msg.Base(m.base))),
                centred(
                    ui.button_with(
                        [text("Next"), icon("go-next-symbolic")],
                        Msg.Base(m.base),
                    ).style([Button.outline()]),
                ),
                centred(
                    ui.button_with([icon("open-menu-symbolic")], Msg.Base(m.base)).style([
                        Button.icon(),
                        Button.outline(),
                    ]).tooltip("Menu"),
                ),
                centred(
                    ui.button_with([icon("edit-delete-symbolic")], Msg.Base(m.base)).style([
                        Button.icon(),
                        Button.ghost(),
                    ]).tooltip("Delete"),
                ),
            ]).style([Spacing.gap(8)]),
            row([
                centred(ui.button("Disabled", Msg.Base(m.base)).disabled(true)),
                centred(
                    ui.button("Disabled", Msg.Base(m.base)).style([Button.outline()]).disabled(
                        true,
                    ),
                ),
                centred(button("Native GTK", Msg.Base(m.base))),
            ]).style([Spacing.gap(8)]),
        ]).style([Spacing.gap(12)]),
    ),
    section(
        "Group hover",
        // Each tile's × shows while the pointer is anywhere over the tile, or
        // the focus is in it: the overlay is the group, as the × is its layer.
        row(["Notes", "Mail", "Music"].map(fun(name: string): View<Msg> = overlay(
            ui.button_with([text(name)], Msg.Picked("Opened {name}")).style([
                Button.outline(),
                Sizing.min_width(120),
            ]),
            [
                ui.button_with([icon("window-close-symbolic")], Msg.Picked("Closed {name}"))
                    .style([
                        Button.icon(),
                        Button.ghost(),
                        Button.sm(),
                        Effects.opacity(0.0),
                        When(State.GroupHover, [Effects.opacity(1.0)]),
                        When(State.GroupFocusWithin, [Effects.opacity(1.0)]),
                        Motion.opacity(150),
                    ])
                    .tooltip("Close {name}")
                    .place(Align.End, Align.Center),
            ],
        ).style([Group.mark()]))).style([Spacing.gap(8)]),
    ),
    section(
        "Badge",
        row([
            centred(badge("Badge")),
            centred(badge("Secondary").style([Badge.secondary()])),
            centred(badge("Destructive").style([Badge.destructive()])),
            centred(badge("Outline").style([Badge.outline()])),
        ]).style([Spacing.gap(8)]),
    ),
    section(
        "Beside text",
        row([
            centred(text("Inbox")),
            centred(badge("12")),
            centred(text("Build")),
            centred(badge("Passing").style([Badge.secondary()])),
            centred(text("Deploy")),
            centred(badge("Failed").style([Badge.destructive()])),
        ]).style([Spacing.gap(8)]),
    ),
    section(
        "With icons",
        row([
            centred(badge_with([icon("emblem-ok-symbolic"), text("Verified")])),
            centred(
                badge_with([icon("mail-unread-symbolic"), text("3 new")]).style([
                    Badge.secondary(),
                ]),
            ),
            centred(
                badge_with([icon("dialog-warning-symbolic"), text("Expired")]).style([
                    Badge.destructive(),
                ]),
            ),
            centred(badge_with([text("12%"), icon("go-up-symbolic")]).style([Badge.outline()])),
            centred(badge_with([icon("starred-symbolic")]).style([Badge.outline()])),
        ]).style([Spacing.gap(8)]),
    ),
    section(
        "Adjusted",
        row([
            centred(badge("Primary text").style([Badge.outline(), Text.color(Token.Primary)])),
            centred(badge("A pill").style([Border.rounded(999)])),
        ]).style([Spacing.gap(8)]),
    ),
    section(
        "Input",
        row([
            ui.input(m.email, Msg.Email).placeholder("Email"),
            ui.input(m.email, Msg.Email).placeholder("Invalid").style([
                if m.email.contains("@") || m.email == "" { look([]) } else { Input.invalid() },
            ]),
            ui.input("Disabled", Msg.Email).disabled(true),
        ]).style([Spacing.gap(8)]),
    ),
    section(
        "Dialog",
        row([ui.button("Delete project…", Msg.Deleting(true)).style([Button.destructive()])]),
    ),
    section(
        "Sheet",
        row([
            ui.button("Top", Msg.Sheet(0)).style([Button.outline()]),
            ui.button("Right", Msg.Sheet(1)).style([Button.outline()]),
            ui.button("Bottom", Msg.Sheet(2)).style([Button.outline()]),
            ui.button("Left", Msg.Sheet(3)).style([Button.outline()]),
        ]).style([Spacing.gap(8)]),
    ),
    section(
        "Popover",
        row([
            ui.popover(
                ui.button("Dimensions", Msg.Dimensions(!m.dimensions)).style([Button.outline()]),
                m.dimensions,
                column([
                    dialog_header("Dimensions", "Set the dimensions for the layer."),
                    field_horizontal([field_label("Width"), ui.input(m.width, Msg.Width)]),
                    dialog_footer([ui.button("Save", Msg.Picked("Width {m.width}")).style([Button.sm()])]),
                ]).style([Spacing.gap(16)]),
                // A click outside or Escape.
                Msg.Dimensions(false),
            ).align(Align.Center),
        ]),
    ),
    section(
        "Dropdown menu",
        column([
            row([
                ui.dropdown_menu(ui.button("Open", Msg.Picked("")).style([Button.outline()]), [
                    menu_label("My Account"),
                    item("Profile", Msg.Picked("Profile")).hint("Shift+Ctrl+P"),
                    item("Billing", Msg.Picked("Billing")).hint("Ctrl+B"),
                    item("Settings", Msg.Picked("Settings")).hint("Ctrl+S"),
                    menu_separator(),
                    menu_label("Team"),
                    submenu("Invite users", [
                        item("Email", Msg.Picked("Invite by email")),
                        item("Message", Msg.Picked("Invite by message")),
                    ]),
                    item("New team", Msg.Picked("New team")).hint("Ctrl+T"),
                    menu_separator(),
                    item("API", Msg.Picked("API")).disabled(true),
                    item("Log out", Msg.Picked("Log out")),
                ]).align(Align.Center),
                ui.dropdown_menu(ui.button("View", Msg.Picked("")).style([Button.outline()]), [
                    menu_label("Appearance"),
                    check_item("Status bar", m.status_bar, Msg.StatusBar).hint("Ctrl+B"),
                    check_item("Activity bar (locked)", false, Msg.StatusBar).disabled(true),
                    menu_separator(),
                    menu_label("Panel position"),
                    radio_group(m.panel, [
                        ("Top", Msg.Panel("Top")),
                        ("Bottom", Msg.Panel("Bottom")),
                        ("Right", Msg.Panel("Right")),
                    ]),
                ]).align(Align.Center),
                text("Right-click me").style([Text.color(Token.MutedForeground)]).menu([
                    item("Copy", Msg.Picked("Copy")),
                    item("Paste", Msg.Picked("Paste")),
                ]).style([Menu.look()]).align(Align.Center),
            ]).style([Spacing.gap(16)]),
            text(
                "{if m.picked == "" { "Nothing picked yet." } else { "Picked: {m.picked}." }} Status bar {if m.status_bar { "on" } else { "off" }}, panel {m.panel}.",
            ).style([Text.color(Token.MutedForeground)]),
        ]).style([Spacing.gap(12)]),
    ),
];
