// The first app: a name field, a greeting and a counter. Its looks are
// values on the nodes (`.style`); everything it doesn't set is the GTK
// theme's, so it follows light and dark.
import kivuli { View, Font, Text, Weight, Size, Paint, button, column, input, row, sandbox, text };

struct Model {
    count: i64,
    name: string,
}

enum Msg {
    Add,
    Reset,
    Named(string),
}

fun update(m: Model, msg: Msg): Model = match msg {
    Add => Model { count: m.count + 1, ..m },
    Reset => Model { count: 0, ..m },
    Named(name) => Model { name: name, ..m },
};

fun view(m: Model): View<Msg> = column([
    input(m.name, Msg.Named).placeholder("Your name"),
    text("Hello, {m.name}").style([
        Font { size: Size.Pt(18), weight: Weight.Bold, ..Font.theme() },
    ]),
    text("Clicked {m.count} times").style([Text { color: Paint.Faded(0.55), ..Text.theme() }]),
    row([button("Add", Msg.Add), button("Reset", Msg.Reset).disabled(m.count == 0)]).spacing(8),
]).padding(24).spacing(8).window("Hello", 320, 240);

fun main(): i32 = sandbox("org.kivuli.hello", Model { count: 0, name: "" }, update, view);
