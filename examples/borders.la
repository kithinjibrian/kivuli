// A specimen of borders, outlines and spacing: each line style, one side at
// a time, `all` with one side overridden, each radius, padding inside a
// border and margin outside it, exact, minimum and maximum sizes, styles per
// state (hover, press, focus, disabled, checked), and outlines that step
// aside for the theme's focus ring: Tab to an outlined button and its focus
// ring shows instead. Some values are written in full, some with the
// groups' short utilities (`Font.bold()`, `Shadow.md()`).
import kivuli {
    View,
    Background,
    Sizing,
    Edges,
    Spacing,
    Border,
    Side,
    Outline,
    Width,
    Line,
    Radius,
    Paint,
    Font,
    Text,
    Size,
    Weight,
    button,
    column,
    hex,
    sandbox,
    scroll,
    text,
    wrap,
    When,
    State,
    checkbox,
    Shadow,
    Drop,
    Effects,
    Move,
    Image,
};

/** At least `w` by `h` pixels; 0 leaves that way to the theme. */
fun at_least(w: i64, h: i64): Sizing = Sizing {
    min_width: if w > 0 { Width.Px(w) } else { Width.Theme },
    min_height: if h > 0 { Width.Px(h) } else { Width.Theme },
    ..Sizing.theme(),
};

fun heading(s: string): View<()> = text(s).style([Font.size(16), Font.bold()]);

/** A tile with `b` as its border, its label inside. */
fun tile(label: string, b: Border): View<()> = column([
    text(label).style([Font.scale(0.85)]),
]).style([at_least(150, 70)]).style([Spacing.padding(10)]).style([b]);

fun side(n: i64, line: Line): Side = Side {
    width: Width.Px(n),
    color: Paint.Faded(0.6),
    style: line,
};

/** A hairline that follows light and dark. */
fun hairline(): Side = Side { width: Width.Px(1), color: Paint.Faded(0.2), style: Line.Solid };

fun all(s: Side): Border = Border { all: s, ..Border.theme() };

fun view(m: ()): View<()> = scroll(
    column([
        heading("Line styles (all sides, 3 px)"),
        wrap([
            tile("Solid", all(side(3, Line.Solid))),
            tile("Dashed", all(side(3, Line.Dashed))),
            tile("Dotted", all(side(3, Line.Dotted))),
            tile("Double", all(side(4, Line.Double))),
            tile("Groove", all(side(4, Line.Groove))),
            tile("Ridge", all(side(4, Line.Ridge))),
            tile("Inset", all(side(4, Line.Inset))),
            tile("Outset", all(side(4, Line.Outset))),
            tile("Width only: drawn solid", all(Side { width: Width.Px(2), ..Side.theme() })),
        ]).style([Spacing.gap(12)]),
        heading("One side at a time"),
        wrap([
            tile("top", Border { top: side(3, Line.Solid), ..Border.theme() }),
            tile("right", Border { right: side(3, Line.Solid), ..Border.theme() }),
            tile("bottom", Border { bottom: side(3, Line.Solid), ..Border.theme() }),
            tile("left", Border { left: side(3, Line.Solid), ..Border.theme() }),
            tile("all, bottom thicker", Border {
                all: hairline(),
                bottom: Side { width: Width.Px(4), ..Side.theme() },
                ..Border.theme(),
            }),
            tile("all, left red", Border {
                all: hairline(),
                left: Side {
                    width: Width.Px(3),
                    color: Paint.Color(hex("#c0392b")),
                    ..Side.theme(),
                },
                ..Border.theme(),
            }),
        ]).style([Spacing.gap(12)]),
        heading("Corners (a rounded node clips what's inside)"),
        wrap([
            tile("All(12)", Border { all: hairline(), radius: Radius.All(12), ..Border.theme() }),
            tile("Corners(8, 8, 0, 0)", Border {
                all: hairline(),
                radius: Radius.Corners(8, 8, 0, 0),
                ..Border.theme(),
            }),
            tile("Corners(24, 0, 24, 0)", Border {
                all: side(2, Line.Solid),
                radius: Radius.Corners(24, 0, 24, 0),
                ..Border.theme(),
            }),
            tile("All(35): a pill", Border {
                all: hairline(),
                radius: Radius.All(35),
                ..Border.theme(),
            }),
        ]).style([Spacing.gap(12)]),
        heading("Padding and margin"),
    wrap([
        // Padding is inside the border: the text keeps clear of the line.
        column([text("padding 16")]).style([all(hairline()), Spacing.padding(16)]),
        column([text("padding 0")]).style([all(hairline())]),
        // Margin is outside: the dashed box sits 16 px in from its grey frame.
        column([
            column([text("margin 16")]).style([
                all(side(2, Line.Dashed)),
                Spacing { margin: Edges { all: Width.Px(16), ..Edges.theme() }, ..Spacing.theme() },
            ]),
        ]).style([all(hairline())]),
        // A side's own value beats all.
        column([text("all 4, left 32")]).style([
            all(hairline()),
            Spacing { padding: Edges { all: Width.Px(4), left: Width.Px(32), ..Edges.theme() }, ..Spacing.theme() },
        ]),
        // A negative margin pulls a node toward its neighbour.
        column([
            text("above"),
            text("pulled up 6").style([Spacing { margin: Edges { top: Width.Px(-6), ..Edges.theme() }, ..Spacing.theme() }]),
        ]).style([all(hairline()), Spacing.padding(8)]),
    ]).style([Spacing.gap(12)]),
    heading("Sizing (resize the window)"),
    column([
        text("width 320: exactly, however wide the window").style([
            all(hairline()),
            Spacing.padding(8),
            Sizing { width: Width.Px(320), ..Sizing.theme() },
        ]),
        text("max_width 560: a readable column. This text wraps and never runs wider than 560 pixels, so lines stay easy to follow on a wide window.").wrap().style([
            all(hairline()),
            Spacing.padding(8),
            Sizing { max_width: Width.Px(560), ..Sizing.theme() },
        ]),
        text("min_width 200, max_width 400: between the two").style([
            all(hairline()),
            Spacing.padding(8),
            Sizing { min_width: Width.Px(200), max_width: Width.Px(400), ..Sizing.theme() },
        ]),
        text("min_height 60: at least").style([all(hairline()), Spacing.padding(8), at_least(0, 60)]),
    ]).style([Spacing.gap(12)]),
    heading("States (hover, press, Tab to focus)"),
    wrap([
        button("Hover and press me", ()).style([
            Background.color(hex("#2a5298")),
            Text.color(hex("#ffffff")),
            When(State.Hover, [Background.color(hex("#3a62a8"))]),
            When(State.Press, [Background.color(hex("#1e3c72"))]),
            When(State.Focus, [
                Outline { width: Width.Px(2), color: Paint.Color(hex("#ffffff")), style: Line.Solid, offset: -4 },
            ]),
        ]),
        button("Bold on hover", ()).style([When(State.Hover, [Font.bold()])]),
        button("Disabled: faded", ()).disabled(true).style([
            When(State.Disabled, [Text { color: Paint.Faded(0.4), ..Text.theme() }, Border { all: side(1, Line.Dashed), ..Border.theme() }]),
        ]),
        checkbox("Ticked: green", true, fun(b: bool) = ()).style([
            When(State.Checked, [Text.color(hex("#27ae60"))]),
        ]),
    ]).style([Spacing.gap(16)]),
    heading("Shadows and effects (hover the tile)"),
    wrap([
        column([text("A card lifted off the page")]).style([
            Spacing.padding(16),
            Border { radius: Radius.All(12), ..Border.theme() },
            Background { color: Paint.Color(hex("#ffffff")), ..Background.theme() },
            Text { color: Paint.Color(hex("#222222")), ..Text.theme() },
            Shadow { boxes: [
                Drop { y: 8, blur: 24, color: Paint.Color(hex("#00000026")), ..Drop.theme() },
                Drop { y: 1, blur: 2, color: Paint.Color(hex("#00000033")), ..Drop.theme() },
            ], ..Shadow.theme() },
        ]),
        button("Grows on hover", ()).style([
            When(State.Hover, [
                Effects { transform: [Move.Scale(1.08)], ..Effects.theme() },
                Shadow { boxes: [Drop { y: 4, blur: 12, color: Paint.Color(hex("#00000040")), ..Drop.theme() }], ..Shadow.theme() },
            ]),
        ]),
        column([text("Shadow.md(), in one line")]).style([
            Spacing.padding(16),
            Border.rounded(12),
            Background.color(hex("#ffffff")),
            Text.color(hex("#222222")),
            Shadow.md(),
        ]),
        button("No theme shadow", ()).style([Shadow.off()]),
        text("Text with a shadow").style([
            Font { size: Size.Pt(18), weight: Weight.Bold, ..Font.theme() },
            Shadow { text: [Drop { x: 1, y: 2, blur: 3, color: Paint.Faded(0.5), ..Drop.theme() }], ..Shadow.theme() },
        ]),
        text("Half see-through").style([Effects.opacity(0.5)]),
        column([]).style([at_least(80, 60), Background { image: Some(Image.File("examples/assets/sample.png")), ..Background.theme() }, Effects.grayscale()]),
        column([]).style([at_least(80, 60), Background { image: Some(Image.File("examples/assets/sample.png")), ..Background.theme() }, Effects.blur(3)]),
        text("Tilted").style([Effects.rotate(-8)]),
    ]).style([Spacing.gap(24)]),
    heading("Outlines (Tab to the buttons: the focus ring shows instead)"),
        wrap([
            button("Outlined, offset 2", ()).style([
                Outline {
                    width: Width.Px(2),
                    color: Paint.Color(hex("#2a5298")),
                    style: Line.Solid,
                    offset: 2,
                },
            ]),
            button("Dashed, offset 4", ()).style([
                Outline {
                    width: Width.Px(2),
                    color: Paint.Color(hex("#c0392b")),
                    style: Line.Dashed,
                    offset: 4,
                },
            ]),
            button("Inside: offset -4", ()).style([
                Outline {
                    width: Width.Px(1),
                    color: Paint.Faded(0.6),
                    style: Line.Dotted,
                    offset: -4,
                },
            ]),
        ]).style([Spacing.gap(16)]),
    ]).style([Spacing.gap(12), Spacing.padding(24)]),
).window("Borders", 720, 760);

fun main(): i32 = sandbox("org.kivuli.borders", (), fun(m: (), msg: ()): () = (), view);
