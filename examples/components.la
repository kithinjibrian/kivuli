// kivuli.ui's components, one at a time as they arrive: today the badge in
// each variant, beside text, with icons and on a card, in light and dark and in each
// palette.
import kivuli {
    View,
    Align,
    Token,
    Palette,
    Scheme,
    Background,
    Border,
    Font,
    Shadow,
    Spacing,
    Text,
    button,
    column,
    icon,
    row,
    sandbox,
    text,
};
import kivuli.ui { badge, badge_with, Badge };

struct Model {
    dark: bool,
    base: i64,
}

enum Msg {
    Dark(bool),
    Base(i64),
}

fun update(m: Model, msg: Msg): Model = match msg {
    Dark(on) => Model { dark: on, ..m },
    Base(n) => Model { base: n, ..m },
};

fun palette_of(n: i64): Palette = if n == 1 {
    Palette.slate()
} else if n == 2 {
    Palette.stone()
} else if n == 3 {
    Palette.zinc().radius(4)
} else {
    Palette.zinc()
};

/** A section's heading and what it shows. */
fun section(title: string, body: View<Msg>): View<Msg> = column([
    text(title).style([Font.sm(), Font.medium(), Text.color(Token.MutedForeground)]),
    body,
]).style([Spacing.gap(8)]);

fun centred(v: View<Msg>): View<Msg> = v.align(Align.Center);

fun view(m: Model): View<Msg> = column([
    text("Components").style([Font.h2()]),
    row([
        button(if m.dark { "Light" } else { "Dark" }, Msg.Dark(!m.dark)),
        button("Zinc", Msg.Base(0)),
        button("Slate", Msg.Base(1)),
        button("Stone", Msg.Base(2)),
        button("Radius 4", Msg.Base(3)),
    ]).style([Spacing.gap(8)]),
    section(
        "Badge",
        row([
            centred(badge("Badge")),
            centred(badge("Secondary").style([Badge.secondary()])),
            centred(badge("Destructive").style([Badge.destructive()])),
            centred(badge("Outline").style([Badge.outline()])),
        ]).style([Spacing.gap(8)]),
    ),
    section(
        "Beside text",
        row([
            centred(text("Inbox")),
            centred(badge("12")),
            centred(text("Build")),
            centred(badge("Passing").style([Badge.secondary()])),
            centred(text("Deploy")),
            centred(badge("Failed").style([Badge.destructive()])),
        ]).style([Spacing.gap(8)]),
    ),
    section(
        "With icons",
        row([
            centred(badge_with([icon("emblem-ok-symbolic"), text("Verified")])),
            centred(
                badge_with([icon("mail-unread-symbolic"), text("3 new")]).style([
                    Badge.secondary(),
                ]),
            ),
            centred(
                badge_with([icon("dialog-warning-symbolic"), text("Expired")]).style([
                    Badge.destructive(),
                ]),
            ),
            centred(badge_with([text("12%"), icon("go-up-symbolic")]).style([Badge.outline()])),
            centred(badge_with([icon("starred-symbolic")]).style([Badge.outline()])),
        ]).style([Spacing.gap(8)]),
    ),
    section(
        "Adjusted",
        row([
            centred(badge("Primary text").style([Badge.outline(), Text.color(Token.Primary)])),
            centred(badge("A pill").style([Border.rounded(999)])),
        ]).style([Spacing.gap(8)]),
    ),
    column([
        row([
            centred(text("Pro plan").style([Font.heading()])),
            centred(badge("Current").style([Badge.secondary()])),
        ]).style([Spacing.gap(8)]),
        text("12 of 20 seats used").style([Text.color(Token.MutedForeground)]),
    ]).style([
        Background.color(Token.Card),
        Text.color(Token.CardForeground),
        Border.all(1, Token.Border),
        Border.rounded_lg(),
        Spacing.padding(20),
        Spacing.gap(6),
        Shadow.sm(),
    ]),
]).style([Spacing.padding(32), Spacing.gap(20)]).palette(palette_of(m.base)).scheme(
    if m.dark { Scheme.Dark } else { Scheme.Light },
).window("Components", 640, 560);

fun main(): i32 = sandbox("org.kivuli.components", Model { dark: false, base: 0 }, update, view);
