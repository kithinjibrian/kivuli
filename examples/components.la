// kivuli.ui's components, one at a time as they arrive: the button in each
// variant and size (Tab through them for the focus ring), the input (type
// in it for its ring; no "@" marks it invalid), the badge in each variant,
// and cards, in light and dark and in each palette.
import kivuli {
    View,
    Align,
    Token,
    Palette,
    Scheme,
    look,
    Background,
    Border,
    Font,
    Shadow,
    Spacing,
    Text,
    button,
    checkbox,
    column,
    submenu,
    menu_separator,
    menu_label,
    item,
    dropdown,
    icon,
    input,
    Sizing,
    row,
    scroll,
    slider,
    switch,
    sandbox,
    text,
};
import kivuli.ui {
    badge,
    badge_with,
    Badge,
    Button,
    Input,
    card,
    card_header,
    card_header_with,
    card_content,
    card_footer,
    field,
    field_horizontal,
    field_label,
    field_description,
    field_error,
    field_group,
    Field,
    input_group,
    group_input,
    group_text,
    group_button,
    group_button_with,
    InputGroup,
    separator_with,
    Dropdown,
    tab,
    tab_with,
    Menu,
};

struct Model {
    dark: bool,
    base: i64,
    email: string,
    password: string,
    user: string,
    same: bool,
    volume: i64,
    fruit: string,
    airplane: bool,
    tab: i64,
    picked: string,
}

enum Msg {
    Dark(bool),
    Base(i64),
    Email(string),
    Password(string),
    User(string),
    Same(bool),
    Volume(i64),
    Fruit(string),
    Airplane(bool),
    Tab(i64),
    Picked(string),
}

fun update(m: Model, msg: Msg): Model = match msg {
    Dark(on) => Model { dark: on, ..m },
    Base(n) => Model { base: n, ..m },
    Email(s) => Model { email: s, ..m },
    Password(s) => Model { password: s, ..m },
    User(s) => Model { user: s, ..m },
    Same(b) => Model { same: b, ..m },
    Volume(n) => Model { volume: n, ..m },
    Fruit(f) => Model { fruit: f, ..m },
    Airplane(b) => Model { airplane: b, ..m },
    Tab(n) => Model { tab: n, ..m },
    Picked(what) => Model { picked: what, ..m },
};

fun palette_of(n: i64): Palette = if n == 1 {
    Palette.slate()
} else if n == 2 {
    Palette.stone()
} else if n == 3 {
    Palette.zinc().radius(4)
} else {
    Palette.zinc()
};

/** A section's heading and what it shows. */
fun section(title: string, body: View<Msg>): View<Msg> = column([
    text(title).style([Font.sm(), Font.medium(), Text.color(Token.MutedForeground)]),
    body,
]).style([Spacing.gap(8)]);

fun centred(v: View<Msg>): View<Msg> = v.align(Align.Center);

fun view(m: Model): View<Msg> = scroll(page(m)).palette(palette_of(m.base)).scheme(
    if m.dark { Scheme.Dark } else { Scheme.Light },
).window("Components", 760, 720);

/** The fruit drop-downs' choices. */
fun fruits(): (string, Msg)[] = ["Apple", "Banana", "Blueberry", "Grapes", "Pineapple"].map(
    fun(f: string) = (f, Msg.Fruit(f)),
);

/** Every component, top to bottom; the window scrolls through it. */
fun page(m: Model): View<Msg> = column([
    text("Components").style([Font.h2()]),
    row([
        button(if m.dark { "Light" } else { "Dark" }, Msg.Dark(!m.dark)),
        button("Zinc", Msg.Base(0)),
        button("Slate", Msg.Base(1)),
        button("Stone", Msg.Base(2)),
        button("Radius 4", Msg.Base(3)),
    ]).style([Spacing.gap(8)]),
    section(
        "Button",
        column([
            row([
                centred(ui.button("Button", Msg.Base(m.base))),
                centred(ui.button("Secondary", Msg.Base(m.base)).style([Button.secondary()])),
                centred(ui.button("Destructive", Msg.Base(m.base)).style([Button.destructive()])),
                centred(ui.button("Outline", Msg.Base(m.base)).style([Button.outline()])),
                centred(ui.button("Ghost", Msg.Base(m.base)).style([Button.ghost()])),
                centred(ui.button("Link", Msg.Base(m.base)).style([Button.link()])),
            ]).style([Spacing.gap(8)]),
            row([
                centred(ui.button("Small", Msg.Base(m.base)).style([Button.sm()])),
                centred(ui.button("Default", Msg.Base(m.base))),
                centred(ui.button("Large", Msg.Base(m.base)).style([Button.lg()])),
                centred(ui.button_with([icon("list-add-symbolic"), text("New")], Msg.Base(m.base))),
                centred(
                    ui.button_with(
                        [text("Next"), icon("go-next-symbolic")],
                        Msg.Base(m.base),
                    ).style([Button.outline()]),
                ),
                centred(
                    ui.button_with([icon("open-menu-symbolic")], Msg.Base(m.base)).style([
                        Button.icon(),
                        Button.outline(),
                    ]),
                ),
                centred(
                    ui.button_with([icon("edit-delete-symbolic")], Msg.Base(m.base)).style([
                        Button.icon(),
                        Button.ghost(),
                    ]),
                ),
            ]).style([Spacing.gap(8)]),
            row([
                centred(ui.button("Disabled", Msg.Base(m.base)).disabled(true)),
                centred(
                    ui.button("Disabled", Msg.Base(m.base)).style([Button.outline()]).disabled(
                        true,
                    ),
                ),
                centred(button("Native GTK", Msg.Base(m.base))),
            ]).style([Spacing.gap(8)]),
        ]).style([Spacing.gap(12)]),
    ),
    section(
        "Badge",
        row([
            centred(badge("Badge")),
            centred(badge("Secondary").style([Badge.secondary()])),
            centred(badge("Destructive").style([Badge.destructive()])),
            centred(badge("Outline").style([Badge.outline()])),
        ]).style([Spacing.gap(8)]),
    ),
    section(
        "Beside text",
        row([
            centred(text("Inbox")),
            centred(badge("12")),
            centred(text("Build")),
            centred(badge("Passing").style([Badge.secondary()])),
            centred(text("Deploy")),
            centred(badge("Failed").style([Badge.destructive()])),
        ]).style([Spacing.gap(8)]),
    ),
    section(
        "With icons",
        row([
            centred(badge_with([icon("emblem-ok-symbolic"), text("Verified")])),
            centred(
                badge_with([icon("mail-unread-symbolic"), text("3 new")]).style([
                    Badge.secondary(),
                ]),
            ),
            centred(
                badge_with([icon("dialog-warning-symbolic"), text("Expired")]).style([
                    Badge.destructive(),
                ]),
            ),
            centred(badge_with([text("12%"), icon("go-up-symbolic")]).style([Badge.outline()])),
            centred(badge_with([icon("starred-symbolic")]).style([Badge.outline()])),
        ]).style([Spacing.gap(8)]),
    ),
    section(
        "Adjusted",
        row([
            centred(badge("Primary text").style([Badge.outline(), Text.color(Token.Primary)])),
            centred(badge("A pill").style([Border.rounded(999)])),
        ]).style([Spacing.gap(8)]),
    ),
    section(
        "Input",
        row([
            ui.input(m.email, Msg.Email).placeholder("Email"),
            ui.input(m.email, Msg.Email).placeholder("Invalid").style([
                if m.email.contains("@") || m.email == "" { look([]) } else { Input.invalid() },
            ]),
            ui.input("Disabled", Msg.Email).disabled(true),
        ]).style([Spacing.gap(8)]),
    ),
    section(
        "Dropdown menu",
        column([
            row([
                ui.dropdown_menu(ui.button("Open", Msg.Picked("")).style([Button.outline()]), [
                    menu_label("My Account"),
                    item("Profile", Msg.Picked("Profile")).hint("Shift+Ctrl+P"),
                    item("Billing", Msg.Picked("Billing")).hint("Ctrl+B"),
                    item("Settings", Msg.Picked("Settings")).hint("Ctrl+S"),
                    menu_separator(),
                    menu_label("Team"),
                    submenu("Invite users", [
                        item("Email", Msg.Picked("Invite by email")),
                        item("Message", Msg.Picked("Invite by message")),
                    ]),
                    item("New team", Msg.Picked("New team")).hint("Ctrl+T"),
                    menu_separator(),
                    item("API", Msg.Picked("API")).disabled(true),
                    item("Log out", Msg.Picked("Log out")),
                ]).align(Align.Center),
                text("Right-click me").style([Text.color(Token.MutedForeground)]).menu([
                    item("Copy", Msg.Picked("Copy")),
                    item("Paste", Msg.Picked("Paste")),
                ]).style([Menu.look()]).align(Align.Center),
            ]).style([Spacing.gap(16)]),
            text(if m.picked == "" { "Nothing picked yet." } else { "Picked: {m.picked}" }).style([
                Text.color(Token.MutedForeground),
            ]),
        ]).style([Spacing.gap(12)]),
    ),
    section(
        "Tabs",
        column([
            ui.tabs(
                [
                    tab("Account", Msg.Tab(0)),
                    tab("Password", Msg.Tab(1)),
                    tab("Notifications", Msg.Tab(2)),
                ],
                m.tab,
            ),
            card([
                if m.tab == 0 {
                    card_header("Account", "Make changes to your account here.")
                } else if m.tab == 1 {
                    card_header("Password", "Change your password here.")
                } else {
                    card_header("Notifications", "Choose what we tell you about.")
                },
            ]),
            ui.tabs_line(
                [
                    tab("Overview", Msg.Tab(0)),
                    tab("Analytics", Msg.Tab(1)),
                    tab("Reports", Msg.Tab(2)).disabled(true),
                ],
                m.tab,
            ),
            ui.tabs(
                [
                    tab_with([icon("view-reveal-symbolic"), text("Preview")], Msg.Tab(0)),
                    tab_with([icon("text-x-generic-symbolic"), text("Code")], Msg.Tab(1)),
                ],
                m.tab,
            ),
        ]).style([Spacing.gap(16), Sizing.max_width(480)]),
    ),
    section(
        "Switch",
        column([
            field_horizontal([ui.switch(m.airplane, Msg.Airplane), field_label("Airplane mode")]),
            field_horizontal([
                ui.switch(!m.airplane, fun(b: bool) = Msg.Airplane(!b)).disabled(m.airplane),
                field_label("Wi-Fi (off in airplane mode)"),
            ]),
            field_horizontal([
                switch(m.airplane, Msg.Airplane),
                field_label("A native switch, for comparison"),
            ]),
        ]).style([Spacing.gap(12)]),
    ),
    section(
        "Checkbox",
        column([
            ui.checkbox("Accept terms and conditions", m.same, Msg.Same),
            ui.checkbox("Send me product updates", !m.same, fun(b: bool) = Msg.Same(!b)),
            ui.checkbox(
                "Disabled while the box above is ticked",
                false,
                fun(b: bool) = Msg.Same(!m.same),
            ).disabled(m.same),
            field_horizontal([checkbox("A native check box, for comparison", m.same, Msg.Same)]),
        ]).style([Spacing.gap(12)]),
    ),
    section(
        "Dropdown",
        column([
            ui.dropdown(fruits(), m.fruit, "Select a fruit").style([Sizing.width(220)]),
            field([
                field_label("Fruit"),
                ui.dropdown(fruits(), m.fruit, "Select a fruit").style([
                    if m.fruit == "" { Dropdown.invalid() } else { look([]) },
                ]),
                if m.fruit == "" {
                    field_error("Please select a fruit.")
                } else {
                    field_description("You picked {m.fruit}.")
                },
            ]).style([if m.fruit == "" { Field.invalid() } else { look([]) }]),
            dropdown(fruits(), m.fruit),
        ]).style([Spacing.gap(16), Sizing.max_width(420)]),
    ),
    section(
        "Slider",
        column([
            row([
                text("Volume").style([Font.medium()]).align(Align.Center),
                ui.slider(0, 100, m.volume, Msg.Volume).expand(),
                text("{m.volume}").style([Text.color(Token.MutedForeground)]).align(Align.Center),
            ]).style([Spacing.gap(12)]),
            ui.slider(0, 100, m.volume, Msg.Volume).disabled(m.same),
            slider(0, 100, m.volume, Msg.Volume),
        ]).style([Spacing.gap(16), Sizing.max_width(420)]),
    ),
    section(
        "Separator",
        column([
            text("kivuli.ui").style([Font.medium()]),
            text("Components drawn from the palette's tokens.").style([
                Text.color(Token.MutedForeground),
            ]),
            ui.separator(),
            row([text("Blog"), ui.separator(), text("Docs"), ui.separator(), text("Source")]).style(
                [Spacing.gap(12)],
            ),
            separator_with("Or continue with"),
        ]).style([Spacing.gap(12), Sizing.max_width(420)]),
    ),
    section(
        "Input group",
        column([
            input_group(
                [icon("system-search-symbolic")],
                group_input(m.user, Msg.User).placeholder("Search…"),
                [],
            ),
            input_group(
                [group_text("https://")],
                group_input(m.user, Msg.User).placeholder("example"),
                [group_text(".com")],
            ),
            input_group([], group_input(m.user, Msg.User).placeholder("Find a component"), [
                group_button("Search", Msg.Base(m.base)),
            ]),
            input_group([], group_input(m.password, Msg.Password).placeholder("Password"), [
                group_button_with([icon("view-reveal-symbolic")], Msg.Base(m.base)),
            ]),
            input_group([group_text("$")], group_input(m.user, Msg.User).placeholder("0.00"), [
                group_text("USD"),
            ]).style([
                if m.user.len > 0 && m.user.contains("x") {
                    InputGroup.invalid()
                } else {
                    look([])
                },
            ]),
        ]).style([Spacing.gap(12), Sizing.max_width(420)]),
    ),
    section(
        "Field",
        field_group([
            field([
                field_label("Username"),
                ui.input(m.user, Msg.User),
                field_description("Choose a unique username for your account."),
            ]),
            if m.password.len > 0 && m.password.len < 8 {
                field([
                    field_label("Password"),
                    ui.input(m.password, Msg.Password).style([Input.invalid()]),
                    field_error("Must be at least 8 characters."),
                ]).style([Field.invalid()])
            } else {
                field([
                    field_label("Password"),
                    ui.input(m.password, Msg.Password),
                    field_description("At least 8 characters."),
                ])
            },
            field_horizontal([ui.checkbox("Same as shipping address", m.same, Msg.Same)]),
        ]).style([Sizing.max_width(420)]),
    ),
    section(
        "Card",
        row([
            card([
                card_header("Login to your account", "Enter your email below to log in"),
                card_content([
                    field_group([
                        field([
                            field_label("Email"),
                            ui.input(m.email, Msg.Email).placeholder("m@example.com"),
                        ]),
                        field([field_label("Password"), ui.input(m.password, Msg.Password)]),
                    ]),
                ]),
                card_footer([
                    ui.button("Login", Msg.Base(m.base)),
                    ui.button("Login with Google", Msg.Base(m.base)).style([Button.outline()]),
                ]),
            ]).style([Sizing.width(340)]),
            column([
                card([
                    card_header_with(
                        "Design systems meetup",
                        "A practical talk on component APIs",
                        badge("Featured").style([Badge.secondary()]),
                    ),
                    card_content([text("Thursday, 6 pm · Room 2")]),
                ]),
                card([
                    card_header("Terms of Service", ""),
                    card_content([
                        text(
                            "By using this app you agree to keep your password to yourself and your shortcuts tidy.",
                        ).wrap(),
                    ]),
                    card_footer([
                        ui.button("Accept", Msg.Base(m.base)),
                        ui.button("Decline", Msg.Base(m.base)).style([Button.outline()]),
                    ]),
                ]),
            ]).style([Spacing.gap(16)]).expand(),
        ]).style([Spacing.gap(16)]),
    ),
]).style([Spacing.padding(32), Spacing.gap(20)]);

fun main(): i32 = sandbox(
    "org.kivuli.components",
    Model {
        dark: false,
        base: 0,
        email: "",
        password: "",
        user: "",
        same: true,
        volume: 40,
        fruit: "",
        airplane: false,
        tab: 0,
        picked: "",
    },
    update,
    view,
);
