// kivuli.ui's components, one at a time as they arrive: the button in each
// variant and size (Tab through them for the focus ring), the input (type
// in it for its ring; no "@" marks it invalid), the badge in each variant,
// and cards, in light and dark and in each palette.
// Its sections are in examples/gallery/.
import kivuli {
    View,
    Scheme,
    Font,
    Spacing,
    button,
    column,
    header_bar,
    row,
    scroll,
    sandbox,
    text,
};
import kivuli.ui { Tooltip, WindowControls };
import gallery.state { Model, Msg, update, palette_of };
import gallery.actions { sections as action_sections, delete_dialog, edit_sheet };
import gallery.choices { sections as choice_sections };
import gallery.display { sections as display_sections };

fun view(m: Model): View<Msg> = scroll(page(m))
    // A dialog or a sheet over the whole page while the model says so.
    .dialog(if m.deleting {
        Some(delete_dialog())
    } else if m.sheet >= 0 {
        Some(edit_sheet(m))
    } else {
        None
    })
    .palette(palette_of(m.base))
    .scheme(if m.dark { Scheme.Dark } else { Scheme.Light })
    // Every tooltip in the app, in the palette's look.
    .style([Tooltip.look()])
    .window("Components", 760, 720)
    // GTK's window controls as ghost buttons in the palette's colours.
    .header(header_bar([], text("Components").style([Font.semibold()]), []).style([WindowControls.look()]));

/** Every component, top to bottom; the window scrolls through it. */
fun page(m: Model): View<Msg> = column([
    text("Components").style([Font.h2()]),
    row([
        button(if m.dark { "Light" } else { "Dark" }, Msg.Dark(!m.dark)),
        button("Zinc", Msg.Base(0)),
        button("Slate", Msg.Base(1)),
        button("Stone", Msg.Base(2)),
        button("Radius 4", Msg.Base(3)),
    ]).style([Spacing.gap(8)]),
    column(action_sections(m)).style([Spacing.gap(20)]),
    column(choice_sections(m)).style([Spacing.gap(20)]),
    column(display_sections(m)).style([Spacing.gap(20)]),
]).style([Spacing.padding(32), Spacing.gap(20)]);

fun main(): i32 = sandbox(
    "org.kivuli.components",
    Model {
        dark: false,
        base: 0,
        email: "",
        password: "",
        user: "",
        same: true,
        volume: 40,
        fruit: "",
        airplane: false,
        tab: 0,
        picked: "",
        status_bar: true,
        panel: "Bottom",
        deleting: false,
        sheet: -1,
        dimensions: false,
        width: "100%",
        rows: 3,
    },
    update,
    view,
);
