// A counter written with kivuli: a model, the messages that change it, and a
// view of it. No widget is touched by hand.
import kivuli.ui { View, text, button, column, sandbox };

struct Model {
    count: i64,
}

enum Msg {
    Add,
    Reset,
}

fun update(m: Model, msg: Msg): Model = match msg {
    Add => Model { count: m.count + 1 },
    Reset => Model { count: 0 },
};

fun view(m: Model): View<Msg> = column([
    text("Clicked {m.count} times"),
    button("Add", Msg.Add),
    button("Reset", Msg.Reset),
    text("Kithinji brian"),
]);

fun main(): i32 = sandbox("org.kivuli.counter", Model { count: 0 }, update, view);
