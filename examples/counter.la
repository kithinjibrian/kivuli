// A counter written with kivuli: a model, the messages that change it, and a
// view of it. No widget is touched by hand.
import kivuli { View, text, button, column, row, input, checkbox, separator, sandbox, ButtonStyle };

struct Model {
    count: i64,
    name: string,
    by_two: bool,
}

enum Msg {
    Add,
    Reset,
    Named(string),
    ByTwo(bool),
}

// How much Add adds.
fun step(m: Model): i64 = if m.by_two { 2 } else { 1 };

fun update(m: Model, msg: Msg): Model = match msg {
    Add => Model { count: m.count + step(m), ..m },
    Reset => Model { count: 0, ..m },
    Named(name) => Model { name: name, ..m },
    ByTwo(on) => Model { by_two: on, ..m },
};

fun view(m: Model): View<Msg> = column([
    input(m.name, Msg.Named).placeholder("Your name"),
    text("Hello, {m.name}").bold().size(16),
    text("Clicked {m.count} times"),
    row([
        button("Add", Msg.Add).button_style(ButtonStyle.Primary),
        button("Reset", Msg.Reset).button_style(ButtonStyle.Danger).disabled(m.count == 0),
    ]).spacing(8),
    checkbox("Count by two", m.by_two, Msg.ByTwo),
    separator(),
    text("Kithinji brian").dim(),
]).padding(24).spacing(8);

fun main(): i32 = sandbox(
    "org.kivuli.counter",
    Model { count: 0, name: "", by_two: false },
    update,
    view,
);
