// A to-do list: add with Enter, Ctrl+N or the button; tick, delete (from a
// row's ✕ or its right-click menu), filter, and clear what's done. Rows are
// keyed (moves and deletes touch only those widgets) and lazy (a row is
// rebuilt only when its title or state changes). Its tests are at the
// bottom: `lughac test examples/tasks.la`.
import kivuli {
    Align,
    Width,
    Edges,
    Spacing,
    View,
    Font,
    Text,
    Size,
    Weight,
    Paint,
    Decoration,
    button,
    checkbox,
    column,
    input,
    item,
    keyed_column,
    lazy,
    row,
    sandbox,
    scroll,
    separator,
    spacer,
    text,
};
// For the tests at the bottom; `lughac build` leaves tests out.
import kivuli.testing {
    Lookup,
    click,
    is_disabled,
    pick,
    press,
    submit,
    texts,
    toggle,
    tooltip,
    type_into,
};

/** The same room on every side, inside the node. */
fun pad(n: i64): Spacing = Spacing {
    padding: Edges { all: Width.Px(n), ..Edges.theme() },
    ..Spacing.theme(),
};

/** Room between a column's, row's or wrap's children. */
fun gap(n: i64): Spacing = Spacing { gap: Width.Px(n), ..Spacing.theme() };

struct Todo {
    id: i64,
    title: string,
    done: bool,
}

enum Filter {
    All,
    Active,
    Done,
}

struct Model {
    todos: Todo[],
    draft: string,
    filter: Filter,
    /** The id the next task gets: ids are never reused, so keys stay unique. */
    next: i64,
}

enum Msg {
    Draft(string),
    Add,
    Toggle(i64, bool),
    Delete(i64),
    Show(Filter),
    ClearDone,
}

fun update(m: Model, msg: Msg): Model = match msg {
    Draft(s) => Model { draft: s, ..m },
    Add => {
        let title = m.draft.trim();
        if title == "" {
            m
        } else {
            let mut todos = m.todos;
            todos.push(Todo { id: m.next, title: title, done: false });
            Model { todos: todos, draft: "", next: m.next + 1, ..m }
        }
    }
    Toggle(id, done) => Model {
        todos: m.todos.map(fun(t) = if t.id == id { Todo { done: done, ..t } } else { t }),
        ..m,
    },
    Delete(id) => Model { todos: m.todos.filter(fun(t) = t.id != id), ..m },
    Show(filter) => Model { filter: filter, ..m },
    ClearDone => Model { todos: m.todos.filter(fun(t) = !t.done), ..m },
};

fun shown(t: Todo, filter: Filter): bool = match filter {
    All => true,
    Active => !t.done,
    Done => t.done,
};

fun left(m: Model): i64 = m.todos.filter(fun(t) = !t.done).len;

fun items(n: i64): string = if n == 1 { "1 item" } else { "{n} items" };

/** Greyed text: the theme's text colour, faded. */
fun dim(): Text = Text { color: Paint.Faded(0.55), ..Text.theme() };

fun view(m: Model): View<Msg> = column([
    text("To-do").style([Font { size: Size.Pt(22), weight: Weight.Bold, ..Font.theme() }]),
    row([
        input(m.draft, Msg.Draft).placeholder("What needs doing?").on_submit(
            Msg.Add,
        ).autofocus().expand(),
        button("Add", Msg.Add).shortcut("Ctrl+N").disabled(m.draft.trim() == ""),
    ]).style([gap(8)]),
    row([
        tab("All", Filter.All, m.filter),
        tab("Active", Filter.Active, m.filter),
        tab("Done", Filter.Done, m.filter),
    ]).style([gap(4)]),
    separator(),
    list(m),
    separator(),
    row([
        text("{items(left(m))} left").style([dim()]).align(Align.Center),
        spacer(),
        button("Clear done", Msg.ClearDone).shortcut("Ctrl+Shift+Delete").disabled(
            !m.todos.any(fun(t) = t.done),
        ),
    ]),
]).style([pad(20), gap(12)]).window("To-do — {left(m)} left", 420, 560);

// The filter shown now has nothing to do when clicked: it's disabled (no message).
fun tab(label: string, filter: Filter, current: Filter): View<Msg> = button(
    label,
    Msg.Show(filter),
).disabled(filter == current);

fun list(m: Model): View<Msg> {
    let visible = m.todos.filter(fun(t) = shown(t, m.filter));
    if visible.len == 0 {
        let message = if m.todos.len == 0 { "Nothing to do yet" } else { "Nothing here" };
        return column([
            spacer(),
            text(message).style([dim()]).align(Align.Center),
            spacer(),
        ]).expand();
    }
    scroll(keyed_column(visible.map(fun(t) = ("{t.id}", todo_row(t)))).style([gap(4)]))
}

// Lazy: rebuilt only when the key (everything the row shows) changes.
fun todo_row(t: Todo): View<Msg> = lazy(
    "{t.id}:{t.done}:{t.title}",
    fun(): View<Msg> = row([
        // A long title is cut with "…" and shown whole on hover; a done one is struck through.
        checkbox(t.title, t.done, fun(on: bool) = Msg.Toggle(t.id, on)).ellipsize().tooltip(t.title).style(
            if t.done { [Text { decoration: Decoration.Strikethrough, ..dim() }] } else { [] },
        ).expand(),
        button("✕", Msg.Delete(t.id)).tooltip("Delete {t.title}"),
    ]).style([gap(8)]).name("row {t.title}").menu([
        item(if t.done { "Mark as not done" } else { "Mark as done" }, Msg.Toggle(t.id, !t.done)),
        item("Delete", Msg.Delete(t.id)),
    ]),
);

fun start(): Model = Model { todos: [], draft: "", filter: Filter.All, next: 1 };

fun main(): i32 = sandbox("org.kivuli.tasks", start(), update, view);

// Tests: what a user does, worked out from the view by kivuli.testing and fed
// back through `update`, with no window.

fun after(msgs: Msg[]): Model {
    let mut m = start();
    for msg of msgs {
        m = update(m, msg);
    }
    m
}

// Types `title` into the new-task field and presses Enter.
fun add(m: Model, title: string): Model {
    let typed = update(m, type_into(view(m), "What needs doing?", title).unwrap_or(Msg.Draft("")));
    update(typed, submit(view(typed), "What needs doing?").unwrap_or(Msg.Draft("")))
}

@test
fun typing_and_enter_add_a_task() {
    let m = add(start(), "  milk ");
    assert_eq(m.todos.map(fun(t) = t.title), ["milk"]);
    assert_eq(m.draft, "");
    assert_eq(texts(view(m)), ["To-do", "1 item left"]);
}

@test
fun add_is_disabled_while_the_draft_is_blank() {
    assert_eq(is_disabled(view(start()), "Add"), Ok(true));
    assert_eq(is_disabled(view(after([Msg.Draft("   ")])), "Add"), Ok(true));
    assert_eq(click(view(after([Msg.Draft("eggs")])), "Add"), Ok(Msg.Add));
}

@test
fun ticking_a_task_and_clearing_what_is_done() {
    let m = add(add(start(), "milk"), "eggs");
    assert_eq(is_disabled(view(m), "Clear done"), Ok(true));
    let ticked = update(m, toggle(view(m), "milk").unwrap_or(Msg.Draft("")));
    assert_eq(texts(view(ticked)), ["To-do", "1 item left"]);
    let cleared = update(ticked, click(view(ticked), "Clear done").unwrap_or(Msg.Draft("")));
    assert_eq(cleared.todos.map(fun(t) = t.title), ["eggs"]);
}

@test
fun filters_show_only_their_tasks_and_the_current_one_is_disabled() {
    let m = update(add(add(start(), "milk"), "eggs"), Msg.Toggle(1, true));
    assert_eq(is_disabled(view(m), "All"), Ok(true));
    let active = update(m, click(view(m), "Active").unwrap_or(Msg.Draft("")));
    assert_eq(toggle(view(active), "milk"), Err(Lookup.NotFound("check box \"milk\"")));
    assert_eq(toggle(view(active), "eggs"), Ok(Msg.Toggle(2, true)));
    let done = update(active, Msg.Show(Filter.Done));
    assert_eq(toggle(view(done), "milk"), Ok(Msg.Toggle(1, false)));
}

@test
fun deleting_a_task_by_its_button_or_its_menu() {
    let m = add(add(start(), "milk"), "eggs");
    // Each row has its own ✕: its tooltip says which task it deletes.
    assert_eq(click(view(m), "✕"), Err(Lookup.Ambiguous("button \"✕\"", 2)));
    assert_eq(click(view(m), "Delete eggs"), Ok(Msg.Delete(2)));
    assert_eq(pick(view(m), "row milk", "Delete"), Ok(Msg.Delete(1)));
    assert_eq(pick(view(m), "row milk", "Mark as done"), Ok(Msg.Toggle(1, true)));
    let gone = update(m, pick(view(m), "row milk", "Delete").unwrap_or(Msg.Draft("")));
    assert_eq(gone.todos.map(fun(t) = t.title), ["eggs"]);
}

@test
fun an_empty_list_says_so() {
    assert_eq(texts(view(start())), ["To-do", "Nothing to do yet", "0 items left"]);
}

@test
fun a_long_title_is_shown_whole_on_hover() {
    let long = "buy oat milk, the barista kind, from the shop on the corner";
    assert_eq(tooltip(view(add(start(), long)), "✕"), Ok("Delete {long}"));
}

@test
fun keyboard_shortcuts_add_and_clear() {
    let m = add(start(), "milk");
    // Ctrl+N is Add's shortcut: disabled (sending nothing) while the draft is blank.
    assert_eq(press(view(m), "Ctrl+N"), Err(Lookup.Silent("shortcut \"Ctrl+N\"")));
    assert_eq(press(view(update(m, Msg.Draft("eggs"))), "Ctrl+N"), Ok(Msg.Add));
    assert_eq(press(view(update(m, Msg.Toggle(1, true))), "Ctrl+Shift+Delete"), Ok(Msg.ClearDone));
}
