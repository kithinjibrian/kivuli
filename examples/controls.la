// Controls: a preview whose size follows a slider and whose weight follows a
// drop-down, a check box, a text area, theme icons, one picture from a file
// and from bytes in memory, and an SVG drawn at two sizes. Run it from the
// repository's root (`lughac run examples/controls.la`): the pictures' paths
// are relative to where the app starts. examples/assets/sample.png and
// sample.svg were made for kivuli, GPL-3.0-only like the rest of the
// repository.
import kivuli {
    Align,
    Sizing,
    Width,
    Edges,
    Spacing,
    Fit,
    Image,
    View,
    Font,
    Text,
    Size,
    Weight,
    FontStyle,
    Paint,
    button,
    checkbox,
    column,
    dropdown,
    icon,
    image,
    row,
    sandbox,
    slider,
    spacer,
    text,
    text_area,
};
// For the tests at the bottom; `lughac build` leaves tests out.
import kivuli.testing { choose, slide, texts, toggle, type_into };

/** At least `w` by `h` pixels; 0 leaves that way to the theme. */
fun at_least(w: i64, h: i64): Sizing = Sizing {
    min_width: if w > 0 { Width.Px(w) } else { Width.Theme },
    min_height: if h > 0 { Width.Px(h) } else { Width.Theme },
    ..Sizing.theme(),
};

/** The same room on every side, inside the node. */
fun pad(n: i64): Spacing = Spacing {
    padding: Edges { all: Width.Px(n), ..Edges.theme() },
    ..Spacing.theme(),
};

/** Room between a column's, row's or wrap's children. */
fun gap(n: i64): Spacing = Spacing { gap: Width.Px(n), ..Spacing.theme() };

struct Model {
    /** The preview's size in points: 8 to 72, in steps of 2. */
    size: i64,
    weight: Weight,
    italic: bool,
    notes: string,
    /** The sample picture's bytes, read once at start (empty if it's missing: nothing shows). */
    sample: u8[],
}

enum Msg {
    Size(i64),
    Weigh(Weight),
    Italic(bool),
    Notes(string),
    Reset,
}

fun start(): Model = Model {
    size: 14,
    weight: Weight.Normal,
    italic: false,
    notes: "",
    sample: read_bytes("examples/assets/sample.png").unwrap_or([]),
};

fun update(m: Model, msg: Msg): Model = match msg {
    Size(n) => Model { size: n, ..m },
    Weigh(w) => Model { weight: w, ..m },
    Italic(on) => Model { italic: on, ..m },
    Notes(s) => Model { notes: s, ..m },
    Reset => Model { size: 14, weight: Weight.Normal, italic: false, ..m },
};

fun dim(): Text = Text { color: Paint.Faded(0.55), ..Text.theme() };

fun labelled(label: string, control: View<Msg>): View<Msg> = row([
    text(label).style([at_least(70, 0)]).align(Align.Center),
    control.expand(),
]).style([gap(8)]);

fun view(m: Model): View<Msg> = column([
    text("The quick brown fox").style([at_least(0, 90)]).style([
        Font {
            size: Size.Pt(m.size),
            weight: m.weight,
            style: if m.italic { FontStyle.Italic } else { FontStyle.Normal },
            ..Font.theme()
        },
    ]),
    labelled("Size", slider(8, 72, m.size, Msg.Size).step(2).name("size")),
    labelled(
        "Weight",
        dropdown(
            [
                ("Light", Msg.Weigh(Weight.Light)),
                ("Normal", Msg.Weigh(Weight.Normal)),
                ("Bold", Msg.Weigh(Weight.Bold)),
            ],
            "{m.weight}",
        ).name("weight"),
    ),
    checkbox("Italic", m.italic, Msg.Italic),
    row([
        text("{m.size} pt, {m.weight}{if m.italic { ", italic" } else { "" }}").style([dim()]),
        spacer(),
        button("Reset", Msg.Reset).disabled(m.size == 14 && m.weight == Weight.Normal && !m.italic),
    ]),
    text_area(m.notes, Msg.Notes).name("notes").style([at_least(0, 80)]),
    row([
        icon("emblem-ok-symbolic"),
        icon("starred-symbolic").size(32),
        image(Image.File("examples/assets/sample.png")).style([at_least(120, 80)]).fit(Fit.Cover),
        // The key names the bytes: the same key, and they're never decoded again.
        image(Image.Bytes("sample", m.sample)).size(64),
        // An SVG is drawn, not decoded: sharp at any size.
        image(Image.File("examples/assets/sample.svg")).size(32),
        image(Image.File("examples/assets/sample.svg")).size(96),
    ]).style([gap(12)]),
]).style([pad(16), gap(10)]).window("Controls", 440, 560);

fun main(): i32 = sandbox("org.kivuli.controls", start(), update, view);

// Tests: what a user does, worked out from the view and fed back through `update`.

fun did(m: Model, msg: Msg): Model = update(m, msg);

/** The line under the controls: the one giving the size in points. */
fun summary(m: Model): string = texts(view(m)).filter(fun(t) = t.contains(" pt"))[0];

@test
fun the_size_slider_moves_in_steps_of_two_and_stays_in_range() {
    assert_eq(slide(view(start()), "size", 21), Ok(Msg.Size(22)));
    assert_eq(slide(view(start()), "size", 100), Ok(Msg.Size(72)));
    assert_eq(summary(did(start(), Msg.Size(30))), "30 pt, Normal");
}

@test
fun weight_and_italic_follow_their_controls() {
    let bold = did(start(), choose(view(start()), "weight", "Bold").unwrap_or(Msg.Reset));
    let italic = did(bold, toggle(view(bold), "Italic").unwrap_or(Msg.Reset));
    assert_eq(summary(italic), "14 pt, Bold, italic");
    assert_eq(did(italic, Msg.Reset).weight, Weight.Normal);
}

@test
fun notes_keep_what_was_typed() {
    let m = did(
        start(),
        type_into(view(start()), "notes", "line one\nline two").unwrap_or(Msg.Reset),
    );
    assert_eq(m.notes, "line one\nline two");
}
