// A browser-like frame: the app's own colours as typed looks, a header bar
// with back, an address field filling the bar and a new-tab button, a tab
// rail whose selected tab has a look of its own, and a window that opens
// maximized. The header bar and the rail (on the right) share one flat look,
// so they read as one L-shaped frame, and the page curves only at its top
// right, where the frame wraps it. Home shows app tiles in a wrapping grid:
// resize the window and they re-flow; add or remove one and only that tile
// moves. Info opens a panel over the page's right edge, an overlay; clicking
// outside it closes it; its rows are whole buttons. Right-click a tab (or long-press it, or press
// Shift+F10 on it) for its menu: duplicate, close, close the others. Its tests are at the bottom: `lughac test examples/frame.la`.
import kivuli {
    Align,
    Border,
    ButtonStyle,
    Surface,
    View,
    button,
    button_with,
    column,
    item,
    menu_separator,
    hex,
    icon,
    input,
    keyed_wrap,
    overlay,
    row,
    sandbox,
    text,
    theme,
};
// For the tests at the bottom; `lughac build` leaves tests out.
import kivuli.testing { Lookup, click, is_disabled, pick, submit, texts, type_into };

/** The parts of the frame the app colours. */
enum Look {
    /** The frame: the header bar and the tab rail, one surface with no line between. */
    Frame,
    Tab,
    Selected,
    Panel,
    Scrim,
    Home,
}

fun surface(l: Look): Surface = match l {
    Frame => Surface { background: Some(hex("#242424")), flat: Some(true), ..Surface.theme() },
    Tab => Surface { text: Some(hex("#c0c0c0")), radius: Some(6), ..Surface.theme() },
    Selected => Surface {
        background: Some(hex("#3a3a3a")),
        text: Some(hex("#ffffff")),
        border: Some(Border { width: 1, color: hex("#505050") }),
        ..Surface.theme(),
    },
    /** The info panel over the page, its left corners rounded. */
    Panel => Surface {
        background: Some(hex("#202020")),
        text: Some(hex("#e0e0e0")),
        radius_top_left: Some(12),
        radius_bottom_left: Some(12),
        flat: Some(true),
        ..Surface.theme(),
    },
    /** Behind the panel: dims the page, and a click on it closes the panel. */
    Scrim => Surface { background: Some(hex("#00000060")), flat: Some(true), ..Surface.theme() },
    Home => Surface {
        background: Some(hex("#161616")),
        text: Some(hex("#e0e0e0")),
        // The corner the frame wraps; the other three meet the window's edges.
        radius_top_right: Some(12),
        ..Surface.theme(),
    },
};

struct Browser {
    /** Each tab's history of addresses; the last is shown. */
    tabs: string[][],
    current: i64,
    draft: string,
    /** Home's tiles, by name (each name is its key). */
    tiles: string[],
    /** How many tiles have been added, to name the next. */
    added: i64,
    /** Whether the info panel is open. */
    info: bool,
}

enum Msg {
    Draft(string),
    Go,
    Back,
    Open(i64),
    NewTab,
    /** From a tab's menu: a copy of the tab after it, selected. */
    Duplicate(i64),
    CloseTab(i64),
    CloseOthers(i64),
    Visit(string),
    AddTile,
    RemoveTile,
    ToggleInfo,
    CloseInfo,
}

fun start(): Browser = Browser {
    tabs: [["home"]],
    current: 0,
    draft: "home",
    tiles: ["News", "Mail", "Maps", "Music", "Notes", "Photos", "Weather", "Chess"],
    added: 0,
    info: false,
};

fun shown(b: Browser): string {
    let history = b.tabs[b.current];
    history[history.len - 1]
}

fun update(b: Browser, msg: Msg): Browser = match msg {
    Draft(s) => Browser { draft: s, ..b },
    Go => {
        let mut tabs = b.tabs;
        let mut history = tabs[b.current];
        history.push(b.draft);
        tabs[b.current] = history;
        Browser { tabs: tabs, ..b }
    }
    Back => {
        let mut tabs = b.tabs;
        let mut history = tabs[b.current];
        if history.len > 1 {
            history.pop();
        }
        tabs[b.current] = history;
        let next = Browser { tabs: tabs, ..b };
        Browser { draft: shown(next), ..next }
    }
    Open(i) => {
        let next = Browser { current: i, ..b };
        Browser { draft: shown(next), ..next }
    }
    NewTab => {
        let mut tabs = b.tabs;
        tabs.push(["home"]);
        Browser { tabs: tabs, current: tabs.len - 1, draft: "home", ..b }
    }
    Duplicate(i) => {
        let mut tabs: string[][] = [];
        let mut j = 0;
        while j < b.tabs.len {
            tabs.push(b.tabs[j]);
            if j == i {
                tabs.push(b.tabs[i]);
            }
            j = j + 1;
        }
        update(Browser { tabs: tabs, ..b }, Msg.Open(i + 1))
    }
    // The last tab closed leaves a fresh one; the selected tab closed selects
    // the one taking its place (or the new last).
    CloseTab(i) => if b.tabs.len == 1 {
        update(Browser { tabs: [["home"]], ..b }, Msg.Open(0))
    } else {
        let mut tabs: string[][] = [];
        let mut j = 0;
        while j < b.tabs.len {
            if j != i {
                tabs.push(b.tabs[j]);
            }
            j = j + 1;
        }
        let current = if b.current > i || b.current == tabs.len {
            b.current - 1
        } else {
            b.current
        };
        update(Browser { tabs: tabs, ..b }, Msg.Open(current))
    },
    CloseOthers(i) => update(Browser { tabs: [b.tabs[i]], ..b }, Msg.Open(0)),
    // A tile opens its page in this tab, as typing its name would.
    Visit(name) => update(Browser { draft: name, ..b }, Msg.Go),
    AddTile => {
        let mut tiles = b.tiles;
        tiles.push("App {b.added + 1}");
        Browser { tiles: tiles, added: b.added + 1, ..b }
    }
    // The first tile goes: the rest move up, nothing is rebuilt.
    RemoveTile => Browser { tiles: b.tiles.filter(fun(t) = t != b.tiles[0]), ..b },
    ToggleInfo => Browser { info: !b.info, ..b },
    CloseInfo => Browser { info: false, ..b },
};

/** The info panel: what this tab holds. */
fun info_panel(b: Browser): View<Msg> = column([
    text("About this tab").bold(),
    text("Tab {b.current + 1} of {b.tabs.len}"),
    text("{b.tabs[b.current].len} page(s), now at {shown(b)}").dim(),
    // Whole rows are buttons: a click anywhere on one, or Enter on it.
    column([
        panel_row("Go back", "to {previous(b)}", Msg.Back).disabled(b.tabs[b.current].len < 2),
        panel_row("Open a new tab", "home", Msg.NewTab),
    ]),
    button("Close", Msg.CloseInfo),
]).spacing(10).padding(20).width(300).style([Look.Panel]);

/** One row of the info panel: a label, a summary and an arrow, all one flat button. */
fun panel_row(label: string, summary: string, msg: Msg): View<Msg> = button_with(
    row([text(label).expand(), text(summary).dim(), icon("go-next-symbolic")]).spacing(8),
    msg,
).button_style(ButtonStyle.Subtle);

/** The page before this tab's current one, or "nothing". */
fun previous(b: Browser): string {
    let history = b.tabs[b.current];
    if history.len < 2 { "nothing" } else { history[history.len - 2] }
}

fun tab(b: Browser, i: i64): View<Msg> {
    let history = b.tabs[i];
    let label = button(history[history.len - 1], Msg.Open(i)).menu([
        item("Duplicate tab", Msg.Duplicate(i)),
        item("Close tab", Msg.CloseTab(i)),
        menu_separator(),
        item("Close other tabs", Msg.CloseOthers(i)).disabled(b.tabs.len == 1),
    ]);
    if i == b.current { label.style([Look.Tab, Look.Selected]) } else { label.style([Look.Tab]) }
}

fun view(b: Browser): View<Msg> {
    let mut tabs: View<Msg>[] = [];
    let mut i = 0;
    while i < b.tabs.len {
        tabs.push(tab(b, i));
        i = i + 1;
    }
    let page = column([
            text("You're at {shown(b)}").size(18),
            text("{b.tabs[b.current].len} page(s) in this tab").dim(),
            row([
                button("Add a tile", Msg.AddTile),
                button("Remove a tile", Msg.RemoveTile).disabled(b.tiles.len == 0),
            ]).spacing(8),
            // Equal tiles, at most six across; fewer on a narrow window.
            keyed_wrap(b.tiles.map(fun(t) = (t, button(t, Msg.Visit(t)).width(120).height(72)))).equal().max_per_line(6).spacing(12),
        ]).spacing(8).padding(24).style([Look.Home]);
    // The panel goes over the page; under it, a full-size layer that closes it.
    let layers: View<Msg>[] = if b.info {
        [
            button("", Msg.CloseInfo).style([Look.Scrim]).tooltip("Close the panel"),
            info_panel(b).place(Align.End, Align.Fill),
        ]
    } else {
        []
    };
    // The row is the frame too: the page's curve shows the frame's colour.
    row([
        overlay(page, layers).expand(),
        column(tabs).spacing(4).padding(8).width(160).style([Look.Frame]),
    ]).style([Look.Frame]).window("{shown(b)} — Frame", 1000, 640).maximized().theme(
        theme([Look.Frame, Look.Tab, Look.Selected, Look.Panel, Look.Scrim, Look.Home], surface),
    ).header(
        [
            button("", Msg.Back).icon("go-previous-symbolic").tooltip("Back").disabled(
                b.tabs[b.current].len < 2,
            ),
        ],
        input(b.draft, Msg.Draft).placeholder("Address").on_submit(Msg.Go).expand(),
        [
            button("", Msg.NewTab).icon("tab-new-symbolic").tooltip("New tab"),
            button("", Msg.ToggleInfo).icon("dialog-information-symbolic").tooltip("Info"),
        ],
    ).header_style([Look.Frame])
}

fun main(): i32 = sandbox("org.kivuli.frame", start(), update, view);

// Tests: what a user does, worked out from the view and fed back through `update`.

fun did(b: Browser, msg: Msg): Browser = update(b, msg);

fun visit(b: Browser, address: string): Browser = did(
    did(b, type_into(view(b), "Address", address).unwrap_or(Msg.Go)),
    submit(view(b), "Address").unwrap_or(Msg.Go),
);

@test
fun the_address_bar_in_the_header_goes_and_back_returns() {
    let b = visit(start(), "news");
    assert_eq(shown(b), "news");
    assert_eq(texts(view(b))[0], "You're at news");
    let back = did(b, click(view(b), "Back").unwrap_or(Msg.Go));
    assert_eq(shown(back), "home");
    assert_eq(back.draft, "home");
}

@test
fun back_is_disabled_on_a_tabs_first_page() {
    assert_eq(is_disabled(view(start()), "Back"), Ok(true));
    assert_eq(is_disabled(view(visit(start(), "a")), "Back"), Ok(false));
}

@test
fun new_tabs_open_at_home_and_tabs_switch() {
    let b = did(
        visit(start(), "news"),
        click(view(visit(start(), "news")), "New tab").unwrap_or(Msg.Go),
    );
    assert_eq((b.tabs.len, b.current, shown(b)), (2, 1, "home"));
    let first = did(b, click(view(b), "news").unwrap_or(Msg.Go));
    assert_eq((first.current, first.draft), (0, "news"));
}

@test
fun tiles_open_their_page_and_come_and_go() {
    let b = did(start(), click(view(start()), "Maps").unwrap_or(Msg.Go));
    assert_eq(shown(b), "Maps");
    let more = did(b, click(view(b), "Add a tile").unwrap_or(Msg.Go));
    assert_eq(more.tiles[more.tiles.len - 1], "App 1");
    let fewer = did(more, click(view(more), "Remove a tile").unwrap_or(Msg.Go));
    assert_eq((fewer.tiles.len, fewer.tiles[0]), (more.tiles.len - 1, "Mail"));
}

@test
fun info_opens_a_panel_over_the_page_and_a_click_outside_closes_it() {
    let open = did(start(), click(view(start()), "Info").unwrap_or(Msg.Go));
    assert(open.info);
    assert_eq(texts(view(open)).filter(fun(t) = t == "About this tab").len, 1);
    let outside = did(open, click(view(open), "Close the panel").unwrap_or(Msg.Go));
    assert(!outside.info);
    let closed = did(open, click(view(open), "Close").unwrap_or(Msg.Go));
    assert(!closed.info);
}

@test
fun a_tabs_menu_duplicates_and_closes_tabs() {
    // One tab: closing the others is greyed out.
    assert_eq(
        pick(view(start()), "home", "Close other tabs"),
        Err(Lookup.Silent("menu item \"Close other tabs\"")),
    );
    let b = visit(start(), "news");
    let two = did(b, pick(view(b), "news", "Duplicate tab").unwrap_or(Msg.Go));
    assert_eq((two.tabs.len, two.current, shown(two)), (2, 1, "news"));
    let three = did(two, click(view(two), "New tab").unwrap_or(Msg.Go));
    // Closing the selected tab selects the one that takes its place.
    let closed = did(three, pick(view(three), "home", "Close tab").unwrap_or(Msg.Go));
    assert_eq((closed.tabs.len, closed.current, closed.draft), (2, 1, "news"));
    let alone = did(three, pick(view(three), "home", "Close other tabs").unwrap_or(Msg.Go));
    assert_eq((alone.tabs.len, alone.current, shown(alone)), (1, 0, "home"));
    // The last tab closed leaves a fresh one.
    let fresh = did(b, pick(view(b), "news", "Close tab").unwrap_or(Msg.Go));
    assert_eq((fresh.tabs.len, shown(fresh), fresh.draft), (1, "home", "home"));
}

@test
fun the_info_panels_rows_are_whole_buttons() {
    let open = did(start(), click(view(start()), "Info").unwrap_or(Msg.Go));
    // On a tab's first page there's nowhere to go back to.
    assert_eq(is_disabled(view(open), "Go back"), Ok(true));
    let two = did(open, click(view(open), "Open a new tab").unwrap_or(Msg.Go));
    assert_eq(two.tabs.len, 2);
    let b = did(visit(start(), "news"), Msg.ToggleInfo);
    // A row is found by any text in it, the summary too.
    let back = did(b, click(view(b), "to home").unwrap_or(Msg.Go));
    assert_eq(shown(back), "home");
}
