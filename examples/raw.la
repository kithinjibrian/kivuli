// Step 0: a counter written straight on gtk.raw, with no kivuli.
// This is the layer kivuli will drive for you.
import gtk {
    GtkApplication,
    GtkWidget,
    connect_app,
    connect_widget,
    g_application_run,
    g_object_unref,
    gtk_application_new,
    gtk_application_window_new,
    gtk_box_append,
    gtk_box_new,
    gtk_button_new_with_label,
    gtk_label_new,
    gtk_label_set_text,
    gtk_widget_set_margin_bottom,
    gtk_widget_set_margin_end,
    gtk_widget_set_margin_start,
    gtk_widget_set_margin_top,
    gtk_window_present,
    gtk_window_set_child,
    gtk_window_set_default_size,
    gtk_window_set_title,
};

fun main(): i32 {
    let application = gtk_application_new("org.kivuli.raw", 0);

    connect_app(
        application,
        "activate",
        fun(a: GtkApplication) {
            let window = gtk_application_window_new(a);
            gtk_window_set_title(window, "Raw counter");
            gtk_window_set_default_size(window, 320, 160);

            let label = gtk_label_new("0");
            let button = gtk_button_new_with_label("add one");

            // The "model": the one piece of state, shared with the click handler.
            let count = Ref.new(0);
            connect_widget(
                button,
                "clicked",
                fun(b: GtkWidget) {
                    count.update(fun(n) = n + 1);
                    gtk_label_set_text(label, "{count.get()}");
                },
                0,
            );

            // 1 = vertical (GtkOrientation), 8 px between children.
            let column = gtk_box_new(1, 8);
            gtk_box_append(column, label);
            gtk_box_append(column, button);
            gtk_widget_set_margin_top(column, 24);
            gtk_widget_set_margin_bottom(column, 24);
            gtk_widget_set_margin_start(column, 24);
            gtk_widget_set_margin_end(column, 24);

            gtk_window_set_child(window, column);
            gtk_window_present(window);
        },
        0,
    );

    let status = g_application_run(application, 0, None);
    g_object_unref(application);
    status
}
